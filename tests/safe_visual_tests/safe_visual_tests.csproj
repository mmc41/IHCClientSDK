<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.NUnit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
    <ProjectReference Include="..\..\applications\ihc_openvisual\ihc_openvisual.csproj" />
  </ItemGroup>

  <!-- Catalog-import tests read the synthetic .def/.ifb oracles; this copies them to
       $(OutDir)\testdata\... so they are reached the same way as in the other suites. -->
  <ItemGroup>
    <!-- The shared oracle harnesses, linked in the same way safe_project_tests and safe_unit_tests link them.
         ReportOracles comes along because it owns the PINNED INSTANT both oracle families use: borrowing it is
         what keeps the findings oracles and the report oracles on one clock instead of two. -->
    <Compile Include="..\shared\ReportOracles.cs" Link="shared\ReportOracles.cs" />
    <Compile Include="..\shared\FindingOracles.cs" Link="shared\FindingOracles.cs" />
  </ItemGroup>

  <Import Project="..\TestData.props" />

  <!-- crudarch T023: the registry<->XAML consistency test parses the window's own markup — the SUBJECT under
       test, not an oracle (so it is a direct link, not a TestData.props fixture) — copied to $(OutDir)\appxaml
       and read via TestContext.TestDirectory, never by walking into the source checkout at test time. -->
  <ItemGroup>
    <None Include="..\..\applications\ihc_openvisual\Views\MainWindow.axaml"
          Link="appxaml\MainWindow.axaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Same rule for the icon-mapping doc: the icon-registration tests read it as the SUBJECT under test. -->
    <None Include="..\..\applications\ihc_openvisual\docs\icon_codes.md"
          Link="appdocs\icon_codes.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- And for the product spec: RegisterPinTests reads the Differences register as the SUBJECT under test —
         every registered difference must name the test that would fail if it drifted back. -->
    <None Include="..\..\applications\ihc_openvisual\docs\product.md"
          Link="appdocs\product.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- T041: the host problem appendix, for the same reason — its row table is RENDERED from the
         app.openvisual.* declarations and compared, so the published document cannot fall behind the code. -->
    <None Include="..\..\applications\ihc_openvisual\docs\error-list.md"
          Link="appdocs\error-list.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- T042: the GUI's own sources are the SUBJECT of the message-site fitness check — it must see EVERY file,
         not a list someone remembers to extend, so this is a glob with bin/obj excluded. Copied beside the
         binaries like the markup and docs above; no test walks into the checkout. -->
    <None Include="..\..\applications\ihc_openvisual\**\*.cs"
          Exclude="..\..\applications\ihc_openvisual\bin\**\*.cs;..\..\applications\ihc_openvisual\obj\**\*.cs"
          Link="appsrc\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- T045: the app's MARKUP, for the numeric-bounds gate — it must see every window, not a remembered list.
       Copied by a TARGET rather than as a None item: Avalonia's build targets reclassify *.axaml out of None, so the
       declarative form silently copied nothing (measured: zero files in the output, and the armed control caught
       it — a scan that reads no files passes every assertion). -->
  <Target Name="CopyAppMarkupForScan" BeforeTargets="Build">
    <ItemGroup>
      <AppMarkupForScan Include="..\..\applications\ihc_openvisual\**\*.axaml"
                        Exclude="..\..\applications\ihc_openvisual\bin\**\*.axaml;..\..\applications\ihc_openvisual\obj\**\*.axaml" />
    </ItemGroup>
    <Copy SourceFiles="@(AppMarkupForScan)"
          DestinationFiles="@(AppMarkupForScan->'$(OutDir)appmarkup\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
