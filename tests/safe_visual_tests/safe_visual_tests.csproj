<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.NUnit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
    <ProjectReference Include="..\..\applications\ihc_openvisual\ihc_openvisual.csproj" />
  </ItemGroup>

  <!-- Catalog-import tests read the synthetic .def/.ifb oracles; this copies them to
       $(OutDir)\testdata\... so they are reached the same way as in the other suites. -->
  <Import Project="..\TestData.props" />

  <!-- crudarch T023: the registry<->XAML consistency test parses the window's own markup — the SUBJECT under
       test, not an oracle (so it is a direct link, not a TestData.props fixture) — copied to $(OutDir)\appxaml
       and read via TestContext.TestDirectory, never by walking into the source checkout at test time. -->
  <ItemGroup>
    <None Include="..\..\applications\ihc_openvisual\Views\MainWindow.axaml"
          Link="appxaml\MainWindow.axaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Same rule for the icon-mapping doc: the icon-registration tests read it as the SUBJECT under test. -->
    <None Include="..\..\applications\ihc_openvisual\docs\icon_codes.md"
          Link="appdocs\icon_codes.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- And for the product spec: RegisterPinTests reads the Differences register as the SUBJECT under test —
         every registered difference must name the test that would fail if it drifted back. -->
    <None Include="..\..\applications\ihc_openvisual\docs\product.md"
          Link="appdocs\product.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
