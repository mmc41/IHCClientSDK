<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.NUnit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the shared Avalonia fixture base and its capture attribute live; every fixture here names
         the base, and this suite's own namespace is not the one they are declared in. -->
    <Using Include="Ihc.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
    <!-- The IL decode and the member population every structural rule reads. Shared because the
         controller-reach guard runs INSIDE each suite it polices, and a suite cannot be scanned from
         outside by an assembly that does not reference it. -->
    <Compile Include="..\shared\IlBody.cs" Link="shared\IlBody.cs" />
    <Compile Include="..\shared\AuthoredMembers.cs" Link="shared\AuthoredMembers.cs" />
    <Compile Include="..\shared\ControllerReachScan.cs" Link="shared\ControllerReachScan.cs" />
    <!-- The safety rule, as a gate rather than a convention: this suite may reach no controller. -->
    <Compile Include="..\shared\ControllerReachGuard.cs" Link="shared\ControllerReachGuard.cs" />
    <ProjectReference Include="..\..\applications\ihc_openvisual\ihc_openvisual.csproj" />
  </ItemGroup>

  <!-- Catalog-import tests read the synthetic .def/.ifb oracles; this copies them to
       $(OutDir)\testdata\... so they are reached the same way as in the other suites. -->
  <ItemGroup>
    <!-- The headless Avalonia app builder, shared with safe_visual_e2e_tests: it is what decides font
         metrics, and the two suites have to agree about layout to agree about what is on screen. -->
    <Compile Include="..\shared\OpenVisualHeadlessApp.cs" Link="shared\OpenVisualHeadlessApp.cs" />
    <Compile Include="..\shared\TelemetryCapture.cs" Link="shared\TelemetryCapture.cs" />
    <!-- The headless failure-screenshot capture and the NUnit command that decides when to run it, shared with
         safe_lab_tests: cross-thread dispatch onto the session, a timeout and exception marshalling, and an
         outcome test that cannot be read off the test result alone. A bug in either is a deadlock or a silently
         missing screenshot rather than a red test. -->
    <Compile Include="..\shared\HeadlessScreenshot.cs" Link="shared\HeadlessScreenshot.cs" />
    <Compile Include="..\shared\ScreenshotCaptureCommand.cs" Link="shared\ScreenshotCaptureCommand.cs" />
    <!-- The attribute those two are driven by, and the base class holding the window they capture. One
         declaration for both Avalonia suites; it names no application's types, so each suite supplies its own
         window opener beside it (safe_lab_tests has LabWindows.cs). -->
    <Compile Include="..\shared\AvaloniaTestBase.cs" Link="shared\AvaloniaTestBase.cs" />
    <!-- The shell harness, the scriptable dialog port, the capturing logger and the scratch directory.
         Shared because the toolkit-free half of the GUI suite is moving here and most of it opens with one
         of these; a copy is how the two would drift. -->
    <Compile Include="..\shared\TestSupport.cs" Link="shared\TestSupport.cs" />
    <!-- The session-editing shorthands the harness itself calls, so it travels with it. -->
    <Compile Include="..\shared\SessionEditingTestExtensions.cs" Link="shared\SessionEditingTestExtensions.cs" />
    <!-- The leak detector is an ASSEMBLY-level ITestAction, so it has to be compiled into each hosting
         assembly to act there; a project reference would leave the second suite unguarded. Its
         companions travel with it because the same fixtures use them. -->
    <Compile Include="..\shared\NoLeakedHarness.cs" Link="shared\NoLeakedHarness.cs" />
    <Compile Include="..\shared\TraceProbe.cs" Link="shared\TraceProbe.cs" />
    <!-- The recursive tree-node lookup both suites' fixtures reach for. -->
    <Compile Include="..\shared\TreeNodes.cs" Link="shared\TreeNodes.cs" />
    <!-- The Problemer corpus and the two window-free rigs over it. -->
    <Compile Include="..\shared\ProblemsTestSupport.cs" Link="shared\ProblemsTestSupport.cs" />
  </ItemGroup>

  <Import Project="..\TestData.props" />

  <!-- crudarch T023: the registry<->XAML consistency test parses the window's own markup — the SUBJECT under
       test, not an oracle (so it is a direct link, not a TestData.props fixture) — copied to $(OutDir)\appxaml
       and read via TestContext.TestDirectory, never by walking into the source checkout at test time. -->
  <ItemGroup>
    <None Include="..\..\applications\ihc_openvisual\Views\MainWindow.axaml"
          Link="appxaml\MainWindow.axaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Same rule for the icon-mapping doc: the icon-registration tests read it as the SUBJECT under test. -->
    <None Include="..\..\applications\ihc_openvisual\docs\icon_codes.md"
          Link="appdocs\icon_codes.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The GUI's own sources are the SUBJECT of DialogBoundsFromMetadataTests — it must see EVERY file, not a
         list someone remembers to extend, so this is a glob with bin/obj excluded. Copied beside the binaries
         like the markup and doc above; no test walks into the checkout. -->
    <None Include="..\..\applications\ihc_openvisual\**\*.cs"
          Exclude="..\..\applications\ihc_openvisual\bin\**\*.cs;..\..\applications\ihc_openvisual\obj\**\*.cs"
          Link="appsrc\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- T045: the app's MARKUP, for the numeric-bounds gate — it must see every window, not a remembered list.
       Copied by a TARGET rather than as a None item: Avalonia's build targets reclassify *.axaml out of None, so the
       declarative form silently copied nothing (measured: zero files in the output, and the armed control caught
       it — a scan that reads no files passes every assertion). -->
  <Target Name="CopyAppMarkupForScan" BeforeTargets="Build">
    <ItemGroup>
      <AppMarkupForScan Include="..\..\applications\ihc_openvisual\**\*.axaml"
                        Exclude="..\..\applications\ihc_openvisual\bin\**\*.axaml;..\..\applications\ihc_openvisual\obj\**\*.axaml" />
    </ItemGroup>
    <Copy SourceFiles="@(AppMarkupForScan)"
          DestinationFiles="@(AppMarkupForScan->'$(OutDir)appmarkup\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
