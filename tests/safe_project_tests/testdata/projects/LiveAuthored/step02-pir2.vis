      <group id="_0x2232" name="Entré" icon="_0x15">
         <functionblock id="_0x19628" name="1.4.02.a. PIR styring " master_schneider_electric="yes" master_type="1.4.02" master_version="a" master_name="PIR styring " master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2016" master_date_year="2017" master_date_month="9" master_date_day="14" locked="yes" icon="_0xe" note="1.4.02.a. PIR styring &#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til simpel styring af IHC Wireless produkter og relæer ifm. PIR og manuel betjening.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.">
            <inputs id="_0x1a023" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x1a111" name="PIR" icon="_0x36" note="Forbindes til tilstedeværelses indikering fra PIR sensor.&#xD;&#xA;Virkemåde defineres under indstillinger:&#xD;&#xA; &quot;# PIR funktion&quot;&#xD;&#xA; &quot;# PIR funktion nat&quot;&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x1a211" name="Skumring" icon="_0x36" note="Forbindes fra skumringssensor eller luxsensor ifm. funktionsblok 1.1.12&#xD;&#xA;Alternativt via ur funktionsblok.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" inivalue="on"/>
               <resource_input id="_0x1a311" name="Tilbagemelding" icon="_0x36" note="Opret link mellem produktets &quot;Udgang&quot; og &quot;Tilbagemelding&quot;.&#xD;&#xA;Ved tilbagemelding begrænses genkald af IHC Wireless produkter ifm. PIR aktivitet."/>
               <resource_input id="_0x1a411" name="Natdrift" icon="_0x36" note="Anvendes som begrænsning for PIR funktion om natten.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x1a511" name="Kip" icon="_0x36" note="Kipper udgang og scenarier&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x1a611" name="Tænd" icon="_0x36" note="Tænder udgang og scenarie &#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x1a711" name="Sluk" icon="_0x36" note="Slukker udgang og scenarie.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_input id="_0x1a811" name="Spærring" icon="_0x36" note="Når denne indgang er on, vil al automatik være spærret. Dette giver mulighed for total spærring i både tændt og slukket tilstand.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
            </inputs>
            <outputs id="_0x1a924" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x1aa12" name="Udgang" icon="_0x39" note="Forbindes til relæ hvis scenariefunktion ikke benyttes.&#xD;&#xA;"/>
               <resource_output id="_0x1ab12" name="ON puls" icon="_0x39" note="Giver kort puls ved tænding.&#xD;&#xA;Anvendes til styring af andre blokke."/>
               <resource_output id="_0x1ac12" name="OFF puls" icon="_0x39" note="Giver kort puls ved slukning.&#xD;&#xA;Anvendes til styring af andre blokke."/>
               <resource_output id="_0x1ad12" name="Manuelt betjent" icon="_0x39" note="Visning af overstyring af PIR. &#xD;&#xA;Kan benyttes til diode eller Viewer.&#xD;&#xA;Ifm. manuel sluk vil udgang blinke (default 15 sek.) som kvittéring for spærring af PIR."/>
               <resource_scene id="_0x1ae4a" name="Scenarie tænd" note="Forbindes til relæ og/eller IHC Wireless lysdæmper."/>
               <resource_scene id="_0x1af4a" name="Scenarie sluk" note="Forbindes til relæ og/eller IHC Wireless lysdæmper."/>
            </outputs>
            <settings id="_0x1b025" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x1b110" name="Efterløb" backup="yes" icon="_0x43" note="Her indstilles efterløbstiden.&#xD;&#xA;" hour="0" minute="3" second="0" millisecond="0"/>
               <resource_enum id="_0x1b20f" name="PIR funktion" typedef="_0x5547" inivalue="_0x5648" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Tænder lys&quot;&#xD;&#xA;&quot;Kun efterløb&quot;&#xD;&#xA;"/>
               <resource_enum id="_0x1b30f" name="PIR funktion nat" typedef="_0x5847" inivalue="_0x5948" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have om natten.&#xD;&#xA;Natdrift indgangen skal benyttes for at opnå funktion.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Tænder lys&quot;&#xD;&#xA;&quot;Kun efterløb&quot;&#xD;&#xA;"/>
               <resource_enum id="_0x1b40f" name="Manuel tænding" typedef="_0x5247" inivalue="_0x5348" icon="_0x22" note="Her er det muligt, at vælge funktion på manuel tænding.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Ved &quot;Starter efterløb&quot; vil lys slukke på efterløb efter sidste påvirking af PIR eller tryk.&#xD;&#xA;Ved &quot;Spærrer efterløb&quot; vil lys ikke slukke ved skumringsfrafald når manuel betjening er aktiv."/>
            </settings>
            <internalsettings id="_0x1b529" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x1b610" name="Blokkering efter manuel sluk" icon="_0x43" hour="0" minute="0" second="15" millisecond="0"/>
               <resource_timer id="_0x1b710" name="Puls" icon="_0x43" hour="0" minute="0" second="0" millisecond="250"/>
               <resource_timer id="_0x1b810" name="Kvittér med blink efter manuel sluk" icon="_0x43" hour="0" minute="0" second="1" millisecond="0"/>
            </internalsettings>
