<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE product_dataline[
   <!ELEMENT product_dataline ANY>
   <!ATTLIST product_dataline id ID #REQUIRED
                  product_identifier CDATA #REQUIRED
                  name CDATA ""
                  locked (yes | no) "yes"
                  enduser_report (yes | no) "yes"
                  icon CDATA ""
                  note CDATA ""
                  position CDATA ""
                  documentation_tag CDATA ""
                  power_group CDATA ""
                  cabletype CDATA ""
                  cablenumber CDATA "">
   <!ELEMENT dataline_input ANY>
   <!ATTLIST dataline_input id ID #REQUIRED
                  name CDATA ""
                  note CDATA ""
                  inivalue (on | off) "off"
                  address_dataline CDATA "_0x0"
                  cable_colour CDATA "">
]>
<product_dataline id="_0x01" product_identifier="_0x9f01" name="01#Synthetic Input Product" note="Synthetic oracle - not a real product (æøå)">
  <dataline_input id="_0x02" name="Input A" note="Synthetic pin A" address_dataline="_0x1" cable_colour="ColourA" />
  <dataline_input id="_0x03" name="Input B" note="Synthetic pin B" address_dataline="_0x2" cable_colour="ColourB" inivalue="on" />
</product_dataline>
