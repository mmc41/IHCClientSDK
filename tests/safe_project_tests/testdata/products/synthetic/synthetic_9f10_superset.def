<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE product_dataline[
   <!ELEMENT product_dataline ANY>
   <!ATTLIST product_dataline id ID #REQUIRED
                  product_identifier CDATA #REQUIRED
                  name CDATA ""
                  locked (yes | no) "yes"
                  enduser_report (yes | no) "no"
                  icon CDATA ""
                  note CDATA "">
   <!ELEMENT dataline_input ANY>
   <!ATTLIST dataline_input id ID #REQUIRED
                  name CDATA ""
                  note CDATA ""
                  inivalue (on | off) "off"
                  pulse_width (24 | 48 | none) "24"
                  address_dataline CDATA "_0x0"
                  cable_colour CDATA "">
   <!ELEMENT dataline_output ANY>
   <!ATTLIST dataline_output id ID #REQUIRED
                  name CDATA ""
                  note CDATA ""
                  inivalue (on | off) "off"
                  backup (yes | no) "yes"
                  type (led | unspecified) "unspecified"
                  address_dataline CDATA "_0x0"
                  cable_colour CDATA "">
   <!ELEMENT resource_temperature ANY>
   <!ATTLIST resource_temperature id ID #REQUIRED
                  name CDATA ""
                  note CDATA ""
                  backup (yes | no) "no"
                  inivalue CDATA "20.00"
                  accessibility (read | write | read-write) "read-write">
]>
<product_dataline id="_0x01" product_identifier="_0x9f10" name="Synthetic superset produkt" note="Synthetic oracle - superset DTD, undeclared body type, digit-leading enum tokens">
  <dataline_input id="_0x02" name="Indgang" note="Bruger pulse_width 48" pulse_width="48" address_dataline="_0x1" />
  <resource_input id="_0x03" name="Alarm" note="Synthetic - type undeclared in own DTD" accessibility="read" />
</product_dataline>
