<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE product_rs485_led_dimmer[
   <!ELEMENT product_rs485_led_dimmer ANY>
   <!ATTLIST product_rs485_led_dimmer id ID #REQUIRED
                  product_identifier CDATA #REQUIRED
                  name CDATA ""
                  locked (yes | no) "yes"
                  enduser_report (yes | no) "no"
                  icon CDATA ""
                  note CDATA ""
                  position CDATA ""
                  serialnumber CDATA ""
                  documentation_tag CDATA "">
   <!ELEMENT rs485_led_dimmer_channel ANY>
   <!ATTLIST rs485_led_dimmer_channel id ID #REQUIRED
                  name CDATA ""
                  note CDATA ""
                  channel CDATA ""
                  channel_id CDATA ""
                  icon CDATA "">
   <!ELEMENT resource_flag ANY>
   <!ATTLIST resource_flag id ID #REQUIRED
                  name CDATA "Flag"
                  backup (yes | no) "no"
                  icon CDATA "_0x33"
                  note CDATA ""
                  inivalue (on | off) "off"
                  access (readonly | readwrite | writeonly) "readwrite">
   <!ELEMENT airlink_dimmer_increase ANY>
   <!ATTLIST airlink_dimmer_increase id ID #REQUIRED
                  address_channel CDATA #REQUIRED
                  name CDATA ""
                  note CDATA "">
   <!ELEMENT airlink_dimmer_decrease ANY>
   <!ATTLIST airlink_dimmer_decrease id ID #REQUIRED
                  address_channel CDATA #REQUIRED
                  name CDATA ""
                  note CDATA "">
   <!ELEMENT airlink_dimming ANY>
   <!ATTLIST airlink_dimming id ID #REQUIRED
                  address_channel CDATA #REQUIRED
                  name CDATA ""
                  note CDATA "">
   <!ELEMENT light_indication ANY>
   <!ATTLIST light_indication id ID #REQUIRED
                  name CDATA ""
                  note CDATA "">
   <!ELEMENT scenes ANY>
   <!ATTLIST scenes id ID #REQUIRED
                  name CDATA ""
                  scene_resource IDREF #REQUIRED
                  note CDATA "">
   <!ELEMENT dimmer_settings ANY>
   <!ATTLIST dimmer_settings id ID #REQUIRED
                  name CDATA ""
                  note CDATA "">
   <!ELEMENT dimmer_setting_minimum_value ANY>
   <!ATTLIST dimmer_setting_minimum_value id ID #REQUIRED
                  value CDATA "22"
                  minimum CDATA "0"
                  maximum CDATA "100">
   <!ELEMENT dimmer_setting_maximum_value ANY>
   <!ATTLIST dimmer_setting_maximum_value id ID #REQUIRED
                  value CDATA "100"
                  minimum CDATA "0"
                  maximum CDATA "100">
   <!ELEMENT dimmer_setting_fade_rate_up ANY>
   <!ATTLIST dimmer_setting_fade_rate_up id ID #REQUIRED
                  value CDATA "700"
                  minimum CDATA "200"
                  maximum CDATA "60000">
   <!ELEMENT dimmer_setting_fade_rate_down ANY>
   <!ATTLIST dimmer_setting_fade_rate_down id ID #REQUIRED
                  value CDATA "700"
                  minimum CDATA "200"
                  maximum CDATA "60000">
   <!ELEMENT dimmer_setting_dimming_rate ANY>
   <!ATTLIST dimmer_setting_dimming_rate id ID #REQUIRED
                  value CDATA "5000"
                  minimum CDATA "2000"
                  maximum CDATA "10000">
   <!ELEMENT dimmer_setting_load_mode ANY>
   <!ATTLIST dimmer_setting_load_mode id ID #REQUIRED
                  value (auto | rc | rl_led) "rc">
]>
<product_rs485_led_dimmer id="_0x01" product_identifier="_0x9f05" name="Synthetic RS485 Dimmer Product" serialnumber="" note="Synthetic oracle - dimmer (æøå)" icon="_0x86">
  <resource_flag id="_0x02" name="Sync flag" inivalue="off" />
  <rs485_led_dimmer_channel icon="_0x86" id="_0x10" product_identifier="_0x9f15" name="Channel 1" channel="_0x00" channel_id="">
    <airlink_dimmer_increase id="_0x11" name="Up" address_channel="_0x01" />
    <airlink_dimmer_decrease id="_0x12" name="Down" address_channel="_0x01" />
    <airlink_dimming id="_0x13" name="Level" address_channel="_0x01" />
    <light_indication id="_0x14" name="Indicator" note="Synthetic indicator" />
    <scenes id="_0x15" name="Scene Set" scene_resource="_0x13" />
    <rs485_led_dimmer_error_state_overcurrent id="_0x16" name="Error 1" note="Synthetic error state" locked="yes" />
    <rs485_led_dimmer_error_state_overvoltage id="_0x17" name="Error 2" note="Synthetic error state" locked="yes" />
    <rs485_led_dimmer_error_state_overheating id="_0x18" name="Error 3" note="Synthetic error state" locked="yes" />
    <rs485_led_dimmer_error_state_loadfailure id="_0x19" name="Error 4" note="Synthetic error state" locked="yes" />
    <dimmer_settings id="_0x20">
      <dimmer_setting_minimum_value id="_0x21" />
