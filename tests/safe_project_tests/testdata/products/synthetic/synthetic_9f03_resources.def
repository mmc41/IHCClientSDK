<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE product_dataline[
   <!ELEMENT product_dataline ANY>
   <!ATTLIST product_dataline id ID #REQUIRED
                  product_identifier CDATA #REQUIRED
                  name CDATA ""
                  locked (yes | no) "yes"
                  enduser_report (yes | no) "no"
                  icon CDATA ""
                  note CDATA "">
   <!ELEMENT dataline_input ANY>
   <!ATTLIST dataline_input id ID #REQUIRED
                  name CDATA ""
                  note CDATA ""
                  inivalue (on | off) "off"
                  address_dataline CDATA "_0x0"
                  cable_colour CDATA "">
   <!ELEMENT resource_temperature ANY>
   <!ATTLIST resource_temperature id ID #REQUIRED
                  name CDATA ""
                  note CDATA ""
                  backup (yes | no) "no"
                  inivalue CDATA "20.00"
                  accessibility (read | write | read-write) "read-write">
   <!ELEMENT resource_input ANY>
   <!ATTLIST resource_input id ID #REQUIRED
                  name CDATA ""
                  backup (yes | no) "no"
                  icon CDATA "_0x0"
                  note CDATA ""
                  inivalue (on | off) "off"
                  accessibility (read | write | read-write) "read-write">
   <!ELEMENT resource_enum ANY>
   <!ATTLIST resource_enum id ID #REQUIRED
                  name CDATA "Enumerator"
                  typedef IDREF #IMPLIED
                  inivalue IDREF #IMPLIED
                  backup (yes | no) "no"
                  icon CDATA "_0x22"
                  note CDATA ""
                  accessibility (read | write | read-write) "read-write">
   <!ELEMENT settings ANY>
   <!ATTLIST settings id ID #REQUIRED
                  name CDATA ""
                  note CDATA "">
]>
<product_dataline id="_0x01" product_identifier="_0x9f03" name="03#Synthetic Sensor Product" note="Synthetic oracle - embedded enum + settings" icon="_0x83">
  <enum_definition id="_0x50" typeid="_0x16">
    <enum_value id="_0x51" typeid="_0x17" />
  </enum_definition>
  <resource_temperature id="_0x02" name="Measure 1" accessibility="read" />
  <resource_temperature id="_0x03" name="Measure 2" note="Synthetic reading (å)" accessibility="read" />
  <resource_input id="_0x04" name="Alarm flag" note="Synthetic alarm" accessibility="read" />
  <resource_enum id="_0x05" name="Log 1" typedef="_0x50" inivalue="_0x51" />
  <settings id="_0x06" name="Settings" note="Synthetic settings">
    <dataline_input id="_0x07" name="Sensor pin" />
  </settings>
</product_dataline>
