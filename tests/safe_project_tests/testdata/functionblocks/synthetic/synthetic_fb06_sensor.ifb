                  link2 IDREF #IMPLIED
                  method CDATA "_0x0"
                  udf CDATA "">
]>
<functionblock id="_0x5128" name="Sensorpanel (udvidet)" master_type="9.4.01" master_version="a" master_name="Sensor panel" master_programmer="Morten Christensen" master_date_year="2026" master_date_month="6" master_date_day="30" locked="yes" icon="_0xe" note="Sensorpanel (udvidet)&#xD;&#xA;&#xD;&#xA;Overvåger en temperatur og udløser en alarm når grænseværdien overskrides.">
  <inputs id="_0x5223" name="Input" icon="_0x4" note="Indgange til sensorpanelet">
    <resource_input id="_0x5311" name="Nulstil" icon="_0x36" note="Nulstiller alarmen." />
    <resource_temperature id="_0x5414" name="Målt temperatur" note="Aktuelt målt temperatur." inivalue="20.00" />
  </inputs>
  <outputs id="_0x5524" name="Output" icon="_0x14" note="Udgange fra sensorpanelet">
    <resource_output id="_0x5612" name="Alarm" icon="_0x39" note="Aktiv når grænseværdien overskrides." />
  </outputs>
  <settings id="_0x5725" name="Indstillinger" icon="_0xd" note="Indstillinger som brugeren kan ændre">
    <resource_temperature id="_0x5814" name="Grænseværdi" note="Temperaturgrænse for alarm." inivalue="21.50" />
    <resource_counter id="_0x590c" name="Udløsninger" note="Antal gange alarmen er udløst." inivalue="5" />
    <resource_weekday id="_0x5a09" name="Aktiv ugedag" icon="_0x2c" note="Ugedag hvor blokken overvåger." inivalue="friday" />
    <resource_integer id="_0x5b0b" name="Tærskel" note="Heltalstærskel for gentagne alarmer." inivalue="10" />
  </settings>
  <internalsettings id="_0x5c29" name="Interne variable" icon="_0x13" note="Private variable til blokkens eget brug">
    <resource_time id="_0x5d0d" name="Forsinkelse" icon="_0x2f" hour="0" minute="0" second="30" note="Forsinkelse før alarmen udløses." />
  </internalsettings>
  <programs id="_0x5e26" name="Programmer" icon="_0x19" note="Gruppering af blokkens programmer">
    <program_simple id="_0x5f1e" name="Overvågning" icon="_0x7">
      <events id="_0x6064" name="Hændelser" icon="_0xb" note="Hændelser der udløser programmet">
        <event id="_0x61c8" name="%P bliver ændret" icon="_0xc" note="Start når den målte temperatur ændres" link1="_0x5414" method="_0x96" />
      </events>
      <actions id="_0x6266" name="Kommandoer" icon="_0x8" note="Kommandoer der udføres når en hændelse indtræffer" type="_0x2">
        <program_sub id="_0x631f" name="Under program" icon="_0x7">
          <conditions id="_0x6465" name="Betingelser" icon="_0x16" note="Betingelser der testes logisk">
            <condition id="_0x65c9" name="%P &gt; %S" icon="_0x1a" note="Betingelse: målt temperatur over grænseværdien" link1="_0x5414" link2="_0x5814" method="_0x64" />
          </conditions>
          <actions id="_0x6666" name="Kommandoer ved betingelser sande" icon="_0x8" note="Kommandoer der udføres når betingelserne er opfyldt" type="_0x1">
            <action id="_0x67ca" name="%P = ON" icon="_0x9" note="Udløser alarmen" link1="_0x5612" method="_0xa" />
            <action id="_0x68ca" name="Tæl %P op" icon="_0x9" note="Tæller antal udløsninger" link1="_0x590c" method="_0xbf" />
          </actions>
          <actions id="_0x6966" name="Kommandoer ved betingelser falske" icon="_0x8" note="Kommandoer der udføres når betingelserne ikke er opfyldt">
            <action id="_0x6aca" name="%P = OFF" icon="_0x9" note="Rydder alarmen" link1="_0x5612" method="_0x14" />
          </actions>
        </program_sub>
      </actions>
    </program_simple>
  </programs>
</functionblock>