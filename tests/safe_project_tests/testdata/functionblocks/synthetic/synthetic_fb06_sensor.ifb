<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE functionblock[
   <!ELEMENT functionblock ANY>
   <!ATTLIST functionblock id ID #REQUIRED
                  name CDATA ""
                  master_schneider_electric (yes | no) "no"
                  master_type CDATA ""
