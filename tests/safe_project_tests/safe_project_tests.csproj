<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="CompareNETObjects" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The report-oracle matrix, naming convention, pinned clock and byte assert, shared with
         safe_unit_tests (which owns the .html half of the same 24-oracle contract). -->
    <Compile Include="..\shared\ReportOracleHarness.cs" Link="shared\ReportOracleHarness.cs" />
    <Compile Include="..\shared\FindingOracleHarness.cs" Link="shared\FindingOracleHarness.cs" />
    <Compile Include="..\shared\TelemetryCapture.cs" Link="shared\TelemetryCapture.cs" />
  </ItemGroup>

  <!-- Oracle fixtures live in tests\testdata\ and are shared with safe_unit_tests and
       safe_visual_tests; this copies them to $(OutDir)\testdata\... . -->
  <Import Project="..\TestData.props" />

  <!-- Fails the BUILD if a findings oracle stops matching the shipped schema. Imported by this suite alone
       — it owns the oracles' byte contract, and importing it into all five would validate one corpus five
       times per solution build. -->
  <Import Project="..\ValidateFindingsOracles.targets" />

  <Target Name="CopyConfigFiles" AfterTargets="AfterBuild">
    <!-- NB: Settings file is required for running/testing but allow build without the file to support compilation in a DevOps pipeline -->
    <Copy SourceFiles="..\..\ihcsettings.json" DestinationFolder="$(OutDir)" Condition="Exists('..\..\ihcsettings.json')" />
  </Target>
  <Target Name="DeleteConfigFiles" AfterTargets="Clean">
    <!-- Delete ihcsettings.json from output directory during clean -->
    <Delete Files="$(OutDir)ihcsettings.json" Condition="Exists('$(OutDir)ihcsettings.json')" />
  </Target>

</Project>
