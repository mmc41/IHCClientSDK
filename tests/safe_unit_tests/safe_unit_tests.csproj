<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="NUnit.Analyzers" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="CompareNETObjects" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The report-oracle matrix, naming convention, pinned clock and byte assert, shared with
         safe_project_tests (which owns the .txt half of the same 24-oracle contract). -->
    <Compile Include="..\shared\ReportOracles.cs" Link="shared\ReportOracles.cs" />
  </ItemGroup>

    <ItemGroup>
    <Using Include="NUnit.Framework" />
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
    <ProjectReference Include="..\..\utilities\ihc_lab\ihc_lab.csproj" />
    <!-- The catalog→insert-menu projection (CatalogMenu) is Avalonia-free VM logic in the OpenVisual app; unit-test
         it here (H2/T004). Referencing the app assembly for its testable logic matches the existing ihc_lab ref. -->
    <ProjectReference Include="..\..\applications\ihc_openvisual\ihc_openvisual.csproj" />
  </ItemGroup>

  <!-- T002 characterization: the ProjectTreeProjector sub-program-name branch needs a real oracle carrying
       user-named sub-programs (no public rename-sub-program command exists to synthesise one). The shared
       fixtures copy to $(OutDir)\testdata\... . -->
  <Import Project="..\TestData.props" />
</Project>
