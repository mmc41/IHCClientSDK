<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- White-boxes the generated SOAP layer on purpose: the serialization tests round-trip the generated
         message wrappers, and the service tests fake the generated contracts. Exempt from the repo-wide
         ban in BannedSymbols.txt. -->
    <UsesGeneratedSoapLayer>true</UsesGeneratedSoapLayer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CompareNETObjects" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\TelemetryRegistryContract.cs" Link="shared\TelemetryRegistryContract.cs" />
    <Compile Include="..\shared\TelemetryCapture.cs" Link="shared\TelemetryCapture.cs" />
    <!-- The exception that cannot describe itself. Shared because the same claim — that recording a fault does
         not become the fault — is made about the instrumentation core here and about the validator's
         report-and-continue policy in the project suite. -->
    <Compile Include="..\shared\UnreadableException.cs" Link="shared\UnreadableException.cs" />
  </ItemGroup>

    <ItemGroup>
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
    <!-- The loopback stub host the utility process tests start each utility against. The stub itself is tested in
         safe_stub_tests. -->
    <ProjectReference Include="..\..\ihcclient_stub\ihcclient_stub.csproj" />
    <Compile Include="..\shared\UtilityProcessRunner.cs" Link="shared\UtilityProcessRunner.cs" />
    <Compile Include="..\shared\CleanCopy.cs" Link="shared\CleanCopy.cs" />
    <!-- The socket stand-in the transport tests here and the stub seam tests in safe_stub_tests both drive. -->
    <Compile Include="..\shared\StubTransport.cs" Link="shared\StubTransport.cs" />
    <!-- The IL decode and the member population every structural rule reads. Shared because the
         controller-reach guard runs INSIDE each suite it polices, and a suite cannot be scanned from
         outside by an assembly that does not reference it. -->
    <Compile Include="..\shared\IlBody.cs" Link="shared\IlBody.cs" />
    <Compile Include="..\shared\AuthoredMembers.cs" Link="shared\AuthoredMembers.cs" />
    <Compile Include="..\shared\ControllerReachScan.cs" Link="shared\ControllerReachScan.cs" />
    <!-- The safety rule, as a gate rather than a convention: this suite may reach no controller. -->
    <Compile Include="..\shared\ControllerReachGuard.cs" Link="shared\ControllerReachGuard.cs" />
    <!-- ...and the same rule at run time: a stub registered for the whole run latches every real endpoint. -->
    <Compile Include="..\shared\ControllerStubLatchFixture.cs" Link="shared\ControllerStubLatchFixture.cs" />
    <Compile Include="..\shared\ControllerStubLatchSupport.cs" Link="shared\ControllerStubLatchSupport.cs" />
    <!-- The telemetry bootstrap two fixtures here compose against. It used to arrive transitively through the
         app references this suite no longer has, and it is the AVALONIA-FREE half of the bootstrap pair, so
         naming it directly is what keeps a toolkit out of the SDK suite rather than merely out of its usings. -->
    <ProjectReference Include="..\..\shared\ihc_hostbootstrap\ihc_hostbootstrap.csproj" />
    <!-- The credentials-file rewrite in ihc_settings_encrypt: its testable logic is in the utility rather
         than in the SDK, and no suite of its own exists to hold it. -->
    <ProjectReference Include="..\..\utilities\ihc_settings_encrypt\ihc_settings_encrypt.csproj" />
    <!-- Utilities started as processes under the controller-stub switch. Referenced so each is built before this
         suite runs, and not as an assembly: the tests run the utility's own build output, never its code in this
         process. -->
    <ProjectReference Include="..\..\utilities\ihc_info\ihc_info.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\utilities\ihc_admin\ihc_admin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\utilities\ihc_project_download_upload\ihc_ProjectDownloadUpload.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where each utility's build output is, baked in at build time so a Release test run cannot start a Debug
         utility. The tests copy it elsewhere before running it, because the folder itself holds the staged
         settings file a run must never read. -->
    <AssemblyMetadata Include="IhcInfoOutput"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\utilities\ihc_info\bin\$(Configuration)\$(TargetFramework)\'))" />
    <AssemblyMetadata Include="IhcAdminOutput"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\utilities\ihc_admin\bin\$(Configuration)\$(TargetFramework)\'))" />
    <AssemblyMetadata Include="IhcProjectDownloadUploadOutput"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\utilities\ihc_project_download_upload\bin\$(Configuration)\$(TargetFramework)\'))" />
    <!-- The UI-Automation toolkit, for its ONE platform-neutral type. `UiaWait` polls a delegate the caller
         supplies and calls nothing, so unlike the rest of that project it can be exercised without a desktop —
         and a `shared/` project with no suite of its own belongs here. Everything else in it stays verified by
         the end-to-end suite's desktop runs; TESTSTRATEGY.md records the carve-out. -->
    <ProjectReference Include="..\..\shared\ihc_uiautomation_windows\ihc_uiautomation_windows.csproj" />
  </ItemGroup>

  <!-- T002 characterization: the ProjectTreeProjector sub-program-name branch needs a real oracle carrying
       user-named sub-programs (no public rename-sub-program command exists to synthesise one). The shared
       fixtures copy to $(OutDir)\testdata\... . -->
  <Import Project="..\TestData.props" />
</Project>
