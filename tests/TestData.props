<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    The shared oracle fixtures under tests\testdata\, copied into the importing test project's
    output directory as testdata\... .

    Imported explicitly rather than auto-discovered: these globs must NOT go into the repo-root
    Directory.Build.props, which is imported by all 17 projects and would copy ~3 MB of fixtures
    into every output including the SDK and the apps. Only suites that actually read oracles
    import this file.

    Before this file existed the same fixtures were reached three different ways: an in-project
    glob (safe_project_tests), a hand-written per-file None/Link item (safe_unit_tests), and a
    runtime walk up the directory tree into the source checkout (safe_visual_tests). The third
    bypassed the output directory entirely and hardcoded the repo layout in C#.

    LinkBase is load-bearing. Items outside the importing project's own directory cone are
    flattened into the output root without it, so testdata\projects\Project0-Tomt.vis would land
    as Project0-Tomt.vis and every "testdata/projects/..." path in the suites would break.
  -->

  <PropertyGroup>
    <SharedTestDataRoot>$(MSBuildThisFileDirectory)testdata\</SharedTestDataRoot>
  </PropertyGroup>

  <ItemGroup>
    <!-- .vis project oracles, .def product / .ifb function-block catalog oracles, the report oracles
         (.html pages plus their plain-text .txt companions), and the findings-export oracles (.xml).

         The .xml oracles are ISO-8859-1, CRLF and BOM-less, so they carry raw bytes above 0x7F that
         no UTF-8 decoder would round-trip. MSBuild copies a None item verbatim: it never decodes,
         re-encodes or normalizes line endings, so the copy in each output directory is byte-identical
         to the source. Verified by SHA-256 comparison when this glob was added, over a probe file
         carrying 0xE5, 0xE6, 0xF8 and CRLF line ends. -->
    <None Include="$(SharedTestDataRoot)**\*.vis;$(SharedTestDataRoot)**\*.def;$(SharedTestDataRoot)**\*.ifb;$(SharedTestDataRoot)**\*.html;$(SharedTestDataRoot)**\*.txt;$(SharedTestDataRoot)**\*.xml"
          LinkBase="testdata"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
