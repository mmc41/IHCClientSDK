<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This suite COLLECTS coverage. It used to opt out, and the two reasons it gave are answered elsewhere now
    rather than by staying dark. (safe_architecture_tests is the only suite that opts out today, for a reason
    of its own that is stated in its project.)

    The child process is the one that mattered: the default mode launches ihc_openvisual.exe out of the test
    host, and an instrumented child outliving its test keeps that process holding its bin DLLs, which is how a
    later build fails to overwrite the very binaries this suite just exercised. That is settled in .runsettings,
    where CollectFromChildProcesses is now switched OFF explicitly instead of being left to a default that is
    True. What is measured here is therefore the HEADLESS leg, which hosts the same MainWindow in this process —
    and that is the leg CI runs.

    The other reason was that CI runs only a filtered subset, so a slice from here would describe less than the
    suite. True, and true of every suite: a slice always describes the run that produced it, which is what
    Summary.txt's per-suite listing and its stale marking are for. Reading a filtered slice as a statement about
    the whole suite is a mistake about the report, not a reason to withhold the measurement.
  -->

  <ItemGroup>
    <!-- The shared oracle harnesses pin their clock to one instant with a FakeTimeProvider. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- The headless driver hosts the real MainWindow in-process; see Drivers/HeadlessDriver.cs. -->
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ihc_openvisual is referenced for BOTH modes, and for different reasons.

      The headless driver hosts the application's own types in this process — MainWindow, its view-models and
      the workflow behind them — which is also why ihc_openvisual grants this assembly InternalsVisibleTo: the
      app is built here the way Program builds it, WithAppFonts included.

      The real mode never touches a product type; it drives a separate process through UiaDriver. It needs
      the reference anyway, because without it that driver would find whatever exe happened to be left under
      applications/ihc_openvisual/bin from an earlier build, and the suite would silently report on a stale
      application.

      ihcclient comes along because the shared oracle harness below reads Ihc.Vis types.
    -->
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
    <ProjectReference Include="..\..\applications\ihc_openvisual\ihc_openvisual.csproj" />
    <!-- The Windows UI-Automation mechanics the real driver is built on. The DRIVER — the verbs, the envelope
         and the OpenVisual automation ids — stays here, because none of that is reusable by anything else. -->
    <ProjectReference Include="..\..\shared\ihc_uiautomation_windows\ihc_uiautomation_windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Where the real driver launches the application from: the APPLICATION'S own build output, not the copy the
      ProjectReference above stages beside these tests.

      The difference is ihcsettings.json. The app probes for it beside its own executable, and its project
      stages the repository's file there (CopyIhcSettingsToOutput); the copy in this suite's output has no such
      file, so an app launched from here starts with no telemetry and a desktop run produces nothing to diagnose
      with. Baking the path in at build time — rather than computing it at run time — also pins the
      CONFIGURATION to the one these tests were built in, so a Release test run cannot silently drive a Debug
      application.

      Windows-only by construction, and so is the mode that reads it: the headless leg never launches anything.
    -->
    <AssemblyMetadata Include="OpenVisualExecutable"
                      Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\applications\ihc_openvisual\bin\$(Configuration)\$(TargetFramework)\ihc_openvisual.exe'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- The findings-oracle reader, and the row projection these tests compare the live panel against. Shared
         with safe_project_tests, whose FindingOracleLinkTests is the guard that the reader still finds rows —
         the desktop leg of this suite does not run in CI, so a reader that silently returned nothing would
         break nothing here. ReportOracleHarness comes along because it owns the pinned instant the finding
         harness reads its clock from. -->
    <Compile Include="..\shared\ReportOracleHarness.cs" Link="shared\ReportOracleHarness.cs" />
    <Compile Include="..\shared\FindingOracleHarness.cs" Link="shared\FindingOracleHarness.cs" />
    <Compile Include="..\shared\FindingOracleRows.cs" Link="shared\FindingOracleRows.cs" />
    <!-- The safety rule, as a gate rather than a convention: this suite drives a GUI and may reach no
         controller. It matters more here than anywhere, not less — the desktop leg is outside every default
         verification, so an unsafe site added here would be policed by nothing at all. The IL decode and the
         member population the scan reads come with it. -->
    <Compile Include="..\shared\IlBody.cs" Link="shared\IlBody.cs" />
    <Compile Include="..\shared\AuthoredMembers.cs" Link="shared\AuthoredMembers.cs" />
    <Compile Include="..\shared\ControllerReachScan.cs" Link="shared\ControllerReachScan.cs" />
    <Compile Include="..\shared\ControllerReachGuard.cs" Link="shared\ControllerReachGuard.cs" />
    <!-- The projects the application opens are read as real paths out of tests/testdata, so this suite is one
         of the few that legitimately reaches the source checkout. That is now its ONLY reason to: the driver
         is this suite's own code, and SkillIndependenceGuard fails the build if a path under .claude/ comes
         back. -->
    <Compile Include="..\shared\TestRepository.cs" Link="shared\TestRepository.cs" />
    <!-- The headless Avalonia app builder, shared with safe_visual_tests: it is what decides font metrics,
         and the two suites have to agree about layout to agree about which rows are on screen. -->
    <Compile Include="..\shared\OpenVisualHeadlessApp.cs" Link="shared\OpenVisualHeadlessApp.cs" />

  </ItemGroup>

  <Import Project="..\TestData.props" />

</Project>
