<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="CompareNETObjects" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="System.Configuration.ConfigurationManager" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.NUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Statically, so fixtures keep calling SetupMainWindowAsync() unqualified now that it is no longer
         an inherited member of the shared AvaloniaTestBase. -->
    <Using Include="Ihc.Tests.LabWindows" Static="true" />
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
    <!-- The IL decode and the member population every structural rule reads. Shared because the
         controller-reach guard runs INSIDE each suite it polices, and a suite cannot be scanned from
         outside by an assembly that does not reference it. -->
    <Compile Include="..\shared\IlBody.cs" Link="shared\IlBody.cs" />
    <Compile Include="..\shared\AuthoredMembers.cs" Link="shared\AuthoredMembers.cs" />
    <Compile Include="..\shared\ControllerReachScan.cs" Link="shared\ControllerReachScan.cs" />
    <!-- The safety rule, as a gate rather than a convention: this suite may reach no controller. -->
    <Compile Include="..\shared\ControllerReachGuard.cs" Link="shared\ControllerReachGuard.cs" />
    <ProjectReference Include="..\..\utilities\ihc_lab\ihc_lab.csproj" />
  </ItemGroup>

  <!-- The headless failure-screenshot capture and the NUnit command that decides when to run it, shared with
       safe_visual_tests: cross-thread dispatch onto the session, a timeout and exception marshalling, and an
       outcome test that cannot be read off the test result alone. A bug in either is a deadlock or a silently
       missing screenshot rather than a red test. Linked the same way the other suites link tests/shared. -->
  <ItemGroup>
    <Compile Include="..\shared\HeadlessScreenshot.cs" Link="shared\HeadlessScreenshot.cs" />
    <Compile Include="..\shared\ScreenshotCaptureCommand.cs" Link="shared\ScreenshotCaptureCommand.cs" />
    <!-- The attribute those two are driven by, and the base class holding the window they capture. One
         declaration for both Avalonia suites; it names no application's types, so this suite adds LabWindows.cs
         beside it for the window opener and imports it statically. -->
    <Compile Include="..\shared\AvaloniaTestBase.cs" Link="shared\AvaloniaTestBase.cs" />
  </ItemGroup>
</Project>
