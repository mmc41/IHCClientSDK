<?xml version="1.0" encoding="UTF-8"?>
<!-- The catalogue rows whose disposition and operation disagree; rows that agree are absent, so an
     empty set would mean the catalogue and the code say the same thing everywhere. Kinds:
       refuses-but-not-fatal : two faces - reports at validate AND refuses at the operation, both intended
       fatal-but-proceeds    : the catalogue promises a refusal the code does not make (product decision D13)
       ruled-out             : investigated - not separately decidable, already reported under another id
     Derived and kept honest by SeverityOperationMatrixTests; when it fails, review the difference and
     paste the expected rows it prints. See tests/testdata/testdataoverview.md. -->
<ihc_catalog_divergences version="1">
   <divergence code="attr-latin1" kind="refuses-but-not-fatal"/>
   <divergence code="attr-required" kind="refuses-but-not-fatal"/>
   <divergence code="attr-undeclared" kind="refuses-but-not-fatal"/>
   <divergence code="element-undeclared" kind="refuses-but-not-fatal"/>
   <divergence code="import-catalog-wrong-kind" kind="fatal-but-proceeds"/>
   <divergence code="load-truncated" kind="ruled-out"/>
   <divergence code="root-version" kind="fatal-but-proceeds"/>
</ihc_catalog_divergences>
