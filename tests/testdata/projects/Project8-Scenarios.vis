         <functionblock id="_0x18628" name="1.2.04.e. Trådløs / Bus lysdæmper" master_schneider_electric="yes" master_type="1.2.04" master_version="e" master_name="Trådløs / Bus lysdæmper" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2016" master_date_year="2017" master_date_month="9" master_date_day="11" locked="yes" icon="_0xe" note="1.2.04.e. Trådløs / Bus lysdæmper&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til styring af IHC Wireless og IHC Bus lysdæmpere.&#xD;&#xA;Kan anvendes som 1- og/eller 2-tast betjent regulering samt fremkald og gem høj/lav.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse; markér overskrift på funktionsblok og tryk F1.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.&#xD;&#xA;">
            <inputs id="_0x19523" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x19611" name="Touch " icon="_0x36" note="Kort tryk tænd/sluk - langt tryk regulerer lys niveau op/ned.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_input id="_0x19711" name="Tænd/regulér op" icon="_0x36" note="Kort tryk tænd - langt tryk regulerer lysniveau op.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x19811" name="Sluk/regulér ned  " icon="_0x36" note="Kort tryk sluk - langt tryk regulerer lysniveau ned.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_input id="_0x19911" name="Høj" icon="_0x36" note="Fremkalder højt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som høj.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;"/>
               <resource_input id="_0x19a11" name="Lav " icon="_0x36" note="Fremkalder lavt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som lav.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)"/>
               <resource_light_level id="_0x19b13" name="Lys niveau " note="Opret link mellem produktets &quot;Lys niveau&quot; og denne indgang"/>
               <resource_input id="_0x19c11" name="Natdrift" icon="_0x36" note="Ved aktivitet (betingelse opfyldt) vil et kort regulerings tryk tænde lyset på &quot;Lavt niveau&quot;. PIR vil enten være helt eller delvist begrænset.&#xD;&#xA;Sammensættes med urfunktion eller dag og nat funktion.&#xD;&#xA;(Udfyldes af installatøren)"/>
            </inputs>
            <outputs id="_0x19d24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_scene id="_0x19e4a" name="Højt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;Default 100%, rampetid 1 sek.&#xD;&#xA;Dette scenarie benyttes til at fremkalde niveauet, regulere samt sluke lysdæmper." hide_dialog="yes">
                  <scene_link id="_0x5534b" name="Scenarie link" icon="_0x47" link="_0x5524c"/>
                  <scene_link id="_0x5554b" name="Scenarie link" icon="_0x47" link="_0x5544d"/>
               </resource_scene>
               <resource_scene id="_0x19f4a" name="Lavt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;">
                  <scene_link id="_0x5514b" name="Scenarie link" icon="_0x47" link="_0x5504c"/>
                  <scene_link id="_0x5594b" name="Scenarie link" icon="_0x47" link="_0x5584c"/>
                  <scene_link id="_0x55b4b" name="Scenarie link" icon="_0x47" link="_0x55a4c"/>
               </resource_scene>
               <resource_enum id="_0x1a00f" name="Lysdæmper status" typedef="_0x18b47" inivalue="_0x18d48" backup="yes" icon="_0x22" note="Status indikering til Viewer."/>
               <resource_output id="_0x1a112" name="Lysdæmper tændt" backup="yes" icon="_0x39" note="Status indikering i diode eller Viewer."/>
            </outputs>
            <settings id="_0x1a225" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x1a30f" name="Kort reguleringstryk tænder" typedef="_0x18747" inivalue="_0x18848" backup="yes" icon="_0x22" note="Her er det muligt, at vælge funktionalitet på reguleringstryk dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Højt niveau&#xD;&#xA;Lavt niveau&#xD;&#xA;Sidste niveau" note-2="Dette valg er kun aktivt dag/aften. Om natten (natdrift anvendt) vil et kort reguleringstryk tænde lys på lavt niveau.&#xD;&#xA;Ved frafald af &quot;Natdrift&quot; vil &quot;Højt niveau&quot; fremkaldes første gang der trykkes kort reguleringstryk selvom &quot;Sidste niveau&quot; er valgt. Dette er valgt fordi ny dag er kommet og gl. niveau ikke er relevant mere. "/>
            </settings>
