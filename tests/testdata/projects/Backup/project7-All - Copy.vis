         <functionblock id="_0x255628" name="4.1.09. Forsinkelsesblok" master_schneider_electric="yes" master_type="4.1.09" master_name="Forsinkelsesblok" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.1.09. Forsinkelsesblok &#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Funktionsblok til indkobling i trin. Anvendes f.eks. til at mindske startstrømmen hvis flere store belastning skal indkobles.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x255723" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x255811" name="Start forsinkelsesblok" icon="_0x36" note="Start forsinkelsesblok&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Start forsinkelsesblok&quot; til det tryk der skal betjene funktionen. Ref. 4.1.09-IN01."/>
            </inputs>
            <outputs id="_0x255924" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x255a12" name="Udgang 1" icon="_0x39" note="Udgang &quot;Udgang 1&quot; - styrer det tilkoblede produkt.&#xD;&#xA;Udfyldes af installatøren. Ref. 4.1.09-UD01." note-2="Vejledning - &quot;Udgang 1&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 4.1.09-UD01."/>
               <resource_output id="_0x255b12" name="Udgang 2" icon="_0x39" note="Statusudgang &quot;Udgang 2&quot;. Anvendes til visning på grafisk brugerflade. Ref. 4.1.09-UD02." note-2="Tip: brug &quot;Udgang 2&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 4.1.09-UD02."/>
               <resource_output id="_0x255c12" name="Udgang 3" icon="_0x39" note="Udgang &quot;Udgang 3&quot; fra 4.1.09. Forsinkelsesblok. Maks. belastning 10 A ved 230 V AC. Ref. 4.1.09-UD03." note-2="Note: &quot;Udgang 3&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 4.1.09-UD03."/>
               <resource_output id="_0x255d12" name="Udgang 4" icon="_0x39" note="Udgang &quot;Udgang 4&quot;: pulser kortvarigt (&lt; 500 ms) ved tilstandsskift. Ref. 4.1.09-UD04." note-2="Vejledning: verificér &quot;Udgang 4&quot; med en måling på klemmen (230 V AC). Ref. 4.1.09-UD04."/>
               <resource_output id="_0x255e12" name="Udgang 5" icon="_0x39" note="Udgang &quot;Udgang 5&quot; - kan viderekobles til andre funktionsblokke &amp; scenarier. Ref. 4.1.09-UD05." note-2="Hjælp: notér i 4.1.09. Forsinkelsesblok hvilke produkter &quot;Udgang 5&quot; betjener. Ref. 4.1.09-UD05."/>
            </outputs>
            <settings id="_0x255f25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x256010" name="Forsinkelse mellem indkoblinger" icon="_0x43" note="Funktions beskrivelse" hour="0" minute="7" second="0" millisecond="700" note-2="Hjælpetekst for &quot;Forsinkelse mellem indkoblinger&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 4.1.09-IS01."/>
            </settings>
