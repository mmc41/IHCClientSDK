         <functionblock id="_0x242b28" name="4.1.04. Driftstimetæller" master_schneider_electric="yes" master_type="4.1.04" master_name="Driftstimetæller" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.1.04. Driftstimetæller&#xD;&#xA;&#xD;&#xA;Anvendes:&#xD;&#xA;Til at tælle time forbrug på f.eks lysrør, eller steder hvor forebyggende vedligehold ønskes. &#xD;&#xA;Dette vises i Timer.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x242c23" name="Input" icon="_0x4">
               <resource_input id="_0x242d11" name="Indgang" icon="_0x36" note="Når denne indgang er &quot;ON&quot; tæller tiden op.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Indgang&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 4.1.04-IN01.">
                  <link_to_resource id="_0x49862c" name="Følg Link" icon="_0x4a" link="_0x49852d"/>
               </resource_input>
               <resource_input id="_0x242e11" name="Reset" icon="_0x36" note="Aktiveres ved et langt tryk.&#xD;&#xA;Skal holdes inde i  &gt;1sek før &quot;Reset&quot; udføres.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Reset&quot; i simulering før anlægget sættes i drift. Ref. 4.1.04-IN02."/>
            </inputs>
            <outputs id="_0x242f24" name="Output" icon="_0x14">
               <resource_output id="_0x243012" name="Indikation" backup="yes" icon="_0x39" note="Denne udgang kan bruges til en Diode, der indikerer at &quot;Set-punktet&quot; er opnået.&#xD;&#xA;Denne kan ligeledes anvendes til at sende en mail til værkfører eller elektriker om f.eks. &quot;Det er tid til at skifte lysrør&quot;" note-2="Vejledning: verificér &quot;Indikation&quot; med en måling på klemmen (230 V AC). Ref. 4.1.04-UD01."/>
               <resource_counter id="_0x24310c" name="Timer" backup="yes" note="Kan anvendes i Viewer." note-2="Hjælp: notér i 4.1.04. Driftstimetæller hvilke produkter &quot;Timer&quot; betjener. Ref. 4.1.04-UD02."/>
               <resource_counter id="_0x24320c" name="Minut" backup="yes" note="Kan anvendes i Viewer." note-2="Vejledning - &quot;Minut&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 4.1.04-UD03."/>
               <resource_counter id="_0x24330c" name="Sekund" backup="yes" note="Kan anvendes i Viewer." note-2="Tip: brug &quot;Sekund&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 4.1.04-UD04."/>
            </outputs>
            <settings id="_0x243425" name="Indstillinger" icon="_0xd">
               <resource_counter id="_0x24350c" name="Set-Punkt" backup="yes" note="Default 10.000&#xD;&#xA;Hvis &quot;Timer&quot; bliver =&gt; &quot;Set-punkt&quot; vil &quot;Indikation&quot; blive &quot;ON&quot; &#xD;&#xA;Rettes &quot;Set-Punkt&quot; til en højre værdi end &quot;Timer&quot; vil &quot;Indikation&quot; blive &quot;OFF&quot; indtil &quot;Set-punkt&quot; igen bliver nået." inivalue="11000" note-2="Vejledning - &quot;Set-Punkt&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 4.1.04-IS01."/>
            </settings>
            <internalsettings id="_0x243629" name="Interne variable" icon="_0x13">
               <resource_time id="_0x24370d" name="Systemtid-1" icon="_0x2f" hour="0" minute="0" second="0"/>
               <resource_time id="_0x24380d" name="Systemtid-2" icon="_0x2f" hour="0" minute="0" second="0"/>
               <resource_timer id="_0x243910" name="½sec" icon="_0x43" hour="0" minute="0" second="0" millisecond="500"/>
               <resource_timer id="_0x243a10" name="Reset" icon="_0x43" hour="0" minute="0" second="1" millisecond="0"/>
            </internalsettings>
