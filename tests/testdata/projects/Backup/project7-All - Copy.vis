         <functionblock id="_0x2ad628" name="4.2.06. Dag og Nat" master_schneider_electric="yes" master_type="4.2.06" master_name="Dag og Nat" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.2.06 Nat og Dag&#xD;&#xA;&#xD;&#xA;Anvendes til at slukke lys i udvalgte rum og sætte huset i &quot;NAT-Tilstand&quot;, &#xD;&#xA;når familien er går i seng. &#xD;&#xA;På Visility DashBoard vises tilstand for Dag eller Nat. Tilstand kan skiftes ved tryk på ikon.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.&#xD;&#xA;Denne FB er kompatibel med &quot;Visility Dashboard&quot;." udf="#DBScenario#">
            <inputs id="_0x2b8123" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x2b8211" name="Skift Dag/Nat" icon="_0x36" note="Skifter mellem Nat og Dag&#xD;&#xA;Denne er afhæning af &quot;Tryk betingelser&quot;&#xD;&#xA;&quot;Tryk - Uafhængigt af tryktid&quot; - Skifter mellem Nat og Dag , uanset tryktid.&#xD;&#xA;&quot;Langt tryk &gt; 0,7 sec&quot; - Kort tryk skifter til &quot;Dag&quot; - Tryk &gt;0.7 sekund = &quot;Nat&quot; &quot;&#xD;&#xA;&quot;X-langt tryk &gt; 1 sec&quot; - Kort tryk skifter til &quot;Dag&quot; - Tryk &gt; 1 sekund = &quot;Nat&quot; &#xD;&#xA;&quot;X-langt tryk &gt; 2 sec&quot; - Kort tryk skifter til &quot;Dag&quot; - Tryk &gt; 2 sekund = &quot;Nat&quot; &#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Skift Dag/Nat&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 4.2.06-IN01."/>
               <resource_input id="_0x2b8311" name="Nat" icon="_0x36" note="Skifter til &quot;Nat&quot; - Uanset tryktid&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Nat&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 4.2.06-IN02."/>
               <resource_input id="_0x2b8411" name="Dag" icon="_0x36" note="Skifter til &quot;Dag&quot; - Uanset tryktid&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Dag&quot; i simulering før anlægget sættes i drift. Ref. 4.2.06-IN03."/>
               <resource_input id="_0x2b8511" name="Indgang for PIR" icon="_0x36" note="Forbindes til en eller flere PIR sensorer.&#xD;&#xA;Anvendes kun ved &quot;Auto skift på = Ur og PIR&quot;&#xD;&#xA;Vælg under indstillinger &quot;PIR Type&quot; om det er en Lys PIR eller en &quot;Alarm PIR&quot;.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang for PIR&quot; er linket til i 4.2.06. Dag og Nat. Ref. 4.2.06-IN04."/>
            </inputs>
            <outputs id="_0x2b8624" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x2b8712" name="Dag og Nat" backup="yes" icon="_0x39" note="Forbindes til de funktionsblokke der anvender &quot;Nat&quot; tilstand&#xD;&#xA;denne udgang er &quot;ON&quot; når &quot;Nat&quot; er aktiveret &#xD;&#xA;og &quot;OFF&quot; når &quot;Dag&quot; er aktiveret" note-2="Vejledning: verificér &quot;Dag og Nat&quot; med en måling på klemmen (230 V AC). Ref. 4.2.06-UD01."/>
               <resource_scene id="_0x2b884a" name="Scenarie Godnat" note="Fremkaldes kun når &quot;Nat&quot; aktivers.&#xD;&#xA;Forbindes til den produkter der skal slukke til Godnat." note-2="Hjælp: dokumentér &quot;Scenarie Godnat&quot; i 4.2.06. Dag og Nat over for slutbrugeren. Ref. 4.2.06-UD02."/>
               <resource_output id="_0x2b8912" name="Puls - Nat" icon="_0x39" note="Kort puls , når &quot;Nat&quot; aktivers" note-2="Vejledning - &quot;Puls - Nat&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 4.2.06-UD03."/>
               <resource_output id="_0x2b8a12" name="Puls - Dag " icon="_0x39" note="Kort puls , når &quot;Nat&quot; aktivers" note-2="Tip: brug &quot;Puls - Dag&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 4.2.06-UD04."/>
            </outputs>
            <settings id="_0x2b8b25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x2b8c0f" name="Auto skift på" typedef="_0x2b2047" inivalue="_0x2b2148" icon="_0x22" note="Betingelse for hvornår automatisk skift til &quot;Dag&quot; &#xD;&#xA;&quot;Ur&quot; - Når &quot;Tidspunkt for Dag&quot; opnås skifter funktionsblokken automatisk til &quot;Dag&quot; &#xD;&#xA;&quot;Ur og Pir&quot; -  Når &quot;Tidspunkt for Dag&quot; er opfyldt, vil autonatisk skift til &quot;Dag&quot; først ske når &quot;Indgang for Pir&quot; aktivers&#xD;&#xA;&quot;Manualt&quot; - Skifter ikke automatisk." note-2="Vejledning - &quot;Auto skift på&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 4.2.06-IS01."/>
               <resource_time id="_0x2b8d0d" name="Tidspunkt for Dag" backup="yes" icon="_0x2f" note="Skifter til Dag når dette tisdpunkt er opnået.&#xD;&#xA;" hour="6" minute="45" second="0" note-2="Tip: notér den valgte værdi for &quot;Tidspunkt for Dag&quot; i anlægsdokumentationen. Ref. 4.2.06-IS02."/>
               <resource_enum id="_0x2b8e0f" name="Pir Type" typedef="_0x12e547" inivalue="_0x12e748" icon="_0x22" note="Vælg hvilken pir der er tilsluttet til blokken &#xD;&#xA;Vælg mellem Lys-pir og Alarm-pir" note-2="Note: &quot;Pir Type&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 4.2.06-IS03."/>
            </settings>
            <internalsettings id="_0x2b8f29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_enum id="_0x2b900f" name="DBScenario" typedef="_0x2b2447" inivalue="_0x2b4248" backup="yes" icon="_0x22" note="DBScenario" note-2="This enum control what icon is shown on the widget. This may be changes runtime by program. If value Hide is selected no icon is shown. Se documentation for icon id&apos;s." udf="#Scenario#"/>
