      <group id="_0x176832" name="FB 2.1 Tid ur og kalender" icon="_0x15" note="locNote 1024">
         <functionblock id="_0x176928" name="2.1.01.a. Ur, med 1 tidspunkt" master_schneider_electric="yes" master_type="2.1.01" master_version="a" master_name="Ur, med 1 tidspunkt" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="2.1.01.a. 7 dages ur, med 1 tænd tidspunkt&#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;7 dages ur, hvor der kun er et tænd- og sluktidspunkt. Dvs. at alle ugens 7 dage har samme tænd- og sluktidspunkt.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x176a23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x176b11" name="Tryk (manuel overstyring)" icon="_0x36" note="Manuelt overstyring af ur - en aktivering vil skifte udgangen. Udgang for ur vil forblive i tilstanden indtil næste urtidspunkt.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Tryk (manuel overstyring)&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 2.1.01.a-IN01."/>
            </inputs>
            <outputs id="_0x176c24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x176d12" name="Udgang fra ur" icon="_0x39" note="Anvendes til urstyring" note-2="Vejledning: verificér &quot;Udgang fra ur&quot; med en måling på klemmen (230 V AC). Ref. 2.1.01.a-UD01.">
                  <link_from_resource id="_0x4a692d" name="Følg Link" icon="_0x47" link="_0x4a6a2c"/>
               </resource_output>
               <resource_output id="_0x176e12" name="ON puls" icon="_0x39" note="Giver kort puls når &quot;Udgang for ur&quot; går on&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Hjælp: notér i 2.1.01.a. Ur, med 1 tidspunkt hvilke produkter &quot;ON puls&quot; betjener. Ref. 2.1.01.a-UD02.">
                  <link_from_resource id="_0x4a412d" name="Følg Link" icon="_0x47" link="_0x4a422c"/>
               </resource_output>
               <resource_output id="_0x176f12" name="OFF puls" icon="_0x39" note="Giver kort puls når &quot;Udgang for ur&quot; går off&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Vejledning - &quot;OFF puls&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 2.1.01.a-UD03."/>
               <resource_scene id="_0x17704a" name="Scenarie Tænd" note="Fremkalder scenarie når &quot;Udgang for ur&quot; går on&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Tip: hold antallet af produkter i &quot;Scenarie Tænd&quot; lavt (&lt; 20) af hensyn til svartiden. Ref. 2.1.01.a-UD04.">
                  <scene_link id="_0x4a644b" name="Scenarie link" icon="_0x47" link="_0x4a634c"/>
               </resource_scene>
               <resource_scene id="_0x17714a" name="Scenarie Sluk" note="Fremkalder scenarie når &quot;Udgang for ur&quot; går off&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Note: &quot;Scenarie Sluk&quot; fremkaldes også fra ur og kalender.&#xD;&#xA;Ref. 2.1.01.a-UD05."/>
            </outputs>
