            <outputs id="_0x2ec224" name="Udgang" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x2ec312" name="Udgang til pumpe" icon="_0x39" note="Forbindes til udgang for cirkulationspumpe.&#xD;&#xA;Udgang aktiveres ikke før &quot; Timertid før start af pumpe&quot; er udløbet og deaktiveres ikke før &quot; Timertid før stop af pumpe&quot; er udløbet.&#xD;&#xA;" note-2="Vejledning: verificér &quot;Udgang til pumpe&quot; med en måling på klemmen (230 V AC). Ref. 5.2.03.e-UD01."/>
               <resource_output id="_0x2ec412" name="Udgang kald på varme ved pumpedrift" icon="_0x39" note="Udgang aktiveres først når &quot;timertid før start af pumpe&quot; udløber dvs samtidigt med at cirkulationpumpe starter. &#xD;&#xA;Anvendes til varmekilder som f.eks. el-fyr eller lette kedler.&#xD;&#xA;&#xD;&#xA;" note-2="Hjælp: notér i 5.2.03.e. Pumpestyring hvilke produkter &quot;Udgang kald på varme ved pumpedrift&quot; betjener. Ref. 5.2.03.e-UD02."/>
               <resource_output id="_0x2ec512" name="Udgang kald på varme før pumpedrift" icon="_0x39" note="Udgang aktiveres med det samme når der kaldes på varme - cirkulationspumpe starter først når &quot;Timertid før start af pumpe&quot; udløber . &#xD;&#xA;Anvendes til træge varmekilder som f.eks. støbejernskedler og pillefyr&#xD;&#xA;" note-2="Vejledning - &quot;Udgang kald på varme før pumpedrift&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 5.2.03.e-UD03."/>
               <resource_output id="_0x2ec612" name="Udgang for ventilmotion" icon="_0x39" note="Forbindes til &quot;Indgang for start af ventilmotion&quot; på&#xD;&#xA;FB &quot;5.2.01 betjeningspanel&quot;.&#xD;&#xA;Anvendes til at motionere ventiler og pumpe så de ikke &quot;gror&quot; fast.&#xD;&#xA;" note-2="Tip: brug &quot;Udgang for ventilmotion&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.2.03.e-UD04."/>
            </outputs>
            <settings id="_0x2ec725" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timertime id="_0x2ec817" name="Timertid før start af pumpe" backup="yes" icon="_0x4d" note="Indstilling af tid før pumpestart ved kald på varme.&#xD;&#xA;Sørger for at telestater er åbne inden pumpe startes&#xD;&#xA;" hour="0" minute="2" second="45" millisecond="0" note-2="Vejledning - &quot;Timertid før start af pumpe&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 5.2.03.e-IS01."/>
               <resource_timertime id="_0x2ec917" name="Timertid før stop af pumpe" icon="_0x4d" note="Indstilling af tid før pumpestop, når der ikke er kald på varme længere.&#xD;&#xA;Sørger for at udnytte restvarmen inden telestaten lukker.&#xD;&#xA;" hour="0" minute="1" second="20" millisecond="0" note-2="Tip: notér den valgte værdi for &quot;Timertid før stop af pumpe&quot; i anlægsdokumentationen. Ref. 5.2.03.e-IS02."/>
               <resource_enum id="_0x2eca0f" name="Pumpemotion" typedef="_0x2eae47" inivalue="_0x2eb048" icon="_0x22" note="Her vælges om der ønskes pumpemotion." note-2="Note: &quot;Pumpemotion&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 5.2.03.e-IS03."/>
               <resource_integer id="_0x2ecb0b" name="Antal dage imellem pumpemotion" backup="yes" note="Vælg ønsket antal af dage imellem motionering af pumpe og ventiler" inivalue="4" note-2="Vejledning: afprøv &quot;Antal dage imellem pumpemotion&quot; i simulering før anlægget overdrages. Ref. 5.2.03.e-IS04."/>
               <resource_timertime id="_0x2ecc17" name="Varighed af pumpemotion" icon="_0x4d" note="Indstilling af varighed af pumpe- og ventil motionering" hour="0" minute="9" second="0" millisecond="0" note-2="Hjælp: værdien for &quot;Varighed af pumpemotion&quot; i 5.2.03.e. Pumpestyring bør gennemgås ved service. Ref. 5.2.03.e-IS05."/>
            </settings>
