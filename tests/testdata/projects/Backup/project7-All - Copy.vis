               <resource_input id="_0x3f811" name="Indgang" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Indgang&quot; til det tryk der skal betjene funktionen. Ref. 1.1.04.c-IN01.">
