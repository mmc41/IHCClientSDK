                  <link_from_resource id="_0x49e32d" name="Følg Link" icon="_0x47" link="_0x49e42c"/>
               </resource_output>
               <resource_output id="_0x43f12" name="Udgang 3 - OP / Tænd" icon="_0x39" note="Udgang &quot;Udgang 3 - OP / Tænd&quot;: aktiv så længe betingelserne i blokken er opfyldt. Ref. 1.1.05-UD05." note-2="Tip: brug &quot;Udgang 3 - OP / Tænd&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 1.1.05-UD05."/>
               <resource_output id="_0x44012" name="Udgang 3 - Ned / Sluk" icon="_0x39" note="Udgang &quot;Udgang 3 - Ned / Sluk&quot; fra funktionsblok 1.1.05. Forbindes til lampeudtag eller relæ. Ref. 1.1.05-UD06." note-2="Note: &quot;Udgang 3 - Ned / Sluk&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 1.1.05-UD06."/>
               <resource_output id="_0x44112" name="Udgang 4 - OP / Tænd" icon="_0x39" note="Udgang &quot;Udgang 4 - OP / Tænd&quot; - styrer det tilkoblede produkt.&#xD;&#xA;Udfyldes af installatøren. Ref. 1.1.05-UD07." note-2="Vejledning: verificér &quot;Udgang 4 - OP / Tænd&quot; med en måling på klemmen (230 V AC). Ref. 1.1.05-UD07."/>
