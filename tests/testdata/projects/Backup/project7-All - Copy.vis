         <functionblock id="_0x56928" name="1.1.12. Lysstyring (luxsensor)" master_schneider_electric="yes" master_type="1.1.12" master_name="Lysstyring (luxsensor)" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="1.1.12. Lysstyring (luxsensor)&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Tænder og slukker lyset ud fra en målt luxværdi &amp; et setpunkt.&#xD;&#xA;Ind- og udkobling forsinkes, så skyer og forbikørende lys ikke giver blink.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.">
            <inputs id="_0x56a23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_light id="_0x56b16" name="Lys" note="Forbindes til luxsensor" inivalue="500" note-2="Vejledning: test &quot;Lys&quot; i simulering før anlægget sættes i drift. Ref. 1.1.12-IN01."/>
            </inputs>
            <outputs id="_0x56c24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x56d12" name="Udgang" icon="_0x39" note="Forbindes til komponent som ønskes styres" note-2="Bemærk: &quot;Udgang&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 1.1.12-UD01."/>
            </outputs>
            <settings id="_0x56e25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_light id="_0x56f16" name="Setpunkt for lys" backup="yes" note="Indstilling af setpunkt" inivalue="220" note-2="Hjælp: værdien for &quot;Setpunkt for lys&quot; i 1.1.12. Lysstyring (luxsensor) bør gennemgås ved service. Ref. 1.1.12-IS01."/>
               <resource_light id="_0x57016" name="Offset for lys (hysterese)" note="Indstilling af hysterese" inivalue="22" note-2="Vejledning - &quot;Offset for lys (hysterese)&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 1.1.12-IS02."/>
               <resource_timer id="_0x57110" name="Forsinkelse af indkobling" icon="_0x43" note="Indstilling af forsinkelse af tænd&#xD;&#xA;Anvendes til at undgå utilsigtet tænd af lys ved pludselige ændringer i lysniveau&#xD;&#xA;F.eks. et objekt kortvarigt passerer sensoren." hour="0" minute="2" second="40" millisecond="0" note-2="Tip: notér den valgte værdi for &quot;Forsinkelse af indkobling&quot; i anlægsdokumentationen. Ref. 1.1.12-IS03."/>
               <resource_timer id="_0x57210" name="Forsinkelse af udkobling" icon="_0x43" note="Indstilling af forsinkelse af sluk&#xD;&#xA;Anvendes til at undgå utilsigtet tænd af lys ved pludselige ændringer i lysniveau&#xD;&#xA;F.eks. billygte kortvarigt lyser på sensoren." hour="0" minute="1" second="5" millisecond="0" note-2="Note: &quot;Forsinkelse af udkobling&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 1.1.12-IS04."/>
            </settings>
            <internalsettings id="_0x57329" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_light id="_0x57416" name="Lysniveau for tænd" note="Intern tidsstyring &quot;Lysniveau for tænd&quot; i 1.1.12. Værdien styres af programmet &amp; ikke af brugeren. Ref. 1.1.12-IV01." note-2="Hjælpetekst for &quot;Lysniveau for tænd&quot;: se blokkens fulde beskrivelse med &quot;F1&quot;. Ref. 1.1.12-IV01."/>
               <resource_light id="_0x57516" name="Lysniveau for sluk" note="Intern variabel &quot;Lysniveau for sluk&quot;: ikke synlig i konfigurationsvinduet (&lt; programmeringsmode). Ref. 1.1.12-IV02." note-2="Bemærk: &quot;Lysniveau for sluk&quot; indgår i &gt; 1 af blokkens programmer. Ref. 1.1.12-IV02."/>
               <resource_flag id="_0x5760a" name="Flag" icon="_0x33" note="Intern variabel &quot;Flag&quot; - indgår i blokkens betingelser og kommandoer. Ref. 1.1.12-IV03." note-2="Hjælpetekst: &quot;Flag&quot; er intern - lad den stå som blokken leverer den. Ref. 1.1.12-IV03."/>
            </internalsettings>
