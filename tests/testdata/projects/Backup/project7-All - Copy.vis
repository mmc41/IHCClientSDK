         <functionblock id="_0x16be28" name="1.4.09. PIR og tryk styret udgang" master_schneider_electric="yes" master_type="1.4.09" master_name="PIR og tryk styret udgang" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2016" master_date_year="2017" master_date_month="5" master_date_day="1" locked="yes" icon="_0xe" note="Styring af udgang med tryk, PIR, skumring og ur.&#xD;&#xA;Typisk anvendelse til styring af lys ude eller inde. ">
            <inputs id="_0x16c623" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x16c711" name="PIR" icon="_0x36" note="Indgang fra PIR ( on ved aktivitet )&#xD;&#xA;(Udfyldes af installatøren)" note-2="Er styreformen &quot;PIR: tænd og sluk&quot;, skal: pir, skumring- og ur indgang være on for at tænde udgangen. Så snart pir indgangen skifter til off startes neddtælling på timer.&#xD;&#xA;Er nedtælling i gang og pir indgangen skifter til on stoppes nedtællingen."/>
               <resource_input id="_0x16c811" name="Skumring" icon="_0x36" note="Indgang fra lysføler/skumring eller astro ur (IC Astro 1 Kanal 10A 230V .&#xD;&#xA;EAN: 36 06 480 179 631) &#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst: forbind &quot;Skumring&quot; til det tryk der skal betjene funktionen. Ref. 1.4.09-IN02."/>
               <resource_input id="_0x16c911" name="Ur" icon="_0x36" note="Indgang fra ur.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Ur- og skumringsindgangen skal være on for at udgangen kan skifte til on ved pir aktivitet (on). Ved ur skifte til off vil udgangen altid skifte til off."/>
               <resource_input id="_0x16ca11" name="Kip" icon="_0x36" note="Tænd og sluk&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tændes udgangen og pir indgangen ikke er on vil nedtælling på timer starte med det samme, hvis ikke manuelt tænd og skul er valgt som styreform.&#xD;&#xA;Slukkes udgangen på tryk vil en en spærre tid blive aktiveret, så rummet kan forlades uden at udgangen skifter til on ved at pir indgangen er eller skifter til on."/>
               <resource_input id="_0x16cb11" name="Tænd" icon="_0x36" note="Tænd.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tændes udgangen og pir indgangen ikke er on vil nedtælling på timer starte med det samme, hvis ikke manuelt tænd og skul er valgt som styreform."/>
               <resource_input id="_0x16cc11" name="Sluk" icon="_0x36" note="Sluk.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Sluk&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 1.4.09-IN06."/>
            </inputs>
            <outputs id="_0x16cd24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x16ce12" name="Udgang" icon="_0x39" note="Udgang &quot;Udgang&quot; - styrer det tilkoblede produkt.&#xD;&#xA;Udfyldes af installatøren. Ref. 1.4.09-UD01." note-2="Vejledning - &quot;Udgang&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 1.4.09-UD01."/>
            </outputs>
            <settings id="_0x16cf25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x16d010" name="Timer sluk" backup="yes" icon="_0x43" note="Indstilling &quot;Timer sluk&quot;. Ændres kun efter aftale med bygherren. Ref. 1.4.09-IS01." hour="0" minute="5" second="15" millisecond="0" note-2="Bemærk: &quot;Timer sluk&quot; træder i kraft ved næste programafvikling. Ref. 1.4.09-IS01."/>
               <resource_timer id="_0x16d110" name="PIR spærretid." backup="yes" icon="_0x43" note="Slukkes udgangen på anden måde end via &quot;Timer sluk&quot; aktiveres PIR-spærretid." hour="0" minute="0" second="16" millisecond="0" note-2="Så længe PIR-spærretimer tæller ned vil udgangen ikke tænde ved PIR indgang on.&#xD;&#xA;Når PIR-spærretimer når 0. vil udgangen tænde såfremt betingelserne er opfyldte.&#xD;&#xA;( PIR-, ur- og skumrings indgang er on og styreformen er &quot;PIR: Tænd og sluk&quot; )"/>
               <resource_enum id="_0x16d20f" name="Styreform:" typedef="_0x16c247" inivalue="_0x16c548" backup="yes" icon="_0x22" note="Er styreformen = PIR: tænd og sluk. Er PIR-, skumring-, og urindgangen on skifter udgangen til on. &#xD;&#xA;Er styreformen = PIR: tænd og sluk eller Sluk på PIR skifter udgangen til off når &quot;Timer sluk&quot; udløber." note-2="Er styreformen = PIR: tænd og sluk. Er PIR-, skumring-, og urindgangen on skifter udgangen til on. &#xD;&#xA;Er styreformen = PIR: tænd og sluk eller Sluk på PIR skifter udgangen til off når &quot;Timer sluk&quot; udløber."/>
               <resource_enum id="_0x16d30f" name="Skumring" typedef="_0x16bf47" inivalue="_0x16c048" backup="yes" icon="_0x22" note="&quot;Udgang følger ikke skumring ved skifte til off&quot; Er udgange on slukkes udgangen ikke før timer sluk løber ud, eller på tryk.&#xD;&#xA;(Bruges typisk indendørs hvor skumring/ lysføler bliver påvirket af det lys der bliver tændt)&#xD;&#xA;&#xD;&#xA;&quot;Udgang følger skumring ved skifte til off&quot; Så snart skumringen går off skifter udgangen også til off&#xD;&#xA;(Bruges typisk til udendørs lys)" note-2="Bemærk: &quot;Skumring&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 1.4.09-IS04."/>
            </settings>
            <internalsettings id="_0x16d429" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken"/>
