               <resource_timer id="_0x47c410" name="Timertid for lyd-/lyspuls" icon="_0x43" note="Her indstilles hvor længe udgangen lydgiver skal være on" hour="1" minute="0" second="0" millisecond="150" note-2="Bemærk: &quot;Timertid for lyd-/lyspuls&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 6.4.01.a-IS01."/>
               <resource_timer id="_0x47c510" name="Timertid for pause mellem pulser" icon="_0x43" note="Her indstilles hvor længe udgangen lydgiver skal være off" hour="0" minute="0" second="19" millisecond="0" note-2="Hjælpetekst: &quot;Timertid for pause mellem pulser&quot; justeres til anlæggets faktiske forhold. Ref. 6.4.01.a-IS02."/>
