      <group id="_0x37dd32" name="FB 5.4 Klima Ventilation" icon="_0x15" note="locNote 1031">
         <functionblock id="_0x37de28" name="5.4.01.c. Ventilationsstyring" master_schneider_electric="yes" master_type="5.4.01" master_version="c" master_name="Ventilationsstyring" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="5.4.01 Ventilationsstyring.&#xD;&#xA;&#xD;&#xA;Anvendes til styring af ventilationsanlæg. f.eks NILAN&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse, marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.">
            <inputs id="_0x380d23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x380e11" name="Indgang nødstop (NC)" backup="yes" icon="_0x36" note="Bruges til nødstop af ventilationsanlæget, ved f.eks giftig udeluft som ikke ønskes ind i huset.&#xD;&#xA;Nødstop virker ikke i panelstyret tilstand.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;Indgang nødstop (NC)&quot; bør kun linkes til én indgang ad gangen. Ref. 5.4.01.c-IN01.">
                  <link_to_resource id="_0x4a6e2c" name="Følg Link" icon="_0x4a" link="_0x4a6d2d"/>
               </resource_input>
               <resource_input id="_0x380f11" name="Indgang dør- / vinduesstyring (NC)" icon="_0x36" note="Indgangen bruges til ar reducere eller at stoppe drift på ventilationsanlæg ved åbne døre eller vinduer. &#xD;&#xA;&#xD;&#xA;Er bygningen i beboet drift og indgangen går off vil anlægget ændre hastigheden iht. indstilling, og ved on gå tilbage til normal drift.&#xD;&#xA;Magnetkontakter bør samles i en funktionsblok inden de forbindes til denne indgang.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" inivalue="on" note-2="Hjælp til &quot;Indgang dør- / vinduesstyring (NC)&quot; på 5.4.01.c: signalet skal være stabilt i &gt; 100 ms. Ref. 5.4.01.c-IN02."/>
               <resource_input id="_0x381011" name="Indgang hygrostat" icon="_0x36" note="Når hygrostat er on, vil anlægget køre i trin 4 ved dag og aften drift. Ved natdrift, vil anlægget køre i trin 2. &#xD;&#xA;Denne indgang kan også anvendes til forceret drift fra f.eks. en timer ifb. toilet besøg.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælpetekst for &quot;Indgang hygrostat&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 5.4.01.c-IN03."/>
               <resource_input id="_0x381111" name="Indgang gæstetilstand" icon="_0x36" note="Når indgangen er on, sættes ventilationstrin tvungen i trin 3. &#xD;&#xA;Det er ikke muligt at sætte anlægget i gæstetiltand, ved ubeboet og nat.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Indgang gæstetilstand&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.4.01.c-IN04."/>
               <resource_input id="_0x381211" name="Indgang fri-/ helligdag" icon="_0x36" note="Forbindes sammen med 5.2.04.a. Ur til nat- og dagtemperatur.&#xD;&#xA;&#xD;&#xA;Denne funktion sørger for at huset er ventileret når man kommer hjem.&#xD;&#xA;&#xD;&#xA;Er indgang on, vil indstillingen Drifttrin ikke hjemme på hverdage, før tidspunkt&quot; ikke være aktiv. &#xD;&#xA;&#xD;&#xA;Er indgang off: Ventilationsanlæget kører indtil indstillingen, &#xD;&#xA;Skift til normal drift på hverdage (ikke hjemme)&#xD;&#xA;Når dette klokkeslet passeres, skiftes til normal drift. &#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælpetekst: forbind &quot;Indgang fri-/ helligdag&quot; til det tryk der skal betjene funktionen. Ref. 5.4.01.c-IN05."/>
               <resource_enum id="_0x38130f" name="Driftform" typedef="_0x2d2247" inivalue="_0x2d2348" backup="yes" icon="_0x22" note="Skal forbindes til funktionsblok 5.2.01 udgang - drifttilstand. &#xD;&#xA;Styrer drifttilstanden og viser hvilken, der er aktiv.&#xD;&#xA;&#xD;&#xA;" note-2="Bemærk: &quot;Driftform&quot; bør kun linkes til én indgang ad gangen. Ref. 5.4.01.c-IN06."/>
               <resource_enum id="_0x38140f" name="Hustilstand" typedef="_0x380847" inivalue="_0x380948" backup="yes" icon="_0x22" note="Forbindes til hustilstandudgang på funktionsblok 5.3.04.&#xD;&#xA;Sørger for at ventilationsstyringen kører i forhold til husets tilstand (er der nogen hjemme osv.)&#xD;&#xA;" note-2="Hjælp til &quot;Hustilstand&quot; på 5.4.01.c: signalet skal være stabilt i &gt; 100 ms. Ref. 5.4.01.c-IN07.">
                  <link_to_resource id="_0x4a842c" name="Følg Link" icon="_0x4a" link="_0x4a832d"/>
               </resource_enum>
               <resource_temperature id="_0x381514" name="Udv. temperatur ind:" note="Den udvendige temperatur bruges til at starte/stoppe anlæget int. indstillet temperatur &quot;Temperatur setpunkt imod frostskader og rørkondens&quot;, når huset er boboet." inivalue="3.00" note-2="Hjælpetekst for &quot;Udv. temperatur ind:&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 5.4.01.c-IN08."/>
               <resource_input id="_0x381611" name="Indgang Stop" icon="_0x36" note="Stopper anlægget. &#xD;&#xA;Virker kun i IHC manuel drift.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Bemærk: &quot;Indgang Stop&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.4.01.c-IN09."/>
               <resource_input id="_0x381711" name="Indgang Trin 1." icon="_0x36" note="Sætter anlægget i trin 1. &#xD;&#xA;Virker kun i IHC manuel drift.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælpetekst: forbind &quot;Indgang Trin 1.&quot; til det tryk der skal betjene funktionen. Ref. 5.4.01.c-IN10."/>
               <resource_input id="_0x381811" name="Indgang Trin 2." icon="_0x36" note="Sætter anlægget i trin 2. &#xD;&#xA;Virker kun i IHC manuel drift.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Bemærk: &quot;Indgang Trin 2.&quot; bør kun linkes til én indgang ad gangen. Ref. 5.4.01.c-IN11."/>
               <resource_input id="_0x381911" name="Indgang Trin 3." icon="_0x36" note="Sætter anlægget i trin 3. &#xD;&#xA;Virker kun i IHC manuel drift.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælp til &quot;Indgang Trin 3.&quot; på 5.4.01.c: signalet skal være stabilt i &gt; 100 ms. Ref. 5.4.01.c-IN12."/>
               <resource_input id="_0x381a11" name="Indgang Trin 4." icon="_0x36" note="Sætter anlægget i trin 4. &#xD;&#xA;Virker kun i IHC manuel drift.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælpetekst for &quot;Indgang Trin 4.&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 5.4.01.c-IN13."/>
               <resource_input id="_0x381b11" name="Driftform: Køl" icon="_0x36" note="Sætter anlægget køldrift, kræver dog køleflade.&#xD;&#xA;Virker kun i IHC manuel drift.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Bemærk: &quot;Driftform: Køl&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.4.01.c-IN14."/>
               <resource_input id="_0x381c11" name="Driftform: Varme" icon="_0x36" note="Sætter anlægget varmedrift, kræver dog varmeflade.&#xD;&#xA;Virker kun i IHC manuel drift.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælpetekst: forbind &quot;Driftform: Varme&quot; til det tryk der skal betjene funktionen. Ref. 5.4.01.c-IN15."/>
               <resource_input id="_0x381d11" name="Driftform: Automatisk" icon="_0x36" note="Sætter anlægget autodrift, således at varme/køl, styres internt i klimaanlægget (kræver varme- og køleflade).&#xD;&#xA;Virker kun i manuel drift.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Bemærk: &quot;Driftform: Automatisk&quot; bør kun linkes til én indgang ad gangen. Ref. 5.4.01.c-IN16."/>
               <resource_input id="_0x381e11" name="Styreform: IHC automatisk styret" icon="_0x36" note="Vælges denne betjeningsform vil ventilationsanlægget, køre iht. til beskrivelse for &quot;Styring via hustilstand&quot;&#xD;&#xA;Hastighed, temperatur og driftform (køl/varme/auto), kan ses men ikke ændres på Nilan styrepanelet.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælp til &quot;Styreform: IHC automatisk styret&quot; på 5.4.01.c: signalet skal være stabilt i &gt; 100 ms. Ref. 5.4.01.c-IN17."/>
               <resource_input id="_0x381f11" name="Styreform: IHC manuelt styret" icon="_0x36" note="Vælges denne betjeningsform er det muligt selv at vælge hastighed, temperatur og driftform (køl/varme/auto)&#xD;&#xA;&#xD;&#xA;Hastighed, temperatur og driftform kan styres via funktionsblokken, dog ses men ikke ændres på Nilan styrepanelet. &#xD;&#xA;Ved skift til IHC Manuel. sættes ventilationsanlæg i trin 2.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Styreform: IHC manuelt styret&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 5.4.01.c-IN18."/>
               <resource_input id="_0x382011" name="Styreform: Panelstyret" icon="_0x36" note="Vælges panelstyret, kan ventilationsanlægget styres fra det Nilan styrepanel der følger med ventilationsanlægget (se vejledning for øvrige funktioner for Nilan styrepanelet).&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Styreform: Panelstyret&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.4.01.c-IN19."/>
               <resource_enum id="_0x38210f" name="Input: Vent. temp. ved manuel" typedef="_0x37fc47" inivalue="_0x380048" backup="yes" icon="_0x22" note="Forberedt for fremtidige applikationer. " note-2="Hjælpetekst: forbind &quot;Input: Vent. temp. ved manuel&quot; til det tryk der skal betjene funktionen. Ref. 5.4.01.c-IN20."/>
            </inputs>
            <outputs id="_0x382224" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_enum id="_0x38230f" name="1. Ventilations temp." typedef="_0x37fc47" inivalue="_0x380248" backup="yes" icon="_0x22" note="Forbindes til 5.4.02. NILAN Gateway funktionsblok - Input 1. Ventilationstemperatur.&#xD;&#xA;&#xD;&#xA;Vælges panelstyret, kan ventilationsanlægget styres fra det Nilan styrepanel der følger med ventilationsanlægget (se vejledning for øvrige funktioner for Nilan styrepanelet).&#xD;&#xA;" note-2="Bemærk: &quot;1. Ventilations temp.&quot; kan linkes til flere produkter samtidigt. Ref. 5.4.01.c-UD01.">
                  <link_from_resource id="_0x4a7d2d" name="Følg Link" icon="_0x47" link="_0x4a7e2c"/>
               </resource_enum>
               <resource_enum id="_0x38240f" name="2. Ventilations drift trin." typedef="_0x37f147" inivalue="_0x37f348" backup="yes" icon="_0x22" note="Forbindes til 5.4.02. NILAN Gateway funktionsblok - Input 2. Ventilations drift trin.&#xD;&#xA;&#xD;&#xA;Viser anlæggets aktuelle drift trin.&#xD;&#xA;&#xD;&#xA;" note-2="Hjælp til &quot;2. Ventilations drift trin.&quot; på 5.4.01.c: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 5.4.01.c-UD02.">
                  <link_from_resource id="_0x4a272d" name="Følg Link" icon="_0x47" link="_0x4a282c"/>
               </resource_enum>
               <resource_enum id="_0x38250f" name="3. Ventilations styreform." typedef="_0x37f847" inivalue="_0x37fa48" backup="yes" icon="_0x22" note="Forbindes til 5.4.02. NILAN Gateway funktionsblok - Input 3. Ventilations styreform.&#xD;&#xA;&#xD;&#xA;Viser anlæggets aktuelle styringsform (IHC Automatik, manuel eller panel).&#xD;&#xA;" note-2="Hjælpetekst for &quot;3. Ventilations styreform.&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 5.4.01.c-UD03.">
                  <link_from_resource id="_0x4a292d" name="Følg Link" icon="_0x47" link="_0x4a2a2c"/>
               </resource_enum>
               <resource_enum id="_0x38260f" name="4. Ventilations drift form." typedef="_0x37ec47" inivalue="_0x37ef48" backup="yes" icon="_0x22" note="Forbindes til 5.4.02. NILAN Gateway funktionsblok - Input 4. Ventilations drift form.&#xD;&#xA;&#xD;&#xA;Viser anlæggets aktuelle driftform (Varme/køl/automatisk).&#xD;&#xA;" note-2="Bemærk: &quot;4. Ventilations drift form.&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 5.4.01.c-UD04.">
                  <link_from_resource id="_0x4a2b2d" name="Følg Link" icon="_0x47" link="_0x4a2c2c"/>
               </resource_enum>
               <resource_output id="_0x382712" name="Udgang nødstop" icon="_0x39" note="Indikerer at nødstop er aktiveret" note-2="Hjælpetekst: &quot;Udgang nødstop&quot; forbindes til det produkt der skal styres. Ref. 5.4.01.c-UD05."/>
               <resource_output id="_0x382812" name="Udgang ventilation" icon="_0x39" note="Indikerer at ventilation er aktiv" note-2="Bemærk: &quot;Udgang ventilation&quot; kan linkes til flere produkter samtidigt. Ref. 5.4.01.c-UD06."/>
               <resource_output id="_0x382912" name="Udgang driftform: køl" icon="_0x39" note="Indikerer at kølefunktion er aktiv." note-2="Hjælp til &quot;Udgang driftform: køl&quot; på 5.4.01.c: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 5.4.01.c-UD07."/>
               <resource_output id="_0x382a12" name="Udgang driftform: varme" icon="_0x39" note="Indikerer at varmefunktion er aktiv." note-2="Hjælpetekst for &quot;Udgang driftform: varme&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 5.4.01.c-UD08."/>
               <resource_output id="_0x382b12" name="Udgang driftform: automatisk:  køl/varme" icon="_0x39" note="Indikerer at anlægget automatisk skifter mellem køl/varme." note-2="Bemærk: &quot;Udgang driftform: automatisk:  køl/varme&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 5.4.01.c-UD09."/>
               <resource_output id="_0x382c12" name="Udgang styreform: IHC automatisk" icon="_0x39" note="Indikerer at styreform er IHC automatisk" note-2="Hjælpetekst: &quot;Udgang styreform: IHC automatisk&quot; forbindes til det produkt der skal styres. Ref. 5.4.01.c-UD10."/>
               <resource_output id="_0x382d12" name="Udgang styreform: IHC manuel" icon="_0x39" note="Indikerer at styreformen er IHC manuel" note-2="Bemærk: &quot;Udgang styreform: IHC manuel&quot; kan linkes til flere produkter samtidigt. Ref. 5.4.01.c-UD11."/>
               <resource_output id="_0x382e12" name="Udgang styreform: Panelstyret" backup="yes" icon="_0x39" note="Indikation af styreform.&#xD;&#xA;Udgang ON: Anlæg styres fra ventilationsanlæggets eget panel.&#xD;&#xA;Udgang OFF: Anlæg styres fra IHC systemet.&#xD;&#xA;" note-2="Hjælp til &quot;Udgang styreform: Panelstyret&quot; på 5.4.01.c: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 5.4.01.c-UD12."/>
            </outputs>
            <settings id="_0x382f25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x38300f" name="Drift trin nat" typedef="_0x37f147" inivalue="_0x37f648" backup="yes" icon="_0x22" note="Her indstilles ventilationshastigheden for natdrift." note-2="Hjælp til &quot;Drift trin nat&quot; på 5.4.01.c: værdier &lt; minimum afvises af controlleren. Ref. 5.4.01.c-IS01."/>
               <resource_enum id="_0x38310f" name="Drift trin ved dørkontakt off" typedef="_0x37f147" inivalue="_0x37f748" backup="yes" icon="_0x22" note="Her indstilles ønsket drift trin, hvis døre eller vinduer bliver åbnet." note-2="Hjælpetekst for &quot;Drift trin ved dørkontakt off&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.4.01.c-IS02."/>
               <resource_enum id="_0x38320f" name="Drift trin gæstetilstand" typedef="_0x37f147" inivalue="_0x37f348" backup="yes" icon="_0x22" note="Her indstilles ventilationshastigheden for gæstetilstand." note-2="Bemærk: &quot;Drift trin gæstetilstand&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.4.01.c-IS03."/>
               <resource_enum id="_0x38330f" name="Drift trin hygrostst on dag" typedef="_0x37f147" inivalue="_0x37f648" backup="yes" icon="_0x22" note="Her indstilles ventilationshastigheden når hygrostat er on. Indstillingen gælder kun ved dag.&#xD;&#xA;&#xD;&#xA;Når hygrostat er on, vil anlægget køre i trin 4 ved dag og aften drift. Ved natdrift, vil anlægget køre i trin 2. &#xD;&#xA;Denne indgang kan også anvendes til forceret drift fra f.eks. en timer ifb. toilet besøg.&#xD;&#xA;" note-2="Hjælpetekst: &quot;Drift trin hygrostst on dag&quot; justeres til anlæggets faktiske forhold. Ref. 5.4.01.c-IS04."/>
               <resource_enum id="_0x38340f" name="Drift trin hygrostst on i nattilstand" typedef="_0x37f147" inivalue="_0x37f748" backup="yes" icon="_0x22" note="Her indstilles ventilationshastigheden når hygrostat er on.&#xD;&#xA;Indstillingen gælder kun ved nattilstand.&#xD;&#xA;&#xD;&#xA;Når hygrostat er on, vil anlægget køre i trin 4 ved dag og aften drift. Ved natdrift, vil anlægget køre i trin 2. &#xD;&#xA;Denne indgang kan også anvendes til forceret drift fra f.eks. en timer ifb. toilet besøg.&#xD;&#xA;" note-2="Bemærk: &quot;Drift trin hygrostst on i nattilstand&quot; træder i kraft ved næste programafvikling. Ref. 5.4.01.c-IS05."/>
               <resource_enum id="_0x38350f" name="Drift trin hjemme (normal drift)" typedef="_0x37f147" inivalue="_0x37f448" backup="yes" icon="_0x22" note="Her indstilles ventilationshastigheden for hjemmetilstand." note-2="Hjælp til &quot;Drift trin hjemme (normal drift)&quot; på 5.4.01.c: værdier &lt; minimum afvises af controlleren. Ref. 5.4.01.c-IS06."/>
               <resource_enum id="_0x38360f" name="Drifttrin, ude til hverdag, før tidspunkt" typedef="_0x37f147" inivalue="_0x37f648" backup="yes" icon="_0x22" note="Drifttrin som er aktivt fra man forlader huset, frem til indstillet tidspunkt for &quot;Skift til normal drift på hverdag kl.&quot;&#xD;&#xA;&#xD;&#xA;Denne funktion sørger for at huset er ventileret når man kommer hjem.&#xD;&#xA;&#xD;&#xA;" note-2="Hjælpetekst for &quot;Drifttrin, ude til hverdag, før tidspunkt&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.4.01.c-IS07."/>
               <resource_enum id="_0x38370f" name="Drifttrin ude til hverdag, efter tidspunkt" typedef="_0x37f147" inivalue="_0x37f748" backup="yes" icon="_0x22" note="Drifttrin som er aktivt efter indstillet tidspunkt for &quot;Skift til normal drift på hverdag kl.&quot;&#xD;&#xA;&#xD;&#xA;Er Indgang &quot;fri-/ helligdag indgang on&quot;, vil indstillingen &quot;Drifttrin ikke hjemme på hverdage, før tidspunkt&quot; ikke være aktiv. Er indgangen off: Ventilationsanlæget kører &quot;Drifttrin, ude til hverdag før tidspunkt&quot; indtil &quot;Skift til normal drift på hverdage&quot; (Tidspunkt)&#xD;&#xA;&#xD;&#xA;Denne funktion sørger for at huset er ventileret når man kommer hjem.&#xD;&#xA;" note-2="Bemærk: &quot;Drifttrin ude til hverdag, efter tidspunkt&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.4.01.c-IS08."/>
               <resource_enum id="_0x38380f" name="Drifttrin ved temp. under setpunkt rørkondens" typedef="_0x37f147" inivalue="_0x37f448" backup="yes" icon="_0x22" note="Drifttrin i forhold til &quot;&#xD;&#xA;Temperatur setpunkt imod frostskader og rørkondens&quot; &#xD;&#xA;Dette sikre at der ikke opstår kondens i stillestående anlæg. Bør ikke sættes til &quot;slukket&quot; ved ventilationsrør på loftet.&#xD;&#xA;" note-2="Bør ikke sættes til &quot;slukket&quot; ved ventilationsrør på loftet."/>
               <resource_enum id="_0x38390f" name="Drifttrin ubeboet" typedef="_0x37f147" inivalue="_0x37f648" backup="yes" icon="_0x22" note="Ventilationstrin når betjeningspanel er sat til &quot;ubeboet&quot;.&#xD;&#xA; Anlægget kører på dette trin 20 min, hver time. (Default)" note-2="Bemærk: &quot;Drifttrin ubeboet&quot; træder i kraft ved næste programafvikling. Ref. 5.4.01.c-IS10."/>
               <resource_timertime id="_0x383a17" name="Drift pr. time i ubeboet" backup="yes" icon="_0x4d" note="Drifttiden som anlæg kører pr. time.&#xD;&#xA; Ved valg af 00:00:00 eller 1 time og derover, vil anlægget kører konstant drift. iht. til valgt trin.&#xD;&#xA;" hour="0" minute="24" second="0" millisecond="0" note-2="Hjælp til &quot;Drift pr. time i ubeboet&quot; på 5.4.01.c: værdier &lt; minimum afvises af controlleren. Ref. 5.4.01.c-IS11."/>
               <resource_timertime id="_0x383b17" name="Timertid efterløb når alarm tilsluttes" backup="yes" icon="_0x4d" note="Timertid for efterløb når alarmen tilsluttes.&#xD;&#xA;Efterløbstiden begynder først når hygostaten skifter til off og alarmen er tilskoblet. Dette sikrer at der efterventileres når huset forlades.&#xD;&#xA;" hour="0" minute="36" second="0" millisecond="0" note-2="Hjælpetekst for &quot;Timertid efterløb når alarm tilsluttes&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.4.01.c-IS12."/>
               <resource_time id="_0x383c0d" name="Skift til normal drift på hverdag kl." backup="yes" icon="_0x2f" note="Tidspunkt for start af ventilation, før man kommer hjem fra arbejde." hour="14" minute="15" second="0" note-2="Bemærk: &quot;Skift til normal drift på hverdag kl.&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.4.01.c-IS13."/>
               <resource_temperature id="_0x383d14" name="Temperatur setpunkt imod frostskader og rørkondens" backup="yes" note="Bør ikke sættes til under 4 °C. ved ventilationsrør på den kolde side af klimaskærmen." inivalue="6.60" note-2="Hjælpetekst: &quot;Temperatur setpunkt imod frostskader og rørkondens&quot; justeres til anlæggets faktiske forhold. Ref. 5.4.01.c-IS14."/>
               <resource_enum id="_0x383e0f" name="Ventilations temperatur ved normaldrift" typedef="_0x37fc47" inivalue="_0x37fd48" backup="yes" icon="_0x22" note="Ønsket temperatur, i normal drift. (Hjemme, dag/aften)" note-2="Bemærk: &quot;Ventilations temperatur ved normaldrift&quot; træder i kraft ved næste programafvikling. Ref. 5.4.01.c-IS15."/>
               <resource_enum id="_0x383f0f" name="Ventilations temperatur ved natdrift" typedef="_0x37fc47" inivalue="_0x380248" backup="yes" icon="_0x22" note="Ønsket temperatur, om natten. (Efter tryk på ?Godnat?)" note-2="Hjælp til &quot;Ventilations temperatur ved natdrift&quot; på 5.4.01.c: værdier &lt; minimum afvises af controlleren. Ref. 5.4.01.c-IS16."/>
               <resource_enum id="_0x38400f" name="Ventilations temperatur ved ude" typedef="_0x37fc47" inivalue="_0x380148" backup="yes" icon="_0x22" note="Ønsket temperatur, når huset forlades. (Alarm tilsluttet eller tryk på sluk alt)" note-2="Hjælpetekst for &quot;Ventilations temperatur ved ude&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.4.01.c-IS17."/>
               <resource_enum id="_0x38410f" name="Ventilations temperatur ved ubeboet" typedef="_0x37fc47" inivalue="_0x380348" backup="yes" icon="_0x22" note="Ønsket temperatur, når huset er i ubeboet tilstand." note-2="Bemærk: &quot;Ventilations temperatur ved ubeboet&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.4.01.c-IS18."/>
               <resource_enum id="_0x38420f" name="Ventilations temperatur ved manuel" typedef="_0x37fc47" inivalue="_0x37fe48" backup="yes" icon="_0x22" note="Ønsket temperatur, i manuel drift. Kræver aktivering af indgang &quot;IHC manuelt styret&quot;" note-2="Hjælpetekst: &quot;Ventilations temperatur ved manuel&quot; justeres til anlæggets faktiske forhold. Ref. 5.4.01.c-IS19."/>
               <resource_timer id="_0x384310" name="Timer drift efterløb" backup="yes" icon="_0x43" note="Kun aktiv hvis &quot;Drift trin ude til hverdag, før tidspunkt&quot; er sat til &quot;Stoppet&quot;&#xD;&#xA;Værdien indstilles under &quot;Drift pr. time i ubeboet Timer for ventilation&quot; Bruges til visning i f.eks. Viewer.&#xD;&#xA;" hour="0" minute="30" second="0" millisecond="0" note-2="Bemærk: &quot;Timer drift efterløb&quot; træder i kraft ved næste programafvikling. Ref. 5.4.01.c-IS20."/>
               <resource_timer id="_0x384410" name="Timer drift ubeboet" backup="yes" icon="_0x43" note="Værdien indstilles under ?Timertid efterløb når alarm tilsluttes?&#xD;&#xA;Ventilations tid som anvendes, når betjeningspanel er sat til &quot;ubeboet&quot;. Anlægget kører på denne tid.&#xD;&#xA;Bruges til visning i f.eks. Viewer.&#xD;&#xA;" hour="0" minute="45" second="0" millisecond="0" note-2="Hjælp til &quot;Timer drift ubeboet&quot; på 5.4.01.c: værdier &lt; minimum afvises af controlleren. Ref. 5.4.01.c-IS21."/>
            </settings>
