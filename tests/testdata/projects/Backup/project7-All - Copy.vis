         <functionblock id="_0x252128" name="4.1.08.a. Betinget Følg/Kip" master_schneider_electric="yes" master_type="4.1.08" master_version="a" master_name="Betinget Følg/Kip" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.1.08.a.  Betinget Følg/Kip&#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Funktionsblok anvendes til at spærre for aktivering af en udgang. &#xD;&#xA;Kan bruges som følg eller kip.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x252823" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x252911" name="Indgang 1 - Permitsignal" icon="_0x36" note="Hvis denne Indgang er &quot;ON&quot; , vil udgangen blive påvirket når &quot;Indgang 2 - Styring af udgang&quot; bliver &quot;ON&quot;.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Indgang 1 - Permitsignal&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 4.1.08.a-IN01."/>
               <resource_input id="_0x252a11" name="Indgang 2 - Styring af udgang" icon="_0x36" note="Udgang følger denne indgang hvis permitsignal er ON.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Indgang 2 - Styring af udgang&quot; i simulering før anlægget sættes i drift. Ref. 4.1.08.a-IN02."/>
            </inputs>
            <outputs id="_0x252b24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x252c12" name="Udgang" icon="_0x39" note="Udgang &quot;Udgang&quot;. Niveau angives i % (0 % = slukket, 100 % = fuld styrke). Ref. 4.1.08.a-UD01." note-2="Vejledning: verificér &quot;Udgang&quot; med en måling på klemmen (230 V AC). Ref. 4.1.08.a-UD01."/>
            </outputs>
            <settings id="_0x252d25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x252e0f" name="Vælg Funktion" typedef="_0x252247" inivalue="_0x252448" icon="_0x22" note="Indstilling &quot;Vælg Funktion&quot; - sættes således at anlægget kører økonomisk. Ref. 4.1.08.a-IS01." note-2="Bemærk: &quot;Vælg Funktion&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 4.1.08.a-IS01."/>
               <resource_enum id="_0x252f0f" name="Indgang 1 - Permitsignal bliver &quot;OFF&quot;" typedef="_0x252547" inivalue="_0x252748" icon="_0x22" note="Indstilling &quot;Indgang 1 - Permitsignal bliver &quot;OFF&quot;&quot; på 4.1.08.a: standardværdien kan overskrives lokalt. Ref. 4.1.08.a-IS02." note-2="Hjælpetekst: &quot;Indgang 1 - Permitsignal bliver &quot;OFF&quot;&quot; justeres til anlæggets faktiske forhold. Ref. 4.1.08.a-IS02."/>
            </settings>
