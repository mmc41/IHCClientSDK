         <functionblock id="_0xd8528" name="1.2.06. Fortrådet lysdæmperstyring" master_schneider_electric="yes" master_type="1.2.06" master_name="Fortrådet lysdæmperstyring" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2016" master_date_year="2017" master_date_month="7" master_date_day="23" locked="yes" icon="_0xe" note="1.2.06. Fortrådet lysdæmperstyring&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til styring af fortrådet lysdæmper ifm. PIR.&#xD;&#xA;Kan anvendes som 1- og/eller 2-tast betjent regulering. &#xD;&#xA;Kan fremkalde/gemme to scenarier.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse; markér overskrift på funktionsblok og tryk F1.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.&#xD;&#xA;">
            <inputs id="_0xda223" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0xda311" name="Touch " icon="_0x36" note="Kort tryk tænd /sluk - langt tryk regulerer lys niveau op/ned &#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Touch&quot; til det tryk der skal betjene funktionen. Ref. 1.2.06-IN01."/>
               <resource_input id="_0xda411" name="Tænd/regulér op" icon="_0x36" note="Kort tryk tænd - langt tryk regulerer lysniveau op&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Tænd/regulér op&quot; bør kun linkes til én indgang ad gangen. Ref. 1.2.06-IN02."/>
               <resource_input id="_0xda511" name="Sluk/regulér ned  " icon="_0x36" note="Kort tryk sluk - langt tryk regulerer lysniveau ned&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Sluk/regulér ned&quot; på 1.2.06: signalet skal være stabilt i &gt; 100 ms. Ref. 1.2.06-IN03."/>
               <resource_input id="_0xda611" name="Høj" icon="_0x36" note="Fremkalder højt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som høj.&#xD;&#xA;Som kvittering blinker udgang samt diode i frontplade.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Høj&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 1.2.06-IN04."/>
               <resource_input id="_0xda711" name="Lav " icon="_0x36" note="Fremkalder lavt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som lav.&#xD;&#xA;Som kvittering blinker udgang samt diode i frontplade.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Lav&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 1.2.06-IN05."/>
               <resource_input id="_0xda811" name="Natdrift" icon="_0x36" note="Ved aktivitet (betingelse opfyldt) vil et kort regulerings tryk tænde lyset på &quot;Lavt niveau&quot;. PIR vil enten være helt eller delvist begrænset.&#xD;&#xA;Sammensættes med urfunktion eller dag og nat funktion.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Natdrift&quot; til det tryk der skal betjene funktionen. Ref. 1.2.06-IN06."/>
               <resource_input id="_0xda911" name="PIR" icon="_0x36" note="Forbindes til tilstedeværelses indikering fra PIR sensor.&#xD;&#xA;Virkemåde defineres under indstilling &quot;# PIR funktion&quot; og &quot;# PIR funktion nat&quot;.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;PIR&quot; bør kun linkes til én indgang ad gangen. Ref. 1.2.06-IN07."/>
               <resource_input id="_0xdaa11" name="Skumring" icon="_0x36" note="Forbindes fra skumringssensor eller luxsensor ifm. funktionsblok 1.1.12&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp til &quot;Skumring&quot; på 1.2.06: signalet skal være stabilt i &gt; 100 ms. Ref. 1.2.06-IN08."/>
               <resource_input id="_0xdab11" name="Spærring" icon="_0x36" note="Når denne indgang er on, vil al automatik være spærret. Dette giver mulighed for total spærring i både tændt og slukket tilstand.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælpetekst for &quot;Spærring&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 1.2.06-IN09."/>
            </inputs>
            <outputs id="_0xdac24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0xdad12" name="Tænd/regulér op" icon="_0x39" note="Forbindes til klemme 1 på 400 UNI IHC/SA.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Hjælp: notér i 1.2.06. Fortrådet lysdæmperstyring hvilke produkter &quot;Tænd/regulér op&quot; betjener. Ref. 1.2.06-UD01."/>
               <resource_output id="_0xdae12" name="Sluk/regulér ned" icon="_0x39" note="Forbindes til klemme 2 på 400 UNI IHC/SA.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Vejledning - &quot;Sluk/regulér ned&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 1.2.06-UD02."/>
               <resource_output id="_0xdaf12" name="Lavt niveau - Memory 1" icon="_0x39" note="Forbindes til klemme 3 på UNI Dimmer 400.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Tip: brug &quot;Lavt niveau - Memory 1&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 1.2.06-UD03."/>
               <resource_output id="_0xdb012" name="Højt niveau - Memory 2" icon="_0x39" note="Forbindes til klemme 4 på 400 UNI IHC/SA.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Note: &quot;Højt niveau - Memory 2&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 1.2.06-UD04."/>
               <resource_enum id="_0xdb10f" name="Lysdæmper status" typedef="_0x60647" inivalue="_0x60848" backup="yes" icon="_0x22" note="Status indikering til Viewer." note-2="Vejledning: verificér &quot;Lysdæmper status&quot; med en måling på klemmen (230 V AC). Ref. 1.2.06-UD05."/>
               <resource_timer id="_0xdb210" name="Efterløb udløber om" icon="_0x43" note="Bemærk:&#xD;&#xA;Hvis efterløb viser 00:00:00,000 er efterløb deaktiveret.&#xD;&#xA;" hour="0" minute="0" second="0" millisecond="0" note-2="Hjælp: notér i 1.2.06. Fortrådet lysdæmperstyring hvilke produkter &quot;Efterløb udløber om&quot; betjener. Ref. 1.2.06-UD06."/>
               <resource_output id="_0xdb312" name="Manuelt betjent " backup="yes" icon="_0x39" note="Visning af overstyring af PIR. &#xD;&#xA;Kan benyttes til diode eller Viewer.&#xD;&#xA;Ifm. manuel sluk vil udgang blinke (default 15 sek.) som kvittéring for spærring af PIR." note-2="Vejledning - &quot;Manuelt betjent&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 1.2.06-UD07."/>
               <resource_output id="_0xdb412" name="Lysdæmper tændt" backup="yes" icon="_0x39" note="Status indikering i diode eller Viewer." note-2="Tip: brug &quot;Lysdæmper tændt&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 1.2.06-UD08."/>
            </outputs>
            <settings id="_0xdb525" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0xdb60f" name="Kort reguleringstryk tænder" typedef="_0x61047" inivalue="_0x61248" backup="yes" icon="_0x22" note="Her er det muligt, at vælge funktionalitet på reguleringstryk dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Højt niveau&#xD;&#xA;Lavt niveau&#xD;&#xA;Sidste niveau" note-2="Dette valg er kun aktivt dag/aften. Om natten (natdrift anvendt) vil et kort reguleringstryk tænde lys på lavt niveau.&#xD;&#xA;Ved frafald af &quot;Natdrift&quot; vil &quot;Højt niveau&quot; fremkaldes første gang der trykkes kort reguleringstryk selvom &quot;Sidste niveau&quot; er valgt. Dette er valgt fordi ny dag er kommet og gl. niveau ikke er relevant mere. "/>
               <resource_enum id="_0xdb70f" name="Manuel betjening" typedef="_0x9e047" inivalue="_0x9e348" backup="yes" icon="_0x22" note="Ved &quot;Starter efterløb&quot; vil lys slukke på efterløb dag/aften efter sidste påvirking af PIR eller manuel betjening.&#xD;&#xA;Ved &quot;Starter ekstra efterløb til sluk&quot; vil lys slukke på ekstra efterløb til sluk efter sidste påvirking af PIR eller betjeningstryk.&#xD;&#xA;Ved &quot;Spærrer efterløb&quot; vil lys ikke slukke ved skumringsfrafald når manuel betjening er aktiv." note-2="Hjælp: værdien for &quot;Manuel betjening&quot; i 1.2.06. Fortrådet lysdæmperstyring bør gennemgås ved service. Ref. 1.2.06-IS02."/>
               <resource_enum id="_0xdb80f" name="PIR funktion " typedef="_0x9d547" inivalue="_0x9d948" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Trin høj/sluk&#xD;&#xA;Trin høj/lav&#xD;&#xA;Trin høj/lav/sluk&#xD;&#xA;Trin høj/lav/+ekstra efterløb til sluk&#xD;&#xA;Trin lav/sluk&#xD;&#xA;Dag/aften slukkes kun lys" note-2="Vejledning - &quot;PIR funktion&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 1.2.06-IS03."/>
               <resource_enum id="_0xdb90f" name="PIR funktion nat" typedef="_0x9e447" inivalue="_0x9e648" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have om natten.&#xD;&#xA;Natdrift indgangen skal benyttes for at opnå funktion.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Trin lav/sluk&quot; kan benyttes til alle rum - dog ikke soverum.&#xD;&#xA;&quot;Kun efterløb&quot; benyttes til soverum og andre rum der ønskes undtaget." note-2="Tip: notér den valgte værdi for &quot;PIR funktion nat&quot; i anlægsdokumentationen. Ref. 1.2.06-IS04."/>
               <resource_timertime id="_0xdba17" name="Efterløb dag/aften" backup="yes" icon="_0x4d" note="Her indstilles efterløbstiden for dag/aften." hour="0" minute="2" second="25" millisecond="0" note-2="Note: &quot;Efterløb dag/aften&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 1.2.06-IS05."/>
               <resource_timertime id="_0xdbb17" name="Efterløb nat" backup="yes" icon="_0x4d" note="Her indstilles efterløbstiden for natdrift." hour="0" minute="1" second="10" millisecond="0" note-2="Vejledning: afprøv &quot;Efterløb nat&quot; i simulering før anlægget overdrages. Ref. 1.2.06-IS06."/>
               <resource_timertime id="_0xdbc17" name="Ekstra efterløb til sluk " backup="yes" icon="_0x4d" note="Her indstilles ekstra efterløbstid.&#xD;&#xA;Benyttes ifm. disse valg:&#xD;&#xA;&quot;PIR funktion = Trin høj/lav/+ekstra efterløb til sluk&quot; &#xD;&#xA;&quot;Manuel betjening = Aktivt ekstra efterløb til sluk&quot;&#xD;&#xA;Efter sidste påvirking af PIR eller betjeningstryk vil lys afhængig af opsætning slukke med den valgte initial værdi." hour="1" minute="48" second="0" millisecond="0" note-2="Hjælp: værdien for &quot;Ekstra efterløb til sluk&quot; i 1.2.06. Fortrådet lysdæmperstyring bør gennemgås ved service. Ref. 1.2.06-IS07."/>
            </settings>
