               <resource_timer id="_0x1ebc10" name="Timer for nedkørsel" icon="_0x43" note="Tiden skal være lidt længere end tiden det tager persiennen at køre ned." hour="0" minute="0" second="14" millisecond="0" note-2="Hjælpetekst for &quot;Timer for nedkørsel&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 3.1.02-IS03."/>
               <resource_timer id="_0x1ebd10" name="Timer for step" icon="_0x43" note="Den tid persienne skal steppes for at justere lameller." hour="0" minute="5" second="0" millisecond="300" note-2="Bemærk: &quot;Timer for step&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 3.1.02-IS04."/>
               <resource_time id="_0x1ebe0d" name="Tidspunkt for afstilling af manuel" backup="yes" icon="_0x2f" note="Indstilling &quot;Tidspunkt for afstilling af manuel&quot; for 3.1.02. Kontrollér værdien efter opdatering af projektet. Ref. 3.1.02-IS05." hour="22" minute="30" second="0" note-2="Hjælpetekst: &quot;Tidspunkt for afstilling af manuel&quot; justeres til anlæggets faktiske forhold. Ref. 3.1.02-IS05."/>
