         </functionblock>
         <functionblock id="_0x12e428" name="1.3.06. Ventilatorstyring - PIR" master_schneider_electric="yes" master_type="1.3.06" master_name="Ventilatorstyring - PIR" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="1.3.06. Ventilatorstyring - PIR&#xD;&#xA;&#xD;&#xA;Anvendes, hvor der ønskes ventilation i lokalet.&#xD;&#xA;Har mulighed for kort og lang efterløbs tid.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x12e823" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x12e911" name="Indgang for tryk" icon="_0x36" note="Tænd / Sluk Ventilator&#xD;&#xA;1 tryk - Tænder Ventilator i 3 minutter efter pir sidst er påvirket&#xD;&#xA;2 tryk - Tænder Ventilator i 10 minutter efter pir sidst er påvirket&#xD;&#xA;Langt tryk &gt; 1.5 sek Tænder Ventilator konstant.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Indgang for tryk&quot; på 1.3.06: signalet skal være stabilt i &gt; 100 ms. Ref. 1.3.06-IN01."/>
               <resource_input id="_0x12ea11" name="Sluk" icon="_0x36" note="Slukker Ventilator&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Sluk&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 1.3.06-IN02."/>
               <resource_input id="_0x12eb11" name="PIR" icon="_0x36" note="Indgang for PIR&#xD;&#xA;Forlænger timer for Ventilator&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;PIR&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 1.3.06-IN03."/>
            </inputs>
            <outputs id="_0x12ec24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x12ed12" name="Ventilator" icon="_0x39" note="Udgang til Ventilator" note-2="Vejledning: verificér &quot;Ventilator&quot; med en måling på klemmen (230 V AC). Ref. 1.3.06-UD01."/>
               <resource_output id="_0x12ee12" name="Diode" icon="_0x39" note="Diode for Ventilator&#xD;&#xA;1 Blink - Ventilator i 3 minutter efter pir sidst er påvirket&#xD;&#xA;2 Blink - Ventilator i 10 minutter efter pir sidst er påvirket&#xD;&#xA;Lyser konstant - Ventilator køre konstant." note-2="Hjælp: notér i 1.3.06. Ventilatorstyring - PIR hvilke produkter &quot;Diode&quot; betjener. Ref. 1.3.06-UD02."/>
               <resource_timer id="_0x12ef10" name="Ventilator slukker om :" icon="_0x43" note="Nedtælling for Ventilator" hour="0" minute="0" second="0" millisecond="0" note-2="Vejledning - &quot;Ventilator slukker om :&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 1.3.06-UD03."/>
            </outputs>
            <settings id="_0x12f025" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x12f110" name="Efterløbs timer Kort" backup="yes" icon="_0x43" note="Denne timer påvirkes ved 1 tryk" hour="0" minute="2" second="15" millisecond="0" note-2="Hjælpetekst: &quot;Efterløbs timer Kort&quot; justeres til anlæggets faktiske forhold. Ref. 1.3.06-IS01."/>
               <resource_timer id="_0x12f210" name="Efterløbs timer Langt" backup="yes" icon="_0x43" note="Denne timer påvirkes ved 2 tryk" hour="0" minute="11" second="0" millisecond="0" note-2="Bemærk: &quot;Efterløbs timer Langt&quot; træder i kraft ved næste programafvikling. Ref. 1.3.06-IS02."/>
               <resource_enum id="_0x12f30f" name="Pir Type" typedef="_0x12e547" inivalue="_0x12e748" icon="_0x22" note="Vælg hvilken pir der er tilsluttet til blokken &#xD;&#xA;Vælg mellem Lys-pir og Alarm-pir" note-2="Hjælp til &quot;Pir Type&quot; på 1.3.06: værdier &lt; minimum afvises af controlleren. Ref. 1.3.06-IS03."/>
            </settings>
            <internalsettings id="_0x12f429" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x12f510" name="Tryk-Timer" icon="_0x43" hour="0" minute="0" second="1" millisecond="500"/>
               <resource_timer id="_0x12f610" name="BlinkTimer" icon="_0x43" hour="0" minute="0" second="0" millisecond="500"/>
               <resource_flag id="_0x12f70a" name="Flag" icon="_0x33"/>
               <resource_integer id="_0x12f80b" name="Heltal"/>
               <resource_integer id="_0x12f90b" name="Fb Ver." note="Made by Schneider Electric - Claus Jørgensen" inivalue="6" udf="#IS11#"/>
            </internalsettings>
