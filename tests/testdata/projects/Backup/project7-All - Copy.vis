         <functionblock id="_0x1e9528" name="3.1.02. Jalousistyring" master_schneider_electric="yes" master_type="3.1.02" master_name="Jalousistyring" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="3.1.02. Jalousistyring &#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til styring af jalousi med tryk for op eller ned og div. aktuatorer (vindmåler, skumringsrelæ, solsensor m.m.)&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x1ea823" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x1ea911" name="Alarm hæv" icon="_0x36" note="Indgang har højeste prioritet.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Alarm hæv&quot; i simulering før anlægget sættes i drift. Ref. 3.1.02-IN01."/>
               <resource_input id="_0x1eaa11" name="Alarm sænk" icon="_0x36" note="Indgang har anden højeste prioritet.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Alarm sænk&quot; er linket til i 3.1.02. Jalousistyring. Ref. 3.1.02-IN02."/>
               <resource_input id="_0x1eab11" name="Gruppebetjeningstryk hæv" icon="_0x36" note="Hæv jalousi - Ved lang aktivering (&gt;1 sek.) hæves persienne. Ved kort aktivering (&lt;1 sek.) justeres persienne.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Gruppebetjeningstryk hæv&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 3.1.02-IN03."/>
               <resource_input id="_0x1eac11" name="Gruppebetjeningstryk sænk" icon="_0x36" note="Sænk jalousi - Ved lang aktivering (&gt;1 sek.) sænkes persienne. Ved kort aktivering (&lt;1 sek.) justeres persienne.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Gruppebetjeningstryk sænk&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 3.1.02-IN04."/>
               <resource_input id="_0x1ead11" name="Lokalbetjeningstryk hæv" icon="_0x36" note="Hæv jalousi - Ved lang aktivering (&gt;1 sek.) hæves persienne. Ved kort aktivering (&lt;1 sek.) justeres persienne.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Lokalbetjeningstryk hæv&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 3.1.02-IN05."/>
               <resource_input id="_0x1eae11" name="Lokalbetjeningstryk sænk" icon="_0x36" note="Sænk jalousi - Ved lang aktivering (&gt;1 sek.) sænkes persienne. Ved kort aktivering (&lt;1 sek.) justeres persienne.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Lokalbetjeningstryk sænk&quot; i simulering før anlægget sættes i drift. Ref. 3.1.02-IN06."/>
               <resource_input id="_0x1eaf11" name="Vindmåler" icon="_0x36" note="Ved aktivering hæves.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Vindmåler&quot; er linket til i 3.1.02. Jalousistyring. Ref. 3.1.02-IN07."/>
               <resource_input id="_0x1eb011" name="Skumringsrelæ" icon="_0x36" note="Ved on sænkes for at spare på varmen.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Skumringsrelæ&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 3.1.02-IN08."/>
               <resource_input id="_0x1eb111" name="Ur for lukketid" icon="_0x36" note="I on perioden sænkes (f.eks. efter lukketid).&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Ur for lukketid&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 3.1.02-IN09."/>
               <resource_input id="_0x1eb211" name="Solsensor" icon="_0x36" note="Ved on sænkes et stykke ned.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Solsensor&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 3.1.02-IN10."/>
               <resource_input id="_0x1eb311" name="Man/auto" icon="_0x36" note="Man/auto - Ved manuel tilstand ignoreres skumringsrelæ, ur og solsensor.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Man/auto&quot; i simulering før anlægget sættes i drift. Ref. 3.1.02-IN11."/>
               <resource_input id="_0x1eb411" name="Tillad trykfunktion" icon="_0x36" note="Lås manuel betjening - Det er ikke muligt at betjene persienne hvis off.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp: dokumentér hvilket produkt &quot;Tillad trykfunktion&quot; er linket til i 3.1.02. Jalousistyring. Ref. 3.1.02-IN12."/>
            </inputs>
