                              <resource_light_level id="_0x5cd13" name="Lys niveau"/>
                           </action>
                           <action id="_0x5ceca" name="Stands tælling på %P" icon="_0x9" note="Standser evt. igangværende optælling eller nedtælling på %P" link1="_0x5b710" method="_0xdc"/>
