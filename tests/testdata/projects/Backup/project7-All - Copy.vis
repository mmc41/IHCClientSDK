                           <action id="_0x5c5ca" name="Aktiver nedtælling på %P" icon="_0x9" note="Aktiver nedtælling på %P" link1="_0x5b710" method="_0xd2"/>
                           <action id="_0x5c6ca" name="%P = %S" icon="_0x9" note="Sætter %P til samme værdi som %S" link1="_0x5b213" link2="_0x5b513" method="_0x1e"/>
