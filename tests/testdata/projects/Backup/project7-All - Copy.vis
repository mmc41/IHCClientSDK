               <resource_input id="_0x239611" name="Indgang 10" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Indgang 10&quot; til det tryk der skal betjene funktionen. Ref. 4.1.02-IN10."/>
            </inputs>
