         <functionblock id="_0x23d428" name="4.1.03.a. Forsinket tiltræk/frafald" master_schneider_electric="yes" master_type="4.1.03" master_version="a" master_name="Forsinket tiltræk/frafald" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.1.03.a. Forsinket tiltræk/frafald&#xD;&#xA;&#xD;&#xA;Til at forsinke ind- og udkobling af div. elementer (f.eks. solsensor, skumringsrelæ osv.). &#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x23d523" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x23d611" name="Indgang" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Indgang&quot; i simulering før anlægget sættes i drift. Ref. 4.1.03.a-IN01.">
