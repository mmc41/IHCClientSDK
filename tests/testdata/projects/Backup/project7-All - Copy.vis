      <group id="_0x110a32" name="FB 1.3 Lys og ventilation" icon="_0x15" note="locNote 1022">
         <functionblock id="_0x110b28" name="1.3.01.c. Ventilatorstyring " master_schneider_electric="yes" master_type="1.3.01" master_version="c" master_name="Ventilatorstyring " master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="1.3.01.c. Ventilatorstyring - 3 indstillings muligheder&#xD;&#xA;&#xD;&#xA;Anvendes, hvor der ønskes ventilation der styres sammen med lyset &#xD;&#xA;kan brugse sammen med relæ eller lysdæmper.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x111023" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x111111" name="Tilbagemelding fra Lys" icon="_0x36" note="Forbindes til lys i rum" note-2="Hjælpetekst for &quot;Tilbagemelding fra Lys&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 1.3.01.c-IN01."/>
               <resource_input id="_0x111211" name="Kip - ventilator" icon="_0x36" note="Manual tænd og sluk af ventilation&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Kip - ventilator&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 1.3.01.c-IN02."/>
               <resource_input id="_0x111311" name="Tænd" icon="_0x36" note="Manual tænd af Ventilation, slukker på efterløb, er Ventilation tændt, forlænges tiden.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Tænd&quot; til det tryk der skal betjene funktionen. Ref. 1.3.01.c-IN03."/>
               <resource_input id="_0x111411" name="Sluk" icon="_0x36" note="Manual Sluk af ventilation&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Sluk&quot; bør kun linkes til én indgang ad gangen. Ref. 1.3.01.c-IN04."/>
            </inputs>
            <outputs id="_0x111524" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x111612" name="Udgang for ventilator" icon="_0x39" note="Udgang &quot;Udgang for ventilator&quot; fra funktionsblok 1.3.01.c. Forbindes til lampeudtag eller relæ. Ref. 1.3.01.c-UD01." note-2="Hjælpetekst: &quot;Udgang for ventilator&quot; forbindes til det produkt der skal styres. Ref. 1.3.01.c-UD01."/>
            </outputs>
            <settings id="_0x111725" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x111810" name="Set Efterløb for ventilator" backup="yes" icon="_0x43" note="Indstille hvor længe ventilatoren skal køre efter lyset er slukket.&#xD;&#xA;Virker under alle 3 tilstande for ventilation. &#xD;&#xA;3 min. (default)" hour="0" minute="3" second="55" millisecond="0" note-2="Vejledning - &quot;Set Efterløb for ventilator&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 1.3.01.c-IS01."/>
               <resource_timer id="_0x111910" name="Set &quot;ventilator skal starte efter X.min&quot;" backup="yes" icon="_0x43" note="Denne betingelse er KUN aktiv under Tilstand - &#xD;&#xA;&quot;3. Ventilator starter først når lyset har været tændt i X min - slukker på timer&quot;&#xD;&#xA;5 min. (default)" hour="0" minute="5" second="30" millisecond="0" note-2="Tip: notér den valgte værdi for &quot;Set &quot;ventilator skal starte efter X.min&quot;&quot; i anlægsdokumentationen. Ref. 1.3.01.c-IS02."/>
               <resource_enum id="_0x111a0f" name="Tilstand for ventilator" typedef="_0x110c47" inivalue="_0x110e48" backup="yes" icon="_0x22" note="Setpunkt &quot;Tilstand for ventilator&quot; på 1.3.01.c. Ventilatorstyring. Værdien gemmes i controllerens projektfil. Ref. 1.3.01.c-IS03." note-2="Note: &quot;Tilstand for ventilator&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 1.3.01.c-IS03."/>
               <resource_timer id="_0x111b10" name="Lys tændt - Timer" icon="_0x43" note="Indstilling &quot;Lys tændt - Timer&quot;: gyldigt område iht. produktdatabladets &quot;Tekniske data&quot;. Ref. 1.3.01.c-IS04." hour="0" minute="0" second="5" millisecond="0" note-2="Vejledning: afprøv &quot;Lys tændt - Timer&quot; i simulering før anlægget overdrages. Ref. 1.3.01.c-IS04."/>
            </settings>
            <internalsettings id="_0x111c29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x111d10" name="Timer" icon="_0x43" hour="0" minute="0" second="1" millisecond="0"/>
            </internalsettings>
