         <functionblock id="_0x365c28" name="5.3.02. Log af temperatur" master_schneider_electric="yes" master_type="5.3.02" master_name="Log af temperatur" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="5.3.02. Log af temperatur&#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Til at logge hver gang temperaturen ændre sig.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x366323" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_temperature id="_0x366414" name="Temperatur ind. 1." note="Indgang &quot;Temperatur ind. 1.&quot; til 5.3.02. Log af temperatur. Skal linkes til et fysisk produkt før idriftsættelse. Ref. 5.3.02-IN01." note-2="Bemærk: &quot;Temperatur ind. 1.&quot; bør kun linkes til én indgang ad gangen. Ref. 5.3.02-IN01.">
                  <link_to_resource id="_0x4a1a2c" name="Følg Link" icon="_0x4a" link="_0x4a192d"/>
               </resource_temperature>
               <resource_temperature id="_0x366514" name="Temperatur ind. 2." note="Signalindgang &quot;Temperatur ind. 2.&quot;. Potentialfri kontakt, maks. 230 V AC &amp; 10 A. Ref. 5.3.02-IN02." note-2="Hjælp til &quot;Temperatur ind. 2.&quot; på 5.3.02: signalet skal være stabilt i &gt; 100 ms. Ref. 5.3.02-IN02.">
                  <link_to_resource id="_0x4a1c2c" name="Følg Link" icon="_0x4a" link="_0x4a1b2d"/>
               </resource_temperature>
               <resource_temperature id="_0x366614" name="Temperatur ind. 3." note="Indgang &quot;Temperatur ind. 3.&quot;: aktiv når signalet skifter til ON (&gt; 50 % af nominelt niveau). Ref. 5.3.02-IN03." note-2="Hjælpetekst for &quot;Temperatur ind. 3.&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 5.3.02-IN03."/>
               <resource_temperature id="_0x366714" name="Temperatur ind. 4." note="Indgang &quot;Temperatur ind. 4.&quot; - anvendes ved manuel betjening af anlægget.&#xD;&#xA;Ref. 5.3.02-IN04." note-2="Bemærk: &quot;Temperatur ind. 4.&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.3.02-IN04.">
                  <link_to_resource id="_0x4a2e2c" name="Følg Link" icon="_0x4a" link="_0x4a2d2d"/>
               </resource_temperature>
               <resource_temperature id="_0x366814" name="Temperatur ind. 5." note="Betjeningsindgang &quot;Temperatur ind. 5.&quot; på 5.3.02. Kobles til trykket i lokaliteten. Ref. 5.3.02-IN05." note-2="Hjælpetekst: forbind &quot;Temperatur ind. 5.&quot; til det tryk der skal betjene funktionen. Ref. 5.3.02-IN05."/>
            </inputs>
            <outputs id="_0x366924" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_temperature id="_0x366a14" name="Temperatur 1." note="Udgang &quot;Temperatur 1.&quot;. Niveau angives i % (0 % = slukket, 100 % = fuld styrke). Ref. 5.3.02-UD01." note-2="Vejledning: verificér &quot;Temperatur 1.&quot; med en måling på klemmen (230 V AC). Ref. 5.3.02-UD01."/>
               <resource_time id="_0x366b0d" name="Tidspunkt 1." icon="_0x2f" note="Udgang &quot;Tidspunkt 1.&quot; fra 5.3.02 - forbindes til udgangsmodulet på datalinjen. Ref. 5.3.02-UD02." hour="0" minute="0" second="0" note-2="Hjælp: notér i 5.3.02. Log af temperatur hvilke produkter &quot;Tidspunkt 1.&quot; betjener. Ref. 5.3.02-UD02."/>
               <resource_temperature id="_0x366c14" name="Temperatur 2." note="Udgang &quot;Temperatur 2.&quot;: aktiv så længe betingelserne i blokken er opfyldt. Ref. 5.3.02-UD03." note-2="Vejledning - &quot;Temperatur 2.&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 5.3.02-UD03."/>
               <resource_time id="_0x366d0d" name="Tidspunkt 2." icon="_0x2f" note="Udgang &quot;Tidspunkt 2.&quot; fra funktionsblok 5.3.02. Forbindes til lampeudtag eller relæ. Ref. 5.3.02-UD04." hour="0" minute="0" second="0" note-2="Tip: brug &quot;Tidspunkt 2.&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.3.02-UD04."/>
               <resource_temperature id="_0x366e14" name="Temperatur 3." note="Udgang &quot;Temperatur 3.&quot; - styrer det tilkoblede produkt.&#xD;&#xA;Udfyldes af installatøren. Ref. 5.3.02-UD05." note-2="Note: &quot;Temperatur 3.&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.3.02-UD05."/>
               <resource_time id="_0x366f0d" name="Tidspunkt 3." icon="_0x2f" note="Statusudgang &quot;Tidspunkt 3.&quot;. Anvendes til visning på grafisk brugerflade. Ref. 5.3.02-UD06." hour="0" minute="0" second="0" note-2="Vejledning: verificér &quot;Tidspunkt 3.&quot; med en måling på klemmen (230 V AC). Ref. 5.3.02-UD06."/>
