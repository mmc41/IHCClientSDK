      <group id="_0x349b32" name="FB 5.3 Klima Indregulering" icon="_0x15" note="locNote 1030">
         <functionblock id="_0x349c28" name="5.3.01. Log af Temperatur i 24 timer" master_schneider_electric="yes" master_type="5.3.01" master_name="Log af Temperatur i 24 timer" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="5.3.01. Log af Temperatur i 24 timer&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til at logge en temperatur over 24 timer &#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x34a023" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_temperature id="_0x34a114" name="Temperatur - in" note="Indgang &quot;Temperatur - in&quot; på funktionsblok 5.3.01. Forbindes til betjeningstryk i lokaliteten. Ref. 5.3.01-IN01." inivalue="21.00" note-2="Hjælpetekst: forbind &quot;Temperatur - in&quot; til det tryk der skal betjene funktionen. Ref. 5.3.01-IN01."/>
               <resource_input id="_0x34a211" name="Betingelse" icon="_0x36" note="Hvis denne &quot;betingelse&quot; er &quot;OFF&quot; vil der ikke blive logget&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;Betingelse&quot; bør kun linkes til én indgang ad gangen. Ref. 5.3.01-IN02."/>
               <resource_input id="_0x34a311" name="Reset" icon="_0x36" note="Denne indgang skal være &quot;ON&quot; i mere en 1 sek. før blokken resettes.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Reset&quot; på 5.3.01: signalet skal være stabilt i &gt; 100 ms. Ref. 5.3.01-IN03."/>
            </inputs>
            <outputs id="_0x34a424" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_temperature id="_0x34a514" name="Sidste Temperatur" backup="yes" note="Her vises den sidste loggede værdi&#xD;&#xA;" note-2="Tip: brug &quot;Sidste Temperatur&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.3.01-UD01."/>
               <resource_time id="_0x34a60d" name="Sidst logget kl." icon="_0x2f" note="Udgang &quot;Sidst logget kl.&quot;: pulser kortvarigt (&lt; 500 ms) ved tilstandsskift. Ref. 5.3.01-UD02." hour="0" minute="0" second="0" note-2="Note: &quot;Sidst logget kl.&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.3.01-UD02."/>
               <resource_date id="_0x34a70e" name="Sidst logget Dato" icon="_0x29" note="Udgang &quot;Sidst logget Dato&quot; - kan viderekobles til andre funktionsblokke &amp; scenarier. Ref. 5.3.01-UD03." year="2000" month="1" day="1" note-2="Vejledning: verificér &quot;Sidst logget Dato&quot; med en måling på klemmen (230 V AC). Ref. 5.3.01-UD03."/>
               <resource_temperature id="_0x34a814" name="Temperatur kl. 01" backup="yes" note="Udgang &quot;Temperatur kl. 01&quot; på 5.3.01. Følger blokkens aktuelle driftstilstand. Ref. 5.3.01-UD04." note-2="Hjælp: notér i 5.3.01. Log af Temperatur i 24 timer hvilke produkter &quot;Temperatur kl. 01&quot; betjener. Ref. 5.3.01-UD04."/>
