         </functionblock>
         <functionblock id="_0x340428" name="5.2.06. Varmestyring - simpel" master_schneider_electric="yes" master_type="5.2.06" master_name="Varmestyring - simpel" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="Varmestyring - simpel&#xD;&#xA;&#xD;&#xA;Temperatur styret med ur on/off og drifttilstanden (beboet, ubeboet eller frostsikring)&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse mærker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.&#xD;&#xA;" udf="#5.2.05#">
            <inputs id="_0x340c23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_temperature id="_0x340d14" name="Rumtemperatur ind" note="Forbindes til udgangen rumtemperatur på termostaten. &#xD;&#xA;Viser den aktuelle temperatur i rummet.&#xD;&#xA;" inivalue="21.00" note-2="Vejledning: test &quot;Rumtemperatur ind&quot; i simulering før anlægget sættes i drift. Ref. 5.2.06-IN01." udf="#I01#">
                  <link_to_resource id="_0x4a0a2c" name="Følg Link" icon="_0x4a" link="_0x4a092d"/>
               </resource_temperature>
               <resource_input id="_0x340e11" name="Alarm - Sensorfejl " icon="_0x36" note="Forbindes til Alarm på termostaten.&#xD;&#xA;On hvis der er fejl i kommunikation med temperatursensor. &#xD;&#xA;Opvarmningen afbrydes og udgangen sensorfejl skifter til on.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælp: dokumentér hvilket produkt &quot;Alarm - Sensorfejl&quot; er linket til i 5.2.06. Varmestyring - simpel. Ref. 5.2.06-IN02.">
                  <link_to_resource id="_0x4a0c2c" name="Følg Link" icon="_0x4a" link="_0x4a0b2d"/>
               </resource_input>
               <resource_input id="_0x340f11" name="Ur" backup="yes" icon="_0x36" note="Bruges til at skifte temperatur i beboet tilstand. Urindgangen har ingen funktion ved ubeboet eller forstsikring. Denne indgang kan anvendes til dag eller natsænkning - evt. begge dele hvis samme temperatur ønskes. Forbindes til ur-funktionsblok, f.eks 5.2.04&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Ur&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 5.2.06-IN03."/>
               <resource_enum id="_0x34100f" name="Driftform" typedef="_0x2d2247" inivalue="_0x2d2348" icon="_0x22" note="Skal forbindes til funktionsblok 5.2.01 udgang - driftform. &#xD;&#xA;Styrer driftform og viser hvilken tilstand der er aktiv." note-2="Tip: lad &quot;Driftform&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 5.2.06-IN04."/>
            </inputs>
            <outputs id="_0x341124" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x341212" name="Telestat / Varme" icon="_0x39" note="Forbindes til telestat, elektrisk opvarmning eller relæ.&#xD;&#xA;" note-2="Vejledning - &quot;Telestat / Varme&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 5.2.06-UD01.">
                  <link_from_resource id="_0x4a0d2d" name="Følg Link" icon="_0x47" link="_0x4a0e2c"/>
               </resource_output>
               <resource_temperature id="_0x341314" name="Aktuelt setpunkt" note="Viser det aktuelle/aktive  setpunkt." note-2="Tip: brug &quot;Aktuelt setpunkt&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.2.06-UD02.">
                  <link_from_resource id="_0x4a2d2d" name="Følg Link" icon="_0x47" link="_0x4a2e2c"/>
               </resource_temperature>
            </outputs>
            <settings id="_0x341425" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_temperature id="_0x341514" name="Setpunkt ur off" backup="yes" note="Temperatur der styres efter når urindgang er off" inivalue="24.80" note-2="Tip: notér den valgte værdi for &quot;Setpunkt ur off&quot; i anlægsdokumentationen. Ref. 5.2.06-IS01." udf="#SS01#"/>
               <resource_temperature id="_0x341614" name="Setpunkt ur on" backup="yes" note="Temperatur der styres efter når urindgang er on." inivalue="18.00" note-2="Note: &quot;Setpunkt ur on&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 5.2.06-IS02."/>
               <resource_temperature id="_0x341714" name="Setpunkt ubeboet" note="Ønsket rumtemperatur hele døgnet når huset er ubeboet - f.eks. når man er på ferie. Kan indstilles fra 10 - 25 gr.&#xD;&#xA;Er kun aktiv når betjeningspanel (FB 5.2.04) er i ubeboet." inivalue="12.00" note-2="Vejledning: afprøv &quot;Setpunkt ubeboet&quot; i simulering før anlægget overdrages. Ref. 5.2.06-IS03."/>
               <resource_temperature id="_0x341814" name="Setpunkt frostsikring" note="Ønsket rumtemperatur hele døgnet når huset er frostbeskyttet - f.eks. når huset er fraflyttet. Kan indstilles fra 0,5 - 15 gr.&#xD;&#xA;Er kun aktiv når betjeningspanel (FB 5.2.04) er i frost drift.&#xD;&#xA;Anvendes til at forebygge evt. skade på rum/gulv" inivalue="4.50" note-2="Hjælp: værdien for &quot;Setpunkt frostsikring&quot; i 5.2.06. Varmestyring - simpel bør gennemgås ved service. Ref. 5.2.06-IS04."/>
               <resource_timertime id="_0x341917" name="Timertid pulsvarme on" backup="yes" icon="_0x4d" note="Den tid der varmes på gulvet når temperaturen er inde for hystereseområdet.&#xD;&#xA;" hour="0" minute="6" second="15" millisecond="0" note-2="Vejledning - &quot;Timertid pulsvarme on&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 5.2.06-IS05."/>
               <resource_timertime id="_0x341a17" name="Timertid pulsvarme pause" backup="yes" icon="_0x4d" note="Den tid der ikke varmes på gulvet når temperaturen er inde for hystereseområdet." hour="0" minute="18" second="0" millisecond="0" note-2="Tip: notér den valgte værdi for &quot;Timertid pulsvarme pause&quot; i anlægsdokumentationen. Ref. 5.2.06-IS06."/>
               <resource_temperature id="_0x341b14" name="Hysterese" note="Indstilling af temperaturudsving (hysterese) i forhold til aktivt setpunkt.&#xD;&#xA;Pulsvarmen er aktiv når temperatur er inden for hysteresen (aktivt setpunkt +/- hysterese)." inivalue="0.40" note-2="Note: &quot;Hysterese&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 5.2.06-IS07."/>
            </settings>
            <internalsettings id="_0x341c29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_temperature id="_0x341d14" name="Temperatur hys +"/>
               <resource_temperature id="_0x341e14" name="Temperatur hys -"/>
               <resource_timer id="_0x341f10" name="Timer pulsvarme" icon="_0x43" hour="0" minute="0" second="0" millisecond="0"/>
            </internalsettings>
