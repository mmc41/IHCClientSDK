         <functionblock id="_0x29ea28" name="4.2.03.b. Pulsopsamling" master_schneider_electric="yes" master_type="4.2.03" master_version="b" master_name="Pulsopsamling" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.2.03.b. Pulsopsamling&#xD;&#xA;&#xD;&#xA;Anvendes:&#xD;&#xA;Bruges til at tælle pulser fra f.eks en bimåler eller vandmåler &#xD;&#xA;og gemme resultatet i op til 12 måneder&#xD;&#xA; &#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x29eb23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x29ec11" name="Puls indgang" icon="_0x36" note="Puls længde skal være &gt; 50 ms" note-2="Bemærk: &quot;Puls indgang&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 4.2.03.b-IN01."/>
               <resource_input id="_0x29ed11" name="Reset" icon="_0x36" note="Ved et langt tryk &gt; 3 sek. resettes &quot;Måned til dato&quot; samt. &quot;Jan-Dec&quot;" note-2="Hjælpetekst: forbind &quot;Reset&quot; til det tryk der skal betjene funktionen. Ref. 4.2.03.b-IN02."/>
            </inputs>
            <outputs id="_0x29ee24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_date id="_0x29ef0e" name="Dags Dato" icon="_0x29" note="Viser dags dato." year="2000" month="1" day="1" note-2="Hjælpetekst: &quot;Dags Dato&quot; forbindes til det produkt der skal styres. Ref. 4.2.03.b-UD01."/>
               <resource_integer id="_0x29f00b" name="Måler Display" backup="yes" note="Viser aktuel måler visning." note-2="Bemærk: &quot;Måler Display&quot; kan linkes til flere produkter samtidigt. Ref. 4.2.03.b-UD02."/>
               <resource_integer id="_0x29f10b" name="Måned til dato" backup="yes" note="Forbrug i indeværende måned." note-2="Hjælp til &quot;Måned til dato&quot; på 4.2.03.b: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 4.2.03.b-UD03."/>
               <resource_integer id="_0x29f20b" name="Januar" backup="yes" note="Forbrug i Januar måned." note-2="Hjælpetekst for &quot;Januar&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 4.2.03.b-UD04."/>
               <resource_integer id="_0x29f30b" name="Februar" backup="yes" note="Forbrug i Februar måned." note-2="Bemærk: &quot;Februar&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 4.2.03.b-UD05."/>
               <resource_integer id="_0x29f40b" name="Marts" backup="yes" note="Forbrug i Marst måned." note-2="Hjælpetekst: &quot;Marts&quot; forbindes til det produkt der skal styres. Ref. 4.2.03.b-UD06."/>
               <resource_integer id="_0x29f50b" name="April" backup="yes" note="Forbrug i April måned." note-2="Bemærk: &quot;April&quot; kan linkes til flere produkter samtidigt. Ref. 4.2.03.b-UD07."/>
               <resource_integer id="_0x29f60b" name="Maj" backup="yes" note="Forbrug i Maj måned." note-2="Hjælp til &quot;Maj&quot; på 4.2.03.b: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 4.2.03.b-UD08."/>
               <resource_integer id="_0x29f70b" name="Juni" backup="yes" note="Forbrug i Juni måned." note-2="Hjælpetekst for &quot;Juni&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 4.2.03.b-UD09."/>
               <resource_integer id="_0x29f80b" name="Juli" backup="yes" note="Forbrug i Juli måned." note-2="Bemærk: &quot;Juli&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 4.2.03.b-UD10."/>
               <resource_integer id="_0x29f90b" name="August" backup="yes" note="Forbrug i August måned." note-2="Hjælpetekst: &quot;August&quot; forbindes til det produkt der skal styres. Ref. 4.2.03.b-UD11."/>
               <resource_integer id="_0x29fa0b" name="September" backup="yes" note="Forbrug i September måned." note-2="Bemærk: &quot;September&quot; kan linkes til flere produkter samtidigt. Ref. 4.2.03.b-UD12."/>
               <resource_integer id="_0x29fb0b" name="Oktober" backup="yes" note="Forbrug i Oktober måned." note-2="Hjælp til &quot;Oktober&quot; på 4.2.03.b: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 4.2.03.b-UD13."/>
               <resource_integer id="_0x29fc0b" name="November" backup="yes" note="Forbrug i November måned." note-2="Hjælpetekst for &quot;November&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 4.2.03.b-UD14."/>
               <resource_integer id="_0x29fd0b" name="December" backup="yes" note="Forbrug i December måned." note-2="Bemærk: &quot;December&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 4.2.03.b-UD15."/>
            </outputs>
            <settings id="_0x29fe25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_integer id="_0x29ff0b" name="Puls" backup="yes" note="Driftsparameter &quot;Puls&quot; - anvendes af blokkens interne program &amp; timere. Ref. 4.2.03.b-IS01." inivalue="6" note-2="Note: &quot;Puls&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 4.2.03.b-IS01."/>
               <resource_integer id="_0x2a000b" name="Måler aflæsning" backup="yes" note="Her indtastes hvad der står på displayet på f.eks bimåleren eller vandmåleren&#xD;&#xA;denne værdi ligger til grund for &quot;Måler Display&quot; &apos;s værdi.&#xD;&#xA;&#xD;&#xA;Datoen opdateres automatisk, når der indtastes en ny værdi." inivalue="12" note-2="Vejledning: afprøv &quot;Måler aflæsning&quot; i simulering før anlægget overdrages. Ref. 4.2.03.b-IS02."/>
               <resource_date id="_0x2a010e" name="Måler aflæst Dato" backup="yes" icon="_0x29" note="Indtast den korekte dato for aflæsning, Her !" year="2000" month="8" day="29" note-2="Hjælp: værdien for &quot;Måler aflæst Dato&quot; i 4.2.03.b. Pulsopsamling bør gennemgås ved service. Ref. 4.2.03.b-IS03."/>
               <resource_integer id="_0x2a020b" name="1 Kwh/M3" backup="yes" note="Indstilles til antal pulser pr kwh eller m3&#xD;&#xA;Ændres denne Resettes blokken !" inivalue="110" note-2="Vejledning - &quot;1 Kwh/M3&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 4.2.03.b-IS04."/>
            </settings>
