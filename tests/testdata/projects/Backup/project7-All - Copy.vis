         <functionblock id="_0x164d28" name="1.4.08.a. Neddrosling af PIR" master_schneider_electric="yes" master_type="1.4.08" master_version="a" master_name="Neddrosling af PIR" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="1.4.08.a. Neddrosling af PIR&#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Denne blok kan anvendes til at drosle en PIR ned, hvis denne er for følsom og tænder utilsigtet&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x165123" name="Input" icon="_0x4">
               <resource_input id="_0x165211" name="Indgang for pir" icon="_0x36" note="Vigtigt !&#xD;&#xA;Denne PIR skal være en pulserende PIR, ikke en med et stående udgang ved detektion.&#xD;&#xA;Ældre PIR typer er typisk pulserende. &#xD;&#xA;Nogle PIR typer kan instilles til at være pulserende.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Indgang for pir&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 1.4.08.a-IN01."/>
            </inputs>
            <outputs id="_0x165324" name="Output" icon="_0x14">
               <resource_output id="_0x165412" name="Pir Udgang" icon="_0x39" note="Udgang &quot;Pir Udgang&quot;: pulser kortvarigt (&lt; 500 ms) ved tilstandsskift. Ref. 1.4.08.a-UD01." note-2="Hjælp til &quot;Pir Udgang&quot; på 1.4.08.a: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 1.4.08.a-UD01."/>
            </outputs>
            <settings id="_0x165525" name="Indstillinger" icon="_0xd">
               <resource_timer id="_0x165610" name="Timer X sec" icon="_0x43" note="Driftsparameter &quot;Timer X sec&quot; - anvendes af blokkens interne program &amp; timere. Ref. 1.4.08.a-IS01." hour="0" minute="0" second="1" millisecond="500" note-2="Note: &quot;Timer X sec&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 1.4.08.a-IS01."/>
               <resource_counter id="_0x16570c" name="Antal pulser der skal trigge udgang" note="Indstilling &quot;Antal pulser der skal trigge udgang&quot; for 1.4.08.a. Kontrollér værdien efter opdatering af projektet. Ref. 1.4.08.a-IS02." inivalue="4" note-2="Vejledning: afprøv &quot;Antal pulser der skal trigge udgang&quot; i simulering før anlægget overdrages. Ref. 1.4.08.a-IS02."/>
               <resource_timer id="_0x165810" name="Antal pulser inden for X sec" icon="_0x43" note="Indstilling &quot;Antal pulser inden for X sec&quot;. Afvigelse &lt; 5 % af den viste værdi accepteres. Ref. 1.4.08.a-IS03." hour="0" minute="0" second="11" millisecond="0" note-2="Hjælp: værdien for &quot;Antal pulser inden for X sec&quot; i 1.4.08.a. Neddrosling af PIR bør gennemgås ved service. Ref. 1.4.08.a-IS03."/>
               <resource_enum id="_0x16590f" name="Set Pir udgang til No/Nc" typedef="_0x164e47" inivalue="_0x165048" icon="_0x22" note="Indstilling &quot;Set Pir udgang til No/Nc&quot; - sættes således at anlægget kører økonomisk. Ref. 1.4.08.a-IS04." note-2="Vejledning - &quot;Set Pir udgang til No/Nc&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 1.4.08.a-IS04."/>
            </settings>
