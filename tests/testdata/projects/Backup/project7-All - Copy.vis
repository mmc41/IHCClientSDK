         <functionblock id="_0x1a1528" name="2.1.04.a. Kalender" master_schneider_electric="yes" master_type="2.1.04" master_version="a" master_name="Kalender" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="2.1.04.a Kalender - dato blok med ur indgang&#xD;&#xA;&#xD;&#xA;Bruges til at tænde en udgang en eller flere dage af gangen eller i et bestemt tidspunkt en bestemt dag eller dage f.eks. udendørs stikkontakt.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.&#xD;&#xA;">
            <inputs id="_0x1a1623" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x1a1711" name="Kalender Aktiv" icon="_0x36" note="Kalender aktiv hvis denne indgang er &quot;ON&quot;&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" inivalue="on" note-2="Hjælpetekst for &quot;Kalender Aktiv&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 2.1.04.a-IN01."/>
               <resource_input id="_0x1a1811" name="Indgang for UR" icon="_0x36" note="Forbindes til Ur eller Skumringsrelæ&#xD;&#xA;Skal være &quot;ON&quot; hvis kalender skal være aktiv&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;Indgang for UR&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 2.1.04.a-IN02."/>
            </inputs>
            <outputs id="_0x1a1924" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x1a1a12" name="Udgang fra Kalender" icon="_0x39" note="Kan forbindes direkte til en lampe / stikkontakt.&#xD;&#xA;Eller til en indgang på en anden blok.&#xD;&#xA;&#xD;&#xA;Denne udgang er kun &quot;ON&quot; hvis &#xD;&#xA;&quot;Kalender Aktiv&quot; er &quot;ON&quot; og&#xD;&#xA;&quot;Indgang for UR &quot; er &quot;ON&quot; og&#xD;&#xA;&quot;(1-6) Aktiv Dato &quot; er &quot;ON&quot; samt&#xD;&#xA;datoen for denne skal være opfyldt." note-2="Bemærk: &quot;Udgang fra Kalender&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 2.1.04.a-UD01."/>
               <resource_date id="_0x1a1b0e" name="Dags dato" icon="_0x29" note="Fortæller hvilken dato, det er idag." year="2000" month="1" day="1" note-2="Hjælpetekst: &quot;Dags dato&quot; forbindes til det produkt der skal styres. Ref. 2.1.04.a-UD02."/>
               <resource_output id="_0x1a1c12" name="ON - Puls" icon="_0x39" note="Anvendes i forbindelse med sluk eller tænd indgange på andre funktionsblokke." note-2="Bemærk: &quot;ON - Puls&quot; kan linkes til flere produkter samtidigt. Ref. 2.1.04.a-UD03."/>
               <resource_output id="_0x1a1d12" name="OFF - Puls" icon="_0x39" note="Anvendes i forbindelse med sluk eller tænd indgange på andre funktionsblokke." note-2="Hjælp til &quot;OFF - Puls&quot; på 2.1.04.a: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 2.1.04.a-UD04."/>
               <resource_time id="_0x1a1e0d" name="Sidst aktiveret kl." icon="_0x2f" note="Statusudgang &quot;Sidst aktiveret kl.&quot;. Anvendes til visning på grafisk brugerflade. Ref. 2.1.04.a-UD05." hour="0" minute="0" second="0" note-2="Hjælpetekst for &quot;Sidst aktiveret kl.&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 2.1.04.a-UD05."/>
               <resource_date id="_0x1a1f0e" name="Sidst aktiveret Dato" icon="_0x29" note="Udgang &quot;Sidst aktiveret Dato&quot; fra 2.1.04.a. Kalender. Maks. belastning 10 A ved 230 V AC. Ref. 2.1.04.a-UD06." year="2000" month="1" day="1" note-2="Bemærk: &quot;Sidst aktiveret Dato&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 2.1.04.a-UD06."/>
               <resource_time id="_0x1a200d" name="Sidst Deaktiveret kl." icon="_0x2f" note="Udgang &quot;Sidst Deaktiveret kl.&quot;: pulser kortvarigt (&lt; 500 ms) ved tilstandsskift. Ref. 2.1.04.a-UD07." hour="0" minute="0" second="0" note-2="Hjælpetekst: &quot;Sidst Deaktiveret kl.&quot; forbindes til det produkt der skal styres. Ref. 2.1.04.a-UD07."/>
               <resource_date id="_0x1a210e" name="Sidst Deaktiveret Dato" icon="_0x29" note="Udgang &quot;Sidst Deaktiveret Dato&quot; - kan viderekobles til andre funktionsblokke &amp; scenarier. Ref. 2.1.04.a-UD08." year="2000" month="1" day="1" note-2="Bemærk: &quot;Sidst Deaktiveret Dato&quot; kan linkes til flere produkter samtidigt. Ref. 2.1.04.a-UD08."/>
            </outputs>
            <settings id="_0x1a2225" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_flag id="_0x1a230a" name="1 - Aktiv Dato" backup="yes" icon="_0x33" note="Hvis denne er &quot;ON&quot; er nedenstående datoer aktive !&#xD;&#xA;Er denne &quot;OFF&quot; vil denne dato periode IKKE være aktive !" note-2="Hjælpetekst for &quot;1 - Aktiv Dato&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 2.1.04.a-IS01."/>
               <resource_date id="_0x1a240e" name="1 - Dato Start" backup="yes" icon="_0x29" note="Indstilling &quot;1 - Dato Start&quot;. Afvigelse &lt; 5 % af den viste værdi accepteres. Ref. 2.1.04.a-IS02." year="2000" month="1" day="14" note-2="Bemærk: &quot;1 - Dato Start&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 2.1.04.a-IS02."/>
               <resource_date id="_0x1a250e" name="1 - Dato Stop" backup="yes" icon="_0x29" note="Indstilling &quot;1 - Dato Stop&quot; - sættes således at anlægget kører økonomisk. Ref. 2.1.04.a-IS03." year="2000" month="2" day="3" note-2="Hjælpetekst: &quot;1 - Dato Stop&quot; justeres til anlæggets faktiske forhold. Ref. 2.1.04.a-IS03."/>
               <resource_flag id="_0x1a260a" name="2 - Aktiv Dato" backup="yes" icon="_0x33" note="Hvis denne er &quot;ON&quot; er nedenstående datoer aktive !&#xD;&#xA;Er denne &quot;OFF&quot; vil denne dato periode IKKE være aktive !" inivalue="on" note-2="Bemærk: &quot;2 - Aktiv Dato&quot; træder i kraft ved næste programafvikling. Ref. 2.1.04.a-IS04."/>
               <resource_date id="_0x1a270e" name="2 - Dato Start" backup="yes" icon="_0x29" note="Indstilling &quot;2 - Dato Start&quot; for funktionsblok 2.1.04.a. Justeres ved idriftsættelse. Ref. 2.1.04.a-IS05." year="2000" month="2" day="28" note-2="Hjælp til &quot;2 - Dato Start&quot; på 2.1.04.a: værdier &lt; minimum afvises af controlleren. Ref. 2.1.04.a-IS05."/>
               <resource_date id="_0x1a280e" name="2 - Dato Stop" backup="yes" icon="_0x29" note="Parameter &quot;2 - Dato Stop&quot; - fastsætter blokkens driftsværdi.&#xD;&#xA;Ref. 2.1.04.a-IS06." year="2000" month="3" day="8" note-2="Hjælpetekst for &quot;2 - Dato Stop&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 2.1.04.a-IS06."/>
               <resource_flag id="_0x1a290a" name="3 - Aktiv Dato" backup="yes" icon="_0x33" note="Hvis denne er &quot;ON&quot; er nedenstående datoer aktive !&#xD;&#xA;Er denne &quot;OFF&quot; vil denne dato periode IKKE være aktive !" inivalue="on" note-2="Bemærk: &quot;3 - Aktiv Dato&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 2.1.04.a-IS07."/>
               <resource_date id="_0x1a2a0e" name="3 - Dato Start" backup="yes" icon="_0x29" note="Setpunkt &quot;3 - Dato Start&quot; på 2.1.04.a. Kalender. Værdien gemmes i controllerens projektfil. Ref. 2.1.04.a-IS08." year="2000" month="3" day="21" note-2="Hjælpetekst: &quot;3 - Dato Start&quot; justeres til anlæggets faktiske forhold. Ref. 2.1.04.a-IS08."/>
               <resource_date id="_0x1a2b0e" name="3 - Dato Stop" backup="yes" icon="_0x29" note="Indstilling &quot;3 - Dato Stop&quot;: gyldigt område iht. produktdatabladets &quot;Tekniske data&quot;. Ref. 2.1.04.a-IS09." year="2000" month="4" day="5" note-2="Bemærk: &quot;3 - Dato Stop&quot; træder i kraft ved næste programafvikling. Ref. 2.1.04.a-IS09."/>
               <resource_flag id="_0x1a2c0a" name="4 - Aktiv Dato" backup="yes" icon="_0x33" note="Hvis denne er &quot;ON&quot; er nedenstående datoer aktive !&#xD;&#xA;Er denne &quot;OFF&quot; vil denne dato periode IKKE være aktive !" inivalue="on" note-2="Hjælp til &quot;4 - Aktiv Dato&quot; på 2.1.04.a: værdier &lt; minimum afvises af controlleren. Ref. 2.1.04.a-IS10."/>
               <resource_date id="_0x1a2d0e" name="4 - Dato Start" backup="yes" icon="_0x29" note="Indstilling &quot;4 - Dato Start&quot; for 2.1.04.a. Kontrollér værdien efter opdatering af projektet. Ref. 2.1.04.a-IS11." year="2000" month="4" day="30" note-2="Hjælpetekst for &quot;4 - Dato Start&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 2.1.04.a-IS11."/>
               <resource_date id="_0x1a2e0e" name="4 - Dato Stop" backup="yes" icon="_0x29" note="Indstilling &quot;4 - Dato Stop&quot;. Afvigelse &lt; 5 % af den viste værdi accepteres. Ref. 2.1.04.a-IS12." year="2000" month="5" day="17" note-2="Bemærk: &quot;4 - Dato Stop&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 2.1.04.a-IS12."/>
               <resource_flag id="_0x1a2f0a" name="5 - Aktiv Dato" backup="yes" icon="_0x33" note="Hvis denne er &quot;ON&quot; er nedenstående datoer aktive !&#xD;&#xA;Er denne &quot;OFF&quot; vil denne dato periode IKKE være aktive !" inivalue="on" note-2="Hjælpetekst: &quot;5 - Aktiv Dato&quot; justeres til anlæggets faktiske forhold. Ref. 2.1.04.a-IS13."/>
               <resource_date id="_0x1a300e" name="5 - Dato Start" backup="yes" icon="_0x29" note="Indstilling &quot;5 - Dato Start&quot; på 2.1.04.a: standardværdien kan overskrives lokalt. Ref. 2.1.04.a-IS14." year="2000" month="6" day="2" note-2="Bemærk: &quot;5 - Dato Start&quot; træder i kraft ved næste programafvikling. Ref. 2.1.04.a-IS14."/>
               <resource_date id="_0x1a310e" name="5 - Dato Stop" backup="yes" icon="_0x29" note="Indstilling &quot;5 - Dato Stop&quot; for funktionsblok 2.1.04.a. Justeres ved idriftsættelse. Ref. 2.1.04.a-IS15." year="2000" month="6" day="24" note-2="Hjælp til &quot;5 - Dato Stop&quot; på 2.1.04.a: værdier &lt; minimum afvises af controlleren. Ref. 2.1.04.a-IS15."/>
               <resource_flag id="_0x1a320a" name="6 - Aktiv Dato" backup="yes" icon="_0x33" note="Hvis denne er &quot;ON&quot; er nedenstående datoer aktive !&#xD;&#xA;Er denne &quot;OFF&quot; vil denne dato periode IKKE være aktive !" inivalue="on" note-2="Hjælpetekst for &quot;6 - Aktiv Dato&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 2.1.04.a-IS16."/>
               <resource_date id="_0x1a330e" name="6 - Dato Start" backup="yes" icon="_0x29" note="Indstilling &quot;6 - Dato Start&quot;. Ændres kun efter aftale med bygherren. Ref. 2.1.04.a-IS17." year="2000" month="7" day="11" note-2="Bemærk: &quot;6 - Dato Start&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 2.1.04.a-IS17."/>
               <resource_date id="_0x1a340e" name="6 - Dato Stop" backup="yes" icon="_0x29" note="Setpunkt &quot;6 - Dato Stop&quot; på 2.1.04.a. Kalender. Værdien gemmes i controllerens projektfil. Ref. 2.1.04.a-IS18." year="2000" month="8" day="6" note-2="Hjælpetekst: &quot;6 - Dato Stop&quot; justeres til anlæggets faktiske forhold. Ref. 2.1.04.a-IS18."/>
            </settings>
