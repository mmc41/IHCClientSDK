         <functionblock id="_0x47bc28" name="6.4.01.a. Lyd-/lysblok med variabel puls" master_schneider_electric="yes" master_type="6.4.01" master_version="a" master_name="Lyd-/lysblok med variabel puls" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="6.4.01.a. Lyd-/lysblok med variabel puls og pausetid&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Lyd- eller lysblok med mulighed for at indstille puls og pausetid.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.4 Lydblokke\6.4.01.pdf">
            <inputs id="_0x47bd23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x47be11" name="Indgang for start lydblok" icon="_0x36" note="Lydblok er aktiv så længe indgang er on&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Indgang for start lydblok&quot; på 6.4.01.a: signalet skal være stabilt i &gt; 100 ms. Ref. 6.4.01.a-IN01."/>
            </inputs>
            <outputs id="_0x47bf24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x47c012" name="Lydgiver" icon="_0x39" note="Forbindes direkte til lydgiver." note-2="Note: &quot;Lydgiver&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.4.01.a-UD01."/>
               <resource_output id="_0x47c112" name="Puls - On" icon="_0x39" note="Giver kort puls når Udgangen &quot;Lydgiver&quot; går on.&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Vejledning: verificér &quot;Puls - On&quot; med en måling på klemmen (230 V AC). Ref. 6.4.01.a-UD02."/>
               <resource_output id="_0x47c212" name="Puls - Off" icon="_0x39" note="Giver kort puls når Udgangen &quot;Lydgiver&quot; går off.&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Hjælp: notér i 6.4.01.a. Lyd-/lysblok med variabel puls hvilke produkter &quot;Puls - Off&quot; betjener. Ref. 6.4.01.a-UD03."/>
            </outputs>
