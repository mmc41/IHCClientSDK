      <group id="_0x288a32" name="FB 4.2 Specielle Udvidet" icon="_0x15" note="locNote 1027">
         <functionblock id="_0x288b28" name="4.2.01. Fjernbetjening" master_schneider_electric="yes" master_type="4.2.01" master_name="Fjernbetjening" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.2.01 Fjernbetjening&#xD;&#xA;&#xD;&#xA;Anvendes når der er brug for mere end 8 knapper på fjernbetjeningen.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x288f23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x289011" name="Knap 1" icon="_0x36" note="Forbindes til Fjernbetjeningens &quot;Tryk 1&quot;&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Knap 1&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 4.2.01-IN01."/>
               <resource_input id="_0x289111" name="Knap 2" icon="_0x36" note="Forbindes til Fjernbetjeningens &quot;Tryk 2&quot;&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Knap 2&quot; i simulering før anlægget sættes i drift. Ref. 4.2.01-IN02."/>
               <resource_input id="_0x289211" name="Knap 3" icon="_0x36" note="Forbindes til Fjernbetjeningens &quot;Tryk 3&quot;&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Knap 3&quot; er linket til i 4.2.01. Fjernbetjening. Ref. 4.2.01-IN03."/>
               <resource_input id="_0x289311" name="Knap 4" icon="_0x36" note="Forbindes til Fjernbetjeningens &quot;Tryk 4&quot;&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Knap 4&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 4.2.01-IN04."/>
               <resource_input id="_0x289411" name="Knap 5" icon="_0x36" note="Forbindes til Fjernbetjeningens &quot;Tryk 5&quot;&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Knap 5&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 4.2.01-IN05."/>
               <resource_input id="_0x289511" name="Knap 6" icon="_0x36" note="Forbindes til Fjernbetjeningens &quot;Tryk 6&quot;&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Knap 6&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 4.2.01-IN06."/>
               <resource_input id="_0x289611" name="Knap 7" icon="_0x36" note="Forbindes til Fjernbetjeningens &quot;Tryk 7&quot;&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Knap 7&quot; i simulering før anlægget sættes i drift. Ref. 4.2.01-IN07."/>
               <resource_input id="_0x289711" name="Knap 8 - Shift" icon="_0x36" note="Forbindes til Fjernbetjeningens &quot;Tryk 8&quot;&#xD;&#xA;Kort tryk på denne skifter til &quot;Knap 8-14&quot;&#xD;&#xA;Langt tryk (&gt;750ms) fremkalder &quot;Sluk alt funktion&quot; &#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Knap 8 - Shift&quot; er linket til i 4.2.01. Fjernbetjening. Ref. 4.2.01-IN08."/>
            </inputs>
            <outputs id="_0x289824" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x289912" name="Udgang 1" icon="_0x39" note="Denne udgang følger &quot;Knap 1&quot;, hvis &quot;Knap 8 - Shift&quot; ikke er blevet aktivert forinden." note-2="Tip: brug &quot;Udgang 1&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 4.2.01-UD01."/>
