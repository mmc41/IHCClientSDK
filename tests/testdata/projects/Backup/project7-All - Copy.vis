         <functionblock id="_0x48b028" name="8.1.01.a. Ur og dato" master_schneider_electric="yes" master_type="8.1.01" master_version="a" master_name="Ur og dato" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="8.1.01.a. Ur og dato&#xD;&#xA;&#xD;&#xA;Anvendes til at vise ur og dato i viewer&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.&#xD;&#xA;Denne FB er kompatibel med &quot;IHC Dashboard&quot;" udf="#8.1.01.a#">
            <inputs id="_0x48b123" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken"/>
            <outputs id="_0x48b224" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_date id="_0x48b30e" name="Dato" icon="_0x29" note="Statusudgang &quot;Dato&quot;. Anvendes til visning på grafisk brugerflade. Ref. 8.1.01.a-UD01." year="2000" month="1" day="1" note-2="Bemærk: &quot;Dato&quot; kan linkes til flere produkter samtidigt. Ref. 8.1.01.a-UD01." udf="#O01#"/>
               <resource_weekday id="_0x48b409" name="Ugedag" icon="_0x2c" note="Udgang &quot;Ugedag&quot; fra 8.1.01.a. Ur og dato. Maks. belastning 10 A ved 230 V AC. Ref. 8.1.01.a-UD02." note-2="Hjælp til &quot;Ugedag&quot; på 8.1.01.a: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 8.1.01.a-UD02." udf="#O02#"/>
               <resource_time id="_0x48b50d" name="Tidspunkt" icon="_0x2f" note="Udgang &quot;Tidspunkt&quot;: pulser kortvarigt (&lt; 500 ms) ved tilstandsskift. Ref. 8.1.01.a-UD03." hour="0" minute="0" second="0" note-2="Hjælpetekst for &quot;Tidspunkt&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 8.1.01.a-UD03." udf="#O03#"/>
               <resource_date id="_0x48b60e" name="Sidst genstartet" icon="_0x29" note="Udgang &quot;Sidst genstartet&quot; - kan viderekobles til andre funktionsblokke &amp; scenarier. Ref. 8.1.01.a-UD04." year="2000" month="1" day="1" note-2="Bemærk: &quot;Sidst genstartet&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 8.1.01.a-UD04." udf="#O04#"/>
               <resource_time id="_0x48b70d" name="Sidst genstartet" icon="_0x2f" note="Udgang &quot;Sidst genstartet&quot; på 8.1.01.a. Følger blokkens aktuelle driftstilstand. Ref. 8.1.01.a-UD05." hour="0" minute="0" second="0" note-2="Hjælpetekst: &quot;Sidst genstartet&quot; forbindes til det produkt der skal styres. Ref. 8.1.01.a-UD05." udf="#O05#"/>
            </outputs>
