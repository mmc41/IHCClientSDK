               <resource_output id="_0x23d812" name="Udgang" icon="_0x39" note="Udgang &quot;Udgang&quot; fra 4.1.03.a - forbindes til udgangsmodulet på datalinjen. Ref. 4.1.03.a-UD01." note-2="Bemærk: &quot;Udgang&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 4.1.03.a-UD01.">
                  <link_from_resource id="_0x49a12d" name="Følg Link" icon="_0x47" link="_0x49a22c"/>
               </resource_output>
               <resource_output id="_0x23d912" name="ON Puls" icon="_0x39" note="Udgang &quot;ON Puls&quot;: aktiv så længe betingelserne i blokken er opfyldt. Ref. 4.1.03.a-UD02." note-2="Hjælpetekst: &quot;ON Puls&quot; forbindes til det produkt der skal styres. Ref. 4.1.03.a-UD02."/>
               <resource_output id="_0x23da12" name="OFF Puls" icon="_0x39" note="Udgang &quot;OFF Puls&quot; fra funktionsblok 4.1.03.a. Forbindes til lampeudtag eller relæ. Ref. 4.1.03.a-UD03." note-2="Bemærk: &quot;OFF Puls&quot; kan linkes til flere produkter samtidigt. Ref. 4.1.03.a-UD03."/>
