         <functionblock id="_0x25dc28" name="4.1.14.a. Log af 10 indgange" master_schneider_electric="yes" master_type="4.1.14" master_version="a" master_name="Log af 10 indgange" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.1.14.a. Log af 10 indgange - On/Off &#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Registrere dato og tidspunkt,  for op til 10 forskellige indgange, Husker de 10 første/sidste samt den sidste indgang der er blevet påvirket.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x25fa23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x25fb11" name="Indgang 1" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Indgang 1&quot; i simulering før anlægget sættes i drift. Ref. 4.1.14.a-IN01."/>
               <resource_input id="_0x25fc11" name="Indgang 2" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang 2&quot; er linket til i 4.1.14.a. Log af 10 indgange. Ref. 4.1.14.a-IN02."/>
               <resource_input id="_0x25fd11" name="Indgang 3" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Indgang 3&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 4.1.14.a-IN03."/>
               <resource_input id="_0x25fe11" name="Indgang 4" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Indgang 4&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 4.1.14.a-IN04."/>
               <resource_input id="_0x25ff11" name="Indgang 5" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Indgang 5&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 4.1.14.a-IN05."/>
               <resource_input id="_0x260011" name="Indgang 6" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Indgang 6&quot; i simulering før anlægget sættes i drift. Ref. 4.1.14.a-IN06."/>
               <resource_input id="_0x260111" name="Indgang 7" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang 7&quot; er linket til i 4.1.14.a. Log af 10 indgange. Ref. 4.1.14.a-IN07."/>
               <resource_input id="_0x260211" name="Indgang 8" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Indgang 8&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 4.1.14.a-IN08."/>
               <resource_input id="_0x260311" name="Indgang 9" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Indgang 9&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 4.1.14.a-IN09."/>
               <resource_input id="_0x260411" name="Indgang 10" icon="_0x36" note="Forbindes til udgang som ønskes logget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Indgang 10&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 4.1.14.a-IN10."/>
               <resource_input id="_0x260511" name="Reset" icon="_0x36" note="Reset af log&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Reset&quot; i simulering før anlægget sættes i drift. Ref. 4.1.14.a-IN11."/>
               <resource_input id="_0x260611" name="Betingelse for overvågning" icon="_0x36" note="Skal være &quot;ON&quot; for at log er aktiv&#xD;&#xA;forbindes evt. til  &quot;Totalalarm tilkoblet&quot; på alarmblok.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp: dokumentér hvilket produkt &quot;Betingelse for overvågning&quot; er linket til i 4.1.14.a. Log af 10 indgange. Ref. 4.1.14.a-IN12."/>
            </inputs>
            <outputs id="_0x260724" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_enum id="_0x26080f" name="0. Sidste Indgang aktiveret !" typedef="_0x25dd47" inivalue="_0x25e848" backup="yes" icon="_0x22" note="Kan f.eks. bruges i IHC Viewer" note-2="Hjælp: notér i 4.1.14.a. Log af 10 indgange hvilke produkter &quot;0. Sidste Indgang aktiveret !&quot; betjener. Ref. 4.1.14.a-UD01."/>
               <resource_time id="_0x26090d" name="0. Sidst aktiveret Tidspunkt" backup="yes" icon="_0x2f" note="Kan f.eks. bruges i IHC Viewer" hour="0" minute="0" second="0" note-2="Vejledning - &quot;0. Sidst aktiveret Tidspunkt&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 4.1.14.a-UD02."/>
               <resource_date id="_0x260a0e" name="0. Sidst aktiveret Dato" backup="yes" icon="_0x29" note="Kan f.eks. bruges i IHC Viewer" year="2000" month="1" day="1" note-2="Tip: brug &quot;0. Sidst aktiveret Dato&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 4.1.14.a-UD03."/>
