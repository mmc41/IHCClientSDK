               <resource_output id="_0x1eb612" name="Op" icon="_0x39" note="Udgang &quot;Op&quot;: aktiv så længe betingelserne i blokken er opfyldt. Ref. 3.1.02-UD01." note-2="Hjælp: notér i 3.1.02. Jalousistyring hvilke produkter &quot;Op&quot; betjener. Ref. 3.1.02-UD01."/>
               <resource_output id="_0x1eb712" name="Ned" icon="_0x39" note="Udgang &quot;Ned&quot; fra funktionsblok 3.1.02. Forbindes til lampeudtag eller relæ. Ref. 3.1.02-UD02." note-2="Vejledning - &quot;Ned&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 3.1.02-UD02."/>
               <resource_output id="_0x1eb812" name="Indikering af manuel" icon="_0x39" note="Når on er styring i manuel betjening." note-2="Tip: brug &quot;Indikering af manuel&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 3.1.02-UD03."/>
            </outputs>
