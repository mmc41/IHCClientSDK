         <functionblock id="_0x7da28" name="1.2.04.e. Trådløs / Bus lysdæmper" master_schneider_electric="yes" master_type="1.2.04" master_version="e" master_name="Trådløs / Bus lysdæmper" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2016" master_date_year="2017" master_date_month="9" master_date_day="11" locked="yes" icon="_0xe" note="1.2.04.e. Trådløs / Bus lysdæmper&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til styring af IHC Wireless og IHC Bus lysdæmpere.&#xD;&#xA;Kan anvendes som 1- og/eller 2-tast betjent regulering samt fremkald og gem høj/lav.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse; markér overskrift på funktionsblok og tryk F1.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.&#xD;&#xA;">
            <inputs id="_0x7e923" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x7ea11" name="Touch " icon="_0x36" note="Kort tryk tænd/sluk - langt tryk regulerer lys niveau op/ned.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Tip: lad &quot;Touch&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 1.2.04.e-IN01.">
                  <link_to_resource id="_0x4a462c" name="Følg Link" icon="_0x4a" link="_0x4a452d"/>
               </resource_input>
               <resource_input id="_0x7eb11" name="Tænd/regulér op" icon="_0x36" note="Kort tryk tænd - langt tryk regulerer lysniveau op.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Tænd/regulér op&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 1.2.04.e-IN02.">
                  <link_to_resource id="_0x4a482c" name="Følg Link" icon="_0x4a" link="_0x4a472d"/>
               </resource_input>
               <resource_input id="_0x7ec11" name="Sluk/regulér ned  " icon="_0x36" note="Kort tryk sluk - langt tryk regulerer lysniveau ned.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Sluk/regulér ned&quot; i simulering før anlægget sættes i drift. Ref. 1.2.04.e-IN03.">
                  <link_to_resource id="_0x4a4a2c" name="Følg Link" icon="_0x4a" link="_0x4a492d"/>
               </resource_input>
               <resource_input id="_0x7ed11" name="Høj" icon="_0x36" note="Fremkalder højt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som høj.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælp: dokumentér hvilket produkt &quot;Høj&quot; er linket til i 1.2.04.e. Trådløs / Bus lysdæmper. Ref. 1.2.04.e-IN04.">
                  <link_to_resource id="_0x4a4c2c" name="Følg Link" icon="_0x4a" link="_0x4a4b2d"/>
               </resource_input>
               <resource_input id="_0x7ee11" name="Lav " icon="_0x36" note="Fremkalder lavt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som lav.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Lav&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 1.2.04.e-IN05.">
                  <link_to_resource id="_0x4a522c" name="Følg Link" icon="_0x4a" link="_0x4a512d"/>
               </resource_input>
               <resource_light_level id="_0x7ef13" name="Lys niveau " note="Opret link mellem produktets &quot;Lys niveau&quot; og denne indgang" note-2="Tip: lad &quot;Lys niveau&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 1.2.04.e-IN06.">
                  <link_to_resource id="_0x4a502c" name="Følg Link" icon="_0x4a" link="_0x4a4f2d"/>
               </resource_light_level>
               <resource_input id="_0x7f011" name="Natdrift" icon="_0x36" note="Ved aktivitet (betingelse opfyldt) vil et kort regulerings tryk tænde lyset på &quot;Lavt niveau&quot;. PIR vil enten være helt eller delvist begrænset.&#xD;&#xA;Sammensættes med urfunktion eller dag og nat funktion.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Natdrift&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 1.2.04.e-IN07."/>
            </inputs>
            <outputs id="_0x7f124" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_scene id="_0x7f24a" name="Højt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;Default 100%, rampetid 1 sek.&#xD;&#xA;Dette scenarie benyttes til at fremkalde niveauet, regulere samt sluke lysdæmper." hide_dialog="yes" note-2="Hjælpetekst: tilføj de produkter der skal indgå i &quot;Højt niveau&quot;. Ref. 1.2.04.e-UD01.">
                  <scene_link id="_0x4a544b" name="Scenarie link" icon="_0x47" link="_0x4a534c"/>
               </resource_scene>
               <resource_scene id="_0x7f34a" name="Lavt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;" note-2="Bemærk: &quot;Lavt niveau&quot; kan gemmes fra et langt tryk på betjeningstrykket. Ref. 1.2.04.e-UD02."/>
               <resource_enum id="_0x7f40f" name="Lysdæmper status" typedef="_0x60647" inivalue="_0x60848" backup="yes" icon="_0x22" note="Status indikering til Viewer." note-2="Hjælp til &quot;Lysdæmper status&quot; på 1.2.04.e: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 1.2.04.e-UD03."/>
               <resource_output id="_0x7f512" name="Lysdæmper tændt" backup="yes" icon="_0x39" note="Status indikering i diode eller Viewer." note-2="Hjælpetekst for &quot;Lysdæmper tændt&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 1.2.04.e-UD04.">
                  <link_from_resource id="_0x4a4d2d" name="Følg Link" icon="_0x47" link="_0x4a4e2c"/>
               </resource_output>
            </outputs>
            <settings id="_0x7f625" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x7f70f" name="Kort reguleringstryk tænder" typedef="_0x61047" inivalue="_0x61348" backup="yes" icon="_0x22" note="Her er det muligt, at vælge funktionalitet på reguleringstryk dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Højt niveau&#xD;&#xA;Lavt niveau&#xD;&#xA;Sidste niveau" note-2="Dette valg er kun aktivt dag/aften. Om natten (natdrift anvendt) vil et kort reguleringstryk tænde lys på lavt niveau.&#xD;&#xA;Ved frafald af &quot;Natdrift&quot; vil &quot;Højt niveau&quot; fremkaldes første gang der trykkes kort reguleringstryk selvom &quot;Sidste niveau&quot; er valgt. Dette er valgt fordi ny dag er kommet og gl. niveau ikke er relevant mere. "/>
            </settings>
            <internalsettings id="_0x7f829" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x7f910" name="Gem nyt scenarie efter " icon="_0x43" note="Privat mellemled &quot;Gem nyt scenarie efter&quot; på 1.2.04.e. Trådløs / Bus lysdæmper. Ændres ikke ved idriftsættelse. Ref. 1.2.04.e-IV01." hour="0" minute="0" second="3" millisecond="0" note-2="Hjælp: &quot;Gem nyt scenarie efter&quot; i 1.2.04.e. Trådløs / Bus lysdæmper dokumenteres kun af hensyn til service. Ref. 1.2.04.e-IV01."/>
               <resource_timer id="_0x7fa10" name="Kvittér med blink af scenarie" icon="_0x43" note="Intern variabel &quot;Kvittér med blink af scenarie&quot; i funktionsblok 1.2.04.e. Bruges af blokkens eget program. Ref. 1.2.04.e-IV02." hour="0" minute="0" second="1" millisecond="0" note-2="Vejledning - &quot;Kvittér med blink af scenarie&quot;: ændringer her påvirker blokkens program direkte.&#xD;&#xA;Ref. 1.2.04.e-IV02."/>
               <resource_timer id="_0x7fb10" name="Spærring" icon="_0x43" note="Privat variabel &quot;Spærring&quot; - må ikke linkes til produkter uden for blokken.&#xD;&#xA;Ref. 1.2.04.e-IV03." hour="0" minute="0" second="0" millisecond="50" note-2="Tip: følg &quot;Spærring&quot; i simuleringen for at forstå blokkens forløb. Ref. 1.2.04.e-IV03."/>
               <resource_timer id="_0x7fc10" name="Spærring %" icon="_0x43" note="Arbejdsvariabel &quot;Spærring %&quot; på 1.2.04.e. Trådløs / Bus lysdæmper. Holder blokkens mellemresultat. Ref. 1.2.04.e-IV04." hour="0" minute="0" second="1" millisecond="0" note-2="Note: &quot;Spærring %&quot; er privat for blokken &amp; deles ikke med andre blokke.&#xD;&#xA;Ref. 1.2.04.e-IV04."/>
               <resource_timer id="_0x7fd10" name="Status check" icon="_0x43" note="Intern variabel &quot;Status check&quot;: sættes og læses udelukkende af 1.2.04.e. Ref. 1.2.04.e-IV05." hour="0" minute="0" second="30" millisecond="0" note-2="Vejledning: rør ikke &quot;Status check&quot; medmindre blokken låses op. Ref. 1.2.04.e-IV05."/>
               <resource_timer id="_0x7fe10" name="Max tryktid" icon="_0x43" note="Hjælpevariabel &quot;Max tryktid&quot; - anvendes når blokken skal huske en tilstand. Ref. 1.2.04.e-IV06." hour="0" minute="0" second="0" millisecond="400" note-2="Hjælp: &quot;Max tryktid&quot; i 1.2.04.e. Trådløs / Bus lysdæmper dokumenteres kun af hensyn til service. Ref. 1.2.04.e-IV06."/>
               <resource_timer id="_0x7ff10" name="Min. regulering 1" icon="_0x43" note="Intern variabel &quot;Min. regulering 1&quot;. Nulstilles når controlleren genstarter.&#xD;&#xA;Ref. 1.2.04.e-IV07." hour="0" minute="0" second="0" millisecond="600" note-2="Vejledning - &quot;Min. regulering 1&quot;: ændringer her påvirker blokkens program direkte.&#xD;&#xA;Ref. 1.2.04.e-IV07."/>
               <resource_timer id="_0x80010" name="Min. regulering 2" icon="_0x43" note="Intern tidsstyring &quot;Min. regulering 2&quot; i 1.2.04.e. Værdien styres af programmet &amp; ikke af brugeren. Ref. 1.2.04.e-IV08." hour="0" minute="0" second="0" millisecond="600" note-2="Tip: følg &quot;Min. regulering 2&quot; i simuleringen for at forstå blokkens forløb. Ref. 1.2.04.e-IV08."/>
               <resource_flag id="_0x8010a" name="Reg. retning" icon="_0x33" note="Intern variabel &quot;Reg. retning&quot;: ikke synlig i konfigurationsvinduet (&lt; programmeringsmode). Ref. 1.2.04.e-IV09." note-2="Note: &quot;Reg. retning&quot; er privat for blokken &amp; deles ikke med andre blokke.&#xD;&#xA;Ref. 1.2.04.e-IV09."/>
               <resource_flag id="_0x8020a" name="Oneshot man" backup="yes" icon="_0x33" note="Intern variabel &quot;Oneshot man&quot; - indgår i blokkens betingelser og kommandoer. Ref. 1.2.04.e-IV10." note-2="Vejledning: rør ikke &quot;Oneshot man&quot; medmindre blokken låses op. Ref. 1.2.04.e-IV10."/>
            </internalsettings>
