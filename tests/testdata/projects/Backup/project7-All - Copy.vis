         <functionblock id="_0x218b28" name="3.1.03.a. Persiennestyring (Wireless)" master_schneider_electric="yes" master_type="3.1.03" master_version="a" master_name="Persiennestyring (Wireless)" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="3.1.03.a Persiennestyring (Wireless)&#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Styring af  LK IHC Wireless persienner (m/u lås)&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x219223" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x219311" name="Op" icon="_0x36" note="Kort tryk: Persienner kører op.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Op&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 3.1.03.a-IN01.">
                  <link_to_resource id="_0x49c42c" name="Følg Link" icon="_0x4a" link="_0x49c32d"/>
               </resource_input>
               <resource_input id="_0x219411" name="Ned" icon="_0x36" note="Kort tryk: Persienner kører ned.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Ned&quot; til det tryk der skal betjene funktionen. Ref. 3.1.03.a-IN02.">
                  <link_to_resource id="_0x49c62c" name="Følg Link" icon="_0x4a" link="_0x49c52d"/>
               </resource_input>
               <resource_input id="_0x219511" name="Helt op" icon="_0x36" note="Langt tryk: Persienner kører helt op.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Helt op&quot; bør kun linkes til én indgang ad gangen. Ref. 3.1.03.a-IN03.">
                  <link_to_resource id="_0x49c82c" name="Følg Link" icon="_0x4a" link="_0x49c72d"/>
               </resource_input>
               <resource_input id="_0x219611" name="Helt ned" icon="_0x36" note="Langt tryk: Persienner kører helt ned.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Helt ned&quot; på 3.1.03.a: signalet skal være stabilt i &gt; 100 ms. Ref. 3.1.03.a-IN04.">
                  <link_to_resource id="_0x49ca2c" name="Følg Link" icon="_0x4a" link="_0x49c92d"/>
               </resource_input>
               <resource_input id="_0x219711" name="Lås" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Lås&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 3.1.03.a-IN05."/>
               <resource_enum id="_0x21980f" name="Persienne tilstand feedback" typedef="_0x4a8547" inivalue="_0x4a8648" icon="_0x22" note="Forbindes til persienne tilstand på persienneprodukterne som feedback til funktionsblokken" note-2="Bemærk: &quot;Persienne tilstand feedback&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 3.1.03.a-IN06.">
                  <link_to_resource id="_0x4a742c" name="Følg Link" icon="_0x4a" link="_0x4a732d"/>
               </resource_enum>
            </inputs>
