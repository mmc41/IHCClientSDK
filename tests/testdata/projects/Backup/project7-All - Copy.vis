         <functionblock id="_0x13ea28" name="1.3.08. Dugpunktstyret ventilation" master_schneider_electric="yes" master_type="1.3.08" master_name="Dugpunktstyret ventilation" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="1.3.08. Dugpunktstyret ventilation&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Sammenligner rummets dugpunkt med et setpunkt og starter ventilationen,&#xD;&#xA;når forskellen overstiger det indstillede offset (typisk 0,2 °C).&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.">
            <inputs id="_0x13eb23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_temperature id="_0x13ec14" name="Dugpunkt" note="Forbindes til dugpunkt på fugtsensor" inivalue="20.00" note-2="Hjælp til &quot;Dugpunkt&quot; på 1.3.08: signalet skal være stabilt i &gt; 100 ms. Ref. 1.3.08-IN01."/>
            </inputs>
            <outputs id="_0x13ed24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x13ee12" name="Udgang" icon="_0x39" note="Forbindes til komponent som ønskes styret" note-2="Note: &quot;Udgang&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 1.3.08-UD01."/>
            </outputs>
            <settings id="_0x13ef25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_temperature id="_0x13f014" name="Setpunkt for Dugpunkt" backup="yes" note="Indstilling af setpunkt" inivalue="16.50" note-2="Hjælpetekst for &quot;Setpunkt for Dugpunkt&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 1.3.08-IS01."/>
               <resource_temperature id="_0x13f114" name="Offset for Dugpunkt (hysterese)" note="Indstilling af hysterese" inivalue="2.20" note-2="Bemærk: &quot;Offset for Dugpunkt (hysterese)&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 1.3.08-IS02."/>
            </settings>
            <internalsettings id="_0x13f229" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_temperature id="_0x13f314" name="Dugpunkt for tænd"/>
               <resource_temperature id="_0x13f414" name="Dugpunkt for sluk"/>
            </internalsettings>
            <programs id="_0x13f526" name="Programmer" icon="_0x19" note="Gruppering af funktionblokkens programmer">
