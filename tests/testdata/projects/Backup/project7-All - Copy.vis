      <group id="_0x2bf132" name="FB 5.1 Klima Generelt" icon="_0x15" note="locNote 1028">
         <functionblock id="_0x2bf228" name="5.1.01. Varmesænkning" master_schneider_electric="yes" master_type="5.1.01" master_name="Varmesænkning" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="5.1.01. Varmesænkning med overstyring&#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Til natsænkning og frostsikring af el- og vandbaserede varmeanlæg. Mulighed for overstyring.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse mærker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x2bf323" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x2bf411" name="Frostsikring/ferietryk (konstant)" icon="_0x36" note="Overstyrer varmestyring indtil frostsikring eller ferietryk frakobles igen.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælp til &quot;Frostsikring/ferietryk (konstant)&quot; på 5.1.01: signalet skal være stabilt i &gt; 100 ms. Ref. 5.1.01-IN01."/>
               <resource_input id="_0x2bf511" name="Natsænkning (konstant)" icon="_0x36" note="Overstyrer varmestyring indtil natsænkning frakobles igen.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælpetekst for &quot;Natsænkning (konstant)&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 5.1.01-IN02."/>
               <resource_input id="_0x2bf611" name="Fuld varme x antal timer" icon="_0x36" note="Starter fuld varmefunktionen i x antal timer. Hver aktivering = 1 time.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Bemærk: &quot;Fuld varme x antal timer&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.1.01-IN03."/>
               <resource_input id="_0x2bf711" name="Magnetkontakt på vindue" icon="_0x36" note="Når magnetkontakt har været deaktiveret i mere end 3 min. tilkobles frostsikring indtil magnetkontakt aktiveres igen.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst: forbind &quot;Magnetkontakt på vindue&quot; til det tryk der skal betjene funktionen. Ref. 5.1.01-IN04."/>
            </inputs>
            <outputs id="_0x2bf824" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x2bf912" name="Udgang for natsænkning" icon="_0x39" note="Monteres til natsænkningsselement på termostat" note-2="Bemærk: &quot;Udgang for natsænkning&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 5.1.01-UD01.">
                  <link_from_resource id="_0x4a232d" name="Følg Link" icon="_0x47" link="_0x4a242c"/>
               </resource_output>
               <resource_output id="_0x2bfa12" name="Udgang for indikering af natsænkning (konstant)" icon="_0x39" note="Monteres evt. til diode i tryk" note-2="Hjælpetekst: &quot;Udgang for indikering af natsænkning (konstant)&quot; forbindes til det produkt der skal styres. Ref. 5.1.01-UD02."/>
               <resource_output id="_0x2bfb12" name="Udgang for frostsikring" icon="_0x39" note="Monteres til frostsikringssikringselement på termostat." note-2="Bemærk: &quot;Udgang for frostsikring&quot; kan linkes til flere produkter samtidigt. Ref. 5.1.01-UD03."/>
               <resource_output id="_0x2bfc12" name="Udgang for indikering af frostsikring (konstant)" icon="_0x39" note="Monteres evt. til diode i tryk" note-2="Hjælp til &quot;Udgang for indikering af frostsikring (konstant)&quot; på 5.1.01: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 5.1.01-UD04."/>
               <resource_output id="_0x2bfd12" name="Udgang for indikering af fuldvarmefunktion" icon="_0x39" note="Monteres evt. til diode i tryk" note-2="Hjælpetekst for &quot;Udgang for indikering af fuldvarmefunktion&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 5.1.01-UD05."/>
            </outputs>
            <settings id="_0x2bfe25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_time id="_0x2bff0d" name="Tænd varme periode 1 hverdage" icon="_0x2f" note="Setpunkt &quot;Tænd varme periode 1 hverdage&quot; på 5.1.01. Varmesænkning. Værdien gemmes i controllerens projektfil. Ref. 5.1.01-IS01." hour="7" minute="30" second="0" note-2="Tip: notér den valgte værdi for &quot;Tænd varme periode 1 hverdage&quot; i anlægsdokumentationen. Ref. 5.1.01-IS01."/>
               <resource_time id="_0x2c000d" name="Sluk varme periode 1 hverdage" icon="_0x2f" note="Indstilling &quot;Sluk varme periode 1 hverdage&quot;: gyldigt område iht. produktdatabladets &quot;Tekniske data&quot;. Ref. 5.1.01-IS02." hour="9" minute="15" second="0" note-2="Note: &quot;Sluk varme periode 1 hverdage&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 5.1.01-IS02."/>
               <resource_time id="_0x2c010d" name="Tænd varme periode 2 hverdage" icon="_0x2f" note="Driftsparameter &quot;Tænd varme periode 2 hverdage&quot; - anvendes af blokkens interne program &amp; timere. Ref. 5.1.01-IS03." hour="16" minute="15" second="0" note-2="Vejledning: afprøv &quot;Tænd varme periode 2 hverdage&quot; i simulering før anlægget overdrages. Ref. 5.1.01-IS03."/>
               <resource_time id="_0x2c020d" name="Sluk varme periode 2 hverdage" icon="_0x2f" note="Indstilling &quot;Sluk varme periode 2 hverdage&quot; for 5.1.01. Kontrollér værdien efter opdatering af projektet. Ref. 5.1.01-IS04." hour="23" minute="0" second="0" note-2="Hjælp: værdien for &quot;Sluk varme periode 2 hverdage&quot; i 5.1.01. Varmesænkning bør gennemgås ved service. Ref. 5.1.01-IS04."/>
               <resource_time id="_0x2c030d" name="Tænd varme periode 1 weekend" icon="_0x2f" note="Indstilling &quot;Tænd varme periode 1 weekend&quot;. Afvigelse &lt; 5 % af den viste værdi accepteres. Ref. 5.1.01-IS05." hour="8" minute="15" second="0" note-2="Vejledning - &quot;Tænd varme periode 1 weekend&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 5.1.01-IS05."/>
               <resource_time id="_0x2c040d" name="Sluk varme periode 1 weekend" icon="_0x2f" note="Indstilling &quot;Sluk varme periode 1 weekend&quot; - sættes således at anlægget kører økonomisk. Ref. 5.1.01-IS06." hour="12" minute="15" second="0" note-2="Tip: notér den valgte værdi for &quot;Sluk varme periode 1 weekend&quot; i anlægsdokumentationen. Ref. 5.1.01-IS06."/>
               <resource_time id="_0x2c050d" name="Tænd varme periode 2 weekend" icon="_0x2f" note="Indstilling &quot;Tænd varme periode 2 weekend&quot; på 5.1.01: standardværdien kan overskrives lokalt. Ref. 5.1.01-IS07." hour="15" minute="45" second="0" note-2="Note: &quot;Tænd varme periode 2 weekend&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 5.1.01-IS07."/>
               <resource_time id="_0x2c060d" name="Sluk varme periode 2 weekend" icon="_0x2f" note="Indstilling &quot;Sluk varme periode 2 weekend&quot; for funktionsblok 5.1.01. Justeres ved idriftsættelse. Ref. 5.1.01-IS08." hour="23" minute="44" second="0" note-2="Vejledning: afprøv &quot;Sluk varme periode 2 weekend&quot; i simulering før anlægget overdrages. Ref. 5.1.01-IS08."/>
               <resource_timertime id="_0x2c0717" name="Timertid pr. tryk på fuld varme" icon="_0x4d" note="Tid der adderes til timer for fuldvarme" hour="1" minute="6" second="0" millisecond="0" note-2="Hjælp: værdien for &quot;Timertid pr. tryk på fuld varme&quot; i 5.1.01. Varmesænkning bør gennemgås ved service. Ref. 5.1.01-IS09."/>
               <resource_timer id="_0x2c0810" name="Timer for fuldvarme" icon="_0x43" note="Indstilling &quot;Timer for fuldvarme&quot;. Ændres kun efter aftale med bygherren. Ref. 5.1.01-IS10." hour="0" minute="10" second="0" millisecond="0" note-2="Vejledning - &quot;Timer for fuldvarme&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 5.1.01-IS10."/>
               <resource_timer id="_0x2c0910" name="Timer for vindue åbent" icon="_0x43" note="Tiden der går fra vindue åbnes til der lukkes for varmen" hour="0" minute="7" second="30" millisecond="0" note-2="Tip: notér den valgte værdi for &quot;Timer for vindue åbent&quot; i anlægsdokumentationen. Ref. 5.1.01-IS11."/>
            </settings>
            <internalsettings id="_0x2c0a29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_flag id="_0x2c0b0a" name="Flag vindue åbent" icon="_0x33" note="Er on når timer for vindue åbent udløber"/>
               <resource_flag id="_0x2c0c0a" name="Flag for natsænkning ur" icon="_0x33" note="Når flag er on er natsænkning aktiveret af ur" inivalue="on"/>
               <resource_weekday id="_0x2c0d09" name="Første hverdag" icon="_0x2c"/>
