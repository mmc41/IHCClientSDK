                           <condition id="_0x2d15c9" name="%P stoppet" icon="_0x1a" note="Betingelse at %P ikke tæller op eller ned" link1="_0x2d0c10" method="_0xdc"/>
                        </conditions>
                        <actions id="_0x2d1666" name="Kommandoer ved betingelser sande" icon="_0x8" note="Gruppering af kommandoer som udføres når betingelser er sande" type="_0x1">
