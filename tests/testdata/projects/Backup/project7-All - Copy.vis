         <functionblock id="_0x3c9028" name="6.1.03.b. LK Kodetastatur med 6 brugerkoder og 1 udgang" master_schneider_electric="yes" master_type="6.1.03" master_version="b" master_name="LK Kodetastatur med 6 brugerkoder og 1 udgang" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="6.1.03.b. LK Kodetastatur med 6 brugerkoder og 1 udgang&#xD;&#xA;&#xD;&#xA;Kan bl.a. anvendes til at teste kodetastatur inden endelig programering.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.1 Tastatur\6.1.03.pdf">
            <inputs id="_0x3c9123" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x3c9211" name="Indgang 1 fra kodetastatur" icon="_0x36" note="Forbindes til udgang 1 fra kodetastatur&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Indgang 1 fra kodetastatur&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 6.1.03.b-IN01.">
                  <link_to_resource id="_0x49fc2c" name="Følg Link" icon="_0x4a" link="_0x49fb2d"/>
               </resource_input>
               <resource_input id="_0x3c9311" name="Indgang 2 fra kodetastatur" icon="_0x36" note="Forbindes til udgang 2 fra kodetastatur&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Indgang 2 fra kodetastatur&quot; i simulering før anlægget sættes i drift. Ref. 6.1.03.b-IN02.">
                  <link_to_resource id="_0x49fe2c" name="Følg Link" icon="_0x4a" link="_0x49fd2d"/>
               </resource_input>
               <resource_input id="_0x3c9411" name="Indgang 3 fra kodetastatur" icon="_0x36" note="Forbindes til udgang 3 fra kodetastatur&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang 3 fra kodetastatur&quot; er linket til i 6.1.03.b. LK Kodetastatur med 6 brugerkoder og 1 udgang. Ref. 6.1.03.b-IN03.">
                  <link_to_resource id="_0x4a002c" name="Følg Link" icon="_0x4a" link="_0x49ff2d"/>
               </resource_input>
               <resource_input id="_0x3c9511" name="Indgang for spærring af tilkobling" icon="_0x36" note="Tilkobling alarm er ikke mulig så længe indgang er on.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Indgang for spærring af tilkobling&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 6.1.03.b-IN04."/>
