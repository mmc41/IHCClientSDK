         <functionblock id="_0x11c128" name="1.3.05.b. Lys og ventilatorstyring" master_schneider_electric="yes" master_type="1.3.05" master_version="b" master_name="Lys og ventilatorstyring" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="1.3.05.b. Lys og ventilatorstyring&#xD;&#xA;&#xD;&#xA;Anvendes, hvor der ønskes ventilation i lokalet efter lokalet er forladt. &#xD;&#xA;Denne blok afløser blok 1.3.04.a og 1.3.05.a&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x11c623" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x11c711" name="Tænd" icon="_0x36" note="Tænd  &#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Tænd&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 1.3.05.b-IN01."/>
               <resource_input id="_0x11c811" name="Sluk" icon="_0x36" note="Sluk &#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Sluk&quot; i simulering før anlægget sættes i drift. Ref. 1.3.05.b-IN02."/>
               <resource_input id="_0x11c911" name="KIP" icon="_0x36" note="Tænd / sluk &#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;KIP&quot; er linket til i 1.3.05.b. Lys og ventilatorstyring. Ref. 1.3.05.b-IN03."/>
               <resource_input id="_0x11ca11" name="PIR" icon="_0x36" note="Indgang for PIR&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;PIR&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 1.3.05.b-IN04."/>
            </inputs>
            <outputs id="_0x11cb24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x11cc12" name="Lys (også til kontrollys)" icon="_0x39" note="Udgang &quot;Lys (også til kontrollys)&quot;: aktiv så længe betingelserne i blokken er opfyldt. Ref. 1.3.05.b-UD01." note-2="Hjælp: notér i 1.3.05.b. Lys og ventilatorstyring hvilke produkter &quot;Lys (også til kontrollys)&quot; betjener. Ref. 1.3.05.b-UD01."/>
               <resource_output id="_0x11cd12" name="Ventilator" icon="_0x39" note="Udgang &quot;Ventilator&quot; fra funktionsblok 1.3.05.b. Forbindes til lampeudtag eller relæ. Ref. 1.3.05.b-UD02." note-2="Vejledning - &quot;Ventilator&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 1.3.05.b-UD02."/>
            </outputs>
            <settings id="_0x11ce25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_time id="_0x11cf0d" name="Timer_1 (efterløb vetilation)" icon="_0x2f" note="Parameter &quot;Timer_1 (efterløb vetilation)&quot; - fastsætter blokkens driftsværdi.&#xD;&#xA;Ref. 1.3.05.b-IS01." hour="0" minute="4" second="30" note-2="Vejledning - &quot;Timer_1 (efterløb vetilation)&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 1.3.05.b-IS01."/>
               <resource_time id="_0x11d00d" name="Timer_2 (tænd ventilator)" icon="_0x2f" note="Indstilling &quot;Timer_2 (tænd ventilator)&quot;. Ændres kun efter aftale med bygherren. Ref. 1.3.05.b-IS02." hour="0" minute="2" second="10" note-2="Tip: notér den valgte værdi for &quot;Timer_2 (tænd ventilator)&quot; i anlægsdokumentationen. Ref. 1.3.05.b-IS02."/>
               <resource_enum id="_0x11d10f" name="Ventilator kører" typedef="_0x11c247" inivalue="_0x11c448" icon="_0x22" note="Setpunkt &quot;Ventilator kører&quot; på 1.3.05.b. Lys og ventilatorstyring. Værdien gemmes i controllerens projektfil. Ref. 1.3.05.b-IS03." note-2="Note: &quot;Ventilator kører&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 1.3.05.b-IS03."/>
            </settings>
            <internalsettings id="_0x11d229" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
