      <group id="_0x2d2032" name="FB 5.2 Klima Udvidet" icon="_0x15" note="locNote 1029">
         <functionblock id="_0x2d2128" name="5.2.01.h. Betjeningspanel" master_schneider_electric="yes" master_type="5.2.01" master_version="h" master_name="Betjeningspanel" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="Panelet anvendes til at vælge drift på klimastyringen af varme og ventilation&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse mærker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." udf="#5.2.01.a#">
            <inputs id="_0x2d2923" name="Indgang" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x2d2a11" name="Indgang Beboet" icon="_0x36" note="Driftform: &quot;Beboet&quot;. Ved langt tryk starter testfunktion. Efter test går styringen  tilbage til beboet drift.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Indgang Beboet&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.2.01.h-IN01." udf="#I01#"/>
               <resource_input id="_0x2d2b11" name="Indgang Ubeboet" icon="_0x36" note="Driftform: &quot;Ubeboet&quot;. Ved langt tryk starter testfunktion. Efter test går styringen  tilbage til ubeboet drift.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Indgang Ubeboet&quot; til det tryk der skal betjene funktionen. Ref. 5.2.01.h-IN02." udf="#I02#"/>
               <resource_input id="_0x2d2c11" name="Indgang Frostsikring" icon="_0x36" note="Driftform: &quot;Frostsikring&quot;. Ved langt tryk starter testfunktion. Efter test går styringen  tilbage til Frostsikringsdrift.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Indgang Frostsikring&quot; bør kun linkes til én indgang ad gangen. Ref. 5.2.01.h-IN03." udf="#I03#"/>
               <resource_input id="_0x2d2d11" name="Indgang for start af ventilmotion" icon="_0x36" note="Forbindes fra &quot;udgang for ventilmotion&quot; på&#xD;&#xA;FB 5.2.03 pumpestyring&#xD;&#xA;Anvendes til at motionere ventiler og pumpe så de ikke &quot;gror&quot; fast.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Indgang for start af ventilmotion&quot; på 5.2.01.h: signalet skal være stabilt i &gt; 100 ms. Ref. 5.2.01.h-IN04." udf="#I04#"/>
               <resource_input id="_0x2d2e11" name="Indgang til aktivering og deaktivering af aut. skift til beboet" icon="_0x36" note="Anvendes til aktivering og deaktivering af automatisk skift til beboet drift. Automatisk skift sker KUN hvis, udgangen &quot;udgang skift til beboet&quot; er on&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Indgang til aktivering og deaktivering af aut. skift til beboet&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 5.2.01.h-IN05." udf="#I05#"/>
               <resource_input id="_0x2d2f11" name="Indgang til aktivering og deaktivering af aut. skift til ubeboet" icon="_0x36" note="Anvendes til aktivering og deaktivering af automatisk skift til ubeboet drift. Automatisk skift sker KUN hvis, udgangen &quot;udgang skift til ubeboet&quot; er on&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Indgang til aktivering og deaktivering af aut. skift til ubeboet&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.2.01.h-IN06." udf="#I06#"/>
               <resource_input id="_0x2d3011" name="Indgang til aktivering og deaktivering af aut. skift til frostsikring" icon="_0x36" note="Anvendes til aktivering og deaktivering af automatisk skift til frostsikret drift. Automatisk skift sker KUN hvis, udgangen &quot;udgang skift til frostsikret&quot; er on&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Indgang til aktivering og deaktivering af aut. skift til frostsikring&quot; til det tryk der skal betjene funktionen. Ref. 5.2.01.h-IN07."/>
            </inputs>
            <outputs id="_0x2d3124" name="Udgang" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x2d3212" name="Udgang beboet (LED ØV)" icon="_0x39" note="Lyser konstant ved Beboet tilstand&#xD;&#xA;Blinker ved test eller ventilmotion aktiv&#xD;&#xA;Forbindes til diode i betjeningspanel eller anden indikering.&#xD;&#xA;Hvis de tre dioder Beboet, Ubeboet, og frostsikring, blinker på skift, nedefra og op er betjeningspanelet i Test tilstand og &#xD;&#xA;oppefra og ned når Ventilmotion er i gang.&#xD;&#xA;&#xD;&#xA;" note-2="Note: &quot;Udgang beboet (LED ØV)&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.2.01.h-UD01." udf="#O01#"/>
               <resource_output id="_0x2d3312" name="Udgang ubeboet (LED MV)" icon="_0x39" note="Lyser konstant ved ubeboet tilstand&#xD;&#xA;Blinker ved test eller ventilmotion aktiv&#xD;&#xA;Forbindes til diode i betjeningspanel eller anden indikering.&#xD;&#xA;Hvis de tre dioder Beboet, Ubeboet, og frostsikring, blinker på skift, nedefra og op er betjeningspanelet i Test tilstand og &#xD;&#xA;oppefra og ned når Ventilmotion er i gang.&#xD;&#xA;" note-2="Vejledning: verificér &quot;Udgang ubeboet (LED MV)&quot; med en måling på klemmen (230 V AC). Ref. 5.2.01.h-UD02." udf="#O02#"/>
               <resource_output id="_0x2d3412" name="Udgang frostsikring (LED NV)" icon="_0x39" note="Lyser konstant ved frostsikret tilstand&#xD;&#xA;Blinker ved test eller ventilmotion aktiv&#xD;&#xA;Forbindes til diode i betjeningspanel eller anden indikering.&#xD;&#xA;Hvis de tre dioder Beboet, Ubeboet, og frostsikring, blinker på skift, nedefra og op er betjeningspanelet i Test tilstand og &#xD;&#xA;oppefra og ned når Ventilmotion er i gang." note-2="Hjælp: notér i 5.2.01.h. Betjeningspanel hvilke produkter &quot;Udgang frostsikring (LED NV)&quot; betjener. Ref. 5.2.01.h-UD03." udf="#O03#"/>
               <resource_output id="_0x2d3512" name="Udgang for indikering af test er i gang" icon="_0x39" note="Kan anvendes til indikation. Bemærk at de tre forgående udgange allerede indikerer test." note-2="Vejledning - &quot;Udgang for indikering af test er i gang&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 5.2.01.h-UD04." udf="#O04#"/>
               <resource_output id="_0x2d3612" name="Udgang automatisk skift til beboet (on ved aktiv)" backup="yes" icon="_0x39" note="Viser at automatisk skift til beboet er aktiv. &#xD;&#xA;Denne funktion kan aktiveres / deaktiveres, fra indgangen til aktivering og deaktivering af aut. skift til beboet.&#xD;&#xA;Hvis denne udgang er ON, vil betjeningspanelet automatisk skifte til ?Beboet? tilstand den dato der er indtastet under indstillinger." note-2="Tip: brug &quot;Udgang automatisk skift til beboet (on ved aktiv)&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.2.01.h-UD05." udf="#O05#"/>
               <resource_output id="_0x2d3712" name="Udgang automatisk skift til ubeboet (on ved aktiv)" backup="yes" icon="_0x39" note="Viser at automatisk skift til ubeboet er aktiv. &#xD;&#xA;Denne funktion kan aktiveres / deaktiveres, fra indgangen til aktivering og deaktivering af aut. skift til ubeboet.&#xD;&#xA;Hvis denne udgang er ON, vil betjeningspanelet automatisk skifte til ubeboet tilstand den dato der er indtastet under indstillinger.&#xD;&#xA;" note-2="Note: &quot;Udgang automatisk skift til ubeboet (on ved aktiv)&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.2.01.h-UD06." udf="#O06#"/>
               <resource_output id="_0x2d3812" name="Udgang automatisk skift til frostsikring (on ved aktiv)" backup="yes" icon="_0x39" note="Viser at automatisk skift til frostsikring er aktiv. &#xD;&#xA;Denne funktion kan aktiveres / deaktiveres, fra indgangen til aktivering og deaktivering af aut. skift til frostsikret.&#xD;&#xA;Hvis denne udgang er ON, vil betjeningspanelet automatisk skifte til frostsikret tilstand den dato der er indtastet under indstillinger.&#xD;&#xA;" note-2="Vejledning: verificér &quot;Udgang automatisk skift til frostsikring (on ved aktiv)&quot; med en måling på klemmen (230 V AC). Ref. 5.2.01.h-UD07." udf="#O06#"/>
               <resource_enum id="_0x2d390f" name="Driftform" typedef="_0x2d2247" inivalue="_0x2d2348" backup="yes" icon="_0x22" note="Skal forbindes til funktionsblok 5.2.05 eller 5.2.06 indgang driftform&#xD;&#xA;Styrer driftform og viser hvilken driftform, der er aktiv.&#xD;&#xA;" note-2="Hjælp: notér i 5.2.01.h. Betjeningspanel hvilke produkter &quot;Driftform&quot; betjener. Ref. 5.2.01.h-UD08.">
                  <link_from_resource id="_0x4a252d" name="Følg Link" icon="_0x47" link="_0x4a262c"/>
               </resource_enum>
            </outputs>
            <settings id="_0x2d3a25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
