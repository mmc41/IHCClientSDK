         <functionblock id="_0x3b9628" name="5.4.03. Hustilstand - Ventilation" master_schneider_electric="yes" master_type="5.4.03" master_name="Hustilstand - Ventilation" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="5.4.03 Hustilstand - Ventilation&#xD;&#xA;&#xD;&#xA;Hustilstandsblok til IHC ventilationsstyring&#xD;&#xA;Forbindes til funkktionsblok 5.4.01&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse mærker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." udf="#10.5.01#">
            <inputs id="_0x3b9c23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x3b9d11" name="Hjemme / Dag" icon="_0x36" note="Aktiveres når tilstand skal skifte til tilstanden hjemme / dag.&#xD;&#xA;F.eks. ved frakobling af alarm, tryk på velkommen hjem eller ved skift til dag- fra nattilstand (kan ske på tryk eller ur for skift til dag), Ved skift til dag - husk spæring når alarm er tilkoblet.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Hjemme / Dag&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 5.4.03-IN01."/>
               <resource_input id="_0x3b9e11" name="Ikke hjemme" icon="_0x36" note="Aktiveres når tilstand skal skifte til tilstanden ikke hjemme.&#xD;&#xA;F.eks. ved tilkobling af alarm eller tryk på slukalt&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Ikke hjemme&quot; i simulering før anlægget sættes i drift. Ref. 5.4.03-IN02."/>
               <resource_input id="_0x3b9f11" name="Hjemme / Nat" icon="_0x36" note="Aktiveres når tilstand skal skifte til tilstanden Hjemme / nat.&#xD;&#xA;F.eks. tryk på godnattryk ved seng.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Hjemme / Nat&quot; er linket til i 5.4.03. Hustilstand - Ventilation. Ref. 5.4.03-IN03."/>
            </inputs>
            <outputs id="_0x3ba024" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_enum id="_0x3ba10f" name="Hustilstand" typedef="_0x380847" inivalue="_0x380948" backup="yes" icon="_0x22" note="Visning af hustilstand (hjemme, ikke hjemme eller nat).&#xD;&#xA;Forbindes til funktionsblok 5.4.01 Ventilationsstyring" note-2="Bemærk: &quot;Hustilstand&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 5.4.03-UD01.">
                  <link_from_resource id="_0x4a832d" name="Følg Link" icon="_0x47" link="_0x4a842c"/>
               </resource_enum>
            </outputs>
