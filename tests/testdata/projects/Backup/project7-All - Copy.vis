         <functionblock id="_0x2f6a28" name="5.2.04.d. Ur til nat- og dagtemperatur" master_schneider_electric="yes" master_type="5.2.04" master_version="d" master_name="Ur til nat- og dagtemperatur" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="Ur til nat- og dagtemperatur&#xD;&#xA;&#xD;&#xA;Bruges til urstyring af nat- og dagtemperatur, med mulighed for overstyring af dagtemperatur. der er ingen dagtemperatur på fridage.&#xD;&#xA;VIGTIGT: Bemærk at urblokken som default kører konstantdrift.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." udf="#5.2.04#">
            <inputs id="_0x2f6e23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x2f6f11" name="Urstyret" icon="_0x36" note="Ved aktivering af urdrift skiftes imellem skift mellem normal-, nat- og dagtemperatur.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Urstyret&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 5.2.04.d-IN01."/>
               <resource_input id="_0x2f7011" name="Konstant" icon="_0x36" note="Konstantdrift anvendes hvis man ikke ønsker urstyret skift mellem normal-, nat- og dagtemperatur.&#xD;&#xA;Ved konstantdrift skal man manuelt vælge mellem normal-, nat- og dagtemperatur. &#xD;&#xA;BEMÆRK: Default (ved opstart) er funktionsblokken opsat til at køre i konstantdrift og skifter derved ikke automatisk mellem normal-, dag- eller nattemperatur. Hvis dette ønskes skal man manuelt aktivere urdrift ved at påvirke denne indgang.&#xD;&#xA;Tip: Er konstantdrift valgt og man ønsker at anvende nattemperatur kan det tilvælges under indstillinger vælge &quot;nattemperatur også ved konstantdrift&quot;.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Konstant&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.2.04.d-IN02."/>
               <resource_input id="_0x2f7111" name="Konstant / urdrift" icon="_0x36" note="Ved aktivering skiftes imellem konstant- og urdrift.&#xD;&#xA;Konstantdrift anvendes hvis man ikke ønsker urstyret skift mellem normal-, nat- og dagtemperatur.&#xD;&#xA;Ved konstantdrift skal man manuelt vælge mellem normal-, nat- og dagtemperatur. &#xD;&#xA;BEMÆRK: Default (ved opstart) er funktionsblokken opsat til at køre i konstantdrift og skifter derved ikke automatisk mellem normal-, dag- eller nattemperatur. Hvis dette ønskes skal man manuelt aktivere urdrift ved at påvirke denne indgang.&#xD;&#xA;Tip: Er konstantdrift valgt og man ønsker at anvende nattemperatur kan det tilvælges under indstillinger vælge &quot;nattemperatur også ved konstantdrift&quot;.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Konstant / urdrift&quot; til det tryk der skal betjene funktionen. Ref. 5.2.04.d-IN03." udf="#I01#"/>
               <resource_input id="_0x2f7211" name="Helligdag eller fridag" icon="_0x36" note="Indgang til styring af &quot;skæve&quot; fridage og helligdage.&#xD;&#xA;Når indgang er aktiv deaktiveres dagtemperatur således at der er normaltemperatur hele dagen.&#xD;&#xA;Manuel overstyring anvendes typisk hvis man er hjemme på en hverdag.&#xD;&#xA;Bemærk: Ved denne overstyring vil tidspunkter for skift til nattemperatur på hverdage blive anvendt. &#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;&#xD;&#xA;" note-2="Bemærk: &quot;Helligdag eller fridag&quot; bør kun linkes til én indgang ad gangen. Ref. 5.2.04.d-IN04." udf="#I02#"/>
               <resource_input id="_0x2f7311" name="Konstant dagtemperatur" icon="_0x36" note="Pulsindgang til aktivering af konstantdrift dagtemperatur..&#xD;&#xA;Kun aktiv hvis konstantdrift er aktiveret.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Konstant dagtemperatur&quot; på 5.2.04.d: signalet skal være stabilt i &gt; 100 ms. Ref. 5.2.04.d-IN05."/>
               <resource_input id="_0x2f7411" name="Konstant nattemperatur" icon="_0x36" note="Pulsindgang til aktivering af konstantdrift nattemperatur..&#xD;&#xA;Kun aktiv hvis konstantdrift er aktiveret.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Konstant nattemperatur&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 5.2.04.d-IN06."/>
               <resource_input id="_0x2f7511" name="Konstant normaltemperatur" icon="_0x36" note="Pulsindgang til aktivering af konstantdrift normaltemperatur..&#xD;&#xA;Kun aktiv hvis konstantdrift er aktiveret.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Konstant normaltemperatur&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.2.04.d-IN07."/>
            </inputs>
            <outputs id="_0x2f7624" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x2f7712" name="Dagtemperatur" icon="_0x39" note="On ved dagtemperatur. Forbindes til FB 5.2.05 - indgang dagtemperatur.&#xD;&#xA;Kan også anvendes til indikering." note-2="Tip: brug &quot;Dagtemperatur&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.2.04.d-UD01." udf="#O01#"/>
               <resource_output id="_0x2f7812" name="Nattemperatur" icon="_0x39" note="On ved natsænkning. Forbindes til FB 5.2.05 - indgang nattemperatur.&#xD;&#xA;Kan også anvendes til indikering." note-2="Note: &quot;Nattemperatur&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.2.04.d-UD02." udf="#O02#"/>
               <resource_output id="_0x2f7912" name="Normaltemperatur" icon="_0x39" note="On ved anvendelse af normaltemperatur.&#xD;&#xA;Normaldrift = Ingen aktivering af dag- eller nattemperatur.&#xD;&#xA;Kan også anvendes til indikering." note-2="Vejledning: verificér &quot;Normaltemperatur&quot; med en måling på klemmen (230 V AC). Ref. 5.2.04.d-UD03." udf="#O04#"/>
               <resource_output id="_0x2f7a12" name="Dag- eller nattemperatur" icon="_0x39" note="Indikerer at dag- eller nattemperatur er aktiv.&#xD;&#xA;Kan forbindes til urindgang på 5.2.06 Simpel varmeblok hvis man både ønsker dag- og natsænkning.&#xD;&#xA;Kan også anvendes til indikering af at  styring ikke er i normaltemperatur." note-2="Hjælp: notér i 5.2.04.d. Ur til nat- og dagtemperatur hvilke produkter &quot;Dag- eller nattemperatur&quot; betjener. Ref. 5.2.04.d-UD04." udf="#O03#"/>
               <resource_output id="_0x2f7b12" name="Helligdag eller fridag" backup="yes" icon="_0x39" note="On når indgang for hellig- eller fridag er aktiv. Anvendes til indikering" note-2="Vejledning - &quot;Helligdag eller fridag&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 5.2.04.d-UD05." udf="#O05#"/>
               <resource_output id="_0x2f7c12" name="Konstantdrift" backup="yes" icon="_0x39" note="On ved konstant drift. Anvendes til indikering." inivalue="on" note-2="Tip: brug &quot;Konstantdrift&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.2.04.d-UD06." udf="#O06#"/>
               <resource_output id="_0x2f7d12" name="Urdrift" backup="yes" icon="_0x39" note="On ved urdrift. Anvendes til indikering." note-2="Note: &quot;Urdrift&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.2.04.d-UD07."/>
            </outputs>
            <settings id="_0x2f7e25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_time id="_0x2f7f0d" name="Tidspunkt for dagtemperatur start" backup="yes" icon="_0x2f" note="Tidspunkt for dagtemperatur start:&#xD;&#xA;Sættes dagtemperatur start og slut ens er uret ikke aktivt.&#xD;&#xA;Ved &quot;helligdag eller fridag&quot; er uret ikke aktivt&#xD;&#xA;&#xD;&#xA;" hour="7" minute="0" second="0" note-2="Hjælpetekst: &quot;Tidspunkt for dagtemperatur start&quot; justeres til anlæggets faktiske forhold. Ref. 5.2.04.d-IS01." udf="#SS01#"/>
               <resource_time id="_0x2f800d" name="Tidspunkt for dagtemperatur slut" backup="yes" icon="_0x2f" note="Tidspunkt for dagtemperatur slut:&#xD;&#xA;Sættes dagtemperatur start og slut ens er uret ikke aktivt.&#xD;&#xA;Ved &quot;helligdag eller fridag&quot; er uret ikke aktivt" hour="14" minute="45" second="0" note-2="Bemærk: &quot;Tidspunkt for dagtemperatur slut&quot; træder i kraft ved næste programafvikling. Ref. 5.2.04.d-IS02." udf="#SS02#"/>
               <resource_time id="_0x2f810d" name="Tidspunkt for nattemperatur hverdag start" backup="yes" icon="_0x2f" note="Tidspunkt for  nattemperatur hverdag start:&#xD;&#xA;Sættes nattemperatur start og slut ens er uret ikke aktivt.&#xD;&#xA;" hour="20" minute="45" second="0" note-2="Hjælp til &quot;Tidspunkt for nattemperatur hverdag start&quot; på 5.2.04.d: værdier &lt; minimum afvises af controlleren. Ref. 5.2.04.d-IS03." udf="#SS03#"/>
               <resource_time id="_0x2f820d" name="Tidspunkt for nattemperatur hverdag slut" backup="yes" icon="_0x2f" note="Tidspunkt for  nattemperatur hverdag slut:&#xD;&#xA;Sættes nattemperatur start og slut ens er uret ikke aktivt." hour="4" minute="45" second="0" note-2="Hjælpetekst for &quot;Tidspunkt for nattemperatur hverdag slut&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.2.04.d-IS04." udf="#SS04#"/>
               <resource_time id="_0x2f830d" name="Tidspunkt for nattemperatur fri-/helligdage start" backup="yes" icon="_0x2f" note="Tidspunkt for nattemperatur fri-/helligdag start:&#xD;&#xA;Sættes nattemperatur fri-/helligdag start og slut ens er uret ikke aktivt." hour="22" minute="0" second="0" note-2="Bemærk: &quot;Tidspunkt for nattemperatur fri-/helligdage start&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.2.04.d-IS05." udf="#SS05#"/>
               <resource_time id="_0x2f840d" name="Tidspunkt for nattemperatur fri-/helligdage slut" backup="yes" icon="_0x2f" note="Tidspunkt for nattemperatur fri-/helligdag slut:&#xD;&#xA;Sættes nattemperatur fri-/helligdag start og slut ens er uret ikke aktivt." hour="5" minute="15" second="0" note-2="Hjælpetekst: &quot;Tidspunkt for nattemperatur fri-/helligdage slut&quot; justeres til anlæggets faktiske forhold. Ref. 5.2.04.d-IS06." udf="#SS06#"/>
               <resource_weekday id="_0x2f8509" name="Første fridag" backup="yes" icon="_0x2c" note="Indstilling af første fridag." inivalue="wednesday" note-2="Bemærk: &quot;Første fridag&quot; træder i kraft ved næste programafvikling. Ref. 5.2.04.d-IS07." udf="#SS07#"/>
               <resource_weekday id="_0x2f8609" name="Sidste fridag" backup="yes" icon="_0x2c" note="Indstilling af sidste fridag" inivalue="saturday" note-2="Hjælp til &quot;Sidste fridag&quot; på 5.2.04.d: værdier &lt; minimum afvises af controlleren. Ref. 5.2.04.d-IS08." udf="#SS08#"/>
               <resource_enum id="_0x2f870f" name="Nattemperatur" typedef="_0x2f6b47" inivalue="_0x2f6c48" backup="yes" icon="_0x22" note="Vælg om nattemperatur skal overstyres ved konstant drift.&#xD;&#xA;Hvis &quot;Nattemperatur også ved konstantdrift&quot; er valgt, vil nattemperatur være aktiv iht til urtider selvom der vælges konstantdrift." note-2="Hjælpetekst for &quot;Nattemperatur&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.2.04.d-IS09." udf="#SA09#"/>
