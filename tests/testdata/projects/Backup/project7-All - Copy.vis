         <functionblock id="_0x13a228" name="1.3.07. Fugtstyret ventilation" master_schneider_electric="yes" master_type="1.3.07" master_name="Fugtstyret ventilation" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="1.3.07. Fugtstyret ventilation&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Starter ventilationen når rummets relative fugtighed stiger mere end den&#xD;&#xA;indstillede maksimale difference (&gt; 10 % RH) over referencemålingen.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.">
            <inputs id="_0x13a323" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_humidity_level id="_0x13a427" name="Fugtighed" note="Indgang &quot;Fugtighed&quot;: aktiv når signalet skifter til ON (&gt; 50 % af nominelt niveau). Ref. 1.3.07-IN01." inivalue="50.00" note-2="Hjælp til &quot;Fugtighed&quot; på 1.3.07: signalet skal være stabilt i &gt; 100 ms. Ref. 1.3.07-IN01.">
                  <link_to_resource id="_0x4a162c" name="Følg Link" icon="_0x4a" link="_0x4a152d"/>
               </resource_humidity_level>
               <resource_humidity_level id="_0x13a527" name="Fugtighed reference" note="Indgang &quot;Fugtighed reference&quot; - anvendes ved manuel betjening af anlægget.&#xD;&#xA;Ref. 1.3.07-IN02." note-2="Hjælpetekst for &quot;Fugtighed reference&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 1.3.07-IN02."/>
               <resource_input id="_0x13a611" name="Tænd" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Bemærk: &quot;Tænd&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 1.3.07-IN03."/>
               <resource_input id="_0x13a711" name="Sluk" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Sluk&quot; til det tryk der skal betjene funktionen. Ref. 1.3.07-IN04."/>
            </inputs>
