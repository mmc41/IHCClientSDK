         <functionblock id="_0x3ed528" name="6.1.05. LK Kodetastatur testblok" master_schneider_electric="yes" master_type="6.1.05" master_name="LK Kodetastatur testblok" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="6.1.05. LK Kodetastatur testblok&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til at teste om LK kodetastaturet er korekt installeret.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x3ed623" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x3ed711" name="Indgang 1 fra kodetastatur" icon="_0x36" note="Forbindes med udgang 1 fra kodetastatur &#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Indgang 1 fra kodetastatur&quot; på 6.1.05: signalet skal være stabilt i &gt; 100 ms. Ref. 6.1.05-IN01."/>
               <resource_input id="_0x3ed811" name="Indgang 2 fra kodetastatur" icon="_0x36" note="Forbindes med udgang 2 fra kodetastatur &#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Indgang 2 fra kodetastatur&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 6.1.05-IN02."/>
               <resource_input id="_0x3ed911" name="Indgang 3 fra kodetastatur" icon="_0x36" note="Forbindes med udgang 3 fra kodetastatur &#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Indgang 3 fra kodetastatur&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 6.1.05-IN03."/>
            </inputs>
            <outputs id="_0x3eda24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x3edb12" name="Udgang for brugerkode 1" icon="_0x39" note="Udgang skifter status ved korrekt indtastet kode" note-2="Vejledning: verificér &quot;Udgang for brugerkode 1&quot; med en måling på klemmen (230 V AC). Ref. 6.1.05-UD01."/>
               <resource_output id="_0x3edc12" name="Udgang for brugerkode 2" icon="_0x39" note="Udgang skifter status ved korrekt indtastet kode" note-2="Hjælp: notér i 6.1.05. LK Kodetastatur testblok hvilke produkter &quot;Udgang for brugerkode 2&quot; betjener. Ref. 6.1.05-UD02."/>
               <resource_output id="_0x3edd12" name="Udgang for brugerkode 3" icon="_0x39" note="Udgang skifter status ved korrekt indtastet kode" note-2="Vejledning - &quot;Udgang for brugerkode 3&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.1.05-UD03."/>
               <resource_output id="_0x3ede12" name="Udgang for brugerkode 4" icon="_0x39" note="Udgang skifter status ved korrekt indtastet kode" note-2="Tip: brug &quot;Udgang for brugerkode 4&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.1.05-UD04."/>
               <resource_output id="_0x3edf12" name="Udgang for brugerkode 5" icon="_0x39" note="Udgang skifter status ved korrekt indtastet kode" note-2="Note: &quot;Udgang for brugerkode 5&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.1.05-UD05."/>
               <resource_output id="_0x3ee012" name="Udgang for brugerkode 6" icon="_0x39" note="Udgang skifter status ved korrekt indtastet kode" note-2="Vejledning: verificér &quot;Udgang for brugerkode 6&quot; med en måling på klemmen (230 V AC). Ref. 6.1.05-UD06."/>
               <resource_output id="_0x3ee112" name="Udgang for sabotage" icon="_0x39" note="Udgang er on ved sabotage på kodetastatur" note-2="Hjælp: notér i 6.1.05. LK Kodetastatur testblok hvilke produkter &quot;Udgang for sabotage&quot; betjener. Ref. 6.1.05-UD07."/>
            </outputs>
