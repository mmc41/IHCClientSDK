         <functionblock id="_0x3ab728" name="5.4.02. NILAN Gateway" master_schneider_electric="yes" master_type="5.4.02" master_name="NILAN Gateway" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="5.4.02. Ventilations gateway&#xD;&#xA;&#xD;&#xA;Passer til Nilan ventilationsanlæg med CTS - 602  print. f.eks comfort 300.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse, marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.">
            <inputs id="_0x3ad023" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_enum id="_0x3ad10f" name="1. Ventilations temp." typedef="_0x37fc47" inivalue="_0x380248" icon="_0x22" note="Forbindes fra 5.4.01.b. Ventilationsstyring funktionsblok - Output 1. Ventilationstemperatur." note-2="Note: &quot;1. Ventilations temp.&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 5.4.02-IN01.">
                  <link_to_resource id="_0x4a7e2c" name="Følg Link" icon="_0x4a" link="_0x4a7d2d"/>
               </resource_enum>
               <resource_enum id="_0x3ad20f" name="2. Ventilations drift trin" typedef="_0x37f147" inivalue="_0x37f248" icon="_0x22" note="Forbindes fra 5.4.01.b. Ventilationsstyring funktionsblok - Output 2. Ventilations drift trin" note-2="Vejledning: test &quot;2. Ventilations drift trin&quot; i simulering før anlægget sættes i drift. Ref. 5.4.02-IN02.">
                  <link_to_resource id="_0x4a282c" name="Følg Link" icon="_0x4a" link="_0x4a272d"/>
               </resource_enum>
               <resource_enum id="_0x3ad30f" name="3. Ventilations styreform" typedef="_0x37f847" inivalue="_0x37fa48" icon="_0x22" note="Forbindes fra 5.4.01.b. Ventilationsstyring funktionsblok - Output 3. Ventilations styreform" note-2="Hjælp: dokumentér hvilket produkt &quot;3. Ventilations styreform&quot; er linket til i 5.4.02. NILAN Gateway. Ref. 5.4.02-IN03.">
                  <link_to_resource id="_0x4a2a2c" name="Følg Link" icon="_0x4a" link="_0x4a292d"/>
               </resource_enum>
               <resource_enum id="_0x3ad40f" name="4. Ventilations drift form" typedef="_0x37ec47" inivalue="_0x37ef48" icon="_0x22" note="Forbindes fra 5.4.01.b. Ventilationsstyring funktionsblok - Output 4. Ventilations drift form" note-2="Vejledning - &quot;4. Ventilations drift form&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 5.4.02-IN04.">
                  <link_to_resource id="_0x4a2c2c" name="Følg Link" icon="_0x4a" link="_0x4a2b2d"/>
               </resource_enum>
               <resource_input id="_0x3ad511" name="Indgang fra PLC for update" icon="_0x36" note="Når indgang aktiveres opdateres alle parametre i Nilan anlægget&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Indgang fra PLC for update&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 5.4.02-IN05."/>
            </inputs>
            <outputs id="_0x3ad624" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x3ad712" name="Udgang 1. til PLC indgang 0." backup="yes" icon="_0x39" note="Forbindes til PLC indgang 0 på PLC i Nilan anlægget, som er forbundet via IHC Output 24&#xD;&#xA;" note-2="Hjælpetekst: &quot;Udgang 1. til PLC indgang 0.&quot; forbindes til det produkt der skal styres. Ref. 5.4.02-UD01."/>
               <resource_output id="_0x3ad812" name="Udgang 2. til PLC indgang 1." icon="_0x39" note="Forbindes til PLC indgang 1 på PLC i Nilan anlægget, som er forbundet via IHC Output 24" note-2="Bemærk: &quot;Udgang 2. til PLC indgang 1.&quot; kan linkes til flere produkter samtidigt. Ref. 5.4.02-UD02."/>
               <resource_output id="_0x3ad912" name="Udgang 3. til PLC indgang 2." icon="_0x39" note="Forbindes til PLC indgang 2 på PLC i Nilan anlægget, som er forbundet via IHC Output 24" note-2="Hjælp til &quot;Udgang 3. til PLC indgang 2.&quot; på 5.4.02: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 5.4.02-UD03."/>
               <resource_output id="_0x3ada12" name="Udgang 4. til PLC indgang 3." icon="_0x39" note="Forbindes til PLC indgang 3 på PLC i Nilan anlægget, som er forbundet via IHC Output 24" note-2="Hjælpetekst for &quot;Udgang 4. til PLC indgang 3.&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 5.4.02-UD04."/>
               <resource_output id="_0x3adb12" name="Udgang sender til gateway" icon="_0x39" note="Indikering af at data sendes til NILAN anlægget" note-2="Bemærk: &quot;Udgang sender til gateway&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 5.4.02-UD05."/>
            </outputs>
