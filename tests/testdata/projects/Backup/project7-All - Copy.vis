         <functionblock id="_0x17af28" name="2.1.02.c. Uge ur" master_schneider_electric="yes" master_type="2.1.02" master_version="c" master_name="Uge ur" master_programmer="Schneider Electric&#xD;&#xA;Copyright © 2009-2020" master_date_year="2020" master_date_month="6" master_date_day="17" locked="yes" icon="_0xe" note="2.1.02.c  Uge - døgn - hverdag/weekend UR med indgang for overstyring samt deaktivering af ur-blok &#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Ugeur hvor det er muligt at have flere urtider på samme dag.&#xD;&#xA;Hvis UR er sat til 00:00:00 er dette UR DEAKTIVERET !&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x17c623" name="Input" icon="_0x4">
               <resource_input id="_0x17c711" name="Manuel kip af udgang" icon="_0x36" note="Manuel overstyring af ur.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Manuel kip af udgang&quot; på 2.1.02.c: signalet skal være stabilt i &gt; 100 ms. Ref. 2.1.02.c-IN01."/>
               <resource_input id="_0x17c811" name="Manuel tænd" icon="_0x36" note="Manuel tænd af ur.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Manuel tænd&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 2.1.02.c-IN02."/>
               <resource_input id="_0x17c911" name="Manuel sluk" icon="_0x36" note="Manuel sluk af ur.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Manuel sluk&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 2.1.02.c-IN03."/>
               <resource_input id="_0x17ca11" name="Ur Aktiv" icon="_0x36" note="Skal være &quot;ON&quot; hvis uret skal være &quot;Aktiv&quot;&#xD;&#xA;Kan forbindes til Kalender funktionsblok eller Skumringsrelæ&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst: forbind &quot;Ur Aktiv&quot; til det tryk der skal betjene funktionen. Ref. 2.1.02.c-IN04."/>
            </inputs>
            <outputs id="_0x17cb24" name="Output" icon="_0x14">
               <resource_output id="_0x17cc12" name="Udgang for Ur" icon="_0x39" note="Anvendes til urstyring" note-2="Bemærk: &quot;Udgang for Ur&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 2.1.02.c-UD01.">
                  <link_from_resource id="_0x4a6b2d" name="Følg Link" icon="_0x47" link="_0x4a6c2c"/>
               </resource_output>
               <resource_output id="_0x17cd12" name="Udgang for ON puls" icon="_0x39" note="Anvendes ifm. sluk eller tænd indgange på andre funktionsblokke samt til styring af dimmere" note-2="Hjælpetekst: &quot;Udgang for ON puls&quot; forbindes til det produkt der skal styres. Ref. 2.1.02.c-UD02."/>
