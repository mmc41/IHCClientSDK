               <resource_integer id="_0x47fc0b" name="Antal pulser i anden pulsperiode" note="Her indstilles hvor mange pulser der skal være i anden pulsperiode" inivalue="10" note-2="Bemærk: &quot;Antal pulser i anden pulsperiode&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 6.4.02.a-IS08."/>
