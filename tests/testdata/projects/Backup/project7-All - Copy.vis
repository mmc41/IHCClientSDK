      <group id="_0x1b2832" name="FB 3.1 Persienne og jalousi" icon="_0x15" note="locNote 1025">
         <functionblock id="_0x1b2928" name="3.1.01. Persiennestyring" master_schneider_electric="yes" master_type="3.1.01" master_name="Persiennestyring" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="3.1.01. Persiennestyring&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til styring af persienne med tryk for op eller ned og div. aktuatorer (vindmåler, skumringsrelæ, solsensor m.m.)&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x1b3c23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x1b3d11" name="Alarm hæv" icon="_0x36" note="Indgang har højeste prioritet.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Alarm hæv&quot; på 3.1.01: signalet skal være stabilt i &gt; 100 ms. Ref. 3.1.01-IN01.">
                  <link_to_resource id="_0x49b82c" name="Følg Link" icon="_0x4a" link="_0x49b72d"/>
               </resource_input>
               <resource_input id="_0x1b3e11" name="Alarm sænk" icon="_0x36" note="Indgang har anden højeste prioritet.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Alarm sænk&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 3.1.01-IN02.">
                  <link_to_resource id="_0x49ba2c" name="Følg Link" icon="_0x4a" link="_0x49b92d"/>
               </resource_input>
               <resource_input id="_0x1b3f11" name="Vindmåler" icon="_0x36" note="Ved aktivering hæves persienne.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Vindmåler&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 3.1.01-IN03.">
                  <link_to_resource id="_0x49bc2c" name="Følg Link" icon="_0x4a" link="_0x49bb2d"/>
               </resource_input>
               <resource_input id="_0x1b4011" name="Regndetektor" icon="_0x36" note="Ved aktivering kører persienne op&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Regndetektor&quot; til det tryk der skal betjene funktionen. Ref. 3.1.01-IN04.">
                  <link_to_resource id="_0x49be2c" name="Følg Link" icon="_0x4a" link="_0x49bd2d"/>
               </resource_input>
               <resource_input id="_0x1b4111" name="Gruppebetjeningstryk hæv" icon="_0x36" note="Hæv persienne - Ved lang aktivering (&gt;1 sek.) hæves persienne. Ved kort aktivering (&lt;1 sek.) justeres persienne.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Gruppebetjeningstryk hæv&quot; bør kun linkes til én indgang ad gangen. Ref. 3.1.01-IN05."/>
               <resource_input id="_0x1b4211" name="Gruppebetjeningstryk sænk" icon="_0x36" note="Sænk persienne - Ved lang aktivering (&gt;1 sek.) sænkes persienne. Ved kort aktivering (&lt;1 sek.) justeres persienne.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Gruppebetjeningstryk sænk&quot; på 3.1.01: signalet skal være stabilt i &gt; 100 ms. Ref. 3.1.01-IN06."/>
               <resource_input id="_0x1b4311" name="Lokalbetjeningstryk hæv" icon="_0x36" note="Hæv persienne - Ved lang aktivering (&gt;1 sek.) hæves persienne. Ved kort aktivering (&lt;1 sek.) justeres persienne.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Lokalbetjeningstryk hæv&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 3.1.01-IN07."/>
               <resource_input id="_0x1b4411" name="Lokalbetjeningstryk sænk" icon="_0x36" note="Sænk persienne - Ved lang aktivering (&gt;1 sek.) sænkes persienne. Ved kort aktivering (&lt;1 sek.) justeres persienne.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Lokalbetjeningstryk sænk&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 3.1.01-IN08."/>
               <resource_input id="_0x1b4511" name="Skumringsrelæ" icon="_0x36" note="Ved on sænkes persienne for at spare på varmen.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Skumringsrelæ&quot; til det tryk der skal betjene funktionen. Ref. 3.1.01-IN09."/>
               <resource_input id="_0x1b4611" name="Ur for lukketid" icon="_0x36" note="I on perioden er persienner nede (f.eks. efter lukketid).&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Ur for lukketid&quot; bør kun linkes til én indgang ad gangen. Ref. 3.1.01-IN10."/>
               <resource_input id="_0x1b4711" name="Solsensor" icon="_0x36" note="Ved on sænkes persienne et stykke ned.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Solsensor&quot; på 3.1.01: signalet skal være stabilt i &gt; 100 ms. Ref. 3.1.01-IN11."/>
               <resource_input id="_0x1b4811" name="Man/auto" icon="_0x36" note="Man/auto - ved manuel tilstand ignoreres skumringsrelæ, ur og solsensor.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Man/auto&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 3.1.01-IN12."/>
               <resource_input id="_0x1b4911" name="Tillad trykfunktion" icon="_0x36" note="Lås manuel betjening - det er ikke muligt at betjene persienne hvis off.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;Tillad trykfunktion&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 3.1.01-IN13."/>
            </inputs>
            <outputs id="_0x1b4a24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x1b4b12" name="Op" icon="_0x39" note="Udgang &quot;Op&quot;. Niveau angives i % (0 % = slukket, 100 % = fuld styrke). Ref. 3.1.01-UD01." note-2="Vejledning: verificér &quot;Op&quot; med en måling på klemmen (230 V AC). Ref. 3.1.01-UD01.">
                  <link_from_resource id="_0x49bf2d" name="Følg Link" icon="_0x47" link="_0x49c02c"/>
               </resource_output>
               <resource_output id="_0x1b4c12" name="Ned" icon="_0x39" note="Udgang &quot;Ned&quot; fra 3.1.01 - forbindes til udgangsmodulet på datalinjen. Ref. 3.1.01-UD02." note-2="Hjælp: notér i 3.1.01. Persiennestyring hvilke produkter &quot;Ned&quot; betjener. Ref. 3.1.01-UD02.">
                  <link_from_resource id="_0x49c12d" name="Følg Link" icon="_0x47" link="_0x49c22c"/>
               </resource_output>
               <resource_output id="_0x1b4d12" name="Indikering af manuel" icon="_0x39" note="Når on er styring i manuel betjening." note-2="Vejledning - &quot;Indikering af manuel&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 3.1.01-UD03.">
                  <link_from_resource id="_0x4a712d" name="Følg Link" icon="_0x47" link="_0x4a722c"/>
               </resource_output>
            </outputs>
            <settings id="_0x1b4e25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x1b4f10" name="Timer for solafskærmning" icon="_0x43" note="Tiden persienne kører ned ved solsensor on" hour="0" minute="0" second="9" millisecond="0" note-2="Hjælpetekst: &quot;Timer for solafskærmning&quot; justeres til anlæggets faktiske forhold. Ref. 3.1.01-IS01."/>
               <resource_timer id="_0x1b5010" name="Timer for opkørsel" icon="_0x43" note="Tiden skal være lidt længere end tiden det tager persiennen at køre op." hour="0" minute="0" second="12" millisecond="0" note-2="Bemærk: &quot;Timer for opkørsel&quot; træder i kraft ved næste programafvikling. Ref. 3.1.01-IS02."/>
               <resource_timer id="_0x1b5110" name="Timer for nedkørsel" icon="_0x43" note="Tiden skal være lidt længere end tiden det tager persiennen at køre ned." hour="0" minute="0" second="8" millisecond="0" note-2="Hjælp til &quot;Timer for nedkørsel&quot; på 3.1.01: værdier &lt; minimum afvises af controlleren. Ref. 3.1.01-IS03."/>
               <resource_timer id="_0x1b5210" name="Timer for step" icon="_0x43" note="Den tid persienne skal steppes for at justere lameller." hour="0" minute="4" second="0" millisecond="300" note-2="Hjælpetekst for &quot;Timer for step&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 3.1.01-IS04."/>
               <resource_timer id="_0x1b5310" name="Timer for &quot;Slat&quot; ved solafskærmning" icon="_0x43" note="Den tid som persiennen kører tilbage for at justere vinklen på lamellerne." hour="0" minute="0" second="6" millisecond="0" note-2="Bemærk: &quot;Timer for &quot;Slat&quot; ved solafskærmning&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 3.1.01-IS05."/>
               <resource_time id="_0x1b540d" name="Tidspunkt for afstilling af manuel" backup="yes" icon="_0x2f" note="Driftsparameter &quot;Tidspunkt for afstilling af manuel&quot; - anvendes af blokkens interne program &amp; timere. Ref. 3.1.01-IS06." hour="21" minute="45" second="0" note-2="Hjælpetekst: &quot;Tidspunkt for afstilling af manuel&quot; justeres til anlæggets faktiske forhold. Ref. 3.1.01-IS06."/>
               <resource_enum id="_0x1b550f" name="Persienne tilstand" typedef="_0x1b2a47" inivalue="_0x1b2f48" icon="_0x22" note="Indstilling &quot;Persienne tilstand&quot; for 3.1.01. Kontrollér værdien efter opdatering af projektet. Ref. 3.1.01-IS07." note-2="Bemærk: &quot;Persienne tilstand&quot; træder i kraft ved næste programafvikling. Ref. 3.1.01-IS07."/>
