               <resource_output id="_0x3fa12" name="Udgang for Følg / Invertering " icon="_0x39" note="Udgangen følger eller inverterer indgangen alt efter om &quot;# Tilstand for udgang&quot; er sat til Følg eller Invertering." note-2="Vejledning - &quot;Udgang for Følg / Invertering&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 1.1.04.c-UD01.">
                  <link_from_resource id="_0x498b2d" name="Følg Link" icon="_0x47" link="_0x498c2c"/>
               </resource_output>
               <resource_output id="_0x3fb12" name="ON Puls" icon="_0x39" note="Giver kort puls når &quot;Udgang for Følg / Invertering &quot; går on." note-2="Tip: brug &quot;ON Puls&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 1.1.04.c-UD02."/>
               <resource_output id="_0x3fc12" name="OFF Puls" icon="_0x39" note="Giver kort puls når &quot;Udgang for Følg / Invertering &quot; går off." note-2="Note: &quot;OFF Puls&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 1.1.04.c-UD03."/>
               <resource_scene id="_0x3fd4a" name="Scenarie Tænd" note="Scenarie &quot;Scenarie Tænd&quot; - fremkaldes når blokkens udgang skifter tilstand. Ref. 1.1.04.c-UD04." note-2="Fremkalder dette scenarie når Udgang går on&#xD;&#xA;Sættes til den ønskede % eller &quot;ON&quot;">
