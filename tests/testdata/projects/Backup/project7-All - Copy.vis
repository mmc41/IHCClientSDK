         <functionblock id="_0x472628" name="6.3.03.a. Overfaldstryk" master_schneider_electric="yes" master_type="6.3.03" master_version="a" master_name="Overfaldstryk" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="6.3.03.a. Overfaldstryk&#xD;&#xA;&#xD;&#xA;Anvendes til to tast kombinationstryk ifb. med aktivering af overfaldsalarm&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.3 Sikkerhed\6.3.03.pdf">
            <inputs id="_0x472723" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x472811" name="Tryk ØV" icon="_0x36" note="Tryk Venstre og Højre aktiverer overfaldsalarm&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Tryk ØV&quot; på 6.3.03.a: signalet skal være stabilt i &gt; 100 ms. Ref. 6.3.03.a-IN01."/>
               <resource_input id="_0x472911" name="Tryk ØH" icon="_0x36" note="Tryk Venstre og Højre aktiverer overfaldsalarm&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Tryk ØH&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 6.3.03.a-IN02."/>
            </inputs>
            <outputs id="_0x472a24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x472b12" name="Udgang til alarmblok" icon="_0x39" note="Forbindes til alarmblok, Indgang for overfald" note-2="Hjælpetekst for &quot;Udgang til alarmblok&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 6.3.03.a-UD01."/>
            </outputs>
