      <group id="_0x60432" name="FB 1.2 Lysdaempning" icon="_0x15" note="locNote 1021">
         <functionblock id="_0x60528" name="1.2.02.c. Fortrådet lysdæmper " master_schneider_electric="yes" master_type="1.2.02" master_version="c" master_name="Fortrådet lysdæmper " master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2016" master_date_year="2017" master_date_month="7" master_date_day="23" locked="yes" icon="_0xe" note="1.2.02.c. Fortrådet lysdæmper&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til styring af fortrådet lysdæmper.&#xD;&#xA;Kan anvendes som 1- og/eller 2-tast betjent regulering. &#xD;&#xA;Kan fremkalde/gemme to scenarier.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse; markér overskrift på funktionsblok og tryk F1.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret&#xD;&#xA;">
            <inputs id="_0x61423" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x61511" name="Touch " icon="_0x36" note="Kort tryk tænd /sluk - langt tryk regulerer lys niveau op/ned &#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælpetekst: forbind &quot;Touch&quot; til det tryk der skal betjene funktionen. Ref. 1.2.02.c-IN01.">
                  <link_to_resource id="_0x49a42c" name="Følg Link" icon="_0x4a" link="_0x49a32d"/>
               </resource_input>
               <resource_input id="_0x61611" name="Tænd/regulér op" icon="_0x36" note="Kort tryk tænd - langt tryk regulerer lysniveau op&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Bemærk: &quot;Tænd/regulér op&quot; bør kun linkes til én indgang ad gangen. Ref. 1.2.02.c-IN02.">
                  <link_to_resource id="_0x49a62c" name="Følg Link" icon="_0x4a" link="_0x49a52d"/>
               </resource_input>
               <resource_input id="_0x61711" name="Sluk/regulér ned  " icon="_0x36" note="Kort tryk sluk - langt tryk regulerer lysniveau ned&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælp til &quot;Sluk/regulér ned&quot; på 1.2.02.c: signalet skal være stabilt i &gt; 100 ms. Ref. 1.2.02.c-IN03.">
                  <link_to_resource id="_0x49a82c" name="Følg Link" icon="_0x4a" link="_0x49a72d"/>
               </resource_input>
               <resource_input id="_0x61811" name="Høj" icon="_0x36" note="Fremkalder højt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som høj.&#xD;&#xA;Som kvittering blinker udgang samt diode i frontplade.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Høj&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 1.2.02.c-IN04.">
                  <link_to_resource id="_0x49aa2c" name="Følg Link" icon="_0x4a" link="_0x49a92d"/>
               </resource_input>
               <resource_input id="_0x61911" name="Lav " icon="_0x36" note="Fremkalder lavt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som lav.&#xD;&#xA;Som kvittering blinker udgang samt diode i frontplade.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Lav&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 1.2.02.c-IN05.">
                  <link_to_resource id="_0x49ac2c" name="Følg Link" icon="_0x4a" link="_0x49ab2d"/>
               </resource_input>
               <resource_input id="_0x61a11" name="Natdrift" icon="_0x36" note="Ved aktivitet (betingelse opfyldt) vil et kort regulerings tryk tænde lyset på &quot;Lavt niveau&quot;. PIR vil enten være helt eller delvist begrænset.&#xD;&#xA;Sammensættes med urfunktion eller dag og nat funktion.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Natdrift&quot; til det tryk der skal betjene funktionen. Ref. 1.2.02.c-IN06.">
                  <link_to_resource id="_0x49ae2c" name="Følg Link" icon="_0x4a" link="_0x49ad2d"/>
               </resource_input>
            </inputs>
            <outputs id="_0x61b24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x61c12" name="Tænd/regulér op" icon="_0x39" note="Forbindes til klemme 1 på 400 UNI IHC/SA.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Hjælpetekst for &quot;Tænd/regulér op&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 1.2.02.c-UD01.">
                  <link_from_resource id="_0x49af2d" name="Følg Link" icon="_0x47" link="_0x49b02c"/>
               </resource_output>
               <resource_output id="_0x61d12" name="Sluk/regulér ned" icon="_0x39" note="Forbindes til klemme 2 på 400 UNI IHC/SA.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Bemærk: &quot;Sluk/regulér ned&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 1.2.02.c-UD02.">
                  <link_from_resource id="_0x49b12d" name="Følg Link" icon="_0x47" link="_0x49b22c"/>
               </resource_output>
               <resource_output id="_0x61e12" name="Lavt niveau - Memory 1" icon="_0x39" note="Forbindes til klemme 3 på UNI Dimmer 400.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Hjælpetekst: &quot;Lavt niveau - Memory 1&quot; forbindes til det produkt der skal styres. Ref. 1.2.02.c-UD03.">
                  <link_from_resource id="_0x49b32d" name="Følg Link" icon="_0x47" link="_0x49b42c"/>
               </resource_output>
               <resource_output id="_0x61f12" name="Højt niveau - Memory 2" icon="_0x39" note="Forbindes til klemme 4 på 400 UNI IHC/SA.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Bemærk: &quot;Højt niveau - Memory 2&quot; kan linkes til flere produkter samtidigt. Ref. 1.2.02.c-UD04.">
                  <link_from_resource id="_0x49b52d" name="Følg Link" icon="_0x47" link="_0x49b62c"/>
               </resource_output>
               <resource_enum id="_0x6200f" name="Lysdæmper status" typedef="_0x60647" inivalue="_0x60848" backup="yes" icon="_0x22" note="Status indikering til Viewer." note-2="Hjælp til &quot;Lysdæmper status&quot; på 1.2.02.c: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 1.2.02.c-UD05."/>
               <resource_output id="_0x62112" name="Lysdæmper tændt" backup="yes" icon="_0x39" note="Status indikering i diode eller Viewer." note-2="Hjælpetekst for &quot;Lysdæmper tændt&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 1.2.02.c-UD06."/>
            </outputs>
            <settings id="_0x62225" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x6230f" name="Kort reguleringstryk tænder" typedef="_0x61047" inivalue="_0x61248" backup="yes" icon="_0x22" note="Her er det muligt, at vælge funktionalitet på reguleringstryk dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Højt niveau&#xD;&#xA;Lavt niveau&#xD;&#xA;Sidste niveau" note-2="Dette valg er kun aktivt dag/aften. Om natten (natdrift anvendt) vil et kort reguleringstryk tænde lys på lavt niveau.&#xD;&#xA;Ved frafald af &quot;Natdrift&quot; vil &quot;Højt niveau&quot; fremkaldes første gang der trykkes kort reguleringstryk selvom &quot;Sidste niveau&quot; er valgt. Dette er valgt fordi ny dag er kommet og gl. niveau ikke er relevant mere. "/>
            </settings>
            <internalsettings id="_0x62429" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x62510" name="Kvittéring for gemt scenarie " icon="_0x43" note="Privat variabel &quot;Kvittéring for gemt scenarie&quot; - må ikke linkes til produkter uden for blokken.&#xD;&#xA;Ref. 1.2.02.c-IV01." hour="0" minute="0" second="3" millisecond="0" note-2="Vejledning - &quot;Kvittéring for gemt scenarie&quot;: ændringer her påvirker blokkens program direkte.&#xD;&#xA;Ref. 1.2.02.c-IV01."/>
               <resource_timer id="_0x62610" name="Spærring" icon="_0x43" note="Arbejdsvariabel &quot;Spærring&quot; på 1.2.02.c. Fortrådet lysdæmper. Holder blokkens mellemresultat. Ref. 1.2.02.c-IV02." hour="0" minute="0" second="0" millisecond="50" note-2="Tip: følg &quot;Spærring&quot; i simuleringen for at forstå blokkens forløb. Ref. 1.2.02.c-IV02."/>
               <resource_timer id="_0x62710" name="Max tryktid" icon="_0x43" note="Intern variabel &quot;Max tryktid&quot;: sættes og læses udelukkende af 1.2.02.c. Ref. 1.2.02.c-IV03." hour="0" minute="0" second="0" millisecond="400" note-2="Note: &quot;Max tryktid&quot; er privat for blokken &amp; deles ikke med andre blokke.&#xD;&#xA;Ref. 1.2.02.c-IV03."/>
               <resource_timer id="_0x62810" name="Min. regulering 1" icon="_0x43" note="Hjælpevariabel &quot;Min. regulering 1&quot; - anvendes når blokken skal huske en tilstand. Ref. 1.2.02.c-IV04." hour="0" minute="0" second="0" millisecond="600" note-2="Vejledning: rør ikke &quot;Min. regulering 1&quot; medmindre blokken låses op. Ref. 1.2.02.c-IV04."/>
               <resource_timer id="_0x62910" name="Min. regulering 2" icon="_0x43" note="Intern variabel &quot;Min. regulering 2&quot;. Nulstilles når controlleren genstarter.&#xD;&#xA;Ref. 1.2.02.c-IV05." hour="0" minute="0" second="0" millisecond="600" note-2="Hjælp: &quot;Min. regulering 2&quot; i 1.2.02.c. Fortrådet lysdæmper dokumenteres kun af hensyn til service. Ref. 1.2.02.c-IV05."/>
               <resource_flag id="_0x62a0a" name="Reg. retning" icon="_0x33" note="Intern tidsstyring &quot;Reg. retning&quot; i 1.2.02.c. Værdien styres af programmet &amp; ikke af brugeren. Ref. 1.2.02.c-IV06." note-2="Vejledning - &quot;Reg. retning&quot;: ændringer her påvirker blokkens program direkte.&#xD;&#xA;Ref. 1.2.02.c-IV06."/>
               <resource_flag id="_0x62b0a" name="Oneshot man" backup="yes" icon="_0x33" note="Intern variabel &quot;Oneshot man&quot;: ikke synlig i konfigurationsvinduet (&lt; programmeringsmode). Ref. 1.2.02.c-IV07." note-2="Tip: følg &quot;Oneshot man&quot; i simuleringen for at forstå blokkens forløb. Ref. 1.2.02.c-IV07."/>
               <resource_timer id="_0x62c10" name="Puls" icon="_0x43" note="Intern variabel &quot;Puls&quot; - indgår i blokkens betingelser og kommandoer. Ref. 1.2.02.c-IV08." hour="0" minute="0" second="0" millisecond="250" note-2="Note: &quot;Puls&quot; er privat for blokken &amp; deles ikke med andre blokke.&#xD;&#xA;Ref. 1.2.02.c-IV08."/>
            </internalsettings>
