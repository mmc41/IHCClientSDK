      <group id="_0x140d32" name="FB 1.4 PIR og Timer" icon="_0x15" note="locNote 1023">
         <functionblock id="_0x140e28" name="1.4.02.a. PIR styring " master_schneider_electric="yes" master_type="1.4.02" master_version="a" master_name="PIR styring " master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2016" master_date_year="2017" master_date_month="9" master_date_day="14" locked="yes" icon="_0xe" note="1.4.02.a. PIR styring &#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til simpel styring af IHC Wireless produkter og relæer ifm. PIR og manuel betjening.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.">
            <inputs id="_0x141823" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x141911" name="PIR" icon="_0x36" note="Forbindes til tilstedeværelses indikering fra PIR sensor.&#xD;&#xA;Virkemåde defineres under indstillinger:&#xD;&#xA; &quot;# PIR funktion&quot;&#xD;&#xA; &quot;# PIR funktion nat&quot;&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;PIR&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 1.4.02.a-IN01.">
                  <link_to_resource id="_0x4a302c" name="Følg Link" icon="_0x4a" link="_0x4a2f2d"/>
               </resource_input>
               <resource_input id="_0x141a11" name="Skumring" icon="_0x36" note="Forbindes fra skumringssensor eller luxsensor ifm. funktionsblok 1.1.12&#xD;&#xA;Alternativt via ur funktionsblok.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" inivalue="on" note-2="Hjælpetekst: forbind &quot;Skumring&quot; til det tryk der skal betjene funktionen. Ref. 1.4.02.a-IN02.">
                  <link_to_resource id="_0x4a322c" name="Følg Link" icon="_0x4a" link="_0x4a312d"/>
               </resource_input>
               <resource_input id="_0x141b11" name="Tilbagemelding" icon="_0x36" note="Opret link mellem produktets &quot;Udgang&quot; og &quot;Tilbagemelding&quot;.&#xD;&#xA;Ved tilbagemelding begrænses genkald af IHC Wireless produkter ifm. PIR aktivitet." note-2="Bemærk: &quot;Tilbagemelding&quot; bør kun linkes til én indgang ad gangen. Ref. 1.4.02.a-IN03.">
                  <link_to_resource id="_0x4a702c" name="Følg Link" icon="_0x4a" link="_0x4a6f2d"/>
               </resource_input>
               <resource_input id="_0x141c11" name="Natdrift" icon="_0x36" note="Anvendes som begrænsning for PIR funktion om natten.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Natdrift&quot; på 1.4.02.a: signalet skal være stabilt i &gt; 100 ms. Ref. 1.4.02.a-IN04."/>
               <resource_input id="_0x141d11" name="Kip" icon="_0x36" note="Kipper udgang og scenarier&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Kip&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 1.4.02.a-IN05."/>
               <resource_input id="_0x141e11" name="Tænd" icon="_0x36" note="Tænder udgang og scenarie &#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Tænd&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 1.4.02.a-IN06."/>
               <resource_input id="_0x141f11" name="Sluk" icon="_0x36" note="Slukker udgang og scenarie.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælpetekst: forbind &quot;Sluk&quot; til det tryk der skal betjene funktionen. Ref. 1.4.02.a-IN07."/>
               <resource_input id="_0x142011" name="Spærring" icon="_0x36" note="Når denne indgang er on, vil al automatik være spærret. Dette giver mulighed for total spærring i både tændt og slukket tilstand.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Bemærk: &quot;Spærring&quot; bør kun linkes til én indgang ad gangen. Ref. 1.4.02.a-IN08."/>
            </inputs>
            <outputs id="_0x142124" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x142212" name="Udgang" icon="_0x39" note="Forbindes til relæ hvis scenariefunktion ikke benyttes.&#xD;&#xA;" note-2="Hjælpetekst for &quot;Udgang&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 1.4.02.a-UD01.">
                  <link_from_resource id="_0x4a332d" name="Følg Link" icon="_0x47" link="_0x4a342c"/>
               </resource_output>
               <resource_output id="_0x142312" name="ON puls" icon="_0x39" note="Giver kort puls ved tænding.&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Bemærk: &quot;ON puls&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 1.4.02.a-UD02."/>
               <resource_output id="_0x142412" name="OFF puls" icon="_0x39" note="Giver kort puls ved slukning.&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Hjælpetekst: &quot;OFF puls&quot; forbindes til det produkt der skal styres. Ref. 1.4.02.a-UD03."/>
               <resource_output id="_0x142512" name="Manuelt betjent" icon="_0x39" note="Visning af overstyring af PIR. &#xD;&#xA;Kan benyttes til diode eller Viewer.&#xD;&#xA;Ifm. manuel sluk vil udgang blinke (default 15 sek.) som kvittéring for spærring af PIR." note-2="Bemærk: &quot;Manuelt betjent&quot; kan linkes til flere produkter samtidigt. Ref. 1.4.02.a-UD04."/>
               <resource_scene id="_0x14264a" name="Scenarie tænd" note="Forbindes til relæ og/eller IHC Wireless lysdæmper." note-2="Hjælp til &quot;Scenarie tænd&quot; på 1.4.02.a: jalousier &amp; lysdæmpere kan indgå samtidigt. Ref. 1.4.02.a-UD05.">
                  <scene_link id="_0x4a7a4b" name="Scenarie link" icon="_0x47" link="_0x4a794d"/>
               </resource_scene>
               <resource_scene id="_0x14274a" name="Scenarie sluk" note="Forbindes til relæ og/eller IHC Wireless lysdæmper." note-2="Hjælpetekst for &quot;Scenarie sluk&quot;: se afsnittet &quot;Scenarier&quot; i beskrivelsen (F1). Ref. 1.4.02.a-UD06."/>
            </outputs>
            <settings id="_0x142825" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x142910" name="Efterløb" backup="yes" icon="_0x43" note="Her indstilles efterløbstiden.&#xD;&#xA;" hour="0" minute="4" second="10" millisecond="0" note-2="Bemærk: &quot;Efterløb&quot; træder i kraft ved næste programafvikling. Ref. 1.4.02.a-IS01."/>
               <resource_enum id="_0x142a0f" name="PIR funktion" typedef="_0x141247" inivalue="_0x141448" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Tænder lys&quot;&#xD;&#xA;&quot;Kun efterløb&quot;&#xD;&#xA;" note-2="Hjælp til &quot;PIR funktion&quot; på 1.4.02.a: værdier &lt; minimum afvises af controlleren. Ref. 1.4.02.a-IS02."/>
               <resource_enum id="_0x142b0f" name="PIR funktion nat" typedef="_0x141547" inivalue="_0x141748" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have om natten.&#xD;&#xA;Natdrift indgangen skal benyttes for at opnå funktion.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Tænder lys&quot;&#xD;&#xA;&quot;Kun efterløb&quot;&#xD;&#xA;" note-2="Hjælpetekst for &quot;PIR funktion nat&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 1.4.02.a-IS03."/>
               <resource_enum id="_0x142c0f" name="Manuel tænding" typedef="_0x140f47" inivalue="_0x141148" icon="_0x22" note="Her er det muligt, at vælge funktion på manuel tænding.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Ved &quot;Starter efterløb&quot; vil lys slukke på efterløb efter sidste påvirking af PIR eller tryk.&#xD;&#xA;Ved &quot;Spærrer efterløb&quot; vil lys ikke slukke ved skumringsfrafald når manuel betjening er aktiv." note-2="Bemærk: &quot;Manuel tænding&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 1.4.02.a-IS04."/>
            </settings>
            <internalsettings id="_0x142d29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
