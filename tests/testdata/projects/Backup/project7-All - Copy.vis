               <resource_output id="_0x44512" name="Udgang 6 - OP / Tænd" icon="_0x39" note="Udgang &quot;Udgang 6 - OP / Tænd&quot; - kan viderekobles til andre funktionsblokke &amp; scenarier. Ref. 1.1.05-UD11." note-2="Note: &quot;Udgang 6 - OP / Tænd&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 1.1.05-UD11."/>
               <resource_output id="_0x44612" name="Udgang 6 - Ned / Sluk" icon="_0x39" note="Udgang &quot;Udgang 6 - Ned / Sluk&quot; på 1.1.05. Følger blokkens aktuelle driftstilstand. Ref. 1.1.05-UD12." note-2="Vejledning: verificér &quot;Udgang 6 - Ned / Sluk&quot; med en måling på klemmen (230 V AC). Ref. 1.1.05-UD12."/>
               <resource_output id="_0x44712" name="Udgang 7 - OP / Tænd" icon="_0x39" note="Udgang &quot;Udgang 7 - OP / Tænd&quot;. Niveau angives i % (0 % = slukket, 100 % = fuld styrke). Ref. 1.1.05-UD13." note-2="Hjælp: notér i 1.1.05. Beolink Fjernbetjening hvilke produkter &quot;Udgang 7 - OP / Tænd&quot; betjener. Ref. 1.1.05-UD13."/>
               <resource_output id="_0x44812" name="Udgang 7 - Ned / Sluk" icon="_0x39" note="Udgang &quot;Udgang 7 - Ned / Sluk&quot; fra 1.1.05 - forbindes til udgangsmodulet på datalinjen. Ref. 1.1.05-UD14." note-2="Vejledning - &quot;Udgang 7 - Ned / Sluk&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 1.1.05-UD14."/>
               <resource_output id="_0x44912" name="Udgang 8 - OP / Tænd" icon="_0x39" note="Udgang &quot;Udgang 8 - OP / Tænd&quot;: aktiv så længe betingelserne i blokken er opfyldt. Ref. 1.1.05-UD15." note-2="Tip: brug &quot;Udgang 8 - OP / Tænd&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 1.1.05-UD15."/>
               <resource_output id="_0x44a12" name="Udgang 8 - Ned / Sluk" icon="_0x39" note="Udgang &quot;Udgang 8 - Ned / Sluk&quot; fra funktionsblok 1.1.05. Forbindes til lampeudtag eller relæ. Ref. 1.1.05-UD16." note-2="Note: &quot;Udgang 8 - Ned / Sluk&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 1.1.05-UD16."/>
               <resource_output id="_0x44b12" name="Udgang 9 - OP / Tænd" icon="_0x39" note="Udgang &quot;Udgang 9 - OP / Tænd&quot; - styrer det tilkoblede produkt.&#xD;&#xA;Udfyldes af installatøren. Ref. 1.1.05-UD17." note-2="Vejledning: verificér &quot;Udgang 9 - OP / Tænd&quot; med en måling på klemmen (230 V AC). Ref. 1.1.05-UD17."/>
               <resource_output id="_0x44c12" name="Udgang 9 - Ned / Sluk" icon="_0x39" note="Statusudgang &quot;Udgang 9 - Ned / Sluk&quot;. Anvendes til visning på grafisk brugerflade. Ref. 1.1.05-UD18." note-2="Hjælp: notér i 1.1.05. Beolink Fjernbetjening hvilke produkter &quot;Udgang 9 - Ned / Sluk&quot; betjener. Ref. 1.1.05-UD18."/>
            </outputs>
