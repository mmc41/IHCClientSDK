               <resource_time id="_0x17730d" name="Tænd-tidspunkt" backup="yes" icon="_0x2f" note="Tidspunktet, hvor udgangen skal tændes" hour="21" minute="15" second="0" note-2="Bemærk: &quot;Tænd-tidspunkt&quot; træder i kraft ved næste programafvikling. Ref. 2.1.01.a-IS01."/>
               <resource_time id="_0x17740d" name="Sluk-tidspunkt" backup="yes" icon="_0x2f" note="Tidspunktet, hvor udgangen skal slukkes" hour="7" minute="15" second="0" note-2="Hjælp til &quot;Sluk-tidspunkt&quot; på 2.1.01.a: værdier &lt; minimum afvises af controlleren. Ref. 2.1.01.a-IS02."/>
            </settings>
