         <functionblock id="_0x2d0528" name="5.1.02. Styring af cirkulationspumpe med PIR" master_schneider_electric="yes" master_type="5.1.02" master_name="Styring af cirkulationspumpe med PIR" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="5.1.02. Styring af cirkulationspumpe til varmt brugsvand med PIR&#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Pumpe starter ved aktivering af PIR såfremt der er gået 30 min fra sidste aktivering.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse mærker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x2d0623" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x2d0711" name="Indgang for PIR" icon="_0x36" note="Aktiverer cirkulationspumpe hvis ikke denne har kørt inden for de sidste 30 min.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Indgang for PIR&quot; på 5.1.02: signalet skal være stabilt i &gt; 100 ms. Ref. 5.1.02-IN01.">
                  <link_to_resource id="_0x4a202c" name="Følg Link" icon="_0x4a" link="_0x4a1f2d"/>
               </resource_input>
            </inputs>
            <outputs id="_0x2d0824" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x2d0912" name="Udgang til cirkulationspumpe for varmt vand" icon="_0x39" note="Udgang &quot;Udgang til cirkulationspumpe for varmt vand&quot; - kan viderekobles til andre funktionsblokke &amp; scenarier. Ref. 5.1.02-UD01." note-2="Note: &quot;Udgang til cirkulationspumpe for varmt vand&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.1.02-UD01.">
                  <link_from_resource id="_0x4a212d" name="Følg Link" icon="_0x47" link="_0x4a222c"/>
               </resource_output>
            </outputs>
            <settings id="_0x2d0a25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x2d0b10" name="Timertid for cirkulation" icon="_0x43" note="Den tid pumpe kører ved aktivering" hour="0" minute="0" second="48" millisecond="0" note-2="Hjælpetekst for &quot;Timertid for cirkulation&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.1.02-IS01."/>
               <resource_timer id="_0x2d0c10" name="Timertid for spærring af pumpestart" icon="_0x43" note="Indstilling &quot;Timertid for spærring af pumpestart&quot;. Afvigelse &lt; 5 % af den viste værdi accepteres. Ref. 5.1.02-IS02." hour="0" minute="33" second="0" millisecond="0" note-2="Bemærk: &quot;Timertid for spærring af pumpestart&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.1.02-IS02."/>
            </settings>
            <internalsettings id="_0x2d0d29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken"/>
            <programs id="_0x2d0e26" name="Programmer" icon="_0x19" note="Gruppering af funktionblokkens programmer">
               <program_simple id="_0x2d0f1e" name="Cirkulationspumpe on" icon="_0x7">
                  <events id="_0x2d1064" name="Hændelser" icon="_0xb" note="Hændelser">
                     <event id="_0x2d11c8" name="%P -&gt; ON" icon="_0xc" note="Start program når %P antager værdien ON" link1="_0x2d0711" method="_0xa"/>
                  </events>
