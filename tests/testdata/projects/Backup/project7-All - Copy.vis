         <functionblock id="_0x48d328" name="8.1.02. Sikker touch" master_schneider_electric="yes" master_type="8.1.02" master_name="Sikker touch" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="8.1.02. Sikker touch&#xD;&#xA;&#xD;&#xA;Anvendelse til brug i &quot;Viewer&quot; eller &quot;iPhone/Android&quot;, til at sikre at tryktiden har en min. længde.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x48d723" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x48d811" name="Touch Indgang" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Touch Indgang&quot; i simulering før anlægget sættes i drift. Ref. 8.1.02-IN01."/>
            </inputs>
            <outputs id="_0x48d924" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x48da12" name="Touch Udgang" icon="_0x39" note="Forbindes til funktionsblok, som ønskes styret via Viewer eller iPhone/Android" note-2="Bemærk: &quot;Touch Udgang&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 8.1.02-UD01."/>
            </outputs>
            <settings id="_0x48db25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x48dc10" name="Pulstid-timer" icon="_0x43" note="Den tid som &quot;Touch Udgang&quot; min. skal være, uanset hvor kort &quot;Touch Indgang&quot; er.&#xD;&#xA;Er &quot;Touch Indgang&quot; længere en &quot;Initial værdi&quot; er &quot;Touch udgang&quot; lig med &quot;Touch Indgang&quot;" hour="0" minute="0" second="29" millisecond="0" note-2="Hjælp: værdien for &quot;Pulstid-timer&quot; i 8.1.02. Sikker touch bør gennemgås ved service. Ref. 8.1.02-IS01."/>
               <resource_enum id="_0x48dd0f" name="Pulstid" typedef="_0x48d447" inivalue="_0x48d548" backup="yes" icon="_0x22" note="Max. lig med &quot;Pulstid-timer&quot; - &#xD;&#xA;Uanset længde for &quot;Touch Indgang&quot;, vil &quot;Touch Udgang&quot; vil være lig med &quot;Pulstid-timer&quot; (Default 350ms)&#xD;&#xA;&#xD;&#xA;Min. lig med &quot;Pulstid-timer&quot; - &#xD;&#xA;Hvis længde for &quot;Touch Indgang&quot;er kortere en &quot;Pulstid-timer&quot; (Default 350ms), vil &quot;Touch Udgang&quot; være lig med &quot;Pulstid-timer&quot; (Default 350ms)&#xD;&#xA;&#xD;&#xA;Hvis længde for &quot;Touch Indgang&quot; er længere en &quot;Pulstid-timer&quot; (Default 350ms)&#xD;&#xA; vil &quot;Touch Udgang&quot; være lig med &quot;Touch Indgang&quot;" note-2="Vejledning - &quot;Pulstid&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 8.1.02-IS02."/>
            </settings>
            <internalsettings id="_0x48de29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x48df10" name="Tryktimer&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;" icon="_0x43" hour="0" minute="0" second="0" millisecond="0"/>
               <resource_timer id="_0x48e010" name="Timer" icon="_0x43" hour="0" minute="0" second="0" millisecond="0"/>
            </internalsettings>
            <programs id="_0x48e126" name="Programmer" icon="_0x19" note="Gruppering af funktionblokkens programmer">
