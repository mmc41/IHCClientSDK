         <functionblock id="_0x36228" name="1.1.02.g. Puls (Tænd / Sluk Alt)" master_schneider_electric="yes" master_type="1.1.02" master_version="g" master_name="Puls (Tænd / Sluk Alt)" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="9" master_date_day="11" locked="yes" icon="_0xe" note="1.1.02.g. Puls (Tænd / Sluk Alt)&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Funktionsblok som typisk anvendes hvor flere funktioner ønskes på samme tryk.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.&#xD;&#xA;">
            <inputs id="_0x36323" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x36411" name="Tryk" icon="_0x36" note="Uafhængig af tryktid.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Tryk&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 1.1.02.g-IN01."/>
               <resource_input id="_0x36511" name="Kort tryk" icon="_0x36" note="Kort tryk &lt; 1 sek. &#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Kort tryk&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 1.1.02.g-IN02."/>
