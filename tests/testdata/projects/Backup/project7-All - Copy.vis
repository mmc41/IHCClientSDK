               <resource_enum id="_0x2ab40f" name="Indgang er ON" typedef="_0x2aab47" inivalue="_0x2aac48" icon="_0x22" note="Indstilling &quot;Indgang er ON&quot;. Ændres kun efter aftale med bygherren. Ref. 4.2.04-IS01." note-2="Bemærk: &quot;Indgang er ON&quot; træder i kraft ved næste programafvikling. Ref. 4.2.04-IS01."/>
