      <group id="_0x3f9332" name="FB 6.2 Alarm Overvaagning" icon="_0x15" note="locNote 1033">
         <functionblock id="_0x3f9428" name="6.2.01.i. Tyverialarm med 11 stk PIR" master_schneider_electric="yes" master_type="6.2.01" master_version="i" master_name="Tyverialarm med 11 stk PIR" master_programmer="Schneider Electric&#xD;&#xA;Copyright © 2009-2020" master_date_year="2020" master_date_month="6" master_date_day="25" locked="yes" icon="_0xe" note="Tyverialarm med 10 stk PIR, skalsikring og forbikoblerzone.&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Funktionsblok for tyverialarm med 11 stk PIR, skalsikrikring og indbygget LK kodetastatur. Enhed for til- og frakobling kan placeres i forbikoblerzone.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." udf="#6.2.01.e. Tyverialarm med 10 stk PIR, skalsikring og forbikoblerzone. Til- og frakobling inde.#">
            <inputs id="_0x3fb523" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x3fb611" name="PIR 1" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp til &quot;PIR 1&quot; på 6.2.01.i: signalet skal være stabilt i &gt; 100 ms. Ref. 6.2.01.i-IN01." udf="#I01#">
                  <link_to_resource id="_0x4a762c" name="Følg Link" icon="_0x4a" link="_0x4a752d"/>
               </resource_input>
               <resource_input id="_0x3fb711" name="PIR 2" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst for &quot;PIR 2&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 6.2.01.i-IN02." udf="#I02#">
                  <link_to_resource id="_0x49f22c" name="Følg Link" icon="_0x4a" link="_0x49f12d"/>
               </resource_input>
               <resource_input id="_0x3fb811" name="PIR 3" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;PIR 3&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 6.2.01.i-IN03." udf="#I03#">
                  <link_to_resource id="_0x49f42c" name="Følg Link" icon="_0x4a" link="_0x49f32d"/>
               </resource_input>
               <resource_input id="_0x3fb911" name="PIR 4" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst: forbind &quot;PIR 4&quot; til det tryk der skal betjene funktionen. Ref. 6.2.01.i-IN04." udf="#I04#">
                  <link_to_resource id="_0x49f62c" name="Følg Link" icon="_0x4a" link="_0x49f52d"/>
               </resource_input>
               <resource_input id="_0x3fba11" name="PIR 5" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;PIR 5&quot; bør kun linkes til én indgang ad gangen. Ref. 6.2.01.i-IN05." udf="#I05#">
                  <link_to_resource id="_0x49f82c" name="Følg Link" icon="_0x4a" link="_0x49f72d"/>
               </resource_input>
               <resource_input id="_0x3fbb11" name="PIR 6" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp til &quot;PIR 6&quot; på 6.2.01.i: signalet skal være stabilt i &gt; 100 ms. Ref. 6.2.01.i-IN06." udf="#I06#">
                  <link_to_resource id="_0x49fa2c" name="Følg Link" icon="_0x4a" link="_0x49f92d"/>
               </resource_input>
               <resource_input id="_0x3fbc11" name="PIR 7" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst for &quot;PIR 7&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 6.2.01.i-IN07." udf="#I07#">
                  <link_to_resource id="_0x4a822c" name="Følg Link" icon="_0x4a" link="_0x4a812d"/>
               </resource_input>
               <resource_input id="_0x3fbd11" name="PIR 8" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;PIR 8&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 6.2.01.i-IN08." udf="#I08#"/>
               <resource_input id="_0x3fbe11" name="PIR 9" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst: forbind &quot;PIR 9&quot; til det tryk der skal betjene funktionen. Ref. 6.2.01.i-IN09." udf="#I09#"/>
               <resource_input id="_0x3fbf11" name="PIR 10" icon="_0x36" note="PIR sensor for rumovervågning.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;PIR 10&quot; bør kun linkes til én indgang ad gangen. Ref. 6.2.01.i-IN10." udf="#I10#"/>
               <resource_input id="_0x3fc011" name="PIR 11 i forbikoblerzone" icon="_0x36" note="PIR sensor for rumovervågning placeret i forbikoblerzone.&#xD;&#xA;Hvis denne PIR indgang aktiveres når alarmen er tilkoblet skal alarmen frakobles inden den indstillede indgangstid (default 20 sek.). Ellers aktiveres alarmen.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp til &quot;PIR 11 i forbikoblerzone&quot; på 6.2.01.i: signalet skal være stabilt i &gt; 100 ms. Ref. 6.2.01.i-IN11." udf="#I11#"/>
               <resource_input id="_0x3fc111" name="Indgang 1 fra LK kodetastatur" icon="_0x36" note="Forbindes til blå ledning fra kodetastatur&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Indgang 1 fra LK kodetastatur&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 6.2.01.i-IN12." udf="#I12#"/>
               <resource_input id="_0x3fc211" name="Indgang 2 fra LK kodetastatur" icon="_0x36" note="Forbindes til violet ledning fra kodetastatur&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Indgang 2 fra LK kodetastatur&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 6.2.01.i-IN13." udf="#I13#"/>
               <resource_input id="_0x3fc311" name="Indgang 3 fra LK kodetastatur" icon="_0x36" note="Forbindes til grå ledning fra kodetastatur&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Indgang 3 fra LK kodetastatur&quot; til det tryk der skal betjene funktionen. Ref. 6.2.01.i-IN14." udf="#I14#"/>
               <resource_input id="_0x3fc411" name="Styresignal fra enhed for tilkobling af Totalalarm" icon="_0x36" note="Ved puls tilkobles alarm. Anvendes kun hvis der ønskes andre til- eller frakoblingsenheder end LK kodetastatur. Forbindes f.eks. til 6.1.01 kodetastatur uden memoryfunktion.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Styresignal fra enhed for tilkobling af Totalalarm&quot; bør kun linkes til én indgang ad gangen. Ref. 6.2.01.i-IN15."/>
               <resource_input id="_0x3fc511" name="Styresignal fra enhed for frakobling af Totalalarm" icon="_0x36" note="Ved puls frakobles alarm. Anvendes kun hvis der ønskes andre til- eller frakoblingsenheder end LK kodetastatur. Forbindes f.eks. til 6.1.01 kodetastatur uden memoryfunktion.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Styresignal fra enhed for frakobling af Totalalarm&quot; på 6.2.01.i: signalet skal være stabilt i &gt; 100 ms. Ref. 6.2.01.i-IN16."/>
               <resource_input id="_0x3fc611" name="Styresignal fra enhed for til- og frakobling af Totalalarm" icon="_0x36" note="Ved puls til- eller frakobles alarm (kip-funktion). Anvendes kun hvis der ønskes andre til- eller frakoblingsenheder end LK kodetastarur. Forbindes f.eks. til 6.1.01 kodetastatur uden memoryfunktion.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Styresignal fra enhed for til- og frakobling af Totalalarm&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 6.2.01.i-IN17." udf="#I15#"/>
               <resource_input id="_0x3fc711" name="Magnetkontakt i forbikoblerzone" icon="_0x36" note="Indgang for magnetkontakter placeret i forbikoblerzone. Normalt lukkede (NC).&#xD;&#xA;Hvis denne magnetkontakt-indgang aktiveres når alarmen er tilkoblet skal alarmen frakobles inden den indstillede indgangstid (default 20 sek.). Ellers aktiveres alarmen.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;Magnetkontakt i forbikoblerzone&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 6.2.01.i-IN18." udf="#I16#"/>
               <resource_input id="_0x3fc811" name="Magnetkontakter på døre og vinduer" icon="_0x36" note="Indgang for magnetkontakter. Normalt lukkede (NC).&#xD;&#xA;Ved flere magnetkontakter kan de enten forbindes i serie og tilsluttes en indgang eller forbindes til flere indgange og samles i en &quot;And&quot; funktionsblok (f.eks. 4.1.01).&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst: forbind &quot;Magnetkontakter på døre og vinduer&quot; til det tryk der skal betjene funktionen. Ref. 6.2.01.i-IN19." udf="#I17#"/>
               <resource_input id="_0x3fc911" name="Styresignal fra enhed for til- og frakobling af magnetkontaktkreds" icon="_0x36" note="Ved puls til- eller frakobles skalsikring (kip-funktion). Forbindes f.eks. til 6.1.01 kodetastatur uden memoryfunktion.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Styresignal fra enhed for til- og frakobling af magnetkontaktkreds&quot; bør kun linkes til én indgang ad gangen. Ref. 6.2.01.i-IN20." udf="#I18#"/>
               <resource_input id="_0x3fca11" name="Sabotagekreds" icon="_0x36" note="Indgang for sabotagekreds (NC).&#xD;&#xA;Hvis sabotagekreds bliver brudt meden alarm er deaktiv vil alarmen gå igang.&#xD;&#xA;Så længe sabotagekreds er brudt vil det ikke være muligt at tilkoble alarm, men lydgiverne vil blive deaktiveret forsøg på tilkobling.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp til &quot;Sabotagekreds&quot; på 6.2.01.i: signalet skal være stabilt i &gt; 100 ms. Ref. 6.2.01.i-IN21." udf="#I19#"/>
               <resource_input id="_0x3fcb11" name="Styresignal fra til- og frakoblingsenhed af sabotagekreds" icon="_0x36" note="Ved on er sabotagekreds aktiveret&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst for &quot;Styresignal fra til- og frakoblingsenhed af sabotagekreds&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 6.2.01.i-IN22." udf="#I20#"/>
               <resource_input id="_0x3fcc11" name="Overfaldstryk" icon="_0x36" note="Indgang for overfaldstryk. (NO)&#xD;&#xA;Er altid aktiv - også når alarmen er deaktiveret.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Overfaldstryk&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 6.2.01.i-IN23." udf="#I21#"/>
               <resource_input id="_0x3fcd11" name="Modemafstilling af alarm" icon="_0x36" note="Forbindes til alarm aktiv flag fra modem.&#xD;&#xA;Bemærk at der er forsinket afstilling på alamen (timer under indstillinger)&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Modemafstilling af alarm&quot; til det tryk der skal betjene funktionen. Ref. 6.2.01.i-IN24." udf="#I22#"/>
               <resource_input id="_0x3fce11" name="Reset af diodeindikation" icon="_0x36" note="Indgang for reset af indikering af alarm.&#xD;&#xA;Anvendes til at stoppe blink på diode, som indikerer hvilken indgang der aktiverede alarmen. &#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Reset af diodeindikation&quot; bør kun linkes til én indgang ad gangen. Ref. 6.2.01.i-IN25." udf="#I23#"/>
            </inputs>
            <outputs id="_0x3fcf24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x3fd012" name="Udendørs lydgiver" icon="_0x39" note=" Ved alarm aktiveres lydgiver udendørs i 3 min." note-2="Hjælp: notér i 6.2.01.i. Tyverialarm med 11 stk PIR hvilke produkter &quot;Udendørs lydgiver&quot; betjener. Ref. 6.2.01.i-UD01." udf="#O01#"/>
               <resource_output id="_0x3fd112" name="Indendørs lydgiver" icon="_0x39" note="Ved alarm aktiveres lydgiver indendørs i 5 min." note-2="Vejledning - &quot;Indendørs lydgiver&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.2.01.i-UD02." udf="#O02#"/>
               <resource_output id="_0x3fd212" name="On puls til blink med lys i tilfælde af alarm" icon="_0x39" note="Ved alarm vil denne udgang sende on-pulser til at tænde lys som skal blinke.&#xD;&#xA;Når alarm stoppes vil denne puls-udgang være den sidste som bliver aktiveret.&#xD;&#xA;Dette er for at sikre at lyset  forbliver on indtil det slukkes af anden funktionsblok." note-2="Tip: brug &quot;On puls til blink med lys i tilfælde af alarm&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.2.01.i-UD03."/>
               <resource_output id="_0x3fd312" name="Off puls til blink med lys i tilfælde af alarm" icon="_0x39" note="Ved alarm vil denne udgang sende off-pulser til at slukke lys som skal blinke." note-2="Note: &quot;Off puls til blink med lys i tilfælde af alarm&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.2.01.i-UD04."/>
               <resource_scene id="_0x3fd44a" name="Scenarie tænd" note="Sæt lysniveau til 100% og rampetid til 0 sek." note-2="Vejledning: kontrollér &quot;Scenarie tænd&quot; efter udskiftning af et produkt. Ref. 6.2.01.i-UD05." udf="#O04#"/>
               <resource_scene id="_0x3fd54a" name="Scenarie sluk" note="Sæt lysniveau til 0% og rampetid til 0 sek." note-2="Hjælp: dokumentér &quot;Scenarie sluk&quot; i 6.2.01.i. Tyverialarm med 11 stk PIR over for slutbrugeren. Ref. 6.2.01.i-UD06." udf="#O05#"/>
               <resource_output id="_0x3fd612" name="IHCStatus i LK kodetastatur" backup="yes" icon="_0x39" note="Forbindes til hvid ledning fra kodetastatur.&#xD;&#xA;Denne udgang styrer indikeringen rød/grøn.&#xD;&#xA;On = grøn, off = rød." inivalue="on" note-2="Vejledning - &quot;IHCStatus i LK kodetastatur&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.2.01.i-UD07." udf="#O06#"/>
               <resource_output id="_0x3fd712" name="Indikering af alarm" icon="_0x39" note="Indikerer at alarm detekteret. Ved alarm udløst af PIR blinker diode (antal blink = nr. på PIR), ved sabotage, overfald eller magnetkontakt lyses konstant." note-2="Tip: brug &quot;Indikering af alarm&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.2.01.i-UD08." udf="#O07#"/>
               <resource_output id="_0x3fd812" name="Magnetkontaktsløjfe åben" icon="_0x39" note="Indikerer magnetkontaktsløjfe åben. Forbindes til evt. til diode i tryk." note-2="Note: &quot;Magnetkontaktsløjfe åben&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.2.01.i-UD09." udf="#O08#"/>
               <resource_output id="_0x3fd912" name="Sabotagekredssløje åben" icon="_0x39" note="Indikerer sabotagekreds åben. Forbindes til evt. til diode i tryk." note-2="Vejledning: verificér &quot;Sabotagekredssløje åben&quot; med en måling på klemmen (230 V AC). Ref. 6.2.01.i-UD10." udf="#O09#"/>
               <resource_output id="_0x3fda12" name="IHC-modem - PIR" icon="_0x39" note="Udgang forbindes til IHC-Modem. Indikerer PIR aktiverede alarmen." note-2="Hjælp: notér i 6.2.01.i. Tyverialarm med 11 stk PIR hvilke produkter &quot;IHC-modem - PIR&quot; betjener. Ref. 6.2.01.i-UD11." udf="#O10#"/>
               <resource_output id="_0x3fdb12" name="IHC-modem - Skalsikring" icon="_0x39" note="Udgang forbindes til IHC-Modem. Indikerer skalsikringen aktiverede alarmen." note-2="Vejledning - &quot;IHC-modem - Skalsikring&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.2.01.i-UD12." udf="#O11#"/>
               <resource_output id="_0x3fdc12" name="Udgang for afstil alarm på IHC-modem" icon="_0x39" note="Afstiller alarm på IHC-modem. Forbindes til afstil på modem.&#xD;&#xA;" note-2="Anvendes kun i forbindelse med gammelt voice modem." udf="#O12#"/>
               <resource_output id="_0x3fdd12" name="Advarsel for åben magnetkontaktsløjfe ved alarmtilkobling" icon="_0x39" note="Udgang bliver aktiv ved åben magnetkontaktsløjfe ved alarmtilkobling. Forbindes til lydgiver eller diode." note-2="Hjælp til &quot;Advarsel for åben magnetkontaktsløjfe ved alarmtilkobling&quot; på 6.2.01.i: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 6.2.01.i-UD14." udf="#O13#"/>
               <resource_output id="_0x3fde12" name="Tilkobling af alarm ok" icon="_0x39" note="Indikerer at det er muligt at tilkoble alarmen (ingen åbne vinduer osv)" inivalue="on" note-2="Hjælpetekst for &quot;Tilkobling af alarm ok&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 6.2.01.i-UD15." udf="#O14#"/>
               <resource_output id="_0x3fdf12" name="Totalalarm tilkoblet" backup="yes" icon="_0x39" note="Indikerer at totalalarm er tilkoblet" note-2="Bemærk: &quot;Totalalarm tilkoblet&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 6.2.01.i-UD16." udf="#O15#"/>
               <resource_output id="_0x3fe012" name="Magnetkontaktkreds/skalsikring tilkoblet" backup="yes" icon="_0x39" note="Indikerer at skalsikring er tilkoblet" note-2="Hjælpetekst: &quot;Magnetkontaktkreds/skalsikring tilkoblet&quot; forbindes til det produkt der skal styres. Ref. 6.2.01.i-UD17." udf="#O16#"/>
               <resource_output id="_0x3fe112" name="Timer indgangstid aktiv" icon="_0x39" note="Indikerer at indgangstiden tæller ned (den tid man kan opholde sig i forbikoblerzone ved frakobling).&#xD;&#xA;Forbindes til diode eller lydblok." note-2="Bemærk: &quot;Timer indgangstid aktiv&quot; kan linkes til flere produkter samtidigt. Ref. 6.2.01.i-UD18." udf="#O17#"/>
               <resource_output id="_0x3fe212" name="Timer udgangstid aktiv" icon="_0x39" note="Indikerer at udgangstiden tæller ned (den tid man kan opholde sig i forbikoblerzone ved tilkobling).&#xD;&#xA;Forbindes til diode eller lydblok." note-2="Hjælp til &quot;Timer udgangstid aktiv&quot; på 6.2.01.i: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 6.2.01.i-UD19." udf="#O18#"/>
               <resource_enum id="_0x3fe30f" name="Alarm startet via" typedef="_0x3f9547" inivalue="_0x3fa448" icon="_0x22" note="Indikerer hvad der aktiverede alarmen.&#xD;&#xA;Log værdierne bliver stående indtil næste gang der er en alarm-aktivering." note-2="Hjælpetekst for &quot;Alarm startet via&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 6.2.01.i-UD20." udf="#O19#"/>
               <resource_time id="_0x3fe40d" name="Alarm startet klokken" icon="_0x2f" note="Tidspunkt alarm blev aktiveret.&#xD;&#xA;Log værdierne bliver stående indtil næste gang der er en alarm-aktivering.." hour="0" minute="0" second="0" note-2="Bemærk: &quot;Alarm startet klokken&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 6.2.01.i-UD21." udf="#O20#"/>
               <resource_date id="_0x3fe50e" name="Alarm startet på dato" icon="_0x29" note="Dato alarm blev aktiveret.&#xD;&#xA;Log værdierne bliver stående indtil næste gang der er en alarm-aktivering." year="2000" month="1" day="1" note-2="Hjælpetekst: &quot;Alarm startet på dato&quot; forbindes til det produkt der skal styres. Ref. 6.2.01.i-UD22." udf="#O21#"/>
            </outputs>
            <settings id="_0x3fe625" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x3fe710" name="Timer for afstilling af udendørs lydgiver" icon="_0x43" note="Den tid udendørs lydgiver er aktiv (default 3 min.)" hour="0" minute="3" second="18" millisecond="0" note-2="Hjælpetekst: &quot;Timer for afstilling af udendørs lydgiver&quot; justeres til anlæggets faktiske forhold. Ref. 6.2.01.i-IS01." udf="#SS01#"/>
               <resource_timer id="_0x3fe810" name="Timer for afstilling af indendørs lydgiver" icon="_0x43" note="Den tid indendørs lydgiver er aktiv (default 5 min.)" hour="0" minute="3" second="45" millisecond="0" note-2="Bemærk: &quot;Timer for afstilling af indendørs lydgiver&quot; træder i kraft ved næste programafvikling. Ref. 6.2.01.i-IS02." udf="#SS02#"/>
               <resource_timer id="_0x3fe910" name="Timer for stop blink med 230V lys" icon="_0x43" note="Den tid blink af lys er aktiv (default 45 min.)" hour="0" minute="49" second="30" millisecond="0" note-2="Hjælp til &quot;Timer for stop blink med 230V lys&quot; på 6.2.01.i: værdier &lt; minimum afvises af controlleren. Ref. 6.2.01.i-IS03." udf="#SS03#"/>
               <resource_timer id="_0x3fea10" name="Timer for forsinket modemafstilling" icon="_0x43" note="Forsinkelse af alarmafstilling ved modemopkald.&#xD;&#xA;" hour="0" minute="0" second="24" millisecond="0" note-2="Hjælpetekst for &quot;Timer for forsinket modemafstilling&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 6.2.01.i-IS04." udf="#SS04#"/>
               <resource_timer id="_0x3feb10" name="Timer for afstilling af Output IHC-modem" icon="_0x43" note="Timer for genindkobling af modem overvågning. (Modem kan sende en ny alarm)." hour="0" minute="1" second="25" millisecond="0" note-2="Bemærk: &quot;Timer for afstilling af Output IHC-modem&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 6.2.01.i-IS05." udf="#SS05#"/>
               <resource_timer id="_0x3fec10" name="Timer for indgangstid i forbikoblerzone" icon="_0x43" note="Tiden der er tilrådighed til at frakoble alarmen efter indtrængen i forbikoblerzone." hour="0" minute="0" second="26" millisecond="0" note-2="Hjælpetekst: &quot;Timer for indgangstid i forbikoblerzone&quot; justeres til anlæggets faktiske forhold. Ref. 6.2.01.i-IS06." udf="#SS06#"/>
               <resource_timer id="_0x3fed10" name="Timer for udgangstid i forbikoblerzone" icon="_0x43" note="Tiden der er tilrådighed til at forlade forbikoblerzone." hour="0" minute="0" second="33" millisecond="0" note-2="Bemærk: &quot;Timer for udgangstid i forbikoblerzone&quot; træder i kraft ved næste programafvikling. Ref. 6.2.01.i-IS07." udf="#SS07#"/>
               <resource_time id="_0x3fee0d" name="Kode 2 aktiv" icon="_0x2f" note="Tidspunkt brugerkode 2 bliver aktiv" hour="20" minute="30" second="0" note-2="Hjælp til &quot;Kode 2 aktiv&quot; på 6.2.01.i: værdier &lt; minimum afvises af controlleren. Ref. 6.2.01.i-IS08." udf="#SS08#"/>
               <resource_time id="_0x3fef0d" name="Kode 2 passiv" icon="_0x2f" note="Tidspunkt brugerkode 2 bliver passiv. (Kun tilkobling mulig)" hour="15" minute="15" second="0" note-2="Hjælpetekst for &quot;Kode 2 passiv&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 6.2.01.i-IS09." udf="#SS09#"/>
               <resource_time id="_0x3ff00d" name="Kode 3 aktiv" icon="_0x2f" note="Tidspunkt brugerkode 3 bliver aktiv" hour="9" minute="0" second="0" note-2="Bemærk: &quot;Kode 3 aktiv&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 6.2.01.i-IS10." udf="#SS10#"/>
               <resource_time id="_0x3ff10d" name="Kode 3 passiv" icon="_0x2f" note="Tidspunkt brugerkode 3 bliver passiv. (Kun tilkobling mulig)" hour="18" minute="0" second="0" note-2="Hjælpetekst: &quot;Kode 3 passiv&quot; justeres til anlæggets faktiske forhold. Ref. 6.2.01.i-IS11." udf="#SS11#"/>
               <resource_time id="_0x3ff20d" name="Kode 4 aktiv" icon="_0x2f" note="Tidspunkt brugerkode 4 bliver aktiv" hour="10" minute="0" second="0" note-2="Bemærk: &quot;Kode 4 aktiv&quot; træder i kraft ved næste programafvikling. Ref. 6.2.01.i-IS12." udf="#SS12#"/>
               <resource_time id="_0x3ff30d" name="Kode 4 passiv" icon="_0x2f" note="Tidspunkt brugerkode 4 bliver passiv. (Kun tilkobling mulig)" hour="18" minute="30" second="0" note-2="Hjælp til &quot;Kode 4 passiv&quot; på 6.2.01.i: værdier &lt; minimum afvises af controlleren. Ref. 6.2.01.i-IS13." udf="#SS13#"/>
               <resource_time id="_0x3ff40d" name="Kode 5 aktiv" icon="_0x2f" note="Tidspunkt brugerkode 5 bliver aktiv" hour="10" minute="30" second="0" note-2="Hjælpetekst for &quot;Kode 5 aktiv&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 6.2.01.i-IS14." udf="#SS14#"/>
               <resource_time id="_0x3ff50d" name="Kode 5 passiv" icon="_0x2f" note="Tidspunkt brugerkode 5 bliver passiv. (Kun tilkobling mulig)" hour="19" minute="30" second="0" note-2="Bemærk: &quot;Kode 5 passiv&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 6.2.01.i-IS15." udf="#SS15#"/>
               <resource_time id="_0x3ff60d" name="Kode 6 aktiv" icon="_0x2f" note="Tidspunkt brugerkode 6 bliver aktiv" hour="11" minute="30" second="0" note-2="Hjælpetekst: &quot;Kode 6 aktiv&quot; justeres til anlæggets faktiske forhold. Ref. 6.2.01.i-IS16." udf="#SS16#"/>
