      <group id="_0x234132" name="FB 4.1 Specielle Generelt" icon="_0x15" note="locNote 1026">
         <functionblock id="_0x234228" name="4.1.01. AND (&quot;Og&quot;- blok)" master_schneider_electric="yes" master_type="4.1.01" master_name="AND (&quot;Og&quot;- blok)" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.1.01. AND (&quot;Og&quot;- blok)&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Logik funktionsblok - AND (&quot;Og&quot;- blok) med 10 indgange samt puls og scenarie udgange.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x234323" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x234411" name="Indgang 1" icon="_0x36" note="(Udfyldes af installatøren)" inivalue="on" note-2="Vejledning: test &quot;Indgang 1&quot; i simulering før anlægget sættes i drift. Ref. 4.1.01-IN01.">
                  <link_to_resource id="_0x49902c" name="Følg Link" icon="_0x4a" link="_0x498f2d"/>
               </resource_input>
               <resource_input id="_0x234511" name="Indgang 2" icon="_0x36" note="(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang 2&quot; er linket til i 4.1.01. AND (&quot;Og&quot;- blok). Ref. 4.1.01-IN02.">
                  <link_to_resource id="_0x49922c" name="Følg Link" icon="_0x4a" link="_0x49912d"/>
               </resource_input>
               <resource_input id="_0x234611" name="Indgang 3" icon="_0x36" note="(Udfyldes af installatøren)" inivalue="on" note-2="Vejledning - &quot;Indgang 3&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 4.1.01-IN03.">
                  <link_to_resource id="_0x49942c" name="Følg Link" icon="_0x4a" link="_0x49932d"/>
               </resource_input>
               <resource_input id="_0x234711" name="Indgang 4" icon="_0x36" note="(Udfyldes af installatøren)" inivalue="on" note-2="Tip: lad &quot;Indgang 4&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 4.1.01-IN04.">
                  <link_to_resource id="_0x49962c" name="Følg Link" icon="_0x4a" link="_0x49952d"/>
               </resource_input>
               <resource_input id="_0x234811" name="Indgang 5" icon="_0x36" note="(Udfyldes af installatøren)" inivalue="on" note-2="Note: &quot;Indgang 5&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 4.1.01-IN05.">
                  <link_to_resource id="_0x49982c" name="Følg Link" icon="_0x4a" link="_0x49972d"/>
               </resource_input>
               <resource_input id="_0x234911" name="Indgang 6" icon="_0x36" note="(Udfyldes af installatøren)" inivalue="on" note-2="Vejledning: test &quot;Indgang 6&quot; i simulering før anlægget sættes i drift. Ref. 4.1.01-IN06."/>
               <resource_input id="_0x234a11" name="Indgang 7" icon="_0x36" note="(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang 7&quot; er linket til i 4.1.01. AND (&quot;Og&quot;- blok). Ref. 4.1.01-IN07."/>
               <resource_input id="_0x234b11" name="Indgang 8" icon="_0x36" note="(Udfyldes af installatøren)" inivalue="on" note-2="Vejledning - &quot;Indgang 8&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 4.1.01-IN08."/>
               <resource_input id="_0x234c11" name="Indgang 9" icon="_0x36" note="(Udfyldes af installatøren)" inivalue="on" note-2="Tip: lad &quot;Indgang 9&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 4.1.01-IN09."/>
