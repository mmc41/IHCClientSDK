            </inputs>
            <outputs id="_0x234e24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x234f12" name="Udgang" icon="_0x39" note="Udgang &quot;Udgang&quot;. Niveau angives i % (0 % = slukket, 100 % = fuld styrke). Ref. 4.1.01-UD01." note-2="Vejledning: verificér &quot;Udgang&quot; med en måling på klemmen (230 V AC). Ref. 4.1.01-UD01.">
                  <link_from_resource id="_0x49992d" name="Følg Link" icon="_0x47" link="_0x499a2c"/>
               </resource_output>
               <resource_output id="_0x235012" name="ON Puls" icon="_0x39" note="Udgang &quot;ON Puls&quot; fra 4.1.01 - forbindes til udgangsmodulet på datalinjen. Ref. 4.1.01-UD02." note-2="Hjælp: notér i 4.1.01. AND (&quot;Og&quot;- blok) hvilke produkter &quot;ON Puls&quot; betjener. Ref. 4.1.01-UD02.">
                  <link_from_resource id="_0x499b2d" name="Følg Link" icon="_0x47" link="_0x499c2c"/>
               </resource_output>
               <resource_output id="_0x235112" name="OFF Puls" icon="_0x39" note="Udgang &quot;OFF Puls&quot;: aktiv så længe betingelserne i blokken er opfyldt. Ref. 4.1.01-UD03." note-2="Vejledning - &quot;OFF Puls&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 4.1.01-UD03.">
                  <link_from_resource id="_0x499d2d" name="Følg Link" icon="_0x47" link="_0x499e2c"/>
               </resource_output>
               <resource_scene id="_0x23524a" name="Scenarie Tænd" note="Scenarie &quot;Scenarie Tænd&quot; fremkaldes af funktionsblok 4.1.01. Ref. 4.1.01-UD04." note-2="Tip: hold antallet af produkter i &quot;Scenarie Tænd&quot; lavt (&lt; 20) af hensyn til svartiden. Ref. 4.1.01-UD04."/>
               <resource_scene id="_0x23534a" name="Scenarie Sluk" note="Scenarie &quot;Scenarie Sluk&quot; - saml de produkter der skal indgå i stemningen.&#xD;&#xA;Ref. 4.1.01-UD05." note-2="Note: &quot;Scenarie Sluk&quot; fremkaldes også fra ur og kalender.&#xD;&#xA;Ref. 4.1.01-UD05."/>
            </outputs>
