         <functionblock id="_0x474828" name="6.3.05. Røgalarm med logfunktion" master_schneider_electric="yes" master_type="6.3.05" master_name="Røgalarm med logfunktion" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="Simpel røgalarm&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.3 Sikkerhed\6.3.01.pdf">
            <inputs id="_0x474923" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x474a11" name="Indgang for røgsensor" icon="_0x36" note="Indgang for overvågning af røgudvikling (NC).&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Vejledning: test &quot;Indgang for røgsensor&quot; i simulering før anlægget sættes i drift. Ref. 6.3.05-IN01."/>
               <resource_input id="_0x474b11" name="Indgang for reset af røgindikering" icon="_0x36" note="Puls resetter indikering og pauser røgalarm i 15 minuter. Er der stadig røg når pausen er færdig vil der komme røgalarm igen.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang for reset af røgindikering&quot; er linket til i 6.3.05. Røgalarm med logfunktion. Ref. 6.3.05-IN02."/>
               <resource_input id="_0x474c11" name="Indgang for ekstern overvågning aktiv" icon="_0x36" note="Når denne indgang er ON, vil alarmen også blive sendt til udgang for ekstern lydgiver og udgangen for IHC-modem.&#xD;&#xA;Kan evt. forbindes til udgang fra tyveriblok således, at alarmen sendes ud af huset når der ikke er nogle hjemme. &#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Vejledning - &quot;Indgang for ekstern overvågning aktiv&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 6.3.05-IN03."/>
            </inputs>
            <outputs id="_0x474d24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x474e12" name="Overstyring af lys" icon="_0x39" note="Forbindes til indgang for tænd på alle funktionsblokke som ønskes tændt ved røgalarm." note-2="Hjælpetekst: &quot;Overstyring af lys&quot; forbindes til det produkt der skal styres. Ref. 6.3.05-UD01."/>
               <resource_output id="_0x474f12" name="Ekstern lydgiver" icon="_0x39" note="Forbindes til ekstern lydgiver på port 1, ved alarm aktiveres lydgiver i 15 sek (default)." note-2="Bemærk: &quot;Ekstern lydgiver&quot; kan linkes til flere produkter samtidigt. Ref. 6.3.05-UD02."/>
               <resource_output id="_0x475012" name="Intern lydgiver" icon="_0x39" note="Forbindes til intern lydgiver evt. via lydblok. Ved alarm aktiveres lydgiver i 3 minutter (default)" note-2="Hjælp til &quot;Intern lydgiver&quot; på 6.3.05: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 6.3.05-UD03."/>
               <resource_output id="_0x475112" name="Indikering på lydgiver at alarm genindkobles" icon="_0x39" note="Efter pausetimer udløber og der ikke er røg tilstede markeres dette med et kort beep. Forbindes til intern lydgiver." note-2="Hjælpetekst for &quot;Indikering på lydgiver at alarm genindkobles&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 6.3.05-UD04."/>
               <resource_output id="_0x475212" name="Reset af røgsensor" icon="_0x39" note="Forbindes til forsyning på røgsensor.  Røgsensor resettes ved kort afbrydelse af spænding. Ved anvendelse af flere røgsensore skal man kun konfigurere den ene udgang for forsyning, det er således også kun nødvendigt at linke til den konfiguret udgang. (se evt hjælpefil)" inivalue="on" note-2="Bemærk: &quot;Reset af røgsensor&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 6.3.05-UD05."/>
               <resource_output id="_0x475312" name="IHC-modem - Røg" icon="_0x39" note="Udgang til at aktivere IHC-Modem" note-2="Hjælpetekst: &quot;IHC-modem - Røg&quot; forbindes til det produkt der skal styres. Ref. 6.3.05-UD06."/>
               <resource_output id="_0x475412" name="Indikering af alarm - Røg" icon="_0x39" note="Udgang for indikering af røgalarm detekteret. Forbindes evt. til statustryk." note-2="Bemærk: &quot;Indikering af alarm - Røg&quot; kan linkes til flere produkter samtidigt. Ref. 6.3.05-UD07."/>
               <resource_output id="_0x475512" name="Udgang for afstilling af modem" icon="_0x39" note="Afstiller modem efter alarm ved aktivering af &quot;indgang overvågning aktiv&quot;.&#xD;&#xA;Anvendes til voice modem." note-2="Hjælp til &quot;Udgang for afstilling af modem&quot; på 6.3.05: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 6.3.05-UD08."/>
               <resource_output id="_0x475612" name="Udgang for indikering af forbikoblet røgalarm" icon="_0x39" note="Forbindes evt. til lysdiode i tryk" note-2="Hjælpetekst for &quot;Udgang for indikering af forbikoblet røgalarm&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 6.3.05-UD09."/>
               <resource_time id="_0x47570d" name="Tidspunkt for sidste røgalarm" backup="yes" icon="_0x2f" note="Anvendes til visning på grafisk brugerflade" hour="0" minute="0" second="0" note-2="Bemærk: &quot;Tidspunkt for sidste røgalarm&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 6.3.05-UD10."/>
               <resource_date id="_0x47580e" name="Dato for sidste røgalarm" backup="yes" icon="_0x29" note="Anvendes til visning på grafisk brugerflade" year="2000" month="1" day="1" note-2="Hjælpetekst: &quot;Dato for sidste røgalarm&quot; forbindes til det produkt der skal styres. Ref. 6.3.05-UD11."/>
            </outputs>
            <settings id="_0x475925" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x475a10" name="Timer for ekstern lydgiver" icon="_0x43" note="Den tid ekstern lydgiver er on (default 15 sek)" hour="0" minute="0" second="38" millisecond="0" note-2="Vejledning - &quot;Timer for ekstern lydgiver&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 6.3.05-IS01."/>
               <resource_timer id="_0x475b10" name="Timer for intern lydgiver" icon="_0x43" note="Den tid intern lydgiver er on (default 3 minutter)" hour="0" minute="3" second="54" millisecond="0" note-2="Tip: notér den valgte værdi for &quot;Timer for intern lydgiver&quot; i anlægsdokumentationen. Ref. 6.3.05-IS02."/>
               <resource_timer id="_0x475c10" name="Timer for pause af røgalarm" icon="_0x43" note="Den tid røgalarm ikke er aktiv, feks. under madlavning (default 15 minutter)" hour="0" minute="19" second="30" millisecond="0" note-2="Note: &quot;Timer for pause af røgalarm&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 6.3.05-IS03."/>
            </settings>
            <internalsettings id="_0x475d29" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x475e10" name="Timer for indikering af genindkobling af røgalarm" icon="_0x43" hour="0" minute="0" second="0" millisecond="50"/>
            </internalsettings>
