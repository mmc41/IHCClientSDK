         </functionblock>
         <functionblock id="_0x9ca28" name="1.2.05.c. Trådløs / Bus lysdæmperstyring" master_schneider_electric="yes" master_type="1.2.05" master_version="c" master_name="Trådløs / Bus lysdæmperstyring" master_programmer="Schneider Electric&#xD;&#xA;Copyright © 2016-2020" master_date_year="2020" master_date_month="7" master_date_day="10" locked="yes" icon="_0xe" note="1.2.05.c. Trådløs / Bus lysdæmperstyring&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til styring af IHC Wireless og IHC Bus lysdæmpere ifm. PIR og IHCRemote og IHCTablet app.&#xD;&#xA;Kan anvendes som 1- og/eller 2-tast betjent regulering.&#xD;&#xA;Kan fremkalde/gemme to scenarier.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse; markér overskrift på funktionsblok og tryk F1.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.&#xD;&#xA;">
            <inputs id="_0x9e723" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x9e811" name="Touch " icon="_0x36" note="Kort tryk tænd/sluk - langt tryk regulerer lys niveau op/ned.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Note: &quot;Touch&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 1.2.05.c-IN01."/>
               <resource_input id="_0x9e911" name="Tænd/regulér op" icon="_0x36" note="Kort tryk tænd - langt tryk regulerer lysniveau op.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Tænd/regulér op&quot; i simulering før anlægget sættes i drift. Ref. 1.2.05.c-IN02."/>
               <resource_input id="_0x9ea11" name="Sluk/regulér ned  " icon="_0x36" note="Kort tryk sluk - langt tryk regulerer lysniveau ned.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Sluk/regulér ned&quot; er linket til i 1.2.05.c. Trådløs / Bus lysdæmperstyring. Ref. 1.2.05.c-IN03."/>
               <resource_input id="_0x9eb11" name="Høj" icon="_0x36" note="Fremkalder højt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som høj.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Vejledning - &quot;Høj&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 1.2.05.c-IN04."/>
               <resource_input id="_0x9ec11" name="Lav " icon="_0x36" note="Fremkalder lavt lysniveau.&#xD;&#xA;Tryk over 3 sek. vil gemme det aktuelle lysniveau som lav.&#xD;&#xA;Som kvittering slukker lys og gentænder når tryk slippes.&#xD;&#xA;Niveau gemmes kun, hvis lysdæmper er tændt.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Lav&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 1.2.05.c-IN05."/>
               <resource_light_level id="_0x9ed13" name="Lys niveau " note="Opret link mellem produktets &quot;Lys niveau&quot; og denne indgang.&#xD;&#xA;Funktionsblokken virker ikke korrekt uden denne sammenhæng.&#xD;&#xA;" note-2="Note: &quot;Lys niveau&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 1.2.05.c-IN06."/>
               <resource_input id="_0x9ee11" name="Natdrift" icon="_0x36" note="Ved aktivitet (betingelse opfyldt) vil et kort regulerings tryk tænde lyset på &quot;Lavt niveau&quot;. PIR vil enten være helt eller delvist begrænset.&#xD;&#xA;Sammensættes med urfunktion eller dag og nat funktion.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Natdrift&quot; i simulering før anlægget sættes i drift. Ref. 1.2.05.c-IN07."/>
               <resource_input id="_0x9ef11" name="PIR" icon="_0x36" note="Forbindes til tilstedeværelses indikering fra PIR sensor.&#xD;&#xA;Virkemåde defineres under indstilling &quot;# PIR funktion&quot; og &quot;# PIR funktion nat&quot;.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;PIR&quot; er linket til i 1.2.05.c. Trådløs / Bus lysdæmperstyring. Ref. 1.2.05.c-IN08."/>
               <resource_input id="_0x9f011" name="Skumring" icon="_0x36" note="Forbindes fra skumringssensor eller luxsensor ifm. funktionsblok 1.1.12.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" inivalue="on" note-2="Vejledning - &quot;Skumring&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 1.2.05.c-IN09."/>
               <resource_input id="_0x9f111" name="Spærring" icon="_0x36" note="Når denne indgang er on, vil al automatik være spærret. Dette giver mulighed for total spærring i både tændt og slukket tilstand.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Tip: lad &quot;Spærring&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 1.2.05.c-IN10."/>
            </inputs>
            <outputs id="_0x9f224" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_scene id="_0x9f34a" name="Højt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;Default 100%, rampetid 1 sek." hide_dialog="yes" note-2="Note: &quot;Højt niveau&quot; fremkaldes også fra ur og kalender.&#xD;&#xA;Ref. 1.2.05.c-UD01."/>
               <resource_scene id="_0x9f44a" name="Lavt niveau" note="Forbindes til lysdæmperen med det ønskede lysniveau og rampetid.&#xD;&#xA;" note-2="Vejledning: kontrollér &quot;Lavt niveau&quot; efter udskiftning af et produkt. Ref. 1.2.05.c-UD02."/>
               <resource_scene id="_0x9f54a" name="Sluk" note="Forbindes til lysdæmperen med 0% lysniveau og den ønskede rampetid.&#xD;&#xA;Ved automatisk sluk benyttes den valgte rampetid og ved manuel sluk benyttes default tiden i lysdæmperen (700ms) for &quot;softsluk&quot;.&#xD;&#xA;" note-2="Hjælp: dokumentér &quot;Sluk&quot; i 1.2.05.c. Trådløs / Bus lysdæmperstyring over for slutbrugeren. Ref. 1.2.05.c-UD03."/>
               <resource_enum id="_0x9f60f" name="Lysdæmper status" typedef="_0x60647" inivalue="_0x60848" backup="yes" icon="_0x22" note="Status indikering til Viewer." note-2="Vejledning - &quot;Lysdæmper status&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 1.2.05.c-UD04."/>
               <resource_timer id="_0x9f710" name="Efterløb udløber om" icon="_0x43" note="Bemærk:&#xD;&#xA;Hvis efterløb viser 00:00:00,000 er efterløb deaktiveret.&#xD;&#xA;" hour="0" minute="0" second="0" millisecond="0" note-2="Tip: brug &quot;Efterløb udløber om&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 1.2.05.c-UD05."/>
               <resource_output id="_0x9f812" name="Manuelt betjent " backup="yes" icon="_0x39" note="Visning af overstyring af PIR. &#xD;&#xA;Kan benyttes til diode eller Viewer.&#xD;&#xA;Ifm. manuel sluk vil udgang blinke (default 15 sek.) som kvittéring for spærring af PIR." note-2="Note: &quot;Manuelt betjent&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 1.2.05.c-UD06."/>
               <resource_output id="_0x9f912" name="Lysdæmper tændt" backup="yes" icon="_0x39" note="Status indikering i diode eller Viewer." note-2="Vejledning: verificér &quot;Lysdæmper tændt&quot; med en måling på klemmen (230 V AC). Ref. 1.2.05.c-UD07."/>
            </outputs>
            <settings id="_0x9fa25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x9fb0f" name="Kort reguleringstryk tænder" typedef="_0x61047" inivalue="_0x61348" backup="yes" icon="_0x22" note="Her er det muligt, at vælge funktionalitet på reguleringstryk dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Højt niveau&#xD;&#xA;Lavt niveau&#xD;&#xA;Sidste niveau" note-2="Dette valg er kun aktivt dag/aften. Om natten (natdrift anvendt) vil et kort reguleringstryk tænde lys på lavt niveau.&#xD;&#xA;Ved frafald af &quot;Natdrift&quot; vil &quot;Højt niveau&quot; fremkaldes første gang der trykkes kort reguleringstryk selvom &quot;Sidste niveau&quot; er valgt. Dette er valgt fordi ny dag er kommet og gl. niveau ikke er relevant mere. "/>
               <resource_enum id="_0x9fc0f" name="Manuel betjening" typedef="_0x9e047" inivalue="_0x9e348" backup="yes" icon="_0x22" note="Ved &quot;Starter efterløb&quot; vil lys slukke på efterløb dag/aften efter sidste påvirking af PIR, tryk eller app regulering.&#xD;&#xA;Ved &quot;Starter ekstra efterløb til sluk&quot; vil lys slukke på ekstra efterløb til sluk efter sidste påvirking af PIR, tryk eller app regulering.&#xD;&#xA;Ved &quot;Spærrer efterløb&quot; vil lys ikke slukke ved skumringsfrafald når manuel betjening er aktiv." note-2="Hjælp til &quot;Manuel betjening&quot; på 1.2.05.c: værdier &lt; minimum afvises af controlleren. Ref. 1.2.05.c-IS02."/>
               <resource_enum id="_0x9fd0f" name="PIR funktion " typedef="_0x9d547" inivalue="_0x9d848" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have dag/aften.&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;Trin høj/sluk&#xD;&#xA;Trin høj/lav&#xD;&#xA;Trin høj/lav/sluk&#xD;&#xA;Trin høj/lav/+ekstra efterløb til sluk&#xD;&#xA;Trin lav/sluk&#xD;&#xA;Dag/aften slukkes kun lys" note-2="Hjælpetekst for &quot;PIR funktion&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 1.2.05.c-IS03."/>
               <resource_enum id="_0x9fe0f" name="PIR funktion nat" typedef="_0x9e447" inivalue="_0x9e648" backup="yes" icon="_0x22" note="Her er det muligt, at vælge hvilken funktion PIR&apos;en skal have om natten.&#xD;&#xA;Natdrift indgangen skal benyttes for at opnå funktion.&#xD;&#xA;&#xD;&#xA;Vælg mellem:&#xD;&#xA;&#xD;&#xA;&quot;Trin lav/sluk&quot; kan benyttes til alle rum - dog ikke soverum.&#xD;&#xA;&quot;Kun efterløb&quot; benyttes til soverum og andre rum der ønskes undtaget." note-2="Bemærk: &quot;PIR funktion nat&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 1.2.05.c-IS04."/>
               <resource_timertime id="_0x9ff17" name="Efterløb dag/aften" backup="yes" icon="_0x4d" note="Her indstilles efterløbstiden for dag/aften." hour="0" minute="3" second="35" millisecond="0" note-2="Hjælpetekst: &quot;Efterløb dag/aften&quot; justeres til anlæggets faktiske forhold. Ref. 1.2.05.c-IS05."/>
               <resource_timertime id="_0xa0017" name="Efterløb nat" backup="yes" icon="_0x4d" note="Her indstilles efterløbstiden for natdrift." hour="0" minute="0" second="54" millisecond="0" note-2="Bemærk: &quot;Efterløb nat&quot; træder i kraft ved næste programafvikling. Ref. 1.2.05.c-IS06."/>
               <resource_timertime id="_0xa0117" name="Ekstra efterløb til sluk " backup="yes" icon="_0x4d" note="Her indstilles ekstra efterløbstid.&#xD;&#xA;Benyttes ifm. disse valg:&#xD;&#xA;&quot;PIR funktion = Trin høj/lav/+ekstra efterløb til sluk&quot; &#xD;&#xA;&quot;Manuel betjening = Aktivt ekstra efterløb til sluk&quot;&#xD;&#xA;Efter sidste påvirking af PIR, tryk eller app regulering vil lys afhængig af opsætning slukke med den valgte initial værdi." hour="2" minute="12" second="0" millisecond="0" note-2="Hjælp til &quot;Ekstra efterløb til sluk&quot; på 1.2.05.c: værdier &lt; minimum afvises af controlleren. Ref. 1.2.05.c-IS07."/>
               <resource_timer id="_0xa0210" name="Spærring %" icon="_0x43" note="Indstilling &quot;Spærring %&quot; på 1.2.05.c: standardværdien kan overskrives lokalt. Ref. 1.2.05.c-IS08." hour="0" minute="0" second="2" millisecond="0" note-2="Hjælpetekst for &quot;Spærring %&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 1.2.05.c-IS08."/>
            </settings>
            <internalsettings id="_0xa0329" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0xa0410" name="Spærring af PIR efter manuel sluk " icon="_0x43" note="Privat mellemled &quot;Spærring af PIR efter manuel sluk&quot; på 1.2.05.c. Trådløs / Bus lysdæmperstyring. Ændres ikke ved idriftsættelse. Ref. 1.2.05.c-IV01." hour="0" minute="0" second="15" millisecond="0" note-2="Hjælp: &quot;Spærring af PIR efter manuel sluk&quot; i 1.2.05.c. Trådløs / Bus lysdæmperstyring dokumenteres kun af hensyn til service. Ref. 1.2.05.c-IV01."/>
               <resource_timer id="_0xa0510" name="Gem nyt scenarie efter " icon="_0x43" note="Intern variabel &quot;Gem nyt scenarie efter&quot; i funktionsblok 1.2.05.c. Bruges af blokkens eget program. Ref. 1.2.05.c-IV02." hour="0" minute="0" second="3" millisecond="0" note-2="Vejledning - &quot;Gem nyt scenarie efter&quot;: ændringer her påvirker blokkens program direkte.&#xD;&#xA;Ref. 1.2.05.c-IV02."/>
               <resource_timer id="_0xa0610" name="Kvittér med blink af scenarie" icon="_0x43" note="Privat variabel &quot;Kvittér med blink af scenarie&quot; - må ikke linkes til produkter uden for blokken.&#xD;&#xA;Ref. 1.2.05.c-IV03." hour="0" minute="0" second="1" millisecond="0" note-2="Tip: følg &quot;Kvittér med blink af scenarie&quot; i simuleringen for at forstå blokkens forløb. Ref. 1.2.05.c-IV03."/>
               <resource_timer id="_0xa0710" name="Kvittér med blink efter manuel sluk" icon="_0x43" note="Arbejdsvariabel &quot;Kvittér med blink efter manuel sluk&quot; på 1.2.05.c. Trådløs / Bus lysdæmperstyring. Holder blokkens mellemresultat. Ref. 1.2.05.c-IV04." hour="0" minute="0" second="1" millisecond="0" note-2="Note: &quot;Kvittér med blink efter manuel sluk&quot; er privat for blokken &amp; deles ikke med andre blokke.&#xD;&#xA;Ref. 1.2.05.c-IV04."/>
               <resource_timer id="_0xa0810" name="Spærring" icon="_0x43" note="Intern variabel &quot;Spærring&quot;: sættes og læses udelukkende af 1.2.05.c. Ref. 1.2.05.c-IV05." hour="0" minute="0" second="0" millisecond="50" note-2="Vejledning: rør ikke &quot;Spærring&quot; medmindre blokken låses op. Ref. 1.2.05.c-IV05."/>
               <resource_timer id="_0xa0910" name="Status check" icon="_0x43" note="Hjælpevariabel &quot;Status check&quot; - anvendes når blokken skal huske en tilstand. Ref. 1.2.05.c-IV06." hour="0" minute="0" second="30" millisecond="0" note-2="Hjælp: &quot;Status check&quot; i 1.2.05.c. Trådløs / Bus lysdæmperstyring dokumenteres kun af hensyn til service. Ref. 1.2.05.c-IV06."/>
               <resource_timer id="_0xa0a10" name="Max tryktid" icon="_0x43" note="Intern variabel &quot;Max tryktid&quot;. Nulstilles når controlleren genstarter.&#xD;&#xA;Ref. 1.2.05.c-IV07." hour="0" minute="0" second="0" millisecond="400" note-2="Vejledning - &quot;Max tryktid&quot;: ændringer her påvirker blokkens program direkte.&#xD;&#xA;Ref. 1.2.05.c-IV07."/>
               <resource_timer id="_0xa0b10" name="Min. regulering 1" icon="_0x43" note="Intern tidsstyring &quot;Min. regulering 1&quot; i 1.2.05.c. Værdien styres af programmet &amp; ikke af brugeren. Ref. 1.2.05.c-IV08." hour="0" minute="0" second="0" millisecond="600" note-2="Tip: følg &quot;Min. regulering 1&quot; i simuleringen for at forstå blokkens forløb. Ref. 1.2.05.c-IV08."/>
               <resource_timer id="_0xa0c10" name="Min. regulering 2" icon="_0x43" note="Intern variabel &quot;Min. regulering 2&quot;: ikke synlig i konfigurationsvinduet (&lt; programmeringsmode). Ref. 1.2.05.c-IV09." hour="0" minute="0" second="0" millisecond="600" note-2="Note: &quot;Min. regulering 2&quot; er privat for blokken &amp; deles ikke med andre blokke.&#xD;&#xA;Ref. 1.2.05.c-IV09."/>
               <resource_flag id="_0xa0d0a" name="Flag for manuel " backup="yes" icon="_0x33" note="Intern variabel &quot;Flag for manuel&quot; - indgår i blokkens betingelser og kommandoer. Ref. 1.2.05.c-IV10." note-2="Vejledning: rør ikke &quot;Flag for manuel&quot; medmindre blokken låses op. Ref. 1.2.05.c-IV10."/>
               <resource_flag id="_0xa0e0a" name="Reg. retning" icon="_0x33" note="Privat mellemled &quot;Reg. retning&quot; på 1.2.05.c. Trådløs / Bus lysdæmperstyring. Ændres ikke ved idriftsættelse. Ref. 1.2.05.c-IV11." note-2="Hjælp: &quot;Reg. retning&quot; i 1.2.05.c. Trådløs / Bus lysdæmperstyring dokumenteres kun af hensyn til service. Ref. 1.2.05.c-IV11."/>
               <resource_flag id="_0xa0f0a" name="Oneshot man" backup="yes" icon="_0x33" note="Intern variabel &quot;Oneshot man&quot; i funktionsblok 1.2.05.c. Bruges af blokkens eget program. Ref. 1.2.05.c-IV12." note-2="Vejledning - &quot;Oneshot man&quot;: ændringer her påvirker blokkens program direkte.&#xD;&#xA;Ref. 1.2.05.c-IV12."/>
               <resource_flag id="_0xa100a" name="PIR årsag til tænding" icon="_0x33" note="Privat variabel &quot;PIR årsag til tænding&quot; - må ikke linkes til produkter uden for blokken.&#xD;&#xA;Ref. 1.2.05.c-IV13." note-2="Tip: følg &quot;PIR årsag til tænding&quot; i simuleringen for at forstå blokkens forløb. Ref. 1.2.05.c-IV13."/>
            </internalsettings>
