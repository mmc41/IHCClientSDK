         </functionblock>
         <functionblock id="_0x2ead28" name="5.2.03.e. Pumpestyring" master_schneider_electric="yes" master_type="5.2.03" master_version="e" master_name="Pumpestyring" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="Bruges til at styre pumpedrift i forbindelse med vandbåren gulvvarme.&#xD;&#xA;Funktionblokken optimerer pumpedriften således at cirkulationpumpen ikke pumper mod lukkede ventiler.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse mærker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret.">
            <inputs id="_0x2eb123" name="Indgang" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x2eb211" name="Indgang varmestyring 1." icon="_0x36" note="Forbindes til 5.2.05 - Udgang til pumpestyring.&#xD;&#xA;Varmeproduktionen starter når bare en af indgangene er aktive.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Vejledning - &quot;Indgang varmestyring 1.&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 5.2.03.e-IN01."/>
