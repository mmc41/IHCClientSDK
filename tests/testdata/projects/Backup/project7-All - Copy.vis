         <functionblock id="_0x3daf28" name="6.1.04.b. LK Kodetastatur med 6 brugerkoder og 6 udgange" master_schneider_electric="yes" master_type="6.1.04" master_version="b" master_name="LK Kodetastatur med 6 brugerkoder og 6 udgange" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="6.1.04.b. LK Kodetastatur med 6 brugerkoder og 6 udgange&#xD;&#xA;&#xD;&#xA;Anvendes når kodetastaturet skal styre flere ting på hver sin kode. F.eks. alarm, dørlås og lys.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.1 Tastatur\6.1.04.pdf">
            <inputs id="_0x3db023" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x3db111" name="Indgang 1 fra kodetastatur" icon="_0x36" note="Forbindes til udgang 1 fra kodetastatur&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Indgang 1 fra kodetastatur&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 6.1.04.b-IN01."/>
               <resource_input id="_0x3db211" name="Indgang 2 fra kodetastatur" icon="_0x36" note="Forbindes til udgang 2 fra kodetastatur&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Indgang 2 fra kodetastatur&quot; i simulering før anlægget sættes i drift. Ref. 6.1.04.b-IN02."/>
               <resource_input id="_0x3db311" name="Indgang 3 fra kodetastatur" icon="_0x36" note="Forbindes til udgang 2 fra kodetastatur&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang 3 fra kodetastatur&quot; er linket til i 6.1.04.b. LK Kodetastatur med 6 brugerkoder og 6 udgange. Ref. 6.1.04.b-IN03."/>
               <resource_input id="_0x3db411" name="Indgang for spærring af tilkobling" icon="_0x36" note="Tilkobling alarm er ikke mulig så længe indgang er on.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Indgang for spærring af tilkobling&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 6.1.04.b-IN04."/>
            </inputs>
