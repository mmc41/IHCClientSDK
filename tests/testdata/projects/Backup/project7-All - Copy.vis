         <functionblock id="_0x485c28" name="6.4.03.a. Lyd-/lysblok med X antal pulser efterfulgt af lang pause" master_schneider_electric="yes" master_type="6.4.03" master_version="a" master_name="Lyd-/lysblok med X antal pulser efterfulgt af lang pause" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="6.4.03. Lyd-/lysblok med X antal pulser efterfulgt af lang pause.&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Lyd- eller lysblok med et vilkårligt antal pulser efterfulgt af lang pause. Der er mulighed for at ændre alle værdier.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.4 Lydblokke\6.4.03.pdf">
            <inputs id="_0x485d23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x485e11" name="Indgang for start lydblok" icon="_0x36" note="Lydblok er aktiv så længe indgang er on&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Indgang for start lydblok&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 6.4.03.a-IN01."/>
            </inputs>
            <outputs id="_0x485f24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x486012" name="Lydgiver" icon="_0x39" note="Forbindes direkte til lydgiver." note-2="Hjælp til &quot;Lydgiver&quot; på 6.4.03.a: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 6.4.03.a-UD01."/>
               <resource_output id="_0x486112" name="Puls - On" icon="_0x39" note="Giver kort puls når &quot;Lydgiver&quot; går on.&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Hjælpetekst for &quot;Puls - On&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 6.4.03.a-UD02."/>
               <resource_output id="_0x486212" name="Puls - Off" icon="_0x39" note="Giver kort puls når &quot;Lydgiver&quot; går off.&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Bemærk: &quot;Puls - Off&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 6.4.03.a-UD03."/>
            </outputs>
            <settings id="_0x486325" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x486410" name="Timertid for lyd-/lyspuls" icon="_0x43" note="Her indstilles hvor længe udgangen lydgiver skal være on" hour="2" minute="12" second="30" millisecond="200" note-2="Vejledning: afprøv &quot;Timertid for lyd-/lyspuls&quot; i simulering før anlægget overdrages. Ref. 6.4.03.a-IS01."/>
               <resource_timer id="_0x486510" name="Timertid for pause mellem pulser" icon="_0x43" note="Her indstilles hvor længe udgangen lydgiver skal være off i puls perioden" hour="2" minute="13" second="0" millisecond="200" note-2="Hjælp: værdien for &quot;Timertid for pause mellem pulser&quot; i 6.4.03.a. Lyd-/lysblok med X antal pulser efterfulgt af lang pause bør gennemgås ved service. Ref. 6.4.03.a-IS02."/>
               <resource_timer id="_0x486610" name="Timer for lang pause mellem pulser" icon="_0x43" note="Her indstilles den lange pause efter pulsperioden" hour="0" minute="0" second="28" millisecond="500" note-2="Vejledning - &quot;Timer for lang pause mellem pulser&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 6.4.03.a-IS03."/>
               <resource_integer id="_0x48670b" name="Antal pulser i pulsperiode" note="Her indstilles hvor mange pulser der skal være i  pulsperioden" inivalue="16" note-2="Tip: notér den valgte værdi for &quot;Antal pulser i pulsperiode&quot; i anlægsdokumentationen. Ref. 6.4.03.a-IS04."/>
               <resource_counter id="_0x48680c" name="Tæller for pulser i pulsperiode" note="Tæller der viser nedtælling på pulserne" inivalue="7" note-2="Note: &quot;Tæller for pulser i pulsperiode&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 6.4.03.a-IS05."/>
            </settings>
            <internalsettings id="_0x486929" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_timer id="_0x486a10" name="Puls timer til styring af andre blokke" icon="_0x43" hour="0" minute="0" second="0" millisecond="50"/>
            </internalsettings>
