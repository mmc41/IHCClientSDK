               <resource_date id="_0x2d3c0e" name="Dato for skift til beboet" backup="yes" icon="_0x29" note="Her indstilles hvornår der skal skiftes driftstilstand &#xD;&#xA;Anvendes f.eks. til at angive hvornår man vender tilbage fra ferie." year="2000" month="9" day="15" note-2="Note: &quot;Dato for skift til beboet&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 5.2.01.h-IS02." udf="#SS02#"/>
               <resource_time id="_0x2d3d0d" name="Tidspunkt for skift til ubeboet" backup="yes" icon="_0x2f" note="Her indstilles hvornår der skal skiftes driftstilstand &#xD;&#xA;Anvendes f.eks. til at angive hvornår man tager på ferie." hour="16" minute="30" second="0" note-2="Vejledning: afprøv &quot;Tidspunkt for skift til ubeboet&quot; i simulering før anlægget overdrages. Ref. 5.2.01.h-IS03." udf="#SS03#"/>
               <resource_date id="_0x2d3e0e" name="Dato for skift til ubeboet" backup="yes" icon="_0x29" note="Her indstilles hvornår der skal skiftes driftstilstand &#xD;&#xA;Anvendes f.eks. til at angive hvornår man tager på ferie." year="2000" month="10" day="4" note-2="Hjælp: værdien for &quot;Dato for skift til ubeboet&quot; i 5.2.01.h. Betjeningspanel bør gennemgås ved service. Ref. 5.2.01.h-IS04." udf="#SS04#"/>
               <resource_time id="_0x2d3f0d" name="Tidspunkt for skift til frostsikring" backup="yes" icon="_0x2f" note="Her indstilles hvornår der skal skiftes driftstilstand &#xD;&#xA;Anvendes f.eks. i sommerhuse når man lukker huset af for vinteren. " hour="0" minute="20" second="0" note-2="Vejledning - &quot;Tidspunkt for skift til frostsikring&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 5.2.01.h-IS05."/>
               <resource_date id="_0x2d400e" name="Dato for skift til frostsikring" backup="yes" icon="_0x29" note="Her indstilles hvornår der skal skiftes driftstilstand &#xD;&#xA;Anvendes f.eks. i sommerhuse når man lukker huset af for vinteren. " year="2000" month="10" day="27" note-2="Tip: notér den valgte værdi for &quot;Dato for skift til frostsikring&quot; i anlægsdokumentationen. Ref. 5.2.01.h-IS06."/>
               <resource_timer id="_0x2d4110" name="Tryktid før testfunktion aktiveres" icon="_0x43" note="Den tid en af indgangene beboet, ubeboet eller frostsikring skal aktiveres før testfunktion går igang." hour="0" minute="0" second="17" millisecond="500" note-2="Note: &quot;Tryktid før testfunktion aktiveres&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 5.2.01.h-IS07." udf="#SA05#"/>
               <resource_timertime id="_0x2d4217" name="Timertid: Test" icon="_0x4d" note="Varighed af testfunktionen hvor telestaterne åbnes og dioderne beboet, ubeboet og frostsikret blinker." hour="0" minute="27" second="0" millisecond="0" note-2="Vejledning: afprøv &quot;Timertid: Test&quot; i simulering før anlægget overdrages. Ref. 5.2.01.h-IS08."/>
