         <functionblock id="_0x306228" name="5.2.05.d Varmestyring - avanceret" master_schneider_electric="yes" master_type="5.2.05" master_version="d" master_name="Varmestyring - avanceret" master_programmer="Schneider Electric" master_date_year="2018" master_date_month="5" master_date_day="15" locked="yes" icon="_0xe" note="Varmestyring - avanceret&#xD;&#xA;&#xD;&#xA;Avanceret temperaturstyring med mange indstillingsmuligheder styret af dag- og nattemperatur og drifttilstanden (beboet, ubeboet eller frostsikring)&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !&#xD;&#xA;" udf="#5.2.05#">
            <inputs id="_0x308623" name="Indgang" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_temperature id="_0x308714" name="Rumtemperatur" note="Forbindes til udgangen rumtemperatur på termostaten. &#xD;&#xA;Viser den aktuelle temperatur i rummet.&#xD;&#xA;" inivalue="21.00" note-2="Hjælp: dokumentér hvilket produkt &quot;Rumtemperatur&quot; er linket til i 5.2.05.d Varmestyring - avanceret. Ref. 5.2.05.d-IN01." udf="#I01#">
                  <link_to_resource id="_0x4a122c" name="Følg Link" icon="_0x4a" link="_0x4a112d"/>
               </resource_temperature>
               <resource_temperature id="_0x308814" name="Gulvtemperatur" note="Ressource kommer fra produkt" inivalue="26.50" note-2="Vejledning - &quot;Gulvtemperatur&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 5.2.05.d-IN02." udf="#I02#">
                  <link_to_resource id="_0x4a102c" name="Følg Link" icon="_0x4a" link="_0x4a0f2d"/>
               </resource_temperature>
               <resource_input id="_0x308911" name="Alarm - Sensorfejl " icon="_0x36" note="Forbindes til alarm på termostaten.&#xD;&#xA;On hvis der er fejl i kommunikation med temperatursensor. &#xD;&#xA;Opvarmningen afbrydes og og udgangen sensorfejl skifter til on." note-2="Tip: lad &quot;Alarm - Sensorfejl&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 5.2.05.d-IN03." udf="#I03#">
                  <link_to_resource id="_0x4a7c2c" name="Følg Link" icon="_0x4a" link="_0x4a7b2d"/>
               </resource_input>
               <resource_input id="_0x308a11" name="Dagtemperatur" icon="_0x36" note="Aktiverer ønsket dagtemperatur. Forbindes til FB 5.2.04 - Udgang dagtemperatur" note-2="Note: &quot;Dagtemperatur&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 5.2.05.d-IN04." udf="#I07#"/>
               <resource_input id="_0x308b11" name="Nattemperatur" icon="_0x36" note="Aktiverer ønsket nattemperatur. Forbindes til FB 5.2.04 - Udgang nattemperatur" note-2="Vejledning: test &quot;Nattemperatur&quot; i simulering før anlægget sættes i drift. Ref. 5.2.05.d-IN05." udf="#I08#"/>
               <resource_input id="_0x308c11" name="Gæstetilstand" icon="_0x36" note="Input, f.eks. fra en timer for at reducere temperatur. Anvender setpunkt for dagtemperatur." note-2="Hjælp: dokumentér hvilket produkt &quot;Gæstetilstand&quot; er linket til i 5.2.05.d Varmestyring - avanceret. Ref. 5.2.05.d-IN06." udf="#I09#"/>
               <resource_input id="_0x308d11" name="Overstyring" icon="_0x36" note="Overstyring bruges til at overstyre temperaturer iht. indstillinger.&#xD;&#xA;Anvendes til f.eks. overskud af varme fra solfanger, billig strøm eller andre situationer hvor der ønskes en anderledes temperatur." note-2="Vejledning - &quot;Overstyring&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 5.2.05.d-IN07." udf="#I05#"/>
               <resource_input id="_0x308e11" name="Sommertilstand" backup="yes" icon="_0x36" note="Sommertilstand anvendes hvis man ikke ønsker at varme om sommeren.&#xD;&#xA;Indgang fra et planlægningsprogram eller en kontakt (on=sommertilstand).&#xD;&#xA;Ved sommertilstand on vil setpunkter for rum og gulv være som indstillet i ubeboet.&#xD;&#xA;Ønskes man at et gulv som ikke føles koldt om sommeren og er reguleringsformen, rum og gulv eller gulv valgt (kræver man har en gulvføler tilsluttet) kan man vælge sommerkomfort til.&#xD;&#xA;Er sommerkomfort valgt til vil gulvtemperaturen blive reguleret som normalt (ingen sommer sænkning på gulv temp)." note-2="Tip: lad &quot;Sommertilstand&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 5.2.05.d-IN08." udf="#I06#"/>
               <resource_input id="_0x308f11" name="Magnetkontakt (f.eks dør ell. vindue) NC." icon="_0x36" note="Bruges til at slukke for varmen når dør eller vinduer åbnes.&#xD;&#xA;Er kontakten åben vil setpunket for ubeboet tilstand være aktiv, hvis systemet befinder sig i driftformen er beboet." inivalue="on" note-2="Note: &quot;Magnetkontakt (f.eks dør ell. vindue) NC.&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 5.2.05.d-IN09."/>
               <resource_enum id="_0x30900f" name="Driftform" typedef="_0x2d2247" inivalue="_0x2d2348" icon="_0x22" note="Skal forbindes til funktionsblok 5.2.01 udgang - driftform. &#xD;&#xA;Styrer driftform og viser hvilken tilstand der er aktiv.&#xD;&#xA;" note-2="Vejledning: test &quot;Driftform&quot; i simulering før anlægget sættes i drift. Ref. 5.2.05.d-IN10.">
                  <link_to_resource id="_0x4a262c" name="Følg Link" icon="_0x4a" link="_0x4a252d"/>
               </resource_enum>
            </inputs>
            <outputs id="_0x309124" name="Udgang" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x309212" name="Telestat / Varme" icon="_0x39" note="Forbindes til telestat, elektrisk opvarmning eller relæ.&#xD;&#xA;Varmeproduktion og pumpestyring er separate udgange pga pumpe og ventilmotionering." note-2="Hjælp: notér i 5.2.05.d Varmestyring - avanceret hvilke produkter &quot;Telestat / Varme&quot; betjener. Ref. 5.2.05.d-UD01." udf="#O01#">
                  <link_from_resource id="_0x4a132d" name="Følg Link" icon="_0x47" link="_0x4a142c"/>
               </resource_output>
               <resource_output id="_0x309312" name="Pumpestyring" icon="_0x39" note="Forbindes til FB 5.2.03 - Indgang varmestyring 1-16.&#xD;&#xA;Varmeproduktion og pumpestyring er separate udgange pga pumpe og ventilmotionering." note-2="Vejledning - &quot;Pumpestyring&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 5.2.05.d-UD02." udf="#O02#"/>
               <resource_output id="_0x309412" name="Sensor fejl" icon="_0x39" note="On ved fejl på temperatursensor. Anvendes til indikering af fejl på temperatur sensor." note-2="Tip: brug &quot;Sensor fejl&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.2.05.d-UD03." udf="#O03#"/>
               <resource_temperature id="_0x309514" name="Rummets aktuelle setpunkt" backup="yes" note="Viser det aktuelle setpunkt for ønsket rumtemperatur" note-2="Note: &quot;Rummets aktuelle setpunkt&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.2.05.d-UD04." udf="#SS05#"/>
               <resource_temperature id="_0x309614" name="Gulvets aktuelle setpunkt" note="Viser det aktuelle setpunkt for ønsket gulvtemperatur" note-2="Vejledning: verificér &quot;Gulvets aktuelle setpunkt&quot; med en måling på klemmen (230 V AC). Ref. 5.2.05.d-UD05." udf="#SA06#"/>
            </outputs>
            <settings id="_0x309725" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x30980f" name="Reguleringsform" typedef="_0x307f47" inivalue="_0x308048" backup="yes" icon="_0x22" note="Her vælges hvilken sensor der reguleres efter. &#xD;&#xA;Vælg reguleringsform:  rum og gulv, gulv eller rum drift. &#xD;&#xA;Ved valg af rum og gulv skal begge referencer være opfyldt før varmen slukkes.&#xD;&#xA;" note-2="Hjælp til &quot;Reguleringsform&quot; på 5.2.05.d: værdier &lt; minimum afvises af controlleren. Ref. 5.2.05.d-IS01." udf="#SI01#"/>
               <resource_enum id="_0x30990f" name="Varme type" typedef="_0x308347" inivalue="_0x308448" backup="yes" icon="_0x22" note="Vælg anlægstype for opvarmning.&#xD;&#xA;Der kan vælges mellem vandbåren varme og elvarme" note-2="Hjælpetekst for &quot;Varme type&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.2.05.d-IS02." udf="#SI02#"/>
               <resource_enum id="_0x309a0f" name="Pulsvarme" typedef="_0x307c47" inivalue="_0x307e48" backup="yes" icon="_0x22" note="Ved valg af pulsvarme vil udgang for varmeproduktion gå on og off iht. tid når temperaturen er inden for hystereseområdet.&#xD;&#xA;Dette giver en mere stabil temperatur (mindre temperaturudsving).&#xD;&#xA;" note-2="Bemærk: &quot;Pulsvarme&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.2.05.d-IS03." udf="#SA04#"/>
               <resource_enum id="_0x309b0f" name="Sommer gulvkomfort" typedef="_0x307947" inivalue="_0x307b48" backup="yes" icon="_0x22" note="Sommerkomfort vil kun være aktiv hvis indgang sommertilstand er on (se iøvrigt beskrivelse for indgang sommertilstand).&#xD;&#xA;Ved on vil gulvets setpunkt skifte iht indstillede temperaturer.&#xD;&#xA;Ved off anvendes setpunkt for ubeboet." note-2="Hjælpetekst: &quot;Sommer gulvkomfort&quot; justeres til anlæggets faktiske forhold. Ref. 5.2.05.d-IS04." udf="#SA03#"/>
               <resource_enum id="_0x309c0f" name="Overstyring mulig ved følgende driftformer" typedef="_0x306a47" inivalue="_0x307048" icon="_0x22" note="Vælg hvornår overstyring skal være muligt iht. driftform: beboet, ubeboet eller frostsikring.&#xD;&#xA;Anvendes til f.eks. overskud af varme fra solfanger, billig strøm eller andre situationer hvor der ønskes en anderledes temperatur." note-2="Bemærk: &quot;Overstyring mulig ved følgende driftformer&quot; træder i kraft ved næste programafvikling. Ref. 5.2.05.d-IS05."/>
               <resource_enum id="_0x309d0f" name="Overstyring mulig sommer/vinter" typedef="_0x307547" inivalue="_0x307748" icon="_0x22" note="Vælg hvornår overstyring skal være muligt iht. sommer og vinter.&#xD;&#xA;Anvendes til f.eks. overskud af varme fra solfanger, billig strøm eller andre situationer hvor der ønskes en anderledes temperatur." note-2="Hjælp til &quot;Overstyring mulig sommer/vinter&quot; på 5.2.05.d: værdier &lt; minimum afvises af controlleren. Ref. 5.2.05.d-IS06."/>
               <resource_temperature id="_0x309e14" name="Maks. gulvtemperatur" backup="yes" note="Setpunkt for maks. gulvtemperatur i regulering.&#xD;&#xA;Ved temperaturer over dette afbrydes varmeproduktion.&#xD;&#xA;Varmeproduktion genoptages så snart temperatur ikke er over maks gulvtemperatur." inivalue="39.60" note-2="Hjælpetekst for &quot;Maks. gulvtemperatur&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.2.05.d-IS07." udf="#SA10#"/>
               <resource_temperature id="_0x309f14" name="Setpunkt rum &quot;normal&quot;" backup="yes" note="Ønsket rumtemperatur ved normaldrift i &quot;driftform beboet&quot;&#xD;&#xA;Normaldrift = Ingen aktivering af overstyring, gæstetilstand, dag eller nattemperatur." inivalue="23.10" note-2="Bemærk: &quot;Setpunkt rum &quot;normal&quot;&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.2.05.d-IS08." udf="#SS01#"/>
               <resource_temperature id="_0x30a014" name="Setpunkt rum &quot;dag&quot;" backup="yes" note="Ønsket rumtemperatur ved &quot;driftform beboet&quot;&#xD;&#xA;Dagtemperatur er aktiv ved: indgang dagtemperatur on eller gæstetilstand on og overstyring ikke er aktiv iht indstillinger." inivalue="20.90" note-2="Hjælpetekst: &quot;Setpunkt rum &quot;dag&quot;&quot; justeres til anlæggets faktiske forhold. Ref. 5.2.05.d-IS09." udf="#SS15#"/>
               <resource_temperature id="_0x30a114" name="Setpunkt rum &quot;nat&quot;" backup="yes" note="Ønsket rumtemperatur ved &quot;driftform beboet&quot;&#xD;&#xA;Nattemperatur er aktiv ved: indgang nattemperatur on og ingen aktivering af  gæstetilstand, dagtemperatur og overstyring ikke er aktiv iht indstillinger.." inivalue="22.00" note-2="Bemærk: &quot;Setpunkt rum &quot;nat&quot;&quot; træder i kraft ved næste programafvikling. Ref. 5.2.05.d-IS10." udf="#SS16#"/>
               <resource_temperature id="_0x30a214" name="Setpunkt rum &quot;overstyret&quot;" backup="yes" note="Ønsket rumtemperatur ved overstyring iht. indstillinger for overstyring." inivalue="25.30" note-2="Hjælp til &quot;Setpunkt rum &quot;overstyret&quot;&quot; på 5.2.05.d: værdier &lt; minimum afvises af controlleren. Ref. 5.2.05.d-IS11." udf="#SA13#"/>
               <resource_temperature id="_0x30a314" name="Setpunkt gulv &quot;normal&quot;" backup="yes" note="Ønsket gulvtemperatur ved normaldrift i &quot;driftform beboet&quot;&#xD;&#xA;Normaldrift = Ingen aktivering af overstyring, gæstetilstand, dag eller nattemperatur.&#xD;&#xA;" inivalue="29.20" note-2="Hjælpetekst for &quot;Setpunkt gulv &quot;normal&quot;&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.2.05.d-IS12." udf="#SA11#"/>
               <resource_temperature id="_0x30a414" name="Setpunkt gulv &quot;dag&quot;" backup="yes" note="Ønsket gulvtemperatur ved &quot;driftform beboet&quot;&#xD;&#xA;Dagtemperatur er aktiv ved: indgang dagtemperatur on eller gæstetilstand on og overstyring ikke er aktiv iht indstillinger." inivalue="28.10" note-2="Bemærk: &quot;Setpunkt gulv &quot;dag&quot;&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.2.05.d-IS13." udf="#SA21#"/>
               <resource_temperature id="_0x30a514" name="Setpunkt gulv &quot;nat&quot;" backup="yes" note="Ønsket gulvtemperatur ved &quot;driftform beboet&quot;&#xD;&#xA;Nattemperatur er aktiv ved: indgang nattemperatur on og ingen aktivering af  gæstetilstand, dagtemperatur og overstyring ikke er aktiv iht indstillinger." inivalue="28.60" note-2="Hjælpetekst: &quot;Setpunkt gulv &quot;nat&quot;&quot; justeres til anlæggets faktiske forhold. Ref. 5.2.05.d-IS14."/>
               <resource_temperature id="_0x30a614" name="Setpunkt gulv &quot;overstyret&quot;" backup="yes" note="Ønsket gulvtemperatur ved overstyring iht. indstillinger for overstyring.&#xD;&#xA;Anvendes til f.eks. overskud af varme fra solfanger, billig strøm eller andre situationer hvor der ønskes en anderledes temperatur." inivalue="33.00" note-2="Bemærk: &quot;Setpunkt gulv &quot;overstyret&quot;&quot; træder i kraft ved næste programafvikling. Ref. 5.2.05.d-IS15." udf="#SA12#"/>
               <resource_temperature id="_0x30a714" name="Setpunkt rum &amp; gulv &quot;ubeboet&quot;" backup="yes" note="Ønsket rumtemperatur hele døgnet når huset er ubeboet - f.eks. når man er på ferie. Kan indstilles fra 10 - 25 gr.&#xD;&#xA;Er kun aktiv når betjeningspanel (FB 5.2.04) er i ubeboet eller i beboetdrift med sommer tilstand aktiveret.&#xD;&#xA;" inivalue="13.50" note-2="Hjælp til &quot;Setpunkt rum &amp; gulv &quot;ubeboet&quot;&quot; på 5.2.05.d: værdier &lt; minimum afvises af controlleren. Ref. 5.2.05.d-IS16." udf="#SA17#"/>
               <resource_temperature id="_0x30a814" name="Setpunkt rum &amp; gulv &quot;frostsikring&quot;" backup="yes" note="Ønsket rumtemperatur hele døgnet når huset er frostbeskyttet - f.eks. når huset er fraflyttet. Kan indstilles fra 0,5 - 15 gr.&#xD;&#xA;Er kun aktiv når betjeningspanel (FB 5.2.04) er i frost drift.&#xD;&#xA;Anvendes til at forebygge evt. skade på rum/gulv" inivalue="5.50" note-2="Hjælpetekst for &quot;Setpunkt rum &amp; gulv &quot;frostsikring&quot;&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.2.05.d-IS17." udf="#SA18#"/>
               <resource_timertime id="_0x30a917" name="Timertid pulsvarme on" icon="_0x4d" note="Den tid der varmes på gulvet når temperaturen er inde for hystereseområdet." hour="0" minute="7" second="45" millisecond="0" note-2="Bemærk: &quot;Timertid pulsvarme on&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.2.05.d-IS18."/>
               <resource_timertime id="_0x30aa17" name="Timertid pulsvarme pause" icon="_0x4d" note="Den tid der ikke varmes på gulvet når temperaturen er inde for hystereseområdet." hour="0" minute="22" second="0" millisecond="0" note-2="Hjælpetekst: &quot;Timertid pulsvarme pause&quot; justeres til anlæggets faktiske forhold. Ref. 5.2.05.d-IS19."/>
               <resource_temperature id="_0x30ab14" name="Rumhysterese" backup="yes" note="Indstilling af temperaturudsving (hysterese) i forhold til aktivt setpunkt.&#xD;&#xA;Pulsvarmen er aktiv når temperatur er inden for hysteresen (aktivt setpunkt +/- hysterese)." inivalue="0.30" note-2="Bemærk: &quot;Rumhysterese&quot; træder i kraft ved næste programafvikling. Ref. 5.2.05.d-IS20." udf="#SA19#"/>
               <resource_temperature id="_0x30ac14" name="Gulvhysterese" backup="yes" note="Indstilling af temperaturudsving (hysterese) i forhold til aktivt setpunkt.&#xD;&#xA;Pulsvarmen er aktiv når temperatur er inden for hysteresen (aktivt setpunkt +/- hysterese)." inivalue="0.10" note-2="Hjælp til &quot;Gulvhysterese&quot; på 5.2.05.d: værdier &lt; minimum afvises af controlleren. Ref. 5.2.05.d-IS21." udf="#SA20#"/>
               <resource_counter id="_0x30ad0c" name="Antal dage imellem ventilmotion" backup="yes" note="Antal af dage imellem motionering af ventil. Denne funktion sørger for at telestater ikke sætter sig fast. Denne funktion er kun aktiv ved vandbåren varme." inivalue="8" note-2="Hjælpetekst for &quot;Antal dage imellem ventilmotion&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 5.2.05.d-IS22." udf="#SA22#"/>
               <resource_time id="_0x30ae0d" name="Ventilmotion varighed" backup="yes" icon="_0x2f" note="Ønsket tid for motionering af ventiler" hour="0" minute="6" second="30" note-2="Bemærk: &quot;Ventilmotion varighed&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 5.2.05.d-IS23." udf="#SA23#"/>
            </settings>
