         <functionblock id="_0x42628" name="1.1.05. Beolink Fjernbetjening" master_schneider_electric="yes" master_type="1.1.05" master_name="Beolink Fjernbetjening" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="1.1.05. Fjernbetjening&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Blokken er special designet til fjernbetjeningen fra Bang &amp; Olufsen,&#xD;&#xA;kan anvendes til Mark3, Beolink, Beo4 og Beo5&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x43123" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x43211" name="Tryk 11 fra IR fjernbetjening (Light + Store)" icon="_0x36" note="Forbindes til adresse 13 fra IR-modtager&#xD;&#xA;(feks. Beo4 = Light + Store)&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Tryk 11 fra IR fjernbetjening (Light + Store)&quot; i simulering før anlægget sættes i drift. Ref. 1.1.05-IN01.">
                  <link_to_resource id="_0x49ce2c" name="Følg Link" icon="_0x4a" link="_0x49cd2d"/>
               </resource_input>
               <resource_input id="_0x43311" name="Tryk 12 fra IR fjernbetjening (Light + 1)" icon="_0x36" note="Forbindes til adresse 14 fra IR-modtager&#xD;&#xA;(feks. Beo4 = Light + 1)&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Tryk 12 fra IR fjernbetjening (Light + 1)&quot; er linket til i 1.1.05. Beolink Fjernbetjening. Ref. 1.1.05-IN02.">
                  <link_to_resource id="_0x49d02c" name="Følg Link" icon="_0x4a" link="_0x49cf2d"/>
               </resource_input>
               <resource_input id="_0x43411" name="Tryk 13 fra IR fjernbetjening (Light + 2)" icon="_0x36" note="Forbindes til adresse 15 fra IR-modtager&#xD;&#xA;(feks. Beo4 = Light + 2)&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Tryk 13 fra IR fjernbetjening (Light + 2)&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 1.1.05-IN03.">
                  <link_to_resource id="_0x49d22c" name="Følg Link" icon="_0x4a" link="_0x49d12d"/>
               </resource_input>
               <resource_input id="_0x43511" name="Tryk 14 fra IR fjernbetjening (Light + 3)" icon="_0x36" note="Forbindes til adresse 16 fra IR-modtager&#xD;&#xA;(feks. Beo4 = Light + 3)&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Tryk 14 fra IR fjernbetjening (Light + 3)&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 1.1.05-IN04.">
                  <link_to_resource id="_0x49d42c" name="Følg Link" icon="_0x4a" link="_0x49d32d"/>
               </resource_input>
               <resource_input id="_0x43611" name="Tryk 15 fra IR fjernbetjening Light + 4)" icon="_0x36" note="Forbindes til adresse 17 fra IR-modtager&#xD;&#xA;(feks. Beo4 = Light + 4)&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Tryk 15 fra IR fjernbetjening Light + 4)&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 1.1.05-IN05.">
                  <link_to_resource id="_0x49d62c" name="Følg Link" icon="_0x4a" link="_0x49d52d"/>
               </resource_input>
               <resource_input id="_0x43711" name="Tryk 16 fra IR fjernbetjening (Light + 5)" icon="_0x36" note="Forbindes til adresse 18 fra IR-modtager&#xD;&#xA;(feks. Beo4 = Light + 5)&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning: test &quot;Tryk 16 fra IR fjernbetjening (Light + 5)&quot; i simulering før anlægget sættes i drift. Ref. 1.1.05-IN06.">
                  <link_to_resource id="_0x49d82c" name="Følg Link" icon="_0x4a" link="_0x49d72d"/>
               </resource_input>
               <resource_input id="_0x43811" name="Tryk 7 fra IR fjernbetjening (Light + ^)" icon="_0x36" note="Forbindes til adresse 7 fra IR-modtager&#xD;&#xA;(feks. Beo4 = Light + ^)&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Tryk 7 fra IR fjernbetjening (Light + ^)&quot; er linket til i 1.1.05. Beolink Fjernbetjening. Ref. 1.1.05-IN07.">
