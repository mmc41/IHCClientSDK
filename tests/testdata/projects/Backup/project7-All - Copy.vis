         <functionblock id="_0x5ad28" name="1.1.13.a. Dagslysstyring (luxsensor)" master_schneider_electric="yes" master_type="1.1.13" master_version="a" master_name="Dagslysstyring (luxsensor)" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="Anvendes hvor der ønskes en dagslysstyring af således at lyset holdes på et ønsket luxniveau. Denne funktion kræver en IHC Wireless lysdæmper og en luxsensor.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.">
            <inputs id="_0x5ae23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_light id="_0x5af16" name="Lys" note="Forbindes til luxsensor" note-2="Tip: lad &quot;Lys&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 1.1.13.a-IN01.">
                  <link_to_resource id="_0x4a1e2c" name="Følg Link" icon="_0x4a" link="_0x4a1d2d"/>
               </resource_light>
               <resource_input id="_0x5b011" name="Tænd" icon="_0x36" note="Forbindes til udgang som skal aktivere funktionsblokken.&#xD;&#xA;F.eks. kipblok eller urblok" note-2="Note: &quot;Tænd&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 1.1.13.a-IN02."/>
            </inputs>
            <outputs id="_0x5b124" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_light_level id="_0x5b213" name="Lys niveau" note="Lys niveau forbindes til lys niveau på wireless lysdæmper.&#xD;&#xA;Det er denne udgang som styrer lysdæmperen op og ned." inivalue="20" note-2="Note: &quot;Lys niveau&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 1.1.13.a-UD01.">
                  <link_from_resource id="_0x4a552d" name="Følg Link" icon="_0x47" link="_0x4a562c"/>
               </resource_light_level>
            </outputs>
            <settings id="_0x5b325" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_light id="_0x5b416" name="Lys setpunkt" note="Her indstilles lux niveau som der ønskes styret efter.&#xD;&#xA;Bemærk at i mange tilfælde vil luxsensoren registrere lavere lux værdi end det niveau der ønskes på f. eks. et arbejdsbord fordi sensoren er placeret i loft eller på væg. Derfor skal lux niveau indstilles lavere end det ønskede niveau. " inivalue="132" note-2="Hjælpetekst for &quot;Lys setpunkt&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 1.1.13.a-IS01."/>
               <resource_light_level id="_0x5b513" name="Start niveau for lysdæmper" note="Her indstilles luxniveau som lysdæmperen skal starte på inden regulering startes" inivalue="22" note-2="Bemærk: &quot;Start niveau for lysdæmper&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 1.1.13.a-IS02."/>
               <resource_light id="_0x5b616" name="Indstilling af hysterese" note="Her indstilles luxværdi for hysterese.&#xD;&#xA;Default +/- 10 lux - hvilket betyder at regulering af lys niveau starter når luxniveau er 10 lux fra setpunkt." inivalue="11" note-2="Hjælpetekst: &quot;Indstilling af hysterese&quot; justeres til anlæggets faktiske forhold. Ref. 1.1.13.a-IS03."/>
               <resource_timer id="_0x5b710" name="Timer for opdatering af lys niveau" icon="_0x43" note="Her indstilles hvor ofte lys niveau skal opdateres. &#xD;&#xA;Hvis der ønskes en træg regulering skal timerværdi øges og hvis der ønskes en hurtigere regulering skal timerværdi formindskes." hour="0" minute="0" second="4" millisecond="0" note-2="Bemærk: &quot;Timer for opdatering af lys niveau&quot; træder i kraft ved næste programafvikling. Ref. 1.1.13.a-IS04."/>
            </settings>
            <internalsettings id="_0x5b829" name="Interne variable" icon="_0x13" note="Variablene i denne gruppe er private variable til funktionsblokken">
               <resource_light id="_0x5b916" name="Lys max" note="Privat mellemled &quot;Lys max&quot; på 1.1.13.a. Dagslysstyring (luxsensor). Ændres ikke ved idriftsættelse. Ref. 1.1.13.a-IV01." note-2="Hjælp: &quot;Lys max&quot; i 1.1.13.a. Dagslysstyring (luxsensor) dokumenteres kun af hensyn til service. Ref. 1.1.13.a-IV01."/>
               <resource_light id="_0x5ba16" name="Lys min" note="Intern variabel &quot;Lys min&quot; i funktionsblok 1.1.13.a. Bruges af blokkens eget program. Ref. 1.1.13.a-IV02." note-2="Vejledning - &quot;Lys min&quot;: ændringer her påvirker blokkens program direkte.&#xD;&#xA;Ref. 1.1.13.a-IV02."/>
            </internalsettings>
