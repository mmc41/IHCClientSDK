      <group id="_0x3bb732" name="FB 6.1 Alarm Tastatur" icon="_0x15" note="locNote 1032">
         <functionblock id="_0x3bb828" name="6.1.01.c. Fuga/Opus Kodetastatur uden memory" master_schneider_electric="yes" master_type="6.1.01" master_version="c" master_name="Fuga/Opus Kodetastatur uden memory" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="6.1.01.c  Fuga/Opus Kodetastatur uden memoryfunktion.&#xD;&#xA;&#xD;&#xA;Anvendes hvor alm. svagstrømstryk med 4 eller 6 taster, ønskes anvendt som kodetastatur. Den 6 cifferede kode skal indtastes manuelt i funktionsblokken (default er 4 kodepladser -koden 1234)&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.1 Tastatur\6.1.01.pdf">
            <inputs id="_0x3bbd23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x3bbe11" name="Indgang for tast 1" icon="_0x36" note="Tast 1 - Forbindes med tast på svagstrømstryk, som ønskes anvendt som tast nr. 1&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang for tast 1&quot; er linket til i 6.1.01.c. Fuga/Opus Kodetastatur uden memory. Ref. 6.1.01.c-IN01."/>
               <resource_input id="_0x3bbf11" name="Indgang for tast 2" icon="_0x36" note="Tast 2 - Forbindes med tast på svagstrømstryk, som ønskes anvendt som tast nr. 2&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Indgang for tast 2&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 6.1.01.c-IN02."/>
               <resource_input id="_0x3bc011" name="Indgang for tast 3" icon="_0x36" note="Tast 3 - Forbindes med tast på svagstrømstryk, som ønskes anvendt som tast nr. 3&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Indgang for tast 3&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 6.1.01.c-IN03."/>
               <resource_input id="_0x3bc111" name="Indgang for tast 4" icon="_0x36" note="Tast 4 - Forbindes med tast på svagstrømstryk, som ønskes anvendt som tast nr. 4&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Indgang for tast 4&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 6.1.01.c-IN04."/>
               <resource_input id="_0x3bc211" name="Indgang for tast 5" icon="_0x36" note="Tast 5 - Forbindes med tast på svagstrømstryk, som ønskes anvendt som tast nr. 5&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Vejledning: test &quot;Indgang for tast 5&quot; i simulering før anlægget sættes i drift. Ref. 6.1.01.c-IN05."/>
               <resource_input id="_0x3bc311" name="Indgang for tast 6" icon="_0x36" note="Tast 6 - Forbindes med tast på svagstrømstryk, som ønskes anvendt som tast nr. 6&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang for tast 6&quot; er linket til i 6.1.01.c. Fuga/Opus Kodetastatur uden memory. Ref. 6.1.01.c-IN06."/>
            </inputs>
            <outputs id="_0x3bc424" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x3bc512" name="Indikering af indtastning er muligt" icon="_0x39" note="Det er kun muligt at indtaste koden så længe udgang er on. &#xD;&#xA;Forbindes evt. til diode i tryk med blinkfunktion." note-2="Note: &quot;Indikering af indtastning er muligt&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.1.01.c-UD01."/>
               <resource_output id="_0x3bc612" name="Udgang for puls" icon="_0x39" note="Udgang pulser ved korrekt indtastet kode" note-2="Vejledning: verificér &quot;Udgang for puls&quot; med en måling på klemmen (230 V AC). Ref. 6.1.01.c-UD02."/>
            </outputs>
            <settings id="_0x3bc725" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_integer id="_0x3bc80b" name="Første kodeciffer" backup="yes" note="Angiver hvilken tast som skal aktiveres først" inivalue="2" note-2="Vejledning: afprøv &quot;Første kodeciffer&quot; i simulering før anlægget overdrages. Ref. 6.1.01.c-IS01."/>
               <resource_integer id="_0x3bc90b" name="Andet kodeciffer" backup="yes" note="Angiver hvilken tast som skal aktiveres som nr. 2" inivalue="3" note-2="Hjælp: værdien for &quot;Andet kodeciffer&quot; i 6.1.01.c. Fuga/Opus Kodetastatur uden memory bør gennemgås ved service. Ref. 6.1.01.c-IS02."/>
               <resource_integer id="_0x3bca0b" name="Tredie kodeciffer" backup="yes" note="Angiver hvilken tast som skal aktiveres som nr. 3" inivalue="5" note-2="Vejledning - &quot;Tredie kodeciffer&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 6.1.01.c-IS03."/>
               <resource_integer id="_0x3bcb0b" name="Fjerde kodeciffer" backup="yes" note="Angiver hvilken tast som skal aktiveres som nr. 4" inivalue="7" note-2="Tip: notér den valgte værdi for &quot;Fjerde kodeciffer&quot; i anlægsdokumentationen. Ref. 6.1.01.c-IS04."/>
               <resource_integer id="_0x3bcc0b" name="Femte kodeciffer" backup="yes" note="Angiver hvilken tast som skal aktiveres som nr. 5" inivalue="8" note-2="Note: &quot;Femte kodeciffer&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 6.1.01.c-IS05."/>
               <resource_integer id="_0x3bcd0b" name="Sjette kodeciffer" backup="yes" note="Angiver hvilken tast som skal aktiveres som nr. 6" inivalue="9" note-2="Vejledning: afprøv &quot;Sjette kodeciffer&quot; i simulering før anlægget overdrages. Ref. 6.1.01.c-IS06."/>
               <resource_enum id="_0x3bce0f" name="Antal kodepladser" typedef="_0x3bb947" inivalue="_0x3bbb48" backup="yes" icon="_0x22" note="Sættes til det antal kodepladser der ønskes&#xD;&#xA;Sættes denne til 4 kodepladser, skal der indtastes 4 korekte taster før der gives en puls på &quot;Udgang for puls&quot;&#xD;&#xA;det samme gør sig gældende ved 5 og 6 kodepladser " note-2="Hjælp: værdien for &quot;Antal kodepladser&quot; i 6.1.01.c. Fuga/Opus Kodetastatur uden memory bør gennemgås ved service. Ref. 6.1.01.c-IS07."/>
               <resource_timer id="_0x3bcf10" name="Timer for max. tastetid" backup="yes" icon="_0x43" note="Max. tid for indtastning af kode." hour="0" minute="0" second="18" millisecond="0" note-2="Vejledning - &quot;Timer for max. tastetid&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 6.1.01.c-IS08."/>
            </settings>
