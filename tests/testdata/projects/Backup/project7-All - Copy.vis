         <functionblock id="_0x155328" name="1.4.03.a. Udendørslys" master_schneider_electric="yes" master_type="1.4.03" master_version="a" master_name="Udendørslys" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2016" master_date_year="2017" master_date_month="9" master_date_day="14" locked="yes" icon="_0xe" note="1.4.03.a. Udendørslys&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Dedikeret funktionsblok til udendørslys.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis blokken er rød-markeret.">
            <inputs id="_0x155423" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x155511" name="PIR" icon="_0x36" note="Forbindes til tilstedeværelses indikering fra PIR sensor.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;PIR&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 1.4.03.a-IN01.">
                  <link_to_resource id="_0x4a342c" name="Følg Link" icon="_0x4a" link="_0x4a332d"/>
               </resource_input>
               <resource_input id="_0x155611" name="Skumring" icon="_0x36" note="Forbindes fra skumringssensor eller luxsensor ifm. funktionsblok 1.1.12&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;Skumring&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 1.4.03.a-IN02.">
                  <link_to_resource id="_0x4a362c" name="Følg Link" icon="_0x4a" link="_0x4a352d"/>
               </resource_input>
               <resource_input id="_0x155711" name="Magnetkontakt" icon="_0x36" note="Forbindes til magnetkontakt i dørkarm.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælpetekst: forbind &quot;Magnetkontakt&quot; til det tryk der skal betjene funktionen. Ref. 1.4.03.a-IN03.">
                  <link_to_resource id="_0x4a382c" name="Følg Link" icon="_0x4a" link="_0x4a372d"/>
               </resource_input>
               <resource_input id="_0x155811" name="Tilbagemelding" icon="_0x36" note="Opret link mellem produktets &quot;Udgang&quot; og &quot;Tilbagemelding&quot;.&#xD;&#xA;Ved tilbagemelding begrænses genkald af IHC Wireless produkter ifm. PIR aktivitet." note-2="Bemærk: &quot;Tilbagemelding&quot; bør kun linkes til én indgang ad gangen. Ref. 1.4.03.a-IN04.">
                  <link_to_resource id="_0x4a3a2c" name="Følg Link" icon="_0x4a" link="_0x4a392d"/>
               </resource_input>
               <resource_input id="_0x155911" name="Ur" icon="_0x36" note="Forbindes fra ur funktionsblok.&#xD;&#xA;(Udfyldes af installatøren)&#xD;&#xA;" note-2="Hjælp til &quot;Ur&quot; på 1.4.03.a: signalet skal være stabilt i &gt; 100 ms. Ref. 1.4.03.a-IN05.">
                  <link_to_resource id="_0x4a3c2c" name="Følg Link" icon="_0x4a" link="_0x4a3b2d"/>
               </resource_input>
               <resource_input id="_0x155a11" name="Kip - Konstant " icon="_0x36" note="Kort tryk (&lt;1 sek.) tænder ubetinget på &quot;Høj&quot; og sætter &quot;Diode - konstant&quot; ON. &#xD;&#xA;Efterfølgende tryk afstiller &quot;Diode - konstant&quot; og starter nedtælling på efterløb.&#xD;&#xA;Langt tryk (&gt;1 sek.) slukker tænding og afstiller &quot;Diode - konstant&quot;.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst for &quot;Kip - Konstant&quot;: se afsnittet &quot;Indgange&quot; i blokkens beskrivelse (F1). Ref. 1.4.03.a-IN06.">
                  <link_to_resource id="_0x4a3e2c" name="Følg Link" icon="_0x4a" link="_0x4a3d2d"/>
               </resource_input>
               <resource_input id="_0x155b11" name="Tænd - Konstant" icon="_0x36" note="Tænder ubetinget på &quot;Høj&quot; og sætter &quot;Diode - konstant&quot; on.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Tænd - Konstant&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 1.4.03.a-IN07.">
                  <link_to_resource id="_0x4a402c" name="Følg Link" icon="_0x4a" link="_0x4a3f2d"/>
               </resource_input>
               <resource_input id="_0x155c11" name="Sluk" icon="_0x36" note="Kort tryk (&lt;1 sek.) afstiller &quot;Diode - konstant&quot; og starter nedtælling på efterløb.&#xD;&#xA;Langt tryk (&gt;1 sek.) slukker tænding og afstiller &quot;Diode - konstant&quot;.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Sluk&quot; til det tryk der skal betjene funktionen. Ref. 1.4.03.a-IN08.">
                  <link_to_resource id="_0x4a422c" name="Følg Link" icon="_0x4a" link="_0x4a412d"/>
               </resource_input>
            </inputs>
            <outputs id="_0x155d24" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x155e12" name="Sluk " icon="_0x39" note="Forbindes til klemme 2 på 400 UNI IHC/SA.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Hjælp til &quot;Sluk&quot; på 1.4.03.a: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 1.4.03.a-UD01."/>
               <resource_output id="_0x155f12" name="Lavt niveau - Memory 1" icon="_0x39" note="Forbindes til klemme 3 på 400 UNI IHC/SA.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Hjælpetekst for &quot;Lavt niveau - Memory 1&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 1.4.03.a-UD02."/>
               <resource_output id="_0x156012" name="Højt niveau - Memory 2" icon="_0x39" note="Forbindes til klemme 4 på 400 UNI IHC/SA.&#xD;&#xA;Skal forbindes til lysdæmperen for korrekt funktion." note-2="Bemærk: &quot;Højt niveau - Memory 2&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 1.4.03.a-UD03.">
                  <link_from_resource id="_0x4a432d" name="Følg Link" icon="_0x47" link="_0x4a442c"/>
               </resource_output>
               <resource_scene id="_0x15614a" name="Sluk" note="Forbindes til relæ og/eller IHC Wireless lysdæmper.&#xD;&#xA;Skal forbindes for at opnå korrekt funktion." note-2="Hjælpetekst: tilføj de produkter der skal indgå i &quot;Sluk&quot;. Ref. 1.4.03.a-UD04."/>
               <resource_scene id="_0x15624a" name="Lavt niveau" note="Forbindes til relæ og/eller IHC Wireless lysdæmper.&#xD;&#xA;Skal forbindes for at opnå korrekt funktion." note-2="Bemærk: &quot;Lavt niveau&quot; kan gemmes fra et langt tryk på betjeningstrykket. Ref. 1.4.03.a-UD05."/>
               <resource_scene id="_0x15634a" name="Højt niveau" note="Forbindes til relæ og/eller IHC Wireless lysdæmper.&#xD;&#xA;Skal forbindes for at opnå korrekt funktion." note-2="Hjælp til &quot;Højt niveau&quot; på 1.4.03.a: jalousier &amp; lysdæmpere kan indgå samtidigt. Ref. 1.4.03.a-UD06."/>
               <resource_output id="_0x156412" name="Diode - konstant" icon="_0x39" note="Visning af overstyring. Kan benyttes til diode eller Viewer." note-2="Hjælpetekst for &quot;Diode - konstant&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 1.4.03.a-UD07."/>
               <resource_output id="_0x156512" name="Diode - lys tændt" icon="_0x39" note="Visning af status. Kan benyttes til diode eller Viewer." note-2="Bemærk: &quot;Diode - lys tændt&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 1.4.03.a-UD08."/>
            </outputs>
