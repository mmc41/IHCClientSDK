         <functionblock id="_0x248328" name="4.1.05.a. Driftstimetæller vist i år" master_schneider_electric="yes" master_type="4.1.05" master_version="a" master_name="Driftstimetæller vist i år" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.1.05.a. Driftstimetæller vist i år, måneder, dage og timer.&#xD;&#xA;&#xD;&#xA;Anvendelse: &#xD;&#xA;Opsummerer udgangs tændtid. &#xD;&#xA;Dette vises i Minutter, Timer, Dage, Måneder og år &#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x248423" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x248511" name="Indgang hvor timer skal registreres" icon="_0x36" note="Når  indgang er ON vil Brændtimer tælle op&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Indgang hvor timer skal registreres&quot; bør kun linkes til én indgang ad gangen. Ref. 4.1.05.a-IN01."/>
               <resource_input id="_0x248611" name="Reset !" icon="_0x36" note="Aktiveres ved et langt tryk.&#xD;&#xA;Skal holdes inde i  &gt;1sek før &quot;Reset&quot; udføres.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp til &quot;Reset !&quot; på 4.1.05.a: signalet skal være stabilt i &gt; 100 ms. Ref. 4.1.05.a-IN02."/>
            </inputs>
            <outputs id="_0x248724" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x248812" name="Indikation" backup="yes" icon="_0x39" note="Denne udgang kan bruges til en Diode, der indikerer at &quot;Set-punktet&quot; er opnået.&#xD;&#xA;Denne kan ligeledes anvendes til at sende en mail til værkfører eller elektriker om f.eks. &quot;Det er tid til at skifte lysrør&quot;" note-2="Hjælp til &quot;Indikation&quot; på 4.1.05.a: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 4.1.05.a-UD01."/>
               <resource_counter id="_0x24890c" name="År" backup="yes" note="Antal År indgang har været aktiv&#xD;&#xA;1 år ~ 12 måneder (12 * 30 dage)" note-2="Hjælpetekst for &quot;År&quot;: se afsnittet &quot;Udgange&quot; i blokkens beskrivelse (F1). Ref. 4.1.05.a-UD02."/>
               <resource_counter id="_0x248a0c" name="Måned" backup="yes" note="Antal Måneder indgang har været aktiv&#xD;&#xA;1 måned ~ 30 dage" note-2="Bemærk: &quot;Måned&quot; viser status &amp; må ikke anvendes til effektstyring. Ref. 4.1.05.a-UD03."/>
               <resource_counter id="_0x248b0c" name="Dage" backup="yes" note="Antal dage indgang har været aktiv&#xD;&#xA;1 dag ~ 24 timer" note-2="Hjælpetekst: &quot;Dage&quot; forbindes til det produkt der skal styres. Ref. 4.1.05.a-UD04."/>
               <resource_counter id="_0x248c0c" name="Timer" backup="yes" note="Antal timer indgang har været aktiv&#xD;&#xA;1 time ~ 60 min." note-2="Bemærk: &quot;Timer&quot; kan linkes til flere produkter samtidigt. Ref. 4.1.05.a-UD05."/>
               <resource_counter id="_0x248d0c" name="Minuter" backup="yes" note="Antal minutter indgang har været aktiv&#xD;&#xA;1min. ~ 60 sec." note-2="Hjælp til &quot;Minuter&quot; på 4.1.05.a: pulslængden er &lt; 1 s og kan ikke ændres. Ref. 4.1.05.a-UD06."/>
            </outputs>
            <settings id="_0x248e25" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_counter id="_0x248f0c" name="Set År" backup="yes" note="Sættes til den ønskede værdi &#xD;&#xA;når Set - minuter, timer, dage, månder og år er opfyldt vil &quot;Diode indikering&quot; blive &quot;ON&quot;&#xD;&#xA;" inivalue="2" note-2="Hjælpetekst: &quot;Set År&quot; justeres til anlæggets faktiske forhold. Ref. 4.1.05.a-IS01."/>
               <resource_counter id="_0x24900c" name="Set Måned" backup="yes" note="Sættes til den ønskede værdi &#xD;&#xA;når Set - minuter, timer, dage, månder og år er opfyldt vil &quot;Diode indikering&quot; blive &quot;ON&quot;" note-2="Bemærk: &quot;Set Måned&quot; træder i kraft ved næste programafvikling. Ref. 4.1.05.a-IS02."/>
               <resource_counter id="_0x24910c" name="Set Dag" backup="yes" note="Sættes til den ønskede værdi &#xD;&#xA;når Set - minuter, timer, dage, månder og år er opfyldt vil &quot;Diode indikering&quot; blive &quot;ON&quot;" inivalue="23" note-2="Hjælp til &quot;Set Dag&quot; på 4.1.05.a: værdier &lt; minimum afvises af controlleren. Ref. 4.1.05.a-IS03."/>
               <resource_counter id="_0x24920c" name="Set Timer" backup="yes" note="Sættes til den ønskede værdi &#xD;&#xA;når Set - minuter, timer, dage, månder og år er opfyldt vil &quot;Diode indikering&quot; blive &quot;ON&quot;" inivalue="18" note-2="Hjælpetekst for &quot;Set Timer&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 4.1.05.a-IS04."/>
               <resource_counter id="_0x24930c" name="Set Minuter" backup="yes" note="Sættes til den ønskede værdi &#xD;&#xA;når Set - minuter, timer, dage, månder og år er opfyldt vil &quot;Diode indikering&quot; blive &quot;ON&quot;" inivalue="6" note-2="Bemærk: &quot;Set Minuter&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 4.1.05.a-IS05."/>
            </settings>
