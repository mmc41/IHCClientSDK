                           <action id="_0x446eca" name="Fremkald %P" icon="_0x9" note="Aktiver scenarie" link1="_0x3fd54a" method="_0xa"/>
                           <action id="_0x446fca" name="%P = ON" icon="_0x9" note="Sætter %P til ON" link1="_0x3fd312" method="_0xa"/>
                        </actions>
                     </program_sub>
                     <action id="_0x4470ca" name="Aktiver nedtælling på %P med initial værdi" icon="_0x9" note="Aktiver nedtælling på %P med initial værdi" link1="_0x3ffc10" method="_0xbe"/>
                  </actions>
               </program_simple>
               <program_simple id="_0x44711e" name="Puls off on- og off puls blink med lys" icon="_0x7">
                  <events id="_0x447264" name="Hændelser" icon="_0xb" note="Hændelser som starter program">
                     <event id="_0x4473c8" name="%P -&gt; 0" icon="_0xc" note="Start program når %P skifter til 0" link1="_0x3ffc10" method="_0xa"/>
                  </events>
                  <actions id="_0x447466" name="Kommandoer" icon="_0x8" note="Gruppering af kommandoer som udføres når hændelse er indtruffet" type="_0x2">
                     <action id="_0x4475ca" name="%P = OFF" icon="_0x9" note="Sætter %P til OFF" link1="_0x3fd212" method="_0x14"/>
                     <action id="_0x4476ca" name="%P = OFF" icon="_0x9" note="Sætter %P til OFF" link1="_0x3fd312" method="_0x14"/>
                  </actions>
               </program_simple>
            </programs>
         </functionblock>
      </group>
      <group id="_0x447732" name="FB 6.3 Alarm Sikkerhed" icon="_0x15" note="locNote 1034">
         <functionblock id="_0x447828" name="6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion" master_schneider_electric="yes" master_type="6.3.01" master_version="a" master_name="Røg-Gas-Vand-El-alarm med logfunktion" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="Anvendelse:&#xD;&#xA;Til ny røgsensor NC-type. Til overvågning af røg, gas, vand og el&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.3 Sikkerhed\6.3.01.pdf">
            <inputs id="_0x447923" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x447a11" name="Indgang for røgsensor" icon="_0x36" note="Indgang for overvågning af røgudvikling (NC).&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang for røgsensor&quot; er linket til i 6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion. Ref. 6.3.01.a-IN01.">
                  <link_to_resource id="_0x49e62c" name="Følg Link" icon="_0x4a" link="_0x49e52d"/>
               </resource_input>
               <resource_input id="_0x447b11" name="Indgang for gassensor" icon="_0x36" note="Indgang for overvågning af gasudslip (NO). &#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Indgang for gassensor&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 6.3.01.a-IN02.">
                  <link_to_resource id="_0x49e82c" name="Følg Link" icon="_0x4a" link="_0x49e72d"/>
               </resource_input>
               <resource_input id="_0x447c11" name="Indgang for vandsensor" icon="_0x36" note="Indgang for overvågning af vandudslip (NC).&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Tip: lad &quot;Indgang for vandsensor&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 6.3.01.a-IN03.">
                  <link_to_resource id="_0x49ea2c" name="Følg Link" icon="_0x4a" link="_0x49e92d"/>
               </resource_input>
               <resource_input id="_0x447d11" name="Indgang fra backup 24V OK" icon="_0x36" note="Indgang tilslutttes udgang &quot;24V OK&quot; (terminal 10) på Batteribackup.  For overvågning af 24V DC. (OK ved on).&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Note: &quot;Indgang fra backup 24V OK&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 6.3.01.a-IN04.">
                  <link_to_resource id="_0x49ec2c" name="Følg Link" icon="_0x4a" link="_0x49eb2d"/>
               </resource_input>
               <resource_input id="_0x447e11" name="Indgang fra backup 12V OK" icon="_0x36" note="Indgang tilslutttes udgang &quot;12V OK&quot; (terminal 9) på Batteribackup.  For overvågning af Batteri. (OK ved on).&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Vejledning: test &quot;Indgang fra backup 12V OK&quot; i simulering før anlægget sættes i drift. Ref. 6.3.01.a-IN05.">
                  <link_to_resource id="_0x4a582c" name="Følg Link" icon="_0x4a" link="_0x4a572d"/>
               </resource_input>
               <resource_input id="_0x447f11" name="Indgang for reset af røgindikering" icon="_0x36" note="Puls resetter indikering og pauser røgalarm i 15 min.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang for reset af røgindikering&quot; er linket til i 6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion. Ref. 6.3.01.a-IN06.">
                  <link_to_resource id="_0x4a5a2c" name="Følg Link" icon="_0x4a" link="_0x4a592d"/>
               </resource_input>
               <resource_input id="_0x448011" name="Indgang for reset af gasindikering" icon="_0x36" note="Puls resetter indikering og pauser gasalarm i 15 min.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Indgang for reset af gasindikering&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 6.3.01.a-IN07.">
                  <link_to_resource id="_0x4a5c2c" name="Følg Link" icon="_0x4a" link="_0x4a5b2d"/>
               </resource_input>
               <resource_input id="_0x448111" name="Indgang for reset af vandindikering" icon="_0x36" note="Puls resetter indikering og pauser vandalarm i 15 min.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Tip: lad &quot;Indgang for reset af vandindikering&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 6.3.01.a-IN08.">
                  <link_to_resource id="_0x4a5e2c" name="Følg Link" icon="_0x4a" link="_0x4a5d2d"/>
               </resource_input>
               <resource_input id="_0x448211" name="Indgang for reset af indikering af elalarm" icon="_0x36" note="Puls resetter indikering.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Note: &quot;Indgang for reset af indikering af elalarm&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 6.3.01.a-IN09.">
                  <link_to_resource id="_0x4a602c" name="Følg Link" icon="_0x4a" link="_0x4a5f2d"/>
               </resource_input>
               <resource_input id="_0x448311" name="Indgang for ekstern overvågning aktiv" icon="_0x36" note="Når denne indgang er ON, vil alarmen også blive sendt til udgang for ekstern lydgiver og udgangen for IHC-modem.&#xD;&#xA;Kan evt. forbindes til udgang fra tyveriblok således, at alarmen sendes ud af huset når der ikke er nogen hjemme. &#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Vejledning: test &quot;Indgang for ekstern overvågning aktiv&quot; i simulering før anlægget sættes i drift. Ref. 6.3.01.a-IN10.">
                  <link_to_resource id="_0x4a622c" name="Følg Link" icon="_0x4a" link="_0x4a612d"/>
               </resource_input>
            </inputs>
            <outputs id="_0x448424" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x448512" name="Overstyring af lys" icon="_0x39" note="Forbindes til indgang for tænd på alle funktionsblokke som ønskes tændt." note-2="Hjælp: notér i 6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion hvilke produkter &quot;Overstyring af lys&quot; betjener. Ref. 6.3.01.a-UD01."/>
               <resource_output id="_0x448612" name="Ekstern lydgiver - røg og gas" icon="_0x39" note="Forbindes til ekstern lydgiver på port 1, ved alarm aktiveres lydgiver i 15 sek (default)." note-2="Vejledning - &quot;Ekstern lydgiver - røg og gas&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.3.01.a-UD02."/>
               <resource_output id="_0x448712" name="Intern lydgiver - røg og gas" icon="_0x39" note="Forbindes til intern lydgiver evt. via lydblok. Ved alarm aktiveres lydgiver i 3 minutter (default)" note-2="Tip: brug &quot;Intern lydgiver - røg og gas&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.01.a-UD03.">
                  <link_from_resource id="_0x4a812d" name="Følg Link" icon="_0x47" link="_0x4a822c"/>
               </resource_output>
               <resource_output id="_0x448812" name="Intern lydgiver - vand" icon="_0x39" note="Forbindes til intern lydgiver evt. via lydblok. Ved alarm aktiveres lydgiver i 3 minutter (default)." note-2="Note: &quot;Intern lydgiver - vand&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.01.a-UD04."/>
               <resource_output id="_0x448912" name="Intern lydgiver - elalarm" icon="_0x39" note="Forbindes til intern lydgiver evt. via lydblok. Er aktiv så længe der er alarm." note-2="Vejledning: verificér &quot;Intern lydgiver - elalarm&quot; med en måling på klemmen (230 V AC). Ref. 6.3.01.a-UD05."/>
               <resource_output id="_0x448a12" name="Indikering på lydgiver at røg-,  gas- eller vandalarm genindkobles" icon="_0x39" note="Efter pausetimer udløber og der ikke er røg, gas eller vand tilstede markeres dette med et kort beep. Forbindes til intern lydgiver." note-2="Hjælp: notér i 6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion hvilke produkter &quot;Indikering på lydgiver at røg-,  gas- eller vandalarm genindkobles&quot; betjener. Ref. 6.3.01.a-UD06."/>
               <resource_output id="_0x448b12" name="Reset af røgsensor" icon="_0x39" note="Forbindes til forsyning på røgsensor.  Røgsensor resettes ved kort afbrydelse af spænding. Ved anvendelse af flere røgsensore skal man kun konfigurere den ene udgang for forsyning, det er således også kun nødvendigt at linke til den konfiguret udgang. (se evt hjælpefil)" inivalue="on" note-2="Vejledning - &quot;Reset af røgsensor&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.3.01.a-UD07.">
                  <link_from_resource id="_0x49ed2d" name="Følg Link" icon="_0x47" link="_0x49ee2c"/>
               </resource_output>
               <resource_output id="_0x448c12" name="IHC-modem - Røg" icon="_0x39" note="Udgang til at aktivere IHC-Modem" note-2="Tip: brug &quot;IHC-modem - Røg&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.01.a-UD08."/>
               <resource_output id="_0x448d12" name="IHC-modem - Gas" icon="_0x39" note="Udgang til at aktivere IHC-Modem" note-2="Note: &quot;IHC-modem - Gas&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.01.a-UD09."/>
               <resource_output id="_0x448e12" name="IHC-modem - Vand" icon="_0x39" note="Udgang til at aktivere IHC-Modem" note-2="Vejledning: verificér &quot;IHC-modem - Vand&quot; med en måling på klemmen (230 V AC). Ref. 6.3.01.a-UD10."/>
               <resource_output id="_0x448f12" name="IHC-modem - El" icon="_0x39" note="Udgang til at aktivere IHC-Modem (12V OK og 24V OK)" note-2="Hjælp: notér i 6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion hvilke produkter &quot;IHC-modem - El&quot; betjener. Ref. 6.3.01.a-UD11."/>
               <resource_output id="_0x449012" name="Kontaktor for sluk af del af el-forsyningen." icon="_0x39" note="Ved røgalarm slukkes evt for en del af el-forsyningen." inivalue="on" note-2="Vejledning - &quot;Kontaktor for sluk af del af el-forsyningen.&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.3.01.a-UD12."/>
               <resource_output id="_0x449112" name="Gas-Magnetventil" icon="_0x39" note="Udgang forbindes til magnetventil for gas. Her lukkes kun ved gasudslip. Åben ved on." inivalue="on" note-2="Tip: brug &quot;Gas-Magnetventil&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.01.a-UD13."/>
               <resource_output id="_0x449212" name="Gas-Magnetventil der lukker ved røgudvikling" icon="_0x39" note="Udgang forbindes til magnetventil for gas. Denne udgang lukker også ved røgudvikling, dog må begge udgange ikke forbindes samtidig. Åben ved on." inivalue="on" note-2="Note: &quot;Gas-Magnetventil der lukker ved røgudvikling&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.01.a-UD14."/>
               <resource_output id="_0x449312" name="Vand-Magnetventil" icon="_0x39" note="Udgang forbindes til magnetventil for vand. Åben ved off." note-2="Vejledning: verificér &quot;Vand-Magnetventil&quot; med en måling på klemmen (230 V AC). Ref. 6.3.01.a-UD15.">
                  <link_from_resource id="_0x49ef2d" name="Følg Link" icon="_0x47" link="_0x49f02c"/>
               </resource_output>
               <resource_output id="_0x449412" name="Indikering af alarm - Røg" icon="_0x39" note="Udgang for indikering af røgalarm aktiv. Forbindes til statustryk." note-2="Hjælp: notér i 6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion hvilke produkter &quot;Indikering af alarm - Røg&quot; betjener. Ref. 6.3.01.a-UD16."/>
               <resource_output id="_0x449512" name="Indikering af alarm - Gas" icon="_0x39" note="Udgang for indikering af gasalarm aktiv. Forbindes til statustryk." note-2="Vejledning - &quot;Indikering af alarm - Gas&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.3.01.a-UD17."/>
               <resource_output id="_0x449612" name="Indikering af alarm - Vand" icon="_0x39" note="Udgang for indikering af vandalarm aktiv. Forbindes til statustryk." note-2="Tip: brug &quot;Indikering af alarm - Vand&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.01.a-UD18."/>
               <resource_output id="_0x449712" name="Indikering af alarm - El" backup="yes" icon="_0x39" note="Udgang for indikering af elalarm aktiv. Forbindes til statustryk." note-2="Note: &quot;Indikering af alarm - El&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.01.a-UD19."/>
               <resource_output id="_0x449812" name="Backupindikering" icon="_0x39" note="Indikering af at backupbbatteri er i brug." note-2="Vejledning: verificér &quot;Backupindikering&quot; med en måling på klemmen (230 V AC). Ref. 6.3.01.a-UD20."/>
               <resource_output id="_0x449912" name="Udskift batteri indikering" icon="_0x39" note="Indikering om at batterispænding lav." note-2="Hjælp: notér i 6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion hvilke produkter &quot;Udskift batteri indikering&quot; betjener. Ref. 6.3.01.a-UD21."/>
               <resource_output id="_0x449a12" name="Udgang for afstilling af modem" icon="_0x39" note="Afstiller modem efter alarm ved aktivering af &quot;indgang overvågning aktiv&quot;.&#xD;&#xA;Anvendes til voice modem." note-2="Vejledning - &quot;Udgang for afstilling af modem&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.3.01.a-UD22."/>
               <resource_output id="_0x449b12" name="Udgang for indikering af forbikoblet røgalarm" icon="_0x39" note="Forbindes evt. til lysdiode i tryk" note-2="Tip: brug &quot;Udgang for indikering af forbikoblet røgalarm&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.01.a-UD23."/>
               <resource_output id="_0x449c12" name="Udgang for indikering af forbikoblet gasalarm" icon="_0x39" note="Forbindes evt. til lysdiode i tryk" note-2="Note: &quot;Udgang for indikering af forbikoblet gasalarm&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.01.a-UD24."/>
               <resource_output id="_0x449d12" name="Udgang for indikering af forbikoblet vandalarm" icon="_0x39" note="Forbindes evt. til lysdiode i tryk" note-2="Vejledning: verificér &quot;Udgang for indikering af forbikoblet vandalarm&quot; med en måling på klemmen (230 V AC). Ref. 6.3.01.a-UD25."/>
               <resource_time id="_0x449e0d" name="Tidspunkt for sidste røgalarm" backup="yes" icon="_0x2f" note="Anvendes til visning på grafisk brugerflade" hour="0" minute="0" second="0" note-2="Hjælp: notér i 6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion hvilke produkter &quot;Tidspunkt for sidste røgalarm&quot; betjener. Ref. 6.3.01.a-UD26."/>
               <resource_date id="_0x449f0e" name="Dato for sidste røgalarm" backup="yes" icon="_0x29" note="Anvendes til visning på grafisk brugerflade" year="2000" month="1" day="1" note-2="Vejledning - &quot;Dato for sidste røgalarm&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.3.01.a-UD27."/>
               <resource_time id="_0x44a00d" name="Tidspunkt for sidste gasalarm" backup="yes" icon="_0x2f" note="Anvendes til visning på grafisk brugerflade" hour="0" minute="0" second="0" note-2="Tip: brug &quot;Tidspunkt for sidste gasalarm&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.01.a-UD28."/>
               <resource_date id="_0x44a10e" name="Dato for sidste gasalarm" backup="yes" icon="_0x29" note="Anvendes til visning på grafisk brugerflade" year="2000" month="1" day="1" note-2="Note: &quot;Dato for sidste gasalarm&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.01.a-UD29."/>
               <resource_time id="_0x44a20d" name="Tidspunkt for sidste vandalarm" backup="yes" icon="_0x2f" note="Anvendes til visning på grafisk brugerflade" hour="0" minute="0" second="0" note-2="Vejledning: verificér &quot;Tidspunkt for sidste vandalarm&quot; med en måling på klemmen (230 V AC). Ref. 6.3.01.a-UD30."/>
               <resource_date id="_0x44a30e" name="Dato for sidste vandalarm" backup="yes" icon="_0x29" note="Anvendes til visning på grafisk brugerflade" year="2000" month="1" day="1" note-2="Hjælp: notér i 6.3.01.a. Røg-Gas-Vand-El-alarm med logfunktion hvilke produkter &quot;Dato for sidste vandalarm&quot; betjener. Ref. 6.3.01.a-UD31."/>
               <resource_time id="_0x44a40d" name="Tidspunkt for sidste netudfald" backup="yes" icon="_0x2f" note="Anvendes til visning på grafisk brugerflade" hour="0" minute="0" second="0" note-2="Vejledning - &quot;Tidspunkt for sidste netudfald&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.3.01.a-UD32."/>
               <resource_date id="_0x44a50e" name="Dato for sidste netudfald" backup="yes" icon="_0x29" note="Anvendes til visning på grafisk brugerflade" year="2000" month="1" day="1" note-2="Tip: brug &quot;Dato for sidste netudfald&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.01.a-UD33."/>
               <resource_time id="_0x44a60d" name="Tidspunkt for sidste netforsyning ok" backup="yes" icon="_0x2f" note="Anvendes til visning på grafisk brugerflade" hour="0" minute="0" second="0" note-2="Note: &quot;Tidspunkt for sidste netforsyning ok&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.01.a-UD34."/>
               <resource_date id="_0x44a70e" name="Dato for sidste netforsyning ok" backup="yes" icon="_0x29" note="Anvendes til visning på grafisk brugerflade" year="2000" month="1" day="1" note-2="Vejledning: verificér &quot;Dato for sidste netforsyning ok&quot; med en måling på klemmen (230 V AC). Ref. 6.3.01.a-UD35."/>
            </outputs>
            <settings id="_0x44a825" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x44a910" name="Timer for ekstern lydgiver" icon="_0x43" note="Den tid ekstern lydgiver er on (default 15 sek)" hour="0" minute="0" second="21" millisecond="0" note-2="Hjælp til &quot;Timer for ekstern lydgiver&quot; på 6.3.01.a: værdier &lt; minimum afvises af controlleren. Ref. 6.3.01.a-IS01."/>
               <resource_timer id="_0x44aa10" name="Timer for intern lydgiver" icon="_0x43" note="Den tid intern lydgiver er on (default 3 minutter)" hour="0" minute="3" second="36" millisecond="0" note-2="Hjælpetekst for &quot;Timer for intern lydgiver&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 6.3.01.a-IS02."/>
               <resource_timer id="_0x44ab10" name="Timer for pause af røgalarm" icon="_0x43" note="Den tid røgalarm ikke er aktiv, feks. under madlavning (default 15 minutter)" hour="0" minute="16" second="30" millisecond="0" note-2="Bemærk: &quot;Timer for pause af røgalarm&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 6.3.01.a-IS03."/>
               <resource_timer id="_0x44ac10" name="Timer for pause af gasalarm" icon="_0x43" note="Den tid gasalarm ikke er aktiv,(default 15 minutter)" hour="0" minute="13" second="30" millisecond="0" note-2="Hjælpetekst: &quot;Timer for pause af gasalarm&quot; justeres til anlæggets faktiske forhold. Ref. 6.3.01.a-IS04."/>
