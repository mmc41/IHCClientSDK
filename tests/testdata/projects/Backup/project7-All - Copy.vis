         <functionblock id="_0x47ed28" name="6.4.02.a. Lyd-/lysblok med 2 pulsperioder" master_schneider_electric="yes" master_type="6.4.02" master_version="a" master_name="Lyd-/lysblok med 2 pulsperioder" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="6.4.02. Lyd-/lysblok med 2 pulsperioder efterfulgt af pause&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Lyd- eller lysblok med 2 pulsperioder efterfulgt af pause. Der er mulighed for at ændre alle værdier.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.4 Lydblokke\6.4.02.pdf">
            <inputs id="_0x47ee23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x47ef11" name="Indgang for start lydblok" icon="_0x36" note="Lydblok er aktiv så længe indgang er on&#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælpetekst: forbind &quot;Indgang for start lydblok&quot; til det tryk der skal betjene funktionen. Ref. 6.4.02.a-IN01."/>
            </inputs>
            <outputs id="_0x47f024" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x47f112" name="Lydgiver" icon="_0x39" note="Forbindes direkte til lydgiver." note-2="Vejledning - &quot;Lydgiver&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.4.02.a-UD01."/>
               <resource_output id="_0x47f212" name="Puls - On" icon="_0x39" note="Giver kort puls når &quot;Lydgiver&quot; går on.&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Tip: brug &quot;Puls - On&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.4.02.a-UD02."/>
               <resource_output id="_0x47f312" name="Puls - Off" icon="_0x39" note="Giver kort puls når &quot;Lydgiver&quot; går off.&#xD;&#xA;Anvendes til styring af andre blokke." note-2="Note: &quot;Puls - Off&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.4.02.a-UD03."/>
            </outputs>
            <settings id="_0x47f425" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_timer id="_0x47f510" name="Timer for lyd-/lyspuls i første puls periode" icon="_0x43" note="Her indstilles tiden for pulsen i første pulsperiode " hour="0" minute="0" second="23" millisecond="0" note-2="Hjælp til &quot;Timer for lyd-/lyspuls i første puls periode&quot; på 6.4.02.a: værdier &lt; minimum afvises af controlleren. Ref. 6.4.02.a-IS01."/>
               <resource_timer id="_0x47f610" name="Timer for pause mellem pulser i første pulsperiode" icon="_0x43" note="Her indstilles tiden for pausen der skal være mellem pulserne i første pulsperiode" hour="0" minute="0" second="25" millisecond="500" note-2="Hjælpetekst for &quot;Timer for pause mellem pulser i første pulsperiode&quot;: se afsnittet &quot;Indstillinger&quot; i beskrivelsen (F1). Ref. 6.4.02.a-IS02."/>
               <resource_timer id="_0x47f710" name="Timer for lyd-/lyspuls i anden puls periode" icon="_0x43" note="Her indstilles tiden for pulsen i anden pulsperiode " hour="1" minute="30" second="0" millisecond="400" note-2="Bemærk: &quot;Timer for lyd-/lyspuls i anden puls periode&quot; påvirker også blokkens øvrige timere &gt; 0. Ref. 6.4.02.a-IS03."/>
               <resource_timer id="_0x47f810" name="Timer for pause mellem pulser i anden pulsperiode" icon="_0x43" note="Her indstilles tiden for pausen der skal være mellem pulserne i anden pulsperiode" hour="2" minute="0" second="0" millisecond="200" note-2="Hjælpetekst: &quot;Timer for pause mellem pulser i anden pulsperiode&quot; justeres til anlæggets faktiske forhold. Ref. 6.4.02.a-IS04."/>
               <resource_timer id="_0x47f910" name="Timer for lang pause mellem pulser" icon="_0x43" note="Her indstilles tiden for den lange pause der skal være efter de to pulsperioder" hour="0" minute="0" second="27" millisecond="0" note-2="Bemærk: &quot;Timer for lang pause mellem pulser&quot; træder i kraft ved næste programafvikling. Ref. 6.4.02.a-IS05."/>
               <resource_integer id="_0x47fa0b" name="Antal pulser i første pulsperiode" note="Her indstilles hvor mange pulser der skal være i første pulsperiode" inivalue="1" note-2="Hjælp til &quot;Antal pulser i første pulsperiode&quot; på 6.4.02.a: værdier &lt; minimum afvises af controlleren. Ref. 6.4.02.a-IS06."/>
