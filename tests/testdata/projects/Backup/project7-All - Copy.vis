               <resource_input id="_0x239211" name="Indgang 6" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Bemærk: &quot;Indgang 6&quot; bør kun linkes til én indgang ad gangen. Ref. 4.1.02-IN06."/>
               <resource_input id="_0x239311" name="Indgang 7" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Hjælp til &quot;Indgang 7&quot; på 4.1.02: signalet skal være stabilt i &gt; 100 ms. Ref. 4.1.02-IN07."/>
