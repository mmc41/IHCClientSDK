         <functionblock id="_0x36e428" name="5.3.03.a. Max - Min Temp" master_schneider_electric="yes" master_type="5.3.03" master_version="a" master_name="Max - Min Temp" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="5.3.03.a. Max - Min Temp&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Til at logge højeste og laveste temperatur, fra en IHC Temperatur sensor.&#xD;&#xA;Mulighed for at sende en mail/SMS ved høj eller lav setupunkt&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." udf="#5.3.03.a#">
            <inputs id="_0x36e523" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x36e611" name="Log Aktiv" icon="_0x36" note="Denne skal være &quot;ON&quot; for at funktionsblokken er aktiv.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Bemærk: &quot;Log Aktiv&quot; er aktiv høj; invertér signalet i produktet om nødvendigt. Ref. 5.3.03.a-IN01." udf="#I01#"/>
               <resource_temperature id="_0x36e714" name="Temperatur" note="Indsæt en temperatur sensorer der ønskes log på" inivalue="20.00" note-2="Hjælpetekst: forbind &quot;Temperatur&quot; til det tryk der skal betjene funktionen. Ref. 5.3.03.a-IN02." udf="#I02#"/>
               <resource_input id="_0x36e811" name="Reset" icon="_0x36" note="Reset log.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Bemærk: &quot;Reset&quot; bør kun linkes til én indgang ad gangen. Ref. 5.3.03.a-IN03." udf="#I03#"/>
            </inputs>
            <outputs id="_0x36e924" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x36ea12" name="Alarm Lav" icon="_0x39" note="Kan anvendes til at sende en Alarm mail/sms ved &quot;LAV&quot; temperatur" note-2="Vejledning - &quot;Alarm Lav&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 5.3.03.a-UD01." udf="#O01#"/>
               <resource_output id="_0x36eb12" name="Alarm Høj" icon="_0x39" note="Kan anvendes til at sende en Alarm mail/sms ved &quot;HØJ&quot; temperatur" note-2="Tip: brug &quot;Alarm Høj&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.3.03.a-UD02." udf="#O02#"/>
               <resource_temperature id="_0x36ec14" name="&quot;Lav&quot; Temperatur" backup="yes" note="Her gemmes den laveste værdi" note-2="Note: &quot;&quot;Lav&quot; Temperatur&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.3.03.a-UD03." udf="#O03#"/>
               <resource_time id="_0x36ed0d" name="&quot;Lav&quot; Tidspunkt " backup="yes" icon="_0x2f" note="Her gemmes på hvilket tidspunkt den laveste værdi er logget." hour="0" minute="0" second="0" note-2="Vejledning: verificér &quot;&quot;Lav&quot; Tidspunkt&quot; med en måling på klemmen (230 V AC). Ref. 5.3.03.a-UD04." udf="#O04#"/>
               <resource_temperature id="_0x36ee14" name="&quot;Høj&quot;  Temperatur" backup="yes" note="Her gemmes den højeste værdi" note-2="Hjælp: notér i 5.3.03.a. Max - Min Temp hvilke produkter &quot;&quot;Høj&quot;  Temperatur&quot; betjener. Ref. 5.3.03.a-UD05." udf="#O05#"/>
               <resource_time id="_0x36ef0d" name="&quot;Høj&quot; Tidspunkt" backup="yes" icon="_0x2f" note="Her gemmes på hvilket tidspunkt den højeste værdi er logget." hour="0" minute="0" second="0" note-2="Vejledning - &quot;&quot;Høj&quot; Tidspunkt&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 5.3.03.a-UD06." udf="#O06#"/>
               <resource_integer id="_0x36f00b" name="Antal ændringer" backup="yes" note="Hvor mange ændringer der har været, &#xD;&#xA;siden blokken er blevet &quot;Resat&quot; sidst." note-2="Tip: brug &quot;Antal ændringer&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 5.3.03.a-UD07." udf="#O07#"/>
               <resource_timer id="_0x36f110" name="Powerup-Timer" icon="_0x43" note="Powerup-Timer&#xD;&#xA;Fastsætter det korrekte temperatur niveau." hour="0" minute="0" second="15" millisecond="0" note-2="Note: &quot;Powerup-Timer&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 5.3.03.a-UD08." udf="#IS01#"/>
            </outputs>
            <settings id="_0x36f225" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_temperature id="_0x36f314" name="Set alarm Lav" backup="yes" note="Her indstilles hvornår &quot;Alarm Lav&quot; skal sættes &quot;ON&quot; &#xD;&#xA;" inivalue="3.30" note-2="Hjælp: værdien for &quot;Set alarm Lav&quot; i 5.3.03.a. Max - Min Temp bør gennemgås ved service. Ref. 5.3.03.a-IS01." udf="#SS01#"/>
               <resource_temperature id="_0x36f414" name="Set alarm Høj" backup="yes" note="Her indstilles hvornår &quot;Alarm Høj&quot; skal sættes &quot;ON&quot; " inivalue="27.00" note-2="Vejledning - &quot;Set alarm Høj&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 5.3.03.a-IS02." udf="#SS02#"/>
               <resource_temperature id="_0x36f514" name="Ændringer større end +/-" backup="yes" note="Reagerer IKKE ved temperatursvingninger, der er større end denne indstilling" inivalue="6.00" note-2="Tip: notér den valgte værdi for &quot;Ændringer større end +/-&quot; i anlægsdokumentationen. Ref. 5.3.03.a-IS03."/>
            </settings>
