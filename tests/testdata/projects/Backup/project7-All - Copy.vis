               <resource_input id="_0x43911" name="Tryk 8 fra IR fjernbetjening (Light + v)" icon="_0x36" note="Forbindes til adresse 8 fra IR-modtager&#xD;&#xA;(feks. Beo4 = Light + v)&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Tryk 8 fra IR fjernbetjening (Light + v)&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 1.1.05-IN08.">
                  <link_to_resource id="_0x49dc2c" name="Følg Link" icon="_0x4a" link="_0x49db2d"/>
