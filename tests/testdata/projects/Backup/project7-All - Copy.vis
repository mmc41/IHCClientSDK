         <functionblock id="_0x2aaa28" name="4.2.04. Diode grøn/rød" master_schneider_electric="yes" master_type="4.2.04" master_name="Diode grøn/rød" master_programmer="Schneider Electric&#xD;&#xA;Copyrights © 2009" master_date_year="2017" master_date_month="4" master_date_day="29" locked="yes" icon="_0xe" note="4.2.04. Diode Grøn/Rød&#xD;&#xA;&#xD;&#xA;Anvendelse:&#xD;&#xA;Hvor status for en udgang skal vises som en grøn og/eller en rød diode.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret !">
            <inputs id="_0x2aae23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x2aaf11" name="Indgang for status" icon="_0x36" note="(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang for status&quot; er linket til i 4.2.04. Diode grøn/rød. Ref. 4.2.04-IN01.">
                  <link_to_resource id="_0x4a662c" name="Følg Link" icon="_0x4a" link="_0x4a652d"/>
               </resource_input>
            </inputs>
            <outputs id="_0x2ab024" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x2ab112" name="Grøn Diode" icon="_0x39" note="Udgang &quot;Grøn Diode&quot; fra funktionsblok 4.2.04. Forbindes til lampeudtag eller relæ. Ref. 4.2.04-UD01." note-2="Hjælpetekst: &quot;Grøn Diode&quot; forbindes til det produkt der skal styres. Ref. 4.2.04-UD01.">
                  <link_from_resource id="_0x4a672d" name="Følg Link" icon="_0x47" link="_0x4a682c"/>
               </resource_output>
               <resource_output id="_0x2ab212" name="Rød Diode" icon="_0x39" note="Udgang &quot;Rød Diode&quot; - styrer det tilkoblede produkt.&#xD;&#xA;Udfyldes af installatøren. Ref. 4.2.04-UD02." note-2="Bemærk: &quot;Rød Diode&quot; kan linkes til flere produkter samtidigt. Ref. 4.2.04-UD02."/>
            </outputs>
