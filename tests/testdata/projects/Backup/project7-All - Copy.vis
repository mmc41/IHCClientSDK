         <functionblock id="_0x45f728" name="6.3.02.g. Hjemmesimulering med 4 udgange" master_schneider_electric="yes" master_type="6.3.02" master_version="g" master_name="Hjemmesimulering med 4 udgange" master_programmer="Schneider Electric&#xD;&#xA;Copyright © 2009 - 2020" master_date_year="2020" master_date_month="6" master_date_day="10" locked="yes" icon="_0xe" note="Anvendelse:&#xD;&#xA;Når simuleringen er aktiv, skifter sluk- og tændscenarier i et mønster bestemt af timere. Timertiderne kan frit ændres.&#xD;&#xA;&#xD;&#xA;For at se den fulde beskrivelse marker denne linje og tryk &quot;F1&quot;.&#xD;&#xA;Bemærk: Dette virker kun hvis &quot;Blokken&quot; er rød-markeret." helpfile="6. Alarm\6.3 Sikkerhed\6.3.02.pdf">
            <inputs id="_0x45fc23" name="Input" icon="_0x4" note="Variablene i denne gruppering er input til funktionsblokken">
               <resource_input id="_0x45fd11" name="Indgang for start/stop af simulering" icon="_0x36" note="Hjemmesimulering er aktiv sålænge indgang er on.&#xD;&#xA;&quot;Forbindes&quot; f.eks. til alarmblok, således at hjemmesimulering er aktiv når man ikke er hjemme. &#xD;&#xA;(Udfyldes af installatøren)" note-2="Hjælp: dokumentér hvilket produkt &quot;Indgang for start/stop af simulering&quot; er linket til i 6.3.02.g. Hjemmesimulering med 4 udgange. Ref. 6.3.02.g-IN01."/>
               <resource_input id="_0x45fe11" name="Indgang for kip af simulering" icon="_0x36" note="Start / Stop af hjemmesimulering ved hjælp af kipfunktion.&#xD;&#xA;(Udfyldes af installatøren)" note-2="Vejledning - &quot;Indgang for kip af simulering&quot;: kontrollér linket i installationsvinduet før upload.&#xD;&#xA;Ref. 6.3.02.g-IN02."/>
               <resource_input id="_0x45ff11" name="Indgang skumringsrelæ" icon="_0x36" note="Hjemmesimuleringen er kun aktiv hvis denne indgang er on - det vil sige når det er mørkt. Hvis denne indgang ikke forbindes ignoreres skumringsrelæ.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Tip: lad &quot;Indgang skumringsrelæ&quot; stå ulinket hvis funktionen ikke ønskes. Ref. 6.3.02.g-IN03."/>
               <resource_input id="_0x460011" name="Indgang ur" icon="_0x36" note="Forbindes til urfunktionsblok.&#xD;&#xA;Hjemmesimuleringen er kun aktiv hvis denne indgang er on. Anvendes til at stoppe hjemmesimuleringen midt om natten.&#xD;&#xA;Hvis denne indgang ikke forbindes ignoreres urindgangen.&#xD;&#xA;(Udfyldes af installatøren)" inivalue="on" note-2="Note: &quot;Indgang ur&quot; påvirkes af blokkens spærretimer &amp; driftsform.&#xD;&#xA;Ref. 6.3.02.g-IN04."/>
            </inputs>
            <outputs id="_0x460124" name="Output" icon="_0x14" note="Variablene i denne gruppering er output fra funktionsblokken">
               <resource_output id="_0x460212" name="Indikering af hjemmesimulering aktiv" backup="yes" icon="_0x39" note="Udgang til indikering af hjemmesimulering aktiv.&#xD;&#xA;Forbindes f.eks. til diode.&#xD;&#xA;Bemærk selve hjemmesimuleringen starter først når ur er off og skumringsrelæ er on." inivalue="on" note-2="Tip: brug &quot;Indikering af hjemmesimulering aktiv&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.02.g-UD01."/>
               <resource_output id="_0x460312" name="Indikering af hjemmesimulering er startet" icon="_0x39" note="Udgang til indikering af hjemmesimulering er startet.&#xD;&#xA;Forbindes f.eks. til diode.&#xD;&#xA;Denne udgang indikerer at hjemmesimuleringen er igang (ur er off og skumringsrelæ er on)." note-2="Note: &quot;Indikering af hjemmesimulering er startet&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.02.g-UD02."/>
               <resource_scene id="_0x46044a" name="Konstant lys - TÆND Scenarie" note="Konstant lys er tændt sålænge hjemmesimuleringen er aktiv, skumringsrelæ er on og ur er off.&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger der skal stå konstant tændt funktionen. &#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. &#xD;&#xA;Tænk over hvilken udgang der skal stå konstant tændt, forsøg at få huset til at ligne et hus som er beboet.&#xD;&#xA;" note-2="Vejledning: kontrollér &quot;Konstant lys - TÆND Scenarie&quot; efter udskiftning af et produkt. Ref. 6.3.02.g-UD03.">
                  <scene_link id="_0x4a084b" name="Scenarie link" icon="_0x47" link="_0x4a074d"/>
               </resource_scene>
               <resource_scene id="_0x46054a" name="Konstant lys - SLUK Scenarie" note="Konstant lys er tændt sålænge hjemmesimuleringen er aktiv, skumringsrelæ er on og ur er off.&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger der skal stå konstant tændt funktionen. &#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. &#xD;&#xA;Tænk over hvilken udgang der skal stå konstant tændt, forsøg at få huset til at ligne et hus som er beboet." note-2="Hjælp: dokumentér &quot;Konstant lys - SLUK Scenarie&quot; i 6.3.02.g. Hjemmesimulering med 4 udgange over for slutbrugeren. Ref. 6.3.02.g-UD04."/>
               <resource_output id="_0x460612" name="Konstant lys Udgang - TÆND Puls" icon="_0x39" note="Konstant lys er tændt sålænge skumringsrelæ er on og ur er off..&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes. &#xD;&#xA;Tænk over hvilken udgang der skal stå konstant tændt, forsøg at få huset til at ligne et hus som er beboet." note-2="Vejledning - &quot;Konstant lys Udgang - TÆND Puls&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.3.02.g-UD05.">
                  <link_from_resource id="_0x4a032d" name="Følg Link" icon="_0x47" link="_0x4a042c"/>
               </resource_output>
               <resource_output id="_0x460712" name="Konstant lys Udgang - SLUK Puls" icon="_0x39" note="Konstant lys er tændt sålænge skumringsrelæ er on og ur er off..&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes. &#xD;&#xA;Tænk over hvilken udgang der skal stå konstant tændt, forsøg at få huset til at ligne et hus som er beboet." note-2="Tip: brug &quot;Konstant lys Udgang - SLUK Puls&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.02.g-UD06."/>
               <resource_scene id="_0x46084a" name="Simulerende Udgang 1 - TÆND Scenarie" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger som skal aktiveres af hjemmesimuleringen.&#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. " note-2="Note: &quot;Simulerende Udgang 1 - TÆND Scenarie&quot; fremkaldes også fra ur og kalender.&#xD;&#xA;Ref. 6.3.02.g-UD07."/>
               <resource_scene id="_0x46094a" name="Simulerende Udgang 1 - SLUK Scenarie" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger som skal aktiveres af hjemmesimuleringen.&#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. " note-2="Vejledning: kontrollér &quot;Simulerende Udgang 1 - SLUK Scenarie&quot; efter udskiftning af et produkt. Ref. 6.3.02.g-UD08."/>
               <resource_output id="_0x460a12" name="Simulerende Udgang 1 - TÆND Puls" icon="_0x39" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes. " note-2="Hjælp: notér i 6.3.02.g. Hjemmesimulering med 4 udgange hvilke produkter &quot;Simulerende Udgang 1 - TÆND Puls&quot; betjener. Ref. 6.3.02.g-UD09.">
                  <link_from_resource id="_0x4a052d" name="Følg Link" icon="_0x47" link="_0x4a062c"/>
               </resource_output>
               <resource_output id="_0x460b12" name="Simulerende Udgang 1 - SLUK Puls" icon="_0x39" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes. " note-2="Vejledning - &quot;Simulerende Udgang 1 - SLUK Puls&quot;: kontrollér belastningen før tilslutning.&#xD;&#xA;Ref. 6.3.02.g-UD10."/>
               <resource_scene id="_0x460c4a" name="Simulerende Udgang 2 - TÆND Scenarie" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger som skal aktiveres af hjemmesimuleringen.&#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. " note-2="Tip: hold antallet af produkter i &quot;Simulerende Udgang 2 - TÆND Scenarie&quot; lavt (&lt; 20) af hensyn til svartiden. Ref. 6.3.02.g-UD11."/>
               <resource_scene id="_0x460d4a" name="Simulerende Udgang 2 - SLUK Scenarie" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger som skal aktiveres af hjemmesimuleringen.&#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. " note-2="Note: &quot;Simulerende Udgang 2 - SLUK Scenarie&quot; fremkaldes også fra ur og kalender.&#xD;&#xA;Ref. 6.3.02.g-UD12."/>
               <resource_output id="_0x460e12" name="Simulerende Udgang 2 - TÆND Puls" icon="_0x39" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes. " note-2="Vejledning: verificér &quot;Simulerende Udgang 2 - TÆND Puls&quot; med en måling på klemmen (230 V AC). Ref. 6.3.02.g-UD13."/>
               <resource_output id="_0x460f12" name="Simulerende Udgang 2 - SLUK Puls" icon="_0x39" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes." note-2="Hjælp: notér i 6.3.02.g. Hjemmesimulering med 4 udgange hvilke produkter &quot;Simulerende Udgang 2 - SLUK Puls&quot; betjener. Ref. 6.3.02.g-UD14."/>
               <resource_scene id="_0x46104a" name="Simulerende Udgang 3 - TÆND Scenarie" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger som skal aktiveres af hjemmesimuleringen.&#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. " note-2="Vejledning - &quot;Simulerende Udgang 3 - TÆND Scenarie&quot;: sæt hvert produkt til det ønskede niveau i %.&#xD;&#xA;Ref. 6.3.02.g-UD15."/>
               <resource_scene id="_0x46114a" name="Simulerende Udgang 3 - SLUK Scenarie" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger som skal aktiveres af hjemmesimuleringen.&#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. " note-2="Tip: hold antallet af produkter i &quot;Simulerende Udgang 3 - SLUK Scenarie&quot; lavt (&lt; 20) af hensyn til svartiden. Ref. 6.3.02.g-UD16."/>
               <resource_output id="_0x461212" name="Simulerende Udgang 3 - TÆND Puls" icon="_0x39" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes. " note-2="Note: &quot;Simulerende Udgang 3 - TÆND Puls&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.02.g-UD17."/>
               <resource_output id="_0x461312" name="Simulerende Udgang 3 - SLUK Puls" icon="_0x39" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes. " note-2="Vejledning: verificér &quot;Simulerende Udgang 3 - SLUK Puls&quot; med en måling på klemmen (230 V AC). Ref. 6.3.02.g-UD18."/>
               <resource_scene id="_0x46144a" name="Simulerende Udgang 4 - TÆND Scenarie" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger som skal aktiveres af hjemmesimuleringen.&#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. " note-2="Hjælp: dokumentér &quot;Simulerende Udgang 4 - TÆND Scenarie&quot; i 6.3.02.g. Hjemmesimulering med 4 udgange over for slutbrugeren. Ref. 6.3.02.g-UD19."/>
               <resource_scene id="_0x46154a" name="Simulerende Udgang 4 - SLUK Scenarie" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Scenarieudgangen trækkes over på de tændinger som skal aktiveres af hjemmesimuleringen.&#xD;&#xA;HUSK at både tænd og sluk scenarie skal forbindes. " note-2="Vejledning - &quot;Simulerende Udgang 4 - SLUK Scenarie&quot;: sæt hvert produkt til det ønskede niveau i %.&#xD;&#xA;Ref. 6.3.02.g-UD20."/>
               <resource_output id="_0x461612" name="Simulerende Udgang 4 - TÆND Puls" icon="_0x39" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes. " note-2="Tip: brug &quot;Simulerende Udgang 4 - TÆND Puls&quot; som betingelse i andre blokke i stedet for et nyt link. Ref. 6.3.02.g-UD21."/>
               <resource_output id="_0x461712" name="Simulerende Udgang 4 - SLUK Puls" icon="_0x39" note="Det simulerende lys er tændt på skift i forhold til indstillingerne på timerne (se oversigt i hjælpefil).&#xD;&#xA;Puls udgang anvendes f.eks til styring af UNI Dimmer.&#xD;&#xA;HUSK at både tænd og sluk udgang skal forbindes. " note-2="Note: &quot;Simulerende Udgang 4 - SLUK Puls&quot; nulstilles ved strømsvigt medmindre andet er valgt.&#xD;&#xA;Ref. 6.3.02.g-UD22."/>
            </outputs>
            <settings id="_0x461825" name="Indstillinger" icon="_0xd" note="Variablene i denne gruppering er indstillinger til funktionsblokken">
               <resource_enum id="_0x46190f" name="Ved deaktivering skal lyset" typedef="_0x45f847" inivalue="_0x45f948" icon="_0x22" note="Her indstilles hvad der skal ske med udgangene når hjemmesimuleringen deaktiveres:&#xD;&#xA;Tænd ubetinget&#xD;&#xA;Tænd hvis skumringsrelæ er on&#xD;&#xA;Sluk ubetinget&#xD;&#xA;" note-2="Note: &quot;Ved deaktivering skal lyset&quot; gemmes i projektfilen &amp; overføres ved upload.&#xD;&#xA;Ref. 6.3.02.g-IS01."/>
               <resource_timer id="_0x461a10" name="Timer 1" icon="_0x43" note="Indstilles til en tilfældig værdi. Tiden simulerende udgang 1 er on" hour="0" minute="16" second="0" millisecond="0" note-2="Vejledning: afprøv &quot;Timer 1&quot; i simulering før anlægget overdrages. Ref. 6.3.02.g-IS02."/>
               <resource_timer id="_0x461b10" name="Timer 2" icon="_0x43" note="Indstilles til en tilfældig værdi. Tiden simulerende udgang 1 er off." hour="0" minute="41" second="45" millisecond="0" note-2="Hjælp: værdien for &quot;Timer 2&quot; i 6.3.02.g. Hjemmesimulering med 4 udgange bør gennemgås ved service. Ref. 6.3.02.g-IS03."/>
               <resource_timer id="_0x461c10" name="Timer 3" icon="_0x43" note="Indstilles til en tilfældig værdi. Tiden simulerende udgang 2 er on." hour="0" minute="17" second="30" millisecond="0" note-2="Vejledning - &quot;Timer 3&quot;: for lav værdi giver hyppige omkoblinger.&#xD;&#xA;Ref. 6.3.02.g-IS04."/>
