<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE product_dataline [
	<!ELEMENT product_dataline ANY>   
	<!ATTLIST product_dataline id ID #REQUIRED
		product_identifier CDATA #REQUIRED
				name CDATA ""
				locked (yes | no) "yes"
				enduser_report (yes | no) "no"
				icon CDATA ""
				note CDATA "">
   <!ELEMENT dataline_input ANY>
   <!ATTLIST dataline_input id ID #REQUIRED
                  name CDATA ""
                  note CDATA ""
                  inivalue (on | off) "off"
                  address_dataline CDATA "_0x0"
                  cable_colour CDATA "">
]>
<product_dataline id="_0x01" product_identifier="_0x9f11" name="Synthetic quirks produkt" note="Synthetic oracle - DOCTYPE space, tabs, trailing spaces, apostrophe entity">
  <dataline_input id="_0x02" name="Føler&apos;ens indgang" note="PIR&apos;en styrer lyset" address_dataline="_0x1" />
</product_dataline>
