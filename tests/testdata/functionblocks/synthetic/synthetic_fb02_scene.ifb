<functionblock id="_0x5128" name="9.1.02.a. Scene recall" master_type="9.1.02" master_version="a" master_name="Scene recall" master_programmer="Morten Christensen" master_date_year="2026" master_date_month="3" master_date_day="12" locked="yes" icon="_0xe" note="9.1.02.a. Scene recall&#xD;&#xA;&#xD;&#xA;Fremkalder et scenarie når udløseren aktiveres.">
  <inputs id="_0x5223" name="Input" icon="_0x4" note="Indgange til scenarieblokken">
    <resource_input id="_0x5311" name="Udløser" icon="_0x36" note="Aktiverer scenariefremkaldelsen." />
  </inputs>
  <outputs id="_0x5424" name="Output" icon="_0x14" note="Udgange og scenarier fra blokken">
    <resource_output id="_0x5512" name="Relæ" icon="_0x39" note="Slutter eller bryder belastningen." />
    <resource_scene id="_0x564a" name="Scenarie tændt" note="Fremkaldes når udgangen tændes." hide_dialog="yes" />
    <resource_scene id="_0x574a" name="Scenarie slukket" note="Fremkaldes når udgangen slukkes." note-2="Vises kun for avancerede brugere" />
  </outputs>
  <settings id="_0x5825" name="Indstillinger" icon="_0xd" note="Indstillinger som brugeren kan ændre">
    <resource_timer id="_0x5910" name="Holdetid" icon="_0x43" hour="0" minute="2" second="30" millisecond="0" backup="yes" />
  </settings>
  <internalsettings id="_0x5a29" name="Interne variable" icon="_0x13" note="Private variable til blokkens eget brug" />
  <programs id="_0x5b26" name="Programmer" icon="_0x19" note="Gruppering af blokkens programmer">
    <program_simple id="_0x5c1e" name="Fremkald tændt" icon="_0x7">
      <events id="_0x5d64" name="Hændelser" icon="_0xb" note="Hændelser der udløser programmet">
        <event id="_0x5ec8" name="%P -&gt; ON" icon="_0xc" note="Start når %P skifter til ON" link1="_0x5311" method="_0xa" />
      </events>
      <actions id="_0x5f66" name="Kommandoer" icon="_0x8" note="Kommandoer der udføres når en hændelse indtræffer" type="_0x2">
        <action id="_0x60ca" name="%P = ON" icon="_0x9" note="Tænder relæet" link1="_0x5512" method="_0xa" />
        <action id="_0x61ca" name="Fremkald %P" icon="_0x9" note="Fremkalder scenariet" link1="_0x564a" method="_0xa" />
      </actions>
    </program_simple>
    <program_simple id="_0x621e" name="Fremkald slukket" icon="_0x7">
      <events id="_0x6364" name="Hændelser" icon="_0xb" note="Hændelser der udløser programmet">
        <event id="_0x64c8" name="%P -&gt; OFF" icon="_0xc" note="Start når %P skifter til OFF" link1="_0x5311" method="_0x14" />
      </events>
      <actions id="_0x6566" name="Kommandoer" icon="_0x8" note="Kommandoer der udføres når en hændelse indtræffer" type="_0x2">
        <action id="_0x66ca" name="%P = OFF" icon="_0x9" note="Slukker relæet" link1="_0x5512" method="_0x14" />
        <action id="_0x67ca" name="Fremkald %P" icon="_0x9" note="Fremkalder scenariet" link1="_0x574a" method="_0xa" />
      </actions>
    </program_simple>
  </programs>
</functionblock>