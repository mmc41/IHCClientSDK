<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared desktop-app bootstrap (review S2 / T035): the logging + OpenTelemetry start-up pipeline that
    ihc_openvisual and ihc_lab both need. It cannot live in ihcclient — it depends on Avalonia.Logging and the
    OpenTelemetry EXPORTERS, and the SDK core deliberately carries no logging/Avalonia dependency (D09). A small
    library referenced by both Avalonia apps is the one place the two byte-for-byte-duplicated AppSetup files can
    become one. Package versions come from Directory.Packages.props (central management); Microsoft.Extensions.
    Logging.Console transitively provides the ILoggingBuilder.AddConfiguration extension used below.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

</Project>
