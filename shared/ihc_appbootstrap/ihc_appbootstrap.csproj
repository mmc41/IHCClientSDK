<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Avalonia-only half of the shared host bootstrap: the Avalonia→ILogger sink, the AppBuilder hook, the
    dispatcher exception layer and the two level maps. Referenced by ihc_openvisual and ihc_lab.

    The providers and OTLP wiring are NOT here — they moved to ihc_telemetrybootstrap, which carries no UI
    dependency, so a console utility can build the same pipeline without Avalonia (R7). This project
    references that one and adds the toolkit on top; nothing that a headless host could use belongs here.

    Package versions come from Directory.Packages.props (central management).
  -->

  <ItemGroup>
    <ProjectReference Include="..\ihc_telemetrybootstrap\ihc_telemetrybootstrap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
