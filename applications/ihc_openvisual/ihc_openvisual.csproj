<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\openvisual.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.1.0</Version>
    <InformationalVersion>Incubating</InformationalVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Copyright>Apache License 2.0</Copyright>
    <Authors>mmc41</Authors>
    <AssemblyTitle>IHC OpenVisual</AssemblyTitle>
    <Product>IHC OpenVisual</Product>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The SVG icons are ALSO plain embedded resources: the report icon provider reads them without a
         running Avalonia platform (spec S09), so headless tests and report generation share the exact
         glyphs the app ships. -->
    <EmbeddedResource Include="Assets\**\*.svg" />
    <InternalsVisibleTo Include="safe_visual_tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj"/>
    <ProjectReference Include="..\..\shared\ihc_appbootstrap\ihc_appbootstrap.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- GUI-scoped compile-time bans, merged with the repository-wide file the root Directory.Build.targets
         supplies. They live here rather than at the root because the SDK owns the banned namespaces and must
         keep using them; a repo-wide entry would ban them in the project that defines them. -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- .axaml hot reload for the inner development loop: edit markup and see it in the RUNNING window instead
         of paying a restart per tweak. Development-only by construction — PrivateAssets="All" keeps it out of
         anything that consumes this project, and the plugin disables itself outside a Debug configuration, so no
         part of it reaches a Release build. Avalonia.Markup.Xaml.Loader is its runtime XAML parser, referenced
         here only to pin it to the Avalonia version this app actually uses (the plugin's own copy targets 11.x). -->
    <PackageReference Include="HotAvalonia" PrivateAssets="All" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" PrivateAssets="All">
      <!-- HotAvalonia takes itself out of a Release build; this one does not, and would otherwise ship a runtime
           XAML parser no released build ever calls (same shape as AvaloniaUI.DiagnosticsSupport above). -->
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <Target Name="CopyConfigFiles" AfterTargets="AfterBuild">
    <!-- Settings file is optional at runtime (the app starts without it); copy when present so a
         configured telemetry/logging setup is picked up during local runs and tests. -->
    <Copy SourceFiles="..\..\ihcsettings.json" DestinationFolder="$(OutDir)" Condition="Exists('..\..\ihcsettings.json')" />
  </Target>
  <Target Name="DeleteConfigFiles" AfterTargets="Clean">
    <Delete Files="$(OutDir)ihcsettings.json" Condition="Exists('$(OutDir)ihcsettings.json')" />
  </Target>
</Project>
