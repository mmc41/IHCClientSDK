<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ihc_openvisual.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- No ViewLocator: nothing in this app is rendered by matching a view-model to a *View type. The shell is one
         window with its own markup, and every dialog sets its DataContext explicitly and binds with x:DataType. The
         template-generated locator only ever stood to render "Not Found: …ViewModels.MainWindowView". -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Icon ink and status-bar tint follow the active theme's tokens (US-001 SHOULD). The pane
                     header stays a fixed brand blue in both themes (US-001 MUST). -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="IconColor">#FF303030</Color>
                    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFF7F7F7"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF666666"/>
                    <!-- Warning ink (e.g. the "!" unlinked marker). A dark amber that clears WCAG 4.5:1 on the
                         light window background, unlike the former inline #E0A800 which did not. -->
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFB45309"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="IconColor">#FFE0E0E0</Color>
                    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF2A2A2A"/>
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFAAAAAA"/>
                    <!-- Brighter amber for the dark background — high contrast on the dark surfaces. -->
                    <SolidColorBrush x:Key="WarningBrush" Color="#FFFBBF24"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Theme-independent tokens -->
            <SolidColorBrush x:Key="PaneHeaderBackgroundBrush" Color="#FF1E5AA8"/>
            <SolidColorBrush x:Key="PaneHeaderForegroundBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="LinkBrush" Color="#FF3B82F6"/>
            <x:Double x:Key="TitleFontSize">22</x:Double>
            <x:Double x:Key="BodyFontSize">12</x:Double>
            <x:Double x:Key="CaptionFontSize">11</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
