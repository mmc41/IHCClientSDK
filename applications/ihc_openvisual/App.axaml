<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ihc_openvisual.App"
             xmlns:local="using:ihc_openvisual"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Icon ink and status-bar tint follow the active theme's tokens (US-001 SHOULD). The pane
                     header stays a fixed brand blue in both themes (US-001 MUST). -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="IconColor">#FF303030</Color>
                    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFF0F0F0"/>
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFF7F7F7"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF666666"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="IconColor">#FFE0E0E0</Color>
                    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF2A2A2A"/>
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FF2D2D2D"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFAAAAAA"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Theme-independent tokens -->
            <SolidColorBrush x:Key="PaneHeaderBackgroundBrush" Color="#FF1E5AA8"/>
            <SolidColorBrush x:Key="PaneHeaderForegroundBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="LinkBrush" Color="#FF3B82F6"/>
            <x:Double x:Key="TitleFontSize">22</x:Double>
            <x:Double x:Key="HeadingFontSize">16</x:Double>
            <x:Double x:Key="BodyFontSize">12</x:Double>
            <x:Double x:Key="CaptionFontSize">11</x:Double>
            <x:Double x:Key="DialogButtonWidth">90</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
