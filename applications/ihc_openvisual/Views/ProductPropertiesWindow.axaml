<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svc="using:ihc_openvisual.Services"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="480"
        x:Class="ihc_openvisual.Views.ProductPropertiesWindow"
        a:AutomationProperties.AutomationId="ProductPropertiesWindow"
        Title="Produkt egenskaber"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="6">
        <StackPanel.Styles>
            <Style Selector="TextBlock.label">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
        </StackPanel.Styles>

        <TextBlock Name="NameLabel" Classes="label" Text="Navn"/>
        <TextBox Name="NameBox" a:AutomationProperties.LabeledBy="{Binding #NameLabel}"/>

        <!-- A-13/US-011: the vendor's free-text placement descriptor ("i loft"); a plain textbox, no room dropdown
             (moving a product between localities is a tree operation, not a dialog field). -->
        <TextBlock Name="PlaceringLabel" Classes="label" Text="Placering"/>
        <TextBox Name="PlaceringBox" a:AutomationProperties.LabeledBy="{Binding #PlaceringLabel}"/>

        <TextBlock Name="NoteLabel" Classes="label" Text="Note"/>
        <TextBox Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalContentAlignment="Top"
                 a:AutomationProperties.LabeledBy="{Binding #NoteLabel}"/>

        <StackPanel Name="CablingPanel" Spacing="6">
            <TextBlock Name="CableTypeLabel" Classes="label" Text="Kabeltype"/>
            <TextBox Name="CableTypeBox" a:AutomationProperties.LabeledBy="{Binding #CableTypeLabel}"/>

            <TextBlock Name="CableNumberLabel" Classes="label" Text="Kabelnummer"/>
            <TextBox Name="CableNumberBox" a:AutomationProperties.LabeledBy="{Binding #CableNumberLabel}"/>
        </StackPanel>

        <TextBlock Name="IdentificationLabel" Classes="label" Text="Id-kode"/>
        <TextBox Name="IdentificationBox" a:AutomationProperties.LabeledBy="{Binding #IdentificationLabel}"/>

        <TextBlock Name="LightGroupLabel" Classes="label" Text="Lysgruppe"/>
        <TextBox Name="LightGroupBox" a:AutomationProperties.LabeledBy="{Binding #LightGroupLabel}"/>

        <!-- A-23/US-012 + C15 (measured 2026-07-18): the enduser_report flag. The vendor NEVER shows this checkbox —
             control 303 is hidden project-wide (13 products / 6 families measured, 0 showing it; absent entirely from
             the compact handheld dialog). So it is hidden here to match. The value still round-trips (the control keeps
             the loaded state and re-writes it) — only the toggle affordance is removed, exactly like the vendor. -->
        <CheckBox Name="EndUserReportCheck" Margin="0,8,0,0" IsVisible="False"
                  Content="Medtag produkt i slutbrugerrapport"/>

        <!-- US-012: input/output terminal addressing grids. Columns Name | Address | Cable colour | Note; a row is
             addressed by double-tapping it (or selecting it and clicking Configure). -->
        <StackPanel Name="TerminalsPanel" Spacing="4" IsVisible="False">
            <StackPanel.Styles>
                <Style Selector="TextBlock.thead">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
            </StackPanel.Styles>

            <TextBlock Classes="label" Text="Indgange"/>
            <Grid ColumnDefinitions="1.4*,1.3*,*,1.6*">
                <TextBlock Grid.Column="0" Classes="thead" Text="Navn"/>
                <TextBlock Grid.Column="1" Classes="thead" Text="Adresse"/>
                <TextBlock Grid.Column="2" Classes="thead" Text="Ledningsfarve"/>
                <TextBlock Grid.Column="3" Classes="thead" Text="Note"/>
            </Grid>
            <ListBox Name="InputsList" MaxHeight="120" DoubleTapped="OnTerminalActivated"
                     a:AutomationProperties.Name="Indgange">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:ProductTerminal">
                        <Grid ColumnDefinitions="1.4*,1.3*,*,1.6*">
                            <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Address}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CableColour}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Note}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Name="ConfigInputButton" Content="Konfigurer indgang" HorizontalAlignment="Left" Click="OnConfigureInput"/>

            <TextBlock Classes="label" Text="Udgange"/>
            <Grid ColumnDefinitions="1.4*,1.3*,*,1.6*">
                <TextBlock Grid.Column="0" Classes="thead" Text="Navn"/>
                <TextBlock Grid.Column="1" Classes="thead" Text="Adresse"/>
                <TextBlock Grid.Column="2" Classes="thead" Text="Ledningsfarve"/>
                <TextBlock Grid.Column="3" Classes="thead" Text="Note"/>
            </Grid>
            <ListBox Name="OutputsList" MaxHeight="120" DoubleTapped="OnTerminalActivated"
                     a:AutomationProperties.Name="Udgange">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:ProductTerminal">
                        <Grid ColumnDefinitions="1.4*,1.3*,*,1.6*">
                            <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Address}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CableColour}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Note}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Name="ConfigOutputButton" Content="Konfigurer udgang" HorizontalAlignment="Left" Click="OnConfigureOutput"/>
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0">
            <Button Grid.Column="0" Name="AdvancedButton" Content="Avanceret…" MinWidth="96"
                    IsVisible="False" Click="OnAdvanced"/>
            <Button Grid.Column="2" Name="OkButton" Content="OK" MinWidth="84" Margin="8,0,0,0"
                    IsDefault="True" Click="OnOk"/>
            <Button Grid.Column="3" Name="CancelButton" Content="Annuller" MinWidth="84" Margin="8,0,0,0"
                    IsCancel="True" Click="OnCancel"/>
        </Grid>
    </StackPanel>
</Window>
