<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="420"
        x:Class="ihc_openvisual.Views.AdvancedDimmerWindow"
        a:AutomationProperties.AutomationId="AdvancedDimmerWindow"
        Title="Avancerede lysdæmper egenskaber"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="6">
        <StackPanel.Styles>
            <Style Selector="TextBlock.label">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
        </StackPanel.Styles>

        <TextBlock Name="SoftOnLabel" Classes="label" Text="Blød opstart (ms)"/>
        <NumericUpDown Name="SoftOnBox" Increment="100" FormatString="0"
                       a:AutomationProperties.LabeledBy="{Binding #SoftOnLabel}"/>

        <TextBlock Name="SoftOffLabel" Classes="label" Text="Blød nedlukning (ms)"/>
        <NumericUpDown Name="SoftOffBox" Increment="100" FormatString="0"
                       a:AutomationProperties.LabeledBy="{Binding #SoftOffLabel}"/>

        <TextBlock Name="ManualRampLabel" Classes="label" Text="Manuel ramptid (s)"/>
        <NumericUpDown Name="ManualRampBox" Increment="1" FormatString="0"
                       a:AutomationProperties.LabeledBy="{Binding #ManualRampLabel}"/>

        <TextBlock Name="MinimumLabel" Classes="label" Text="Minimum værdi (%)"/>
        <NumericUpDown Name="MinimumBox" Increment="1" FormatString="0"
                       a:AutomationProperties.LabeledBy="{Binding #MinimumLabel}"/>

        <TextBlock Name="MaximumLabel" Classes="label" Text="Maksimum værdi (%)"/>
        <NumericUpDown Name="MaximumBox" Increment="1" FormatString="0"
                       a:AutomationProperties.LabeledBy="{Binding #MaximumLabel}"/>

        <TextBlock Name="LoadModeLabel" Classes="label" Text="Belastnings karakteristik"/>
        <ComboBox Name="LoadModeCombo" HorizontalAlignment="Stretch"
                  a:AutomationProperties.LabeledBy="{Binding #LoadModeLabel}">
            <!-- Matches the original IHC Visual: Auto detektion / RC / RL, Auto first. The three load modes are a
                 fixed enumeration, so each item carries the enum member as its id — a driver selects "Inductive"
                 without knowing how the option is spelled in the running language. -->
            <ComboBoxItem a:AutomationProperties.AutomationId="LoadMode.Auto">Auto detektion</ComboBoxItem>
            <ComboBoxItem a:AutomationProperties.AutomationId="LoadMode.Capacitive">RC</ComboBoxItem>
            <ComboBoxItem a:AutomationProperties.AutomationId="LoadMode.Inductive">RL</ComboBoxItem>
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
            <Button Name="CancelButton" Content="Annuller" MinWidth="84" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
