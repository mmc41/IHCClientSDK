<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="300"
        x:Class="ihc_openvisual.Views.VariablePropertiesWindow"
        Title="Edit variable"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="8">
        <TextBlock Name="NameLabel" Text="Name" FontWeight="SemiBold"/>
        <TextBox Name="NameBox" a:AutomationProperties.LabeledBy="{Binding #NameLabel}"/>

        <TextBlock Name="NoteLabel" Text="Note" FontWeight="SemiBold" Margin="0,6,0,0"/>
        <TextBox Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="90" VerticalContentAlignment="Top"
                 a:AutomationProperties.LabeledBy="{Binding #NoteLabel}"/>

        <!-- W5: the SECOND documentation field (note-2) — installer help text, distinct from the function
             documentation above. A variable carries both; a locality deliberately keeps only Name + Note (D11). -->
        <TextBlock Name="HelpNoteLabel" Text="Help text" FontWeight="SemiBold" Margin="0,6,0,0"/>
        <TextBox Name="HelpNoteBox" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="90" VerticalContentAlignment="Top"
                 a:AutomationProperties.LabeledBy="{Binding #HelpNoteLabel}"/>

        <!-- Bool initial value -->
        <CheckBox Name="BoolBox" Content="Initial value: On" Margin="0,6,0,0" IsVisible="False"/>

        <!-- Numeric initial value -->
        <StackPanel Name="NumberPanel" Margin="0,6,0,0" Spacing="4" IsVisible="False">
            <TextBlock Name="NumberLabel" Text="Initial value" FontWeight="SemiBold"/>
            <TextBox Name="NumberBox" a:AutomationProperties.LabeledBy="{Binding #NumberLabel}"/>
        </StackPanel>

        <!-- Time / duration initial value -->
        <StackPanel Name="TimePanel" Margin="0,6,0,0" Spacing="4" IsVisible="False">
            <TextBlock Text="Initial value" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="H" VerticalAlignment="Center"/>
                <TextBox Name="HourBox" Width="52"/>
                <TextBlock Text="M" VerticalAlignment="Center"/>
                <TextBox Name="MinuteBox" Width="52"/>
                <TextBlock Text="S" VerticalAlignment="Center"/>
                <TextBox Name="SecondBox" Width="52"/>
                <TextBlock Name="MsLabel" Text="ms" VerticalAlignment="Center"/>
                <TextBox Name="MsBox" Width="60"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
            <Button Name="CancelButton" Content="Cancel" MinWidth="84" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
