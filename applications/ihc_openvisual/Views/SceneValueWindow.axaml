<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="260"
        x:Class="ihc_openvisual.Views.SceneValueWindow"
        Title="Scenarie værdi"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="6">
        <StackPanel.Styles>
            <Style Selector="TextBlock.label">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
        </StackPanel.Styles>

        <!-- Dimmer variant: light level + ramp time -->
        <StackPanel Name="DimmerPanel" Spacing="6">
            <TextBlock Name="LevelLabel" Classes="label" Text="Lysniveau (%)"/>
            <NumericUpDown Name="LevelBox" Minimum="0" Maximum="100" Increment="5" FormatString="0"
                           a:AutomationProperties.LabeledBy="{Binding #LevelLabel}"/>
            <TextBlock Classes="label" Text="Ramptid"/>
            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="6">
                <NumericUpDown Grid.Column="0" Name="RampMinutesBox" Minimum="0" Maximum="59" Increment="1" FormatString="0"
                               a:AutomationProperties.Name="Ramptid minutter"/>
                <TextBlock Grid.Column="1" Text="min" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="2" Name="RampSecondsBox" Minimum="0" Maximum="59" Increment="1" FormatString="0"
                               a:AutomationProperties.Name="Ramptid sekunder"/>
                <TextBlock Grid.Column="3" Text="sek" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Relay/socket variant: ON/OFF -->
        <StackPanel Name="RelayPanel" Spacing="6">
            <TextBlock Name="StateLabel" Classes="label" Text="Tilstand"/>
            <ComboBox Name="StateCombo" HorizontalAlignment="Stretch"
                      a:AutomationProperties.LabeledBy="{Binding #StateLabel}">
                <ComboBoxItem>OFF</ComboBoxItem>
                <ComboBoxItem>ON</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
            <Button Name="CancelButton" Content="Annuller" MinWidth="84" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
