<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:svc="using:ihc_openvisual.Services"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="640"
        x:Class="ihc_openvisual.Views.ModemPropertiesWindow"
        Title="SMS modem egenskaber"
        Width="460" MaxHeight="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="6">
            <StackPanel.Styles>
                <Style Selector="TextBlock.label">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Margin" Value="0,6,0,0"/>
                </Style>
                <Style Selector="TextBlock.group">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Margin" Value="0,10,0,2"/>
                </Style>
            </StackPanel.Styles>

            <TextBlock Name="NameLabel" Classes="label" Text="Navn"/>
            <TextBox Name="NameBox" a:AutomationProperties.LabeledBy="{Binding #NameLabel}"/>

            <TextBlock Name="LocationLabel" Classes="label" Text="Placering"/>
            <ComboBox Name="LocationCombo" HorizontalAlignment="Stretch"
                      a:AutomationProperties.LabeledBy="{Binding #LocationLabel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:LocalityChoice">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Name="NoteLabel" Classes="label" Text="Note"/>
            <TextBox Name="NoteBox" a:AutomationProperties.LabeledBy="{Binding #NoteLabel}"/>

            <TextBlock Name="IdentificationLabel" Classes="label" Text="Id-kode"/>
            <TextBox Name="IdentificationBox" a:AutomationProperties.LabeledBy="{Binding #IdentificationLabel}"/>

            <TextBlock Classes="group" Text="Kabling"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Name="Cable0VLabel" Text="0 V" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="Cable0VBox" a:AutomationProperties.LabeledBy="{Binding #Cable0VLabel}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Name="Cable24VLabel" Text="24 V" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="Cable24VBox" a:AutomationProperties.LabeledBy="{Binding #Cable24VLabel}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Name="CableRS485MinusLabel" Text="RS485 −" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="CableRS485MinusBox" a:AutomationProperties.LabeledBy="{Binding #CableRS485MinusLabel}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Name="CableRS485PlusLabel" Text="RS485 +" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="CableRS485PlusBox" a:AutomationProperties.LabeledBy="{Binding #CableRS485PlusLabel}"/>
            </Grid>

            <TextBlock Classes="group" Text="Indstillinger"/>
            <TextBlock Name="PinCodeLabel" Classes="label" Text="PIN kode"/>
            <TextBox Name="PinCodeBox" a:AutomationProperties.LabeledBy="{Binding #PinCodeLabel}"/>

            <TextBlock Classes="group" Text="Telefon numre"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                <TextBlock Grid.Row="0" Grid.Column="0" Name="Phone1Label" Text="Nummer 1" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="Phone1Box" a:AutomationProperties.LabeledBy="{Binding #Phone1Label}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Name="Phone2Label" Text="Nummer 2" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="Phone2Box" a:AutomationProperties.LabeledBy="{Binding #Phone2Label}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Name="Phone3Label" Text="Nummer 3" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="Phone3Box" a:AutomationProperties.LabeledBy="{Binding #Phone3Label}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Name="Phone4Label" Text="Nummer 4" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="Phone4Box" a:AutomationProperties.LabeledBy="{Binding #Phone4Label}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
                <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
                <Button Name="CancelButton" Content="Annuller" MinWidth="84" IsCancel="True" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
