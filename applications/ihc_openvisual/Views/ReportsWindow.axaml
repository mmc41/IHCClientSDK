<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ihc_openvisual.ViewModels"
        xmlns:svc="using:ihc_openvisual.Services.Reporting"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="560"
        x:Class="ihc_openvisual.Views.ReportsWindow"
        x:DataType="vm:ReportsViewModel"
        Title="Reports"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Project documentation" FontWeight="Bold" FontSize="16"/>

        <!-- Purpose presets (US-040): each seeds the switches below for a common report purpose. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
            <TextBlock Text="Preset:" VerticalAlignment="Center"/>
            <Button Content="Installation" Command="{Binding ApplyPresetCommand}"
                    CommandParameter="{x:Static svc:ReportPreset.Installation}"/>
            <Button Content="End-user" Command="{Binding ApplyPresetCommand}"
                    CommandParameter="{x:Static svc:ReportPreset.EndUser}"/>
            <Button Content="Function-block" Command="{Binding ApplyPresetCommand}"
                    CommandParameter="{x:Static svc:ReportPreset.FunctionBlock}"/>
            <Button Content="Full" Command="{Binding ApplyPresetCommand}"
                    CommandParameter="{x:Static svc:ReportPreset.Full}"/>
        </StackPanel>

        <!-- US-071 content-section switches + detail options. -->
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox Content="Installation" IsChecked="{Binding ShowInstallation}" Margin="0,0,12,0"/>
            <CheckBox Content="End-user" IsChecked="{Binding ShowEndUser}" Margin="0,0,12,0"/>
            <CheckBox Content="Function-blocks" IsChecked="{Binding ShowFunctionBlocks}" Margin="0,0,12,0"/>
            <CheckBox Content="Internal ids" IsChecked="{Binding ShowInternalIds}" Margin="0,0,12,0"/>
            <CheckBox Content="Wire colours" IsChecked="{Binding ShowWireColours}" Margin="0,0,12,0"/>
            <CheckBox Content="Link display" IsChecked="{Binding ShowLinkDisplay}" Margin="0,0,12,0"/>
            <CheckBox Content="Function docs" IsChecked="{Binding ShowFunctionDocs}" Margin="0,0,12,0"/>
            <CheckBox Content="Empty fields" IsChecked="{Binding ShowEmptyFields}" Margin="0,0,12,0"/>
        </WrapPanel>

        <CheckBox Grid.Row="3" Name="PrintVariant" Margin="0,8"
                  Content="Printer-friendly (drops the on-screen navigation)"
                  IsChecked="{Binding IsPrint}"/>
        <TextBox Grid.Row="4" Name="HtmlSource" Text="{Binding Html, Mode=OneWay}" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas,monospace" FontSize="11" VerticalContentAlignment="Top"
                 a:AutomationProperties.Name="Rendered report HTML"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Name="OpenButton" Content="Open in browser" Command="{Binding OpenInBrowserCommand}"/>
            <Button Name="CloseButton" Content="Close" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
