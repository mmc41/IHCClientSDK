<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        xmlns:cfg="using:ihc_openvisual.Configuration"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="420"
        x:Class="ihc_openvisual.Views.PinPropertiesWindow"
        a:AutomationProperties.AutomationId="{x:Static cfg:AutomationIds.PinPropertiesWindow}"
        Title="Klemme adressering"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="6">
        <StackPanel.Styles>
            <Style Selector="TextBlock.label">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
            </Style>
        </StackPanel.Styles>

        <!-- Properties above Address, matching IHC Visual's Egenskaber / Adresse grouping (uxparity S-14). -->
        <TextBlock Name="NameLabel" Classes="label" Text="Navn"/>
        <TextBox Name="NameBox" IsReadOnly="True" a:AutomationProperties.LabeledBy="{Binding #NameLabel}"/>

        <TextBlock Name="NoteLabel" Classes="label" Text="Note"/>
        <TextBox Name="NoteBox" a:AutomationProperties.LabeledBy="{Binding #NoteLabel}"/>

        <TextBlock Name="CableColourLabel" Classes="label" Text="Ledningsfarve"/>
        <TextBox Name="CableColourBox"
                 a:AutomationProperties.AutomationId="{x:Static cfg:AutomationIds.CableColourBox}"
                 a:AutomationProperties.LabeledBy="{Binding #CableColourLabel}"/>

        <StackPanel Name="InitialValuePanel">
            <TextBlock Name="InitialValueLabel" Classes="label" Text="Initial værdi"/>
            <ComboBox Name="InitialValueCombo" HorizontalAlignment="Stretch"
                      a:AutomationProperties.LabeledBy="{Binding #InitialValueLabel}">
                <ComboBoxItem a:AutomationProperties.AutomationId="InitialValue.Off">OFF — normalt åben (NO)</ComboBoxItem>
                <ComboBoxItem a:AutomationProperties.AutomationId="InitialValue.On">ON — normalt lukket (NC)</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- The output resumes its last state after a power cut instead of its initial value (the vendor's
             Ved strømsvigt / Gem aktuel værdi). Outputs only: an input has no state to restore. -->
        <StackPanel Name="PowerFailurePanel">
            <TextBlock Name="OnPowerFailureLabel" Classes="label" Text="Ved strømsvigt"/>
            <CheckBox Name="SaveValueCheck" Content="Gem aktuel værdi"
                      a:AutomationProperties.LabeledBy="{Binding #OnPowerFailureLabel}"/>
        </StackPanel>

        <!-- F-33: the address is PICKED FROM TWO LISTS, as the original does — a data line (led by an explicit
             "ikke konfigureret", so an addressed terminal can be returned to unaddressed, story 03 line 272) and
             then a terminal on it. The terminal list stays empty and disabled until a line is chosen, and marks
             ports already taken inline as "3 (i brug)" rather than in a separate sentence (story line 281).
             Spinners could not express any of that: they have no not-configured value, no per-line contents and
             nowhere to show which ports are gone. -->
        <TextBlock Name="DataLineLabel" Classes="label" Text="Datalinie"/>
        <ComboBox Name="DataLineList" HorizontalAlignment="Stretch"
                  a:AutomationProperties.LabeledBy="{Binding #DataLineLabel}"/>

        <!-- Captioned by the terminal's own DIRECTION, as the original captions it (Udgang for an output). -->
        <TextBlock Name="TerminalLabel" Classes="label" Text="Udgang"/>
        <ComboBox Name="TerminalList" HorizontalAlignment="Stretch"
                  a:AutomationProperties.AutomationId="{x:Static cfg:AutomationIds.TerminalList}"
                  a:AutomationProperties.LabeledBy="{Binding #TerminalLabel}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
            <!-- OK, Cancel, Apply — the vendor's button order (uxparity S-14). -->
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"
                    a:AutomationProperties.AutomationId="{x:Static cfg:AutomationIds.OkButton}"/>
            <Button Name="CancelButton" Content="Annuller" MinWidth="84" IsCancel="True" Click="OnCancel"
                    a:AutomationProperties.AutomationId="{x:Static cfg:AutomationIds.CancelButton}"/>
            <Button Name="ApplyButton" Content="Anvend" MinWidth="84" Click="OnApply"/>
        </StackPanel>
    </StackPanel>
</Window>
