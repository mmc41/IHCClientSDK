<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="using:Avalonia.Automation"
        xmlns:cfg="using:ihc_openvisual.Configuration"
        xmlns:controls="using:ihc_openvisual.Controls"
        xmlns:svc="using:ihc_openvisual.Services"
        xmlns:vm="using:ihc_openvisual.ViewModels"
        x:Class="ihc_openvisual.Views.ProductDialogWindow"
        x:DataType="vm:ProductDialogViewModel"
        a:AutomationProperties.AutomationId="{x:Static cfg:AutomationIds.ProductDialogWindow}"
        Width="620" MaxHeight="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Title="{Binding Title}">
    <Window.Styles>
        <!-- One frame for every group, supplied here rather than per dialog: the stock theme renders the header
             as plain text with no chrome, and the original draws a box around each of its captioned sections.

             Selected on HeaderedContentControl, NOT on controls|AccessibleGroupBox: a XAML type selector matches
             the control's STYLE KEY, and AccessibleGroupBox overrides StyleKeyOverride to HeaderedContentControl
             so that it inherits that control's theme (without which it renders untemplated). A selector naming
             the subclass therefore never matches — the Template setter is silently ignored, the stock theme
             still draws the header, and the result is a caption with no box: exactly what product 002's
             composite showed against the vendor's framed group (T036). -->
        <Style Selector="HeaderedContentControl.group">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                                   FontWeight="Bold" Margin="4,0,4,4"/>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="10">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- The column headings of the pseudo-tables (terminals and settings alike). -->
        <Style Selector="TextBlock.thead">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- The header grid is authored OUTSIDE the list and the row grids are realized INSIDE it, so the
             theme's ListBoxItem padding decides whether they share an origin. Fluent's is 12,9,12,12, which
             inset every row inside a header that is not inset and sheared the columns apart by 12 px at the
             left edge — with all three copies of the spec in perfect agreement, which is why nothing caught
             it. Zeroing the HORIZONTAL half lines the two up; the vertical padding stays, since rows still
             need breathing room. Applies to the settings grid too, which had the same shear. -->
        <Style Selector="ListBox.terminals > ListBoxItem">
            <Setter Property="Padding" Value="0,6"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- Fields are realized by DataTemplates keyed on the control KIND, not by themed-control subclasses.
             A subclass per kind would put presentation policy in a type hierarchy the composer cannot see; a
             template is data the renderer owns, and adding a kind is adding one template here.

             ONE of these is built per field, chosen by DialogFieldTemplate — not four with IsVisible bindings.
             Hiding is not the same as not building: four realized editors sharing one AutomationId leave three
             invisible-but-focusable phantoms that break every driver and every screen reader. -->
        <controls:DialogFieldTemplate x:Key="FieldEditor">
            <controls:DialogFieldTemplate.Text>
                <DataTemplate x:DataType="vm:ProductDialogFieldViewModel">
                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                             IsEnabled="{Binding !IsReadOnly}"
                             a:AutomationProperties.AutomationId="{Binding AutomationId}"
                             a:AutomationProperties.Name="{Binding Caption}"/>
                </DataTemplate>
            </controls:DialogFieldTemplate.Text>

            <controls:DialogFieldTemplate.TextMultiline>
                <DataTemplate x:DataType="vm:ProductDialogFieldViewModel">
                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                             IsEnabled="{Binding !IsReadOnly}"
                             AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap"
                             a:AutomationProperties.AutomationId="{Binding AutomationId}"
                             a:AutomationProperties.Name="{Binding Caption}"/>
                </DataTemplate>
            </controls:DialogFieldTemplate.TextMultiline>

            <!-- ALWAYS editable: a suggestion list is a typing aid over free text, never a closed list (D07). -->
            <controls:DialogFieldTemplate.ComboSuggest>
                <DataTemplate x:DataType="vm:ProductDialogFieldViewModel">
                    <ComboBox ItemsSource="{Binding Suggestions}"
                              SelectedItem="{Binding Value, Mode=TwoWay}"
                              IsEnabled="{Binding !IsReadOnly}"
                              HorizontalAlignment="Stretch"
                              a:AutomationProperties.AutomationId="{Binding AutomationId}"
                              a:AutomationProperties.Name="{Binding Caption}"/>
                </DataTemplate>
            </controls:DialogFieldTemplate.ComboSuggest>

            <!-- CLOSED, unlike ComboSuggest above: the items are the attribute's own declared tokens, and a
                 value outside them cannot be stored — so this one is not editable. -->
            <controls:DialogFieldTemplate.ComboFixed>
                <DataTemplate x:DataType="vm:ProductDialogFieldViewModel">
                    <ComboBox ItemsSource="{Binding Suggestions}"
                              SelectedItem="{Binding Value, Mode=TwoWay}"
                              IsEnabled="{Binding !IsReadOnly}"
                              HorizontalAlignment="Stretch"
                              a:AutomationProperties.AutomationId="{Binding AutomationId}"
                              a:AutomationProperties.Name="{Binding Caption}"/>
                </DataTemplate>
            </controls:DialogFieldTemplate.ComboFixed>

            <controls:DialogFieldTemplate.Number>
                <DataTemplate x:DataType="vm:ProductDialogFieldViewModel">
                    <TextBox Text="{Binding Value, Mode=TwoWay}"
                             IsEnabled="{Binding !IsReadOnly}"
                             a:AutomationProperties.AutomationId="{Binding AutomationId}"
                             a:AutomationProperties.Name="{Binding Caption}"/>
                </DataTemplate>
            </controls:DialogFieldTemplate.Number>

            <!-- Labelled by its own Content, and the shared caption block stands down for it
                 (HasSeparateCaption) — the vendor draws the tick with the sentence to its right, once. -->
            <controls:DialogFieldTemplate.Checkbox>
                <DataTemplate x:DataType="vm:ProductDialogFieldViewModel">
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              IsEnabled="{Binding !IsReadOnly}"
                              Content="{Binding Caption}"
                              a:AutomationProperties.AutomationId="{Binding AutomationId}"
                              a:AutomationProperties.Name="{Binding Caption}"/>
                </DataTemplate>
            </controls:DialogFieldTemplate.Checkbox>
        </controls:DialogFieldTemplate>

        <!-- The caption stays out here, shared by every kind. Its accessible-name link is the editor's
             AutomationProperties.Name rather than LabeledBy: the editor is built in a separate template scope,
             where a {Binding #FieldCaption} element reference cannot resolve. Same announcement, same string. -->
        <DataTemplate x:Key="FieldTemplate" x:DataType="vm:ProductDialogFieldViewModel">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Classes="caption" Text="{Binding Caption}"
                           IsVisible="{Binding HasSeparateCaption}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource FieldEditor}"/>
            </StackPanel>
        </DataTemplate>

        <!-- One row of the settings grid: three columns, same ellipsize-and-tooltip treatment as the terminal
             rows, since a calibration note is easily longer than its column. -->
        <DataTemplate x:Key="SettingRow" x:DataType="svc:ProductSetting">
            <Grid ColumnDefinitions="{controls:SettingColumns}">
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Note}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Note}"/>
                <TextBlock Grid.Column="2" Text="{Binding Value}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Value}"/>
            </Grid>
        </DataTemplate>

        <!-- A group lays out as ROWS, not as one flat uniform grid, because a field may take the whole row: the
             vendor gives Note the full width and pairs the fields after it up beneath. A flat grid cannot say
             that — it would put the next field beside Note and shift every later field one cell (T038).
             Each row is its own small uniform grid of `Cells` columns, so the renderer needs no span arithmetic;
             the view-model already decided which fields share a row. -->
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:ProductDialogRow">
            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding Cells}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- ONE row template for both terminal grids: they render the same record with the same four columns, and
             a per-list copy is four TextBlocks and a column spec to keep in step by hand.
             The widths come from controls:TerminalColumns, which is where that spec is WRITTEN — the header above
             each list is a separate Grid and only lines up while the two agree. It is an extension rather than a
             resource because ColumnDefinitions is an owned collection: one shared instance would be re-parented
             by every grid that used it, and this template is instantiated once per row. -->
        <!-- Cells ELLIPSIZE and carry the full text as a tooltip. The vendor's dialog is far wider than this
             one, so a long terminal name or note ("Tilstedeværelses indikering", "Følg (Beo4 = Light + Grøn)")
             does not fit here and was being HARD-CLIPPED mid-word: the installer could not tell the text was
             cut, let alone read it. Widening the columns is not the fix; the column ratios are not the
             problem, and guessing a width would be inventing pixel parity the rubric puts out of scope.
             Making the truncation visible and the text recoverable is (products 009, 019 and 028; T062). -->
        <DataTemplate x:Key="TerminalRow" x:DataType="svc:ProductTerminal">
            <Grid ColumnDefinitions="{controls:TerminalColumns}">
                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Address}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Address}"/>
                <TextBlock Grid.Column="2" Text="{Binding CableColour}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CableColour}"/>
                <TextBlock Grid.Column="3" Text="{Binding Note}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Note}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">
            <ItemsControl Name="GroupList" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProductDialogGroupViewModel">
                        <StackPanel Margin="0,0,0,6">
                            <!-- A captioned group draws a box; an uncaptioned one is a bare run of fields. Both
                                 flow their fields into the descriptor's Columns as a UNIFORM grid. -->
                            <controls:AccessibleGroupBox Classes="group"
                                                         IsVisible="{Binding ShowsPlainBox}"
                                                         Header="{Binding Caption}">
                                <ItemsControl ItemsSource="{Binding Rows}"
                                              ItemTemplate="{StaticResource RowTemplate}"/>
                            </controls:AccessibleGroupBox>

                            <ItemsControl IsVisible="{Binding !HasCaption}"
                                          ItemsSource="{Binding Rows}"
                                          ItemTemplate="{StaticResource RowTemplate}"/>

                            <!-- A COLLAPSIBLE group is the same fields behind a disclosure — the vendor's
                                 Avanceret/Normal affordance, which expands its advanced settings in place inside
                                 this dialog rather than opening a window of its own. Closed on open: these are
                                 settings most visits never touch. -->
                            <Expander IsVisible="{Binding IsCollapsible}"
                                      Header="{Binding Caption}"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch"
                                      a:AutomationProperties.AutomationId="{Binding DisclosureAutomationId}"
                                      a:AutomationProperties.Name="{Binding Caption}">
                                <ItemsControl ItemsSource="{Binding Rows}"
                                              ItemTemplate="{StaticResource RowTemplate}"/>
                            </Expander>

                            <!-- ── The two hand-written composites (D12) ──────────────────────────────────────
                                 Everything above this line is generated from metadata. These two are not, and
                                 deliberately so: a terminal grid and a sub-dialog button are structure, not
                                 fields, and expressing them as metadata would mean a vocabulary big enough to
                                 describe arbitrary UI. The DESCRIPTOR still decides WHETHER each appears and in
                                 which group; only the markup is hand-written. -->

                            <!-- US-012: input/output terminal addressing. Columns Navn | Adresse | Ledningsfarve |
                                 Note; a row is addressed by double-tapping it, or selecting it and clicking
                                 Konfigurer.

                                 ONE template for BOTH sides. Indgange and Udgange differ only in their captions,
                                 their ids, their rows and whose selection Konfigurer reads — all of which the
                                 section view-model carries — so a second copy of this markup would be nineteen
                                 lines differing in nine tokens, with no way to keep them in step. The two sides
                                 are ALWAYS both present (US-012 MUST): a product with no outputs shows an EMPTY
                                 Udgange grid with its Configure button disabled, never a missing section. An
                                 empty grid says "this product has no outputs"; an absent one says nothing and
                                 reads as an unfinished dialog (T030's markup hid each empty side; product 003's
                                 vendor composite caught it, T037). -->
                            <ItemsControl ItemsSource="{Binding TerminalGrids}">
                              <ItemsControl.ItemTemplate>
                               <DataTemplate x:DataType="vm:ProductDialogTerminalGridViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,4">
                                <StackPanel.Styles>
                                    <!-- F-35: the generated ListBoxItem IS the row's automation element, so the
                                         name belongs on the CONTAINER — setting it on the template's Grid leaves
                                         the item announcing the record's ToString(), PinId and all.
                                         Scoped to this template rather than hoisted to Window.Styles even though
                                         the selector would match there too: the settings grid carries the same
                                         class for its padding, and its rows are ProductSettings with no Summary
                                         to bind, so a hoisted rule would name them from a failed binding. -->
                                    <Style Selector="ListBox.terminals > ListBoxItem" x:DataType="svc:ProductTerminal">
                                        <Setter Property="a:AutomationProperties.Name" Value="{Binding Summary}"/>
                                    </Style>
                                </StackPanel.Styles>

                                <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Caption}"/>
                                <Grid ColumnDefinitions="{controls:TerminalColumns}">
                                    <TextBlock Grid.Column="0" Classes="thead" Text="Navn"/>
                                    <TextBlock Grid.Column="1" Classes="thead" Text="Adresse"/>
                                    <TextBlock Grid.Column="2" Classes="thead" Text="Ledningsfarve"/>
                                    <TextBlock Grid.Column="3" Classes="thead" Text="Note"/>
                                </Grid>
                                <!-- No Name: a name cannot be bound, so one template cannot give the two lists
                                     distinct ones. Nothing needs it — the Konfigurer handler reads the section
                                     this button belongs to, and the tests address the lists by their id. -->
                                <ListBox Classes="terminals" MaxHeight="120"
                                         ItemsSource="{Binding Rows}"
                                         SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                         DoubleTapped="OnTerminalActivated"
                                         ItemTemplate="{StaticResource TerminalRow}"
                                         a:AutomationProperties.AutomationId="{Binding AutomationId}"
                                         a:AutomationProperties.Name="{Binding Name}"/>
                                <Button Content="{Binding ButtonCaption}" HorizontalAlignment="Left"
                                        IsEnabled="{Binding HasRows}" Click="OnConfigure"
                                        a:AutomationProperties.AutomationId="{Binding ButtonAutomationId}"/>
                                </StackPanel>
                               </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- T070: the sensors' Indstillinger grid, a third terminal-style list. Presence is
                                 the descriptor's business, so this section renders only where the widget was
                                 declared; the vendor shows it only for products that HAVE settings, unlike the
                                 two terminal grids it always shows.
                                 Selectable since T039, with the same two-way SelectedItem the terminal grids
                                 carry, because the vendor's own "klik for at konfigurere" makes the ROW the
                                 gesture: picking one is the first half of editing it. -->
                            <ItemsControl ItemsSource="{Binding SettingsSection}">
                              <ItemsControl.ItemTemplate>
                               <DataTemplate x:DataType="vm:ProductDialogSettingsGridViewModel">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Caption}"/>
                                    <Grid ColumnDefinitions="{controls:SettingColumns}">
                                        <TextBlock Grid.Column="0" Classes="thead" Text="Navn"/>
                                        <TextBlock Grid.Column="1" Classes="thead" Text="Note"/>
                                        <TextBlock Grid.Column="2" Classes="thead" Text="Værdi"/>
                                    </Grid>
                                    <!-- Two routes to the same editor, as the vendor has: double-click the row,
                                         or right-click it and choose Egenskaber. -->
                                    <ListBox Name="SettingsList" Classes="terminals" MaxHeight="120"
                                             ItemsSource="{Binding Rows}"
                                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                             DoubleTapped="OnSettingActivated"
                                             ContextRequested="OnSettingContextRequested"
                                             ItemTemplate="{StaticResource SettingRow}"
                                             a:AutomationProperties.AutomationId="{Binding AutomationId}"
                                             a:AutomationProperties.Name="{Binding Name}">
                                        <ListBox.ContextFlyout>
                                            <MenuFlyout>
                                                <!-- The Accessible subclass, not the stock MenuItem: Avalonia's
                                                     own peer exposes no Invoke, so a driver and a screen reader
                                                     would both meet a menu item nothing can activate. -->
                                                <controls:AccessibleMenuItem
                                                          Name="SettingPropertiesItem" Header="Egenskaber"
                                                          Click="OnSettingActivated"
                                                          a:AutomationProperties.AutomationId="dlg.indstillinger.egenskaber"/>
                                            </MenuFlyout>
                                        </ListBox.ContextFlyout>
                                    </ListBox>
                                </StackPanel>
                               </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Inline, next to the fields, rather than a second modal on top of this one: the installer has to be
                 able to see the offending value while reading why it was refused. -->
            <TextBlock Name="DialogError"
                       Text="{Binding Refusal}" IsVisible="{Binding HasRefusal}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
                <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
                <Button Name="CancelButton" Content="Annuller" MinWidth="84" IsCancel="True" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
