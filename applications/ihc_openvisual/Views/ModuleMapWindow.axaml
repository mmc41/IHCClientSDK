<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vis="clr-namespace:Ihc.Vis;assembly=ihcclient"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
        x:Class="ihc_openvisual.Views.ModuleMapWindow"
        x:DataType="vis:DatalineModuleMap"
        Title="Data line modules"
        Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">
    <Window.Styles>
        <!-- The same captioned group box the project-info dialog uses; Avalonia has no GroupBox. -->
        <Style Selector="HeaderedContentControl.group">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TextBlock.colhead">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,6,4"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- Read-only rows: an ItemsControl, not a ListBox, so there is no selection or focus affordance to
             suggest the grid is interactive. -->
        <Style Selector="ItemsControl.rows Grid">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom" Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnClose"/>

        <!-- Inputs above outputs, as the vendor stacks them; the output group is the taller of the two because a
             direction's data-line count is its own (8 input lines, 16 output). -->
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <HeaderedContentControl Grid.Row="0" Classes="group" Header="Input modules">
                <Grid RowDefinitions="Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="70,*,170,*">
                        <TextBlock Grid.Column="0" Classes="colhead" Text="Data line"/>
                        <TextBlock Grid.Column="1" Classes="colhead" Text="Module type"/>
                        <TextBlock Grid.Column="2" Classes="colhead" Text="Locality"/>
                        <TextBlock Grid.Column="3" Classes="colhead" Text="Description"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="212">
                        <ItemsControl Name="InputModulesList" Classes="rows" ItemsSource="{Binding InputModules}"
                                      a:AutomationProperties.Name="Input modules">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vis:DatalineModule">
                                    <Grid ColumnDefinitions="70,*,170,*">
                                        <TextBlock Grid.Column="0" Classes="cell" Text="{Binding DataLine}"/>
                                        <TextBlock Grid.Column="1" Classes="cell" Text="{Binding ModuleType}"
                                                   IsVisible="{Binding InUse}"/>
                                        <TextBlock Grid.Column="1" Classes="cell" Text="&lt;not in use&gt;"
                                                   IsVisible="{Binding !InUse}"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                        <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Location}"/>
                                        <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Description}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="1" Classes="group" Header="Output modules" VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="70,*,170,*">
                        <TextBlock Grid.Column="0" Classes="colhead" Text="Data line"/>
                        <TextBlock Grid.Column="1" Classes="colhead" Text="Module type"/>
                        <TextBlock Grid.Column="2" Classes="colhead" Text="Locality"/>
                        <TextBlock Grid.Column="3" Classes="colhead" Text="Description"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl Name="OutputModulesList" Classes="rows" ItemsSource="{Binding OutputModules}"
                                      a:AutomationProperties.Name="Output modules">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vis:DatalineModule">
                                    <Grid ColumnDefinitions="70,*,170,*">
                                        <TextBlock Grid.Column="0" Classes="cell" Text="{Binding DataLine}"/>
                                        <TextBlock Grid.Column="1" Classes="cell" Text="{Binding ModuleType}"
                                                   IsVisible="{Binding InUse}"/>
                                        <TextBlock Grid.Column="1" Classes="cell" Text="&lt;not in use&gt;"
                                                   IsVisible="{Binding !InUse}"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                                        <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Location}"/>
                                        <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Description}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </HeaderedContentControl>
        </Grid>
    </DockPanel>
</Window>
