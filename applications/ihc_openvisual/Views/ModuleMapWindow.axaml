<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vis="clr-namespace:Ihc.Vis;assembly=ihcclient"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        xmlns:controls="using:ihc_openvisual.Controls"
        xmlns:conv="using:ihc_openvisual.Converters"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
        x:Class="ihc_openvisual.Views.ModuleMapWindow"
        a:AutomationProperties.AutomationId="ModuleMapWindow"
        x:DataType="vis:DatalineModuleMap"
        Title="Datalinie moduler"
        Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- ONE row template for both directions: the input and output tables differ only in the id prefix each
             row publishes, which the per-list style below supplies. Written twice, the seven accessibility
             attributes that make a row readable had to be kept in step by hand, and a miss shows up only as a
             screen-reader/driver defect. -->
        <DataTemplate x:Key="ModuleRow" x:DataType="vis:DatalineModule">
            <!-- One ROW = one automation element (USE-01): the cells are Raw so a client reads the row's
                 summarized name once instead of four loose text runs with no structure between them. -->
            <controls:AccessibleDataRow ColumnDefinitions="70,*,170,*"
                    a:AutomationProperties.Name="{Binding ., Converter={x:Static conv:DatalineModuleSummaryConverter.Instance}}">
                <TextBlock Grid.Column="0" Classes="cell" Text="{Binding DataLine}"
                           a:AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding ModuleType}"
                           IsVisible="{Binding InUse}"
                           a:AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="1" Classes="cell" Text="&lt;ikke i brug&gt;"
                           IsVisible="{Binding !InUse}"
                           a:AutomationProperties.AccessibilityView="Raw"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Location}"
                           a:AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Description}"
                           a:AutomationProperties.AccessibilityView="Raw"/>
            </controls:AccessibleDataRow>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- The captioned group box the project-info dialog uses; Avalonia has no GroupBox. A Grid, NOT a
             StackPanel: a StackPanel measures its child with INFINITE height, so the output group's ScrollViewer
             never overflowed — it reported nothing to scroll and the window clipped data lines 13-16 away
             instead. The '*' row passes the group's own height constraint down to the list. -->
        <Style Selector="HeaderedContentControl.group">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="{TemplateBinding Header}" FontWeight="SemiBold"
                                   Margin="2,0,0,4"/>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TextBlock.colhead">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,0,6,4"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- Read-only rows: an ItemsControl, not a ListBox, so there is no selection or focus affordance to
             suggest the grid is interactive. -->
        <!-- :is(Grid), not Grid: a bare type selector matches the EXACT type, and the rows are AccessibleDataRow
             (a Grid subclass carrying the row's automation peer) — so the plain selector would silently stop
             spacing them. -->
        <Style Selector="ItemsControl.rows :is(Grid)">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <!-- The one thing a row does NOT share between the two tables: which direction's data line it is. Kept
             here rather than in the template so the template itself stays direction-agnostic. -->
        <Style Selector="ItemsControl#InputModulesList controls|AccessibleDataRow" x:DataType="vis:DatalineModule">
            <Setter Property="a:AutomationProperties.AutomationId"
                    Value="{Binding DataLine, StringFormat=inputModule.{0}}"/>
        </Style>
        <Style Selector="ItemsControl#OutputModulesList controls|AccessibleDataRow" x:DataType="vis:DatalineModule">
            <Setter Property="a:AutomationProperties.AutomationId"
                    Value="{Binding DataLine, StringFormat=outputModule.{0}}"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom" Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnClose"/>

        <!-- Inputs above outputs, as the vendor stacks them; the output group is the taller of the two because a
             direction's data-line count is its own (8 input lines, 16 output). -->
        <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <HeaderedContentControl Grid.Row="0" Classes="group" Header="Indgangsmoduler">
                <Grid RowDefinitions="Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="70,*,170,*">
                        <TextBlock Grid.Column="0" Classes="colhead" Text="Datalinie"/>
                        <TextBlock Grid.Column="1" Classes="colhead" Text="Modul type"/>
                        <TextBlock Grid.Column="2" Classes="colhead" Text="Lokalitet"/>
                        <TextBlock Grid.Column="3" Classes="colhead" Text="Beskrivelse"/>
                    </Grid>
                    <!-- A standing scrollbar, as the vendor's list controls carry: Avalonia's auto-hiding overlay
                         renders a list that continues below the fold exactly like one that ends there. -->
                    <ScrollViewer Grid.Row="1" MaxHeight="212" AllowAutoHide="False"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="InputModulesList" Classes="rows" ItemsSource="{Binding InputModules}"
                                      ItemTemplate="{StaticResource ModuleRow}"
                                      a:AutomationProperties.Name="Indgangsmoduler"/>
                    </ScrollViewer>
                </Grid>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Row="1" Classes="group" Header="Udgangsmoduler" VerticalAlignment="Stretch">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="70,*,170,*">
                        <TextBlock Grid.Column="0" Classes="colhead" Text="Datalinie"/>
                        <TextBlock Grid.Column="1" Classes="colhead" Text="Modul type"/>
                        <TextBlock Grid.Column="2" Classes="colhead" Text="Lokalitet"/>
                        <TextBlock Grid.Column="3" Classes="colhead" Text="Beskrivelse"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" AllowAutoHide="False" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="OutputModulesList" Classes="rows" ItemsSource="{Binding OutputModules}"
                                      ItemTemplate="{StaticResource ModuleRow}"
                                      a:AutomationProperties.Name="Udgangsmoduler"/>
                    </ScrollViewer>
                </Grid>
            </HeaderedContentControl>
        </Grid>
    </DockPanel>
</Window>
