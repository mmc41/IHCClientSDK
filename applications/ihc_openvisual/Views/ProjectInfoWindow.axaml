<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="560"
        x:Class="ihc_openvisual.Views.ProjectInfoWindow"
        Title="Project information"
        Width="440" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
            <Button Name="CancelButton" Content="Cancel" MinWidth="84" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
        <ScrollViewer>
            <StackPanel Spacing="4">
                <StackPanel.Styles>
                    <Style Selector="TextBlock.section">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Margin" Value="0,10,0,2"/>
                    </Style>
                    <Style Selector="TextBlock.label">
                        <Setter Property="Margin" Value="0,4,0,0"/>
                    </Style>
                </StackPanel.Styles>

                <TextBlock Classes="section" Text="Project"/>
                <TextBlock Name="ProjDescriptionLabel" Classes="label" Text="Description"/>
                <TextBox Name="ProjDescriptionBox" a:AutomationProperties.LabeledBy="{Binding #ProjDescriptionLabel}"/>
                <TextBlock Name="ProjNumberLabel" Classes="label" Text="Number"/>
                <TextBox Name="ProjNumberBox" a:AutomationProperties.LabeledBy="{Binding #ProjNumberLabel}"/>
                <TextBlock Name="ProjProgrammerLabel" Classes="label" Text="Programmer"/>
                <TextBox Name="ProjProgrammerBox" a:AutomationProperties.LabeledBy="{Binding #ProjProgrammerLabel}"/>

                <TextBlock Classes="section" Text="Customer"/>
                <TextBlock Name="CustNameLabel" Classes="label" Text="Name"/>
                <TextBox Name="CustNameBox" a:AutomationProperties.LabeledBy="{Binding #CustNameLabel}"/>
                <TextBlock Name="CustAddressLabel" Classes="label" Text="Address"/>
                <TextBox Name="CustAddressBox" a:AutomationProperties.LabeledBy="{Binding #CustAddressLabel}"/>
                <TextBlock Name="CustCityLabel" Classes="label" Text="City"/>
                <TextBox Name="CustCityBox" a:AutomationProperties.LabeledBy="{Binding #CustCityLabel}"/>
                <TextBlock Name="CustZipLabel" Classes="label" Text="Zip code"/>
                <TextBox Name="CustZipBox" a:AutomationProperties.LabeledBy="{Binding #CustZipLabel}"/>
                <TextBlock Name="CustCountryLabel" Classes="label" Text="Country"/>
                <TextBox Name="CustCountryBox" a:AutomationProperties.LabeledBy="{Binding #CustCountryLabel}"/>
                <TextBlock Name="CustPhoneLabel" Classes="label" Text="Phone"/>
                <TextBox Name="CustPhoneBox" a:AutomationProperties.LabeledBy="{Binding #CustPhoneLabel}"/>
                <TextBlock Name="CustMobileLabel" Classes="label" Text="Mobile"/>
                <TextBox Name="CustMobileBox" a:AutomationProperties.LabeledBy="{Binding #CustMobileLabel}"/>
                <TextBlock Name="CustEmailLabel" Classes="label" Text="Email"/>
                <TextBox Name="CustEmailBox" a:AutomationProperties.LabeledBy="{Binding #CustEmailLabel}"/>

                <TextBlock Classes="section" Text="Installer"/>
                <TextBlock Name="InstNameLabel" Classes="label" Text="Name"/>
                <TextBox Name="InstNameBox" a:AutomationProperties.LabeledBy="{Binding #InstNameLabel}"/>
                <TextBlock Name="InstAddressLabel" Classes="label" Text="Address"/>
                <TextBox Name="InstAddressBox" a:AutomationProperties.LabeledBy="{Binding #InstAddressLabel}"/>
                <TextBlock Name="InstCityLabel" Classes="label" Text="City"/>
                <TextBox Name="InstCityBox" a:AutomationProperties.LabeledBy="{Binding #InstCityLabel}"/>
                <TextBlock Name="InstZipLabel" Classes="label" Text="Zip code"/>
                <TextBox Name="InstZipBox" a:AutomationProperties.LabeledBy="{Binding #InstZipLabel}"/>
                <TextBlock Name="InstCountryLabel" Classes="label" Text="Country"/>
                <TextBox Name="InstCountryBox" a:AutomationProperties.LabeledBy="{Binding #InstCountryLabel}"/>
                <TextBlock Name="InstPhoneLabel" Classes="label" Text="Phone"/>
                <TextBox Name="InstPhoneBox" a:AutomationProperties.LabeledBy="{Binding #InstPhoneLabel}"/>
                <TextBlock Name="InstMobileLabel" Classes="label" Text="Mobile"/>
                <TextBox Name="InstMobileBox" a:AutomationProperties.LabeledBy="{Binding #InstMobileLabel}"/>
                <TextBlock Name="InstEmailLabel" Classes="label" Text="Email"/>
                <TextBox Name="InstEmailBox" a:AutomationProperties.LabeledBy="{Binding #InstEmailLabel}"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
