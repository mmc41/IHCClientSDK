<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        xmlns:controls="using:ihc_openvisual.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="520"
        x:Class="ihc_openvisual.Views.ProjectInfoWindow"
        a:AutomationProperties.AutomationId="ProjectInfoWindow"
        Title="Rediger projekt oplysninger"
        Width="800" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ShowInTaskbar="False">
    <Window.Styles>
        <!-- A captioned group box: the three sections IHC Visual draws (uxparity S-32). Avalonia has no GroupBox,
             so a HeaderedContentControl carries the caption and a bordered panel the fields. -->
        <Style Selector="controls|AccessibleGroupBox.group">
            <!-- F-38: the caption below lives in the TEMPLATE, and a templated TextBlock never reaches the
                 automation tree — so all three captions rendered on screen and NONE appeared in the control
                 inventory. AccessibleGroupBox's peer publishes the Header as the group's name, which is why the
                 type is used here rather than a plain HeaderedContentControl: the caption cannot be forgotten
                 per instance, and the installer and customer blocks carry the SAME eight field labels, so it is
                 the only thing saying which party a field belongs to. -->
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" Margin="2,0,0,4"/>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12,10">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- One field = its caption above its box, so a two-column grid of these reads row-major like the vendor's. -->
        <Style Selector="StackPanel.field">
            <Setter Property="Margin" Value="0,0,10,8"/>
        </Style>
        <Style Selector="StackPanel.field > TextBlock">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
            <Button Name="CancelButton" Content="Annuller" MinWidth="84" IsCancel="True" Click="OnCancel"/>
        </StackPanel>

        <!-- Project across the top; the two contact groups side by side beneath it, installer first — the vendor's
             arrangement. Everything fits without scrolling at the dialog's default size. -->
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
            <controls:AccessibleGroupBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Classes="group" Header="Projekt oplysninger">
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <!-- Field order follows the vendor's reading order (Number, Type, Programmer, Drawing,
                         Description) so the two dialogs present the same sequence — uxparity S-32. -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Name="ProjNumberLabel" Text="Projektnummer:" Margin="0,0,10,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Name="ProjTypeLabel" Text="Projekt type:" Margin="0,0,10,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Name="ProjProgrammerLabel" Text="Programmør:" Margin="0,0,10,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Name="ProjDrawingLabel" Text="Tegning:" Margin="0,0,0,2"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Name="ProjNumberBox" Margin="0,0,10,0"
                             a:AutomationProperties.LabeledBy="{Binding #ProjNumberLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Name="ProjTypeBox" Margin="0,0,10,0"
                             a:AutomationProperties.LabeledBy="{Binding #ProjTypeLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Name="ProjProgrammerBox" Margin="0,0,10,0"
                             a:AutomationProperties.LabeledBy="{Binding #ProjProgrammerLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Name="ProjDrawingBox"
                             a:AutomationProperties.LabeledBy="{Binding #ProjDrawingLabel}"/>
                    <!-- No trailing colon: alone among this dialog's captions, the vendor's reads "Beskrivelse". -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Name="ProjDescriptionLabel"
                               Text="Beskrivelse" Margin="0,8,0,2"/>
                    <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Name="ProjDescriptionBox"
                             a:AutomationProperties.LabeledBy="{Binding #ProjDescriptionLabel}"/>
                </Grid>
            </controls:AccessibleGroupBox>

            <!-- Both contact groups are a two-column grid: Name|Street, Phone|Postal code, Mobile|City,
                 Email|Country — the vendor's cell order, so the fields read in the same sequence in both apps. -->
            <controls:AccessibleGroupBox Grid.Row="1" Grid.Column="0" Classes="group" Header="Installatør information"
                                    VerticalAlignment="Top">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Classes="field">
                        <TextBlock Name="InstNameLabel" Text="Navn:"/>
                        <AutoCompleteBox Name="InstNameBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #InstNameLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Classes="field" Margin="0,0,0,8">
                        <TextBlock Name="InstAddressLabel" Text="Vej:"/>
                        <AutoCompleteBox Name="InstAddressBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #InstAddressLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Classes="field">
                        <TextBlock Name="InstPhoneLabel" Text="Telefon:"/>
                        <AutoCompleteBox Name="InstPhoneBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #InstPhoneLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Classes="field" Margin="0,0,0,8">
                        <TextBlock Name="InstZipLabel" Text="Postnummer:"/>
                        <AutoCompleteBox Name="InstZipBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #InstZipLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Classes="field">
                        <TextBlock Name="InstMobileLabel" Text="Mobil telefon:"/>
                        <AutoCompleteBox Name="InstMobileBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #InstMobileLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Classes="field" Margin="0,0,0,8">
                        <TextBlock Name="InstCityLabel" Text="By:"/>
                        <AutoCompleteBox Name="InstCityBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #InstCityLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Classes="field" Margin="0,0,10,0">
                        <TextBlock Name="InstEmailLabel" Text="Email:"/>
                        <AutoCompleteBox Name="InstEmailBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #InstEmailLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Classes="field" Margin="0">
                        <TextBlock Name="InstCountryLabel" Text="Land:"/>
                        <AutoCompleteBox Name="InstCountryBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #InstCountryLabel}"/>
                    </StackPanel>
                </Grid>
            </controls:AccessibleGroupBox>

            <controls:AccessibleGroupBox Grid.Row="1" Grid.Column="1" Classes="group" Header="Kunde oplysninger"
                                    VerticalAlignment="Top">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Classes="field">
                        <TextBlock Name="CustNameLabel" Text="Navn:"/>
                        <AutoCompleteBox Name="CustNameBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #CustNameLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Classes="field" Margin="0,0,0,8">
                        <TextBlock Name="CustAddressLabel" Text="Vej:"/>
                        <AutoCompleteBox Name="CustAddressBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #CustAddressLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Classes="field">
                        <TextBlock Name="CustPhoneLabel" Text="Telefon:"/>
                        <AutoCompleteBox Name="CustPhoneBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #CustPhoneLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Classes="field" Margin="0,0,0,8">
                        <TextBlock Name="CustZipLabel" Text="Postnummer:"/>
                        <AutoCompleteBox Name="CustZipBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #CustZipLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Classes="field">
                        <TextBlock Name="CustMobileLabel" Text="Mobil telefon:"/>
                        <AutoCompleteBox Name="CustMobileBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #CustMobileLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Classes="field" Margin="0,0,0,8">
                        <TextBlock Name="CustCityLabel" Text="By:"/>
                        <AutoCompleteBox Name="CustCityBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #CustCityLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Classes="field" Margin="0,0,10,0">
                        <TextBlock Name="CustEmailLabel" Text="Email:"/>
                        <AutoCompleteBox Name="CustEmailBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #CustEmailLabel}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Classes="field" Margin="0">
                        <TextBlock Name="CustCountryLabel" Text="Land:"/>
                        <AutoCompleteBox Name="CustCountryBox" MinimumPrefixLength="0" FilterMode="Contains"
                                         a:AutomationProperties.LabeledBy="{Binding #CustCountryLabel}"/>
                    </StackPanel>
                </Grid>
            </controls:AccessibleGroupBox>
        </Grid>
    </DockPanel>
</Window>
