<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
        x:Class="ihc_openvisual.Views.PropertiesWindow"
        a:AutomationProperties.AutomationId="PropertiesWindow"
        Title="Rediger egenskaber"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="8">
        <!-- F-24: the vendor's function-block dialog captions the editable pair "Bruger egenskaber", matching the
             provenance group below it; its other properties dialogs caption nothing here, so the CALLER supplies
             this rather than the window assuming one. -->
        <TextBlock Name="UserGroupCaption" IsVisible="False" FontWeight="SemiBold"/>
        <TextBlock Name="NameLabel" Text="Navn" FontWeight="SemiBold"/>
        <TextBox Name="NameBox" a:AutomationProperties.LabeledBy="{Binding #NameLabel}"/>

        <TextBlock Name="NoteLabel" Text="Note" FontWeight="SemiBold" Margin="0,6,0,0"/>
        <TextBox Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap"
                 Height="110" VerticalContentAlignment="Top"
                 a:AutomationProperties.LabeledBy="{Binding #NoteLabel}"/>

        <!-- A Betingelser group also carries the operator its conditions combine with. The reference application
             shows it in this very dialog, as a captioned "Logisk betingelse" group holding an AND/OR combo
             (measured 2026-08-11, alignment F-48) — the caption is its own word, kept verbatim. Hidden for every
             other node type, none of which has such a field. -->
        <StackPanel Name="LogicPanel" IsVisible="False" Spacing="4" Margin="0,10,0,0">
            <TextBlock Name="LogicLabel" Text="Logisk betingelse" FontWeight="SemiBold"/>
            <ComboBox Name="LogicBox" Width="120" HorizontalAlignment="Left"
                      a:AutomationProperties.LabeledBy="{Binding #LogicLabel}"/>
        </StackPanel>

        <!-- A LIBRARY function block also shows where it came from, read-only (uxparity S-19: the vendor's
             "Oprindelige egenskaber"). Hidden for everything else, which has no master to report. -->
        <StackPanel Name="OriginPanel" IsVisible="False" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="Oprindelige egenskaber" FontWeight="SemiBold"/>

            <TextBlock Name="OriginNameLabel" Text="Navn"/>
            <TextBox Name="OriginNameBox" IsEnabled="False"
                     a:AutomationProperties.LabeledBy="{Binding #OriginNameLabel}"/>

            <Grid ColumnDefinitions="*,8,*,8,*">
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Name="OriginNumberLabel" Text="Nummer"/>
                    <TextBox Name="OriginNumberBox" IsEnabled="False"
                             a:AutomationProperties.LabeledBy="{Binding #OriginNumberLabel}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Name="OriginVersionLabel" Text="Version"/>
                    <TextBox Name="OriginVersionBox" IsEnabled="False"
                             a:AutomationProperties.LabeledBy="{Binding #OriginVersionLabel}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="8">
                    <TextBlock Name="OriginCreatedLabel" Text="Oprettet"/>
                    <TextBox Name="OriginCreatedBox" IsEnabled="False"
                             a:AutomationProperties.LabeledBy="{Binding #OriginCreatedLabel}"/>
                </StackPanel>
            </Grid>

            <TextBlock Name="OriginDeveloperLabel" Text="Udviklet af"/>
            <TextBox Name="OriginDeveloperBox" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="56" VerticalContentAlignment="Top"
                     a:AutomationProperties.LabeledBy="{Binding #OriginDeveloperLabel}"/>

            <!-- "ovennævnte", the reference application's own word (static 521, measured 2026-08-11 on a locked
                 1.1.01.e. Kip tænd sluk) — not "ovenstående", which means the same and is not what it says
                 (alignment F-25). Named so the line is addressable to a test and to an automation client. -->
            <TextBlock Name="OriginContactLabel" Text="Kontakt ovennævnte i tilfælde af problemer"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
            <Button Name="CancelButton" Content="Annuller" MinWidth="84" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
