<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="using:Avalonia.Automation"
        xmlns:controls="using:ihc_openvisual.Controls"
        x:Class="ihc_openvisual.Views.EnumTypeManagerWindow"
        a:AutomationProperties.AutomationId="EnumTypeManagerWindow"
        Width="720" Height="440" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Title="Enumerator typer og værdier">
    <Window.Styles>
        <!-- The vendor frames each pane in a group box whose caption sits on the frame. HeaderedContentControl
             renders no chrome of its own, so the frame is supplied here — once, for both panes. -->
        <Style Selector="HeaderedContentControl.group">
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel LastChildFill="True">
                        <!-- Trimmed, not clipped: the values caption carries the selected type's name, which can be
                             longer than the pane ("Enumerator værdier - Persienne tilstand [read only]"). -->
                        <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                                   TextTrimming="CharacterEllipsis" Margin="4,0,4,4"
                                   ToolTip.Tip="{TemplateBinding Header}"/>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <DockPanel Margin="16" LastChildFill="True">

        <!-- One OK, no Cancel — the vendor's dialog applies each button as it is pressed, so by the time you get
             here there is nothing left to cancel. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" IsCancel="True" Click="OnClose"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,12,*">

            <!-- Types pane -->
            <controls:AccessibleGroupBox Grid.Column="0" Classes="group" Header="Enumerator type">
                <DockPanel Margin="8" LastChildFill="True">
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                        <Button Name="NewTypeButton" Content="Ny" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Margin="0,0,4,0" Click="OnNewType"/>
                        <Button Name="DeleteTypeButton" Content="Slet" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Margin="2,0,2,0" Click="OnDeleteType"/>
                        <Button Name="RenameTypeButton" Content="Omdøb" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Margin="4,0,0,0" Click="OnRenameType"/>
                    </UniformGrid>
                    <ListBox Name="TypesList"
                             a:AutomationProperties.Name="Enumerator type"
                             SelectionChanged="OnTypeSelectionChanged"/>
                </DockPanel>
            </controls:AccessibleGroupBox>

            <!-- Values pane. Its caption carries the selected type's name, as the vendor's does
                 ("Enumerator værdier - Dimmer status"). -->
            <controls:AccessibleGroupBox Grid.Column="2" Classes="group" Name="ValuesGroup" Header="Enumerator værdier">
                <DockPanel Margin="8" LastChildFill="True">
                    <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="0,8,0,0">
                        <Button Name="NewValueButton" Content="Ny" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Margin="0,0,4,0" Click="OnNewValue"/>
                        <Button Name="DeleteValueButton" Content="Slet" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Margin="2,0,2,0" Click="OnDeleteValue"/>
                        <Button Name="RenameValueButton" Content="Omdøb" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Margin="4,0,0,0" Click="OnRenameValue"/>
                    </UniformGrid>
                    <ListBox Name="ValuesList"
                             a:AutomationProperties.Name="Enumerator værdier"
                             SelectionChanged="OnValueSelectionChanged"/>
                </DockPanel>
            </controls:AccessibleGroupBox>
        </Grid>
    </DockPanel>
</Window>
