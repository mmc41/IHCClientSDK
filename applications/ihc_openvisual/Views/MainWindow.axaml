<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ihc_openvisual.ViewModels"
        xmlns:svc="using:ihc_openvisual.Services"
        xmlns:conv="using:ihc_openvisual.Converters"
        xmlns:controls="using:ihc_openvisual.Controls"
        xmlns:a="using:Avalonia.Automation"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="ihc_openvisual.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/openvisual.ico"
        Width="1000" Height="680"
        Title="{Binding Title}">

    <!-- D06 (owner ruling 2026-08-02): a shortcut follows the MENU BAR's availability, not the row's bare gate —
         so Ctrl+X refuses on a locked block, whose Cut the bar greys while the context flyout still offers it
         (D13). That is why these bind Registry.GestureCommands[<row id>] and not the CutCommand-style bridges:
         a KeyBinding never invokes a DISABLED command, and Avalonia services a TopLevel's KeyBindings before any
         instance KeyDown handler (tunnel included), so no handler could veto one after the fact. A row the bar
         never shows (Ctrl+I/Ctrl+U, and the context-menu-only rows) is judged by its own gate. The window's
         OnWindowKeyDownGateGestures then explains whatever did not fire. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding Registry.GestureCommands[file.new]}"/>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding Registry.GestureCommands[file.open]}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding Registry.GestureCommands[file.save]}"/>
        <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding Registry.GestureCommands[insert.emptyFunctionBlock]}"/>
        <KeyBinding Gesture="Ctrl+G" Command="{Binding Registry.GestureCommands[node.saveBlock]}"/>
        <KeyBinding Gesture="F3" Command="{Binding Registry.GestureCommands[view.showProgram]}"/>
        <KeyBinding Gesture="Escape" Command="{Binding Registry.GestureCommands[program.leaveMode]}"/>
        <KeyBinding Gesture="F5" Command="{Binding Registry.GestureCommands[controller.send]}"/>
        <KeyBinding Gesture="F1" Command="{Binding Registry.GestureCommands[help.onNode]}"/>
        <KeyBinding Gesture="Ctrl+I" Command="{Binding Registry.GestureCommands[program.insertInput]}"/>
        <KeyBinding Gesture="Ctrl+U" Command="{Binding Registry.GestureCommands[program.insertOutput]}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding Registry.GestureCommands[edit.undo]}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding Registry.GestureCommands[edit.redo]}"/>
        <KeyBinding Gesture="Ctrl+X" Command="{Binding Registry.GestureCommands[edit.cut]}"/>
        <KeyBinding Gesture="Ctrl+C" Command="{Binding Registry.GestureCommands[edit.copy]}"/>
        <KeyBinding Gesture="Ctrl+V" Command="{Binding Registry.GestureCommands[edit.paste]}"/>
        <KeyBinding Gesture="Ctrl+Shift+Up" Command="{Binding Registry.GestureCommands[edit.moveUp]}"/>
        <KeyBinding Gesture="Ctrl+Shift+Down" Command="{Binding Registry.GestureCommands[edit.moveDown]}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <!-- Recursive theme for the catalog product-insertion menu: each generated MenuItem takes its Header,
             child items and insert command from its ProductMenuItemViewModel, and reuses this same theme for its
             own children (self-reference via DynamicResource) so arbitrarily deep category trees render (US-010). -->
        <ControlTheme x:Key="ProductMenuItemTheme" TargetType="MenuItem" x:DataType="vm:ProductMenuItemViewModel"
                      BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}"/>
            <Setter Property="ItemsSource" Value="{Binding Children}"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="ItemContainerTheme" Value="{DynamicResource ProductMenuItemTheme}"/>
        </ControlTheme>

        <!-- The tree-node context menu, shared by both panes (a Flyout can be shared as a resource; a ContextMenu
             control cannot). Every item self-gates on the active SelectedNode, so the same menu suits either pane;
             "Insert product" is the one pane-specific item (products belong to the Installation pane, gated on
             CanInsertProduct). -->
        <MenuFlyout x:Key="NodeContextMenu" x:DataType="vm:MainWindowViewModel">
            <MenuItem Header="Insert _locality" Command="{Binding InsertLocalityCommand}"
                      IsVisible="{Binding Registry.ContextMenu[insert.locality].Visible, FallbackValue=False}"/>
            <!-- Product category folders are data-driven (H2/D08) — see CatalogMenu.BuildProductForest. -->
            <MenuItem Header="Insert _product" ItemsSource="{Binding ProductsMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanInsertProduct, FallbackValue=False}"/>
            <MenuItem Header="Insert _function block" ItemsSource="{Binding FunctionBlocksMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanInsertFunctionBlock, FallbackValue=False}"/>
            <MenuItem Header="_Empty function block" Command="{Binding InsertEmptyFunctionBlockCommand}"
                      InputGesture="Ctrl+Shift+B"
                      IsVisible="{Binding Registry.ContextMenu[insert.emptyFunctionBlock].Visible, FallbackValue=False}"/>
            <MenuItem Header="Insert _variable" ItemsSource="{Binding VariablePaletteMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanInsertVariable, FallbackValue=False}"/>
            <MenuItem Header="Link _from here" Command="{Binding StartLinkCommand}"
                      IsVisible="{Binding Registry.ContextMenu[link.startFromHere].Visible, FallbackValue=False}"/>
            <MenuItem Header="Link _to here" Command="{Binding LinkToHereCommand}"
                      IsVisible="{Binding Registry.ContextMenu[link.toHere].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Use in program" Command="{Binding UseInProgramCommand}"
                      IsVisible="{Binding Registry.ContextMenu[node.useInProgram].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Log mark" Command="{Binding ToggleLogMarkCommand}"
                      IsVisible="{Binding Registry.ContextMenu[node.toggleLogMark].Visible, FallbackValue=False}"/>
            <MenuItem Header="Save current _value" Command="{Binding ToggleSaveValueCommand}"
                      ToggleType="CheckBox" IsChecked="{Binding SelectedNode.IsValueSaved, Mode=OneWay, FallbackValue=False}"
                      IsVisible="{Binding Registry.ContextMenu[program.toggleSaveValue].Visible, FallbackValue=False}"/>
            <MenuItem Header="Add _event" ItemsSource="{Binding ProgramEventMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddEvent, FallbackValue=False}"/>
            <MenuItem Header="Add _Powerup event" Command="{Binding AddPowerEventCommand}"
                      IsVisible="{Binding Registry.ContextMenu[program.addPowerEvent].Visible, FallbackValue=False}"/>
            <MenuItem Header="Add _command" ItemsSource="{Binding ProgramCommandMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddCommand, FallbackValue=False}"/>
            <MenuItem Header="_Sub-program" Command="{Binding AddSubProgramCommand}"
                      IsVisible="{Binding Registry.ContextMenu[program.addSubProgram].Visible, FallbackValue=False}"/>
            <MenuItem Header="C_ase" ItemsSource="{Binding ProgramCaseMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddCommand, FallbackValue=False}"/>
            <MenuItem Header="Arith_metic" ItemsSource="{Binding ProgramArithmeticMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddCommand, FallbackValue=False}"/>
            <MenuItem Header="New case _value…" Command="{Binding NewCaseValueCommand}"
                      IsVisible="{Binding Registry.ContextMenu[program.newCaseValue].Visible, FallbackValue=False}"/>
            <MenuItem Header="Add co_ndition" ItemsSource="{Binding ProgramConditionMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddCondition, FallbackValue=False}"/>
            <MenuItem Header="Logic _group" Command="{Binding AddLogicGroupCommand}"
                      IsVisible="{Binding Registry.ContextMenu[program.addLogicGroup].Visible, FallbackValue=False}"/>
            <MenuItem Header="Logical condition"
                      IsVisible="{Binding CanAddCondition, FallbackValue=False}">
                <MenuItem Header="AND (_&amp;)" Command="{Binding SetConditionsAndCommand}"/>
                <MenuItem Header="OR (_&gt;=1)" Command="{Binding SetConditionsOrCommand}"/>
            </MenuItem>
            <MenuItem Header="_Save block…" Command="{Binding SaveFunctionBlockCommand}"
                      InputGesture="Ctrl+G"
                      IsVisible="{Binding Registry.ContextMenu[node.saveBlock].Visible, FallbackValue=False}"/>
            <MenuItem Header="Cu_t" Command="{Binding CutCommand}"
                      InputGesture="Ctrl+X"
                      IsVisible="{Binding Registry.ContextMenu[edit.cut].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Copy" Command="{Binding CopyCommand}"
                      InputGesture="Ctrl+C"
                      IsVisible="{Binding Registry.ContextMenu[edit.copy].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Unlock" Command="{Binding UnlockCommand}"
                      IsVisible="{Binding Registry.ContextMenu[node.unlock].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Paste" Command="{Binding PasteCommand}"
                      InputGesture="Ctrl+V"
                      IsVisible="{Binding Registry.ContextMenu[edit.paste].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Jump to opposite link" Command="{Binding NavigateLinkOppositeCommand}"
                      InputGesture="F4"
                      IsVisible="{Binding Registry.ContextMenu[link.jumpOpposite].Visible, FallbackValue=False}"/>
            <MenuItem Header="Move _up" Command="{Binding MoveUpCommand}"
                      IsVisible="{Binding Registry.ContextMenu[edit.moveUp].Visible, FallbackValue=False}"/>
            <MenuItem Header="Move dow_n" Command="{Binding MoveDownCommand}"
                      IsVisible="{Binding Registry.ContextMenu[edit.moveDown].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Delete" Command="{Binding DeleteCommand}"
                      IsVisible="{Binding Registry.ContextMenu[edit.delete].Visible, FallbackValue=False}"/>
            <!-- Offered on a block AND on its pins: the vendor lets you jump from a pin to the program that uses
                 it (uxparity S-28). The registry row's gate resolves the owning block for either. -->
            <MenuItem Header="Show _program" Command="{Binding EnterProgrammingModeCommand}"
                      InputGesture="F3"
                      IsVisible="{Binding Registry.ContextMenu[view.showProgram].Visible, FallbackValue=False}"/>
            <MenuItem Header="P_roperties" Command="{Binding PropertiesCommand}"
                      IsVisible="{Binding Registry.ContextMenu[node.properties].Visible, FallbackValue=False}"/>
        </MenuFlyout>

        <!-- The tree-row container theme + row template, shared by both panes (they were byte-identical). The
             theme carries the container behaviour (TwoWay IsExpanded so an expander click reaches the VM for the
             US-070 snapshot/restore) and the UIA name/kind; the template renders icon + label + the US-014
             unlinked "!" marker. Both panes reference these instead of repeating the blocks inline. -->
        <ControlTheme x:Key="TreeNodeItemTheme" TargetType="TreeViewItem" x:DataType="vm:TreeNodeViewModel"
                      BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <!-- TwoWay so a user's expander click reaches the view-model, which snapshots and restores expansion
                 across every edit's tree rebuild (US-070). -->
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- Publish the row's accessible name on the container itself so a UIA client reading TreeItem.Name gets
                 the label directly (not blank, with the name on an inner peer). -->
            <Setter Property="a:AutomationProperties.Name" Value="{Binding AccessibleName}"/>
            <!-- Publish the row's KIND for automation. AutomationId is never rendered and is not announced as
                 content, so this is invisible to a user — unlike HelpText, which is already the tooltip the user
                 sees. It exists because a row's LABEL is user data and cannot identify it (see
                 TreeNodeViewModel.NodeKind). -->
            <Setter Property="a:AutomationProperties.AutomationId" Value="{Binding NodeKind}"/>
        </ControlTheme>

        <TreeDataTemplate x:Key="TreeNodeTemplate" x:DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
            <!-- DoubleTapped is handled HERE, on the row's own content, and not on the TreeView: the event only
                 bubbles, and TreeViewItem toggles expansion from a handler on its header presenter — this
                 StackPanel's ancestor. Handling it here is therefore the last point that still runs BEFORE the
                 toggle (US-044, F-006/F-007). -->
            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Tooltip}"
                        DoubleTapped="OnNodeDoubleTapped"
                        Background="{Binding IsDropTarget, Converter={x:Static conv:BoolToBrushConverter.DropTarget}}"
                        a:AutomationProperties.Name="{Binding AccessibleName}"
                        a:AutomationProperties.HelpText="{Binding Tooltip}">
                <svg:Svg Width="16" Height="16" Path="{Binding IconAsset}" CurrentColor="{DynamicResource IconColor}"
                         a:AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                           FontWeight="{Binding IsBold, Converter={x:Static conv:BoolToFontWeightConverter.Instance}}"/>
                <!-- Unlinked wireless product marker (US-014) -->
                <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding IsUnlinked}"
                           ToolTip.Tip="Not yet linked to the controller"/>
            </StackPanel>
        </TreeDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ============ Menu bar: the stable title hosts ============ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File" a:AutomationProperties.AutomationId="MenuFile">
                <MenuItem Header="_New project" Command="{Binding NewCommand}" InputGesture="Ctrl+N"/>
                <MenuItem Header="_Open project…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save project" Command="{Binding SaveCommand}" InputGesture="Ctrl+S"/>
                <MenuItem Header="Save project _as…" Command="{Binding SaveAsCommand}"
                          IsEnabled="{Binding Registry.Bar[file.saveAs].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[file.saveAs].Reason}"/>
                <Separator/>
                <MenuItem Header="_Close project" Command="{Binding CloseCommand}"
                          IsEnabled="{Binding Registry.Bar[file.close].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[file.close].Reason}"/>
                <Separator/>
                <MenuItem Name="RecentProjectsMenu" Header="Recent projects" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentProjectViewModel">
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                    <MenuItem.Styles>
                        <!-- Scoped to #RecentProjectsMenu's own children: an unscoped "MenuItem > MenuItem" also
                             matches this MenuItem itself (its real parent, the File menu, is a MenuItem too),
                             applying these setters against MainWindowViewModel instead of the per-item
                             RecentProjectViewModel — Path doesn't exist there, hence a binding warning. -->
                        <Style Selector="MenuItem#RecentProjectsMenu > MenuItem">
                            <Setter Property="Command" Value="{ReflectionBinding OpenCommand}"/>
                            <Setter Property="CommandParameter" Value="{ReflectionBinding Path}"/>
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator/>
                <!-- No InputGesture: the vendor's Luk advertises none, and Alt+F4 is the window manager's gesture
                     rather than the command's (uxparity S-27). It still closes the window. -->
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>

            <!-- Edit is owned by later epics (E14–E15); present as a stable host. -->
            <MenuItem Header="_Edit" a:AutomationProperties.AutomationId="MenuEdit">
                <MenuItem Header="{Binding UndoMenuHeader}" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z"
                          IsEnabled="{Binding Registry.Bar[edit.undo].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.undo].Reason}"/>
                <MenuItem Header="{Binding RedoMenuHeader}" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y"
                          IsEnabled="{Binding Registry.Bar[edit.redo].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.redo].Reason}"/>
                <!-- No separator here: the vendor's Rediger runs Fortryd…Egenskaber ungrouped (uxparity S-27). -->
                <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X"
                          IsEnabled="{Binding Registry.Bar[edit.cut].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.cut].Reason}"/>
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C"
                          IsEnabled="{Binding Registry.Bar[edit.copy].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.copy].Reason}"/>
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V"
                          IsEnabled="{Binding Registry.Bar[edit.paste].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.paste].Reason}"/>
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGesture="Delete"
                          IsEnabled="{Binding Registry.Bar[edit.delete].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.delete].Reason}"/>
                <!-- The vendor's Rediger ends with Egenskaber… F2 (uxparity S-27); OpenVisual bound F2 but only
                     surfaced Properties on the context menu. -->
                <MenuItem Header="P_roperties" Command="{Binding PropertiesCommand}" InputGesture="F2"
                          IsEnabled="{Binding Registry.Bar[node.properties].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[node.properties].Reason}"/>
            </MenuItem>

            <MenuItem Header="_View" a:AutomationProperties.AutomationId="MenuView">
                <!-- The vendor's Vis leads with the three view/navigation commands (uxparity S-27):
                     Konfigurationsvisning (ESC), Vis program (F3), Hop til modsat link (F4). OpenVisual bound all
                     three as keys but surfaced none of them in the menu. -->
                <MenuItem Header="_Configuration view" Command="{Binding LeaveProgrammingModeCommand}" InputGesture="Escape"
                          IsEnabled="{Binding Registry.Bar[program.leaveMode].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[program.leaveMode].Reason}"/>
                <MenuItem Header="_Toolbar" ToggleType="CheckBox"
                          IsChecked="{Binding IsToolbarVisible}" Command="{Binding ToggleToolbarCommand}"/>
                <MenuItem Header="_Status bar" ToggleType="CheckBox"
                          IsChecked="{Binding IsStatusBarVisible}" Command="{Binding ToggleStatusBarCommand}"/>
                <MenuItem Header="Show _program" Command="{Binding EnterProgrammingModeCommand}" InputGesture="F3"
                          IsEnabled="{Binding Registry.Bar[view.showProgram].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[view.showProgram].Reason}"/>
                <MenuItem Header="_Jump to opposite link" Command="{Binding NavigateLinkOppositeCommand}" InputGesture="F4"
                          IsEnabled="{Binding Registry.Bar[link.jumpOpposite].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[link.jumpOpposite].Reason}"/>
                <MenuItem Header="Theme">
                    <MenuItem Header="System" ToggleType="Radio"
                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.System}"
                              IsChecked="{Binding CurrentTheme, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=System}"/>
                    <MenuItem Header="Light" ToggleType="Radio"
                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Light}"
                              IsChecked="{Binding CurrentTheme, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Light}"/>
                    <MenuItem Header="Dark" ToggleType="Radio"
                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Dark}"
                              IsChecked="{Binding CurrentTheme, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Dark}"/>
                </MenuItem>
            </MenuItem>

            <!-- Insert mirrors IHC Visual's Indsæt inventory AND order (uxparity S-27). These commands are also on
                 the node context menu, which is correct — the vendor offers them in both places, and only having
                 them on the context menu left the bar's Insert with a single item. -->
            <MenuItem Header="_Insert" a:AutomationProperties.AutomationId="MenuInsert">
                <MenuItem Header="Pro_gram elements">
                    <MenuItem Header="New case _value…" Command="{Binding NewCaseValueCommand}"
                              IsEnabled="{Binding Registry.Bar[program.newCaseValue].Enabled}"
                              ToolTip.Tip="{Binding Registry.Bar[program.newCaseValue].Reason}"/>
                    <MenuItem Header="_Sub-program" Command="{Binding AddSubProgramCommand}"
                              IsEnabled="{Binding Registry.Bar[program.addSubProgram].Enabled}"
                              ToolTip.Tip="{Binding Registry.Bar[program.addSubProgram].Reason}"/>
                    <MenuItem Header="Logic _group" Command="{Binding AddLogicGroupCommand}"
                              IsEnabled="{Binding Registry.Bar[program.addLogicGroup].Enabled}"
                              ToolTip.Tip="{Binding Registry.Bar[program.addLogicGroup].Reason}"/>
                </MenuItem>
                <MenuItem Header="_Function blocks" ItemsSource="{Binding FunctionBlocksMenu}"
                          ItemContainerTheme="{StaticResource ProductMenuItemTheme}"/>
                <MenuItem Header="_Empty function block" Command="{Binding InsertEmptyFunctionBlockCommand}"
                          IsEnabled="{Binding Registry.Bar[insert.emptyFunctionBlock].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[insert.emptyFunctionBlock].Reason}"
                          InputGesture="Ctrl+Shift+B"/>
                <MenuItem Header="_Locality" Command="{Binding InsertLocalityCommand}"
                          IsEnabled="{Binding Registry.Bar[insert.locality].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[insert.locality].Reason}"/>
                <MenuItem Header="S_pecial">
                    <MenuItem Header="Add _Powerup event" Command="{Binding AddPowerEventCommand}"
                              IsEnabled="{Binding Registry.Bar[program.addPowerEvent].Enabled}"
                              ToolTip.Tip="{Binding Registry.Bar[program.addPowerEvent].Reason}"/>
                </MenuItem>
                <!-- The product category folders are data-driven (H2/D08): Wired / IHC Wireless / Bus / Special plus an
                     Imported/Uncategorized bucket, derived from the catalog's CategoryPath by CatalogMenu. -->
                <MenuItem Header="_Products" ItemsSource="{Binding ProductsMenu}"
                          ItemContainerTheme="{StaticResource ProductMenuItemTheme}"/>
                <MenuItem Header="_Variable" ItemsSource="{Binding VariablePaletteMenu}"
                          ItemContainerTheme="{StaticResource ProductMenuItemTheme}"/>
            </MenuItem>
            <MenuItem Header="_Library" a:AutomationProperties.AutomationId="MenuLibrary">
                <MenuItem Header="Insert _function block" ItemsSource="{Binding FunctionBlocksMenu}"
                          ItemContainerTheme="{StaticResource ProductMenuItemTheme}"/>
                <Separator/>
                <MenuItem Header="_Import catalog file…" Command="{Binding ImportCatalogFileCommand}"/>
                <MenuItem Header="Import catalog f_older…" Command="{Binding ImportCatalogFolderCommand}"/>
            </MenuItem>
            <MenuItem Header="_Controller" a:AutomationProperties.AutomationId="MenuController">
                <MenuItem Header="_Send project" Command="{Binding SendProjectCommand}" InputGesture="F5"
                          IsEnabled="{Binding Registry.Bar[controller.send].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[controller.send].Reason}"/>
                <MenuItem Header="_Retrieve project" Command="{Binding RetrieveProjectCommand}"/>
            </MenuItem>
            <MenuItem Header="Doc_umentation" a:AutomationProperties.AutomationId="MenuDocumentation">
                <MenuItem Header="_Project info…" Command="{Binding ProjectInfoCommand}"
                          IsEnabled="{Binding Registry.Bar[project.info].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[project.info].Reason}"/>
                <MenuItem Header="_Data tables…" Command="{Binding DataTablesCommand}"
                          IsEnabled="{Binding Registry.Bar[project.dataTables].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[project.dataTables].Reason}"/>
                <MenuItem Header="_Wired module map…" Command="{Binding ModuleMapCommand}"
                          IsEnabled="{Binding Registry.Bar[project.moduleMap].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[project.moduleMap].Reason}"/>
                <Separator/>
                <MenuItem Header="_Reports…" Command="{Binding OpenReportsCommand}"
                          IsEnabled="{Binding Registry.Bar[reports.open].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[reports.open].Reason}"/>
            </MenuItem>

            <MenuItem Header="_Help" a:AutomationProperties.AutomationId="MenuHelp">
                <MenuItem Header="Help for _selection" Command="{Binding HelpCommand}" InputGesture="F1"/>
                <Separator/>
                <MenuItem Header="Show settings" Command="{Binding ShowSettingsCommand}"/>
                <MenuItem Header="Telemetry diagnostics" Command="{Binding TelemetryDiagnosticsCommand}"/>
                <Separator/>
                <MenuItem Header="_About…" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ============ Toolbar ============ -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsToolbarVisible}"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <StackPanel.Styles>
                    <Style Selector="Button.tool">
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="svg|Svg.toolicon">
                        <Setter Property="Width" Value="18"/>
                        <Setter Property="Height" Value="18"/>
                        <!-- Icons are decorative; the accessible name lives on the parent Button. Keep the glyph
                             out of the automation tree so it is not announced separately. -->
                        <Setter Property="a:AutomationProperties.AccessibilityView" Value="Raw"/>
                    </Style>
                    <Style Selector="Rectangle.toolsep">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Margin" Value="5,3"/>
                        <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                    </Style>
                </StackPanel.Styles>

                <Button Classes="tool" Command="{Binding NewCommand}" ToolTip.Tip="New project (Ctrl+N)"
                        a:AutomationProperties.Name="New project" a:AutomationProperties.AutomationId="ToolbarNew">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_new.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding OpenCommand}" ToolTip.Tip="Open project (Ctrl+O)"
                        a:AutomationProperties.Name="Open project" a:AutomationProperties.AutomationId="ToolbarOpen">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_open.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="Save project (Ctrl+S)"
                        a:AutomationProperties.Name="Save project" a:AutomationProperties.AutomationId="ToolbarSave">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_save.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>

                <Rectangle Classes="toolsep"/>
                <Button Classes="tool" Command="{Binding AboutCommand}" ToolTip.Tip="Help / About"
                        a:AutomationProperties.Name="Help and About" a:AutomationProperties.AutomationId="ToolbarHelp">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_help.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>

                <Rectangle Classes="toolsep"/>
                <!-- T020: real registry-bound buttons (the toolbar is a persistent surface — it greys, never
                     hides). Tooltips stay the static captions: the T016 spike proved a DISABLED control shows
                     no tooltip, so disabled reasons surface via the T021 status-bar handler instead. -->
                <Button Classes="tool" Command="{Binding RetrieveProjectCommand}"
                        IsEnabled="{Binding Registry.Toolbar[controller.retrieve].Enabled}"
                        ToolTip.Tip="Retrieve from controller"
                        a:AutomationProperties.Name="Retrieve from controller" a:AutomationProperties.AutomationId="ToolbarRetrieve">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_retrieve.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding SendProjectCommand}"
                        IsEnabled="{Binding Registry.Toolbar[controller.send].Enabled}"
                        ToolTip.Tip="Send to controller (F5)"
                        a:AutomationProperties.Name="Send to controller" a:AutomationProperties.AutomationId="ToolbarSend">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_send.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>

                <Rectangle Classes="toolsep"/>
                <Button Classes="tool" Command="{Binding CutCommand}"
                        IsEnabled="{Binding Registry.Toolbar[edit.cut].Enabled}"
                        ToolTip.Tip="Cut (Ctrl+X)"
                        a:AutomationProperties.Name="Cut" a:AutomationProperties.AutomationId="ToolbarCut">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_cut.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding CopyCommand}"
                        IsEnabled="{Binding Registry.Toolbar[edit.copy].Enabled}"
                        ToolTip.Tip="Copy (Ctrl+C)"
                        a:AutomationProperties.Name="Copy" a:AutomationProperties.AutomationId="ToolbarCopy">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_copy.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding PasteCommand}"
                        IsEnabled="{Binding Registry.Toolbar[edit.paste].Enabled}"
                        ToolTip.Tip="Paste (Ctrl+V)"
                        a:AutomationProperties.Name="Paste" a:AutomationProperties.AutomationId="ToolbarPaste">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_paste.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Status bar ============ -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsStatusBarVisible}"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0"
                Padding="8,3">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"
                           FontSize="{StaticResource CaptionFontSize}"/>
                <!-- Locale indicator: Danish flag -->
                <Border Grid.Column="1" Width="20" Height="14" Background="#C8102E" ToolTip.Tip="Danish project locale"
                        a:AutomationProperties.Name="Danish project locale">
                    <Canvas>
                        <Rectangle Canvas.Left="6" Canvas.Top="0" Width="2.5" Height="14" Fill="White"/>
                        <Rectangle Canvas.Left="0" Canvas.Top="5.75" Width="20" Height="2.5" Fill="White"/>
                    </Canvas>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Two tree panes with a splitter ============ -->
        <Grid ColumnDefinitions="*,Auto,*">
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBackgroundBrush}" Padding="10,5">
                    <TextBlock Text="{Binding InstallationPaneHeader}" Foreground="{DynamicResource PaneHeaderForegroundBrush}"
                               FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}"/>
                </Border>
                <controls:AccessibleTreeView x:Name="InstallationTree" ItemsSource="{Binding InstallationNodes}" KeyDown="OnTreeKeyDown"
                          SelectedItem="{Binding SelectedInstallationNode, Mode=TwoWay}"
                          ContextFlyout="{StaticResource NodeContextMenu}"
                          ItemContainerTheme="{StaticResource TreeNodeItemTheme}"
                          ItemTemplate="{StaticResource TreeNodeTemplate}"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBackgroundBrush}" Padding="10,5">
                    <TextBlock Text="{Binding FunctionsPaneHeader}" Foreground="{DynamicResource PaneHeaderForegroundBrush}"
                               FontWeight="SemiBold" FontSize="{StaticResource BodyFontSize}"/>
                </Border>
                <controls:AccessibleTreeView x:Name="FunctionsTree" ItemsSource="{Binding FunctionNodes}" KeyDown="OnTreeKeyDown"
                          SelectedItem="{Binding SelectedFunctionsNode, Mode=TwoWay}"
                          ContextFlyout="{StaticResource NodeContextMenu}"
                          ItemContainerTheme="{StaticResource TreeNodeItemTheme}"
                          ItemTemplate="{StaticResource TreeNodeTemplate}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
