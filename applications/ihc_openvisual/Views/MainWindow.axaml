<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ihc_openvisual.ViewModels"
        xmlns:svc="using:ihc_openvisual.Services"
        xmlns:conv="using:ihc_openvisual.Converters"
        xmlns:controls="using:ihc_openvisual.Controls"
        xmlns:a="using:Avalonia.Automation"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="ihc_openvisual.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/openvisual.ico"
        Width="1000" Height="680"
        FontSize="{DynamicResource WorkspaceFontSize}"
        Title="{Binding Title}">

    <!-- D06 (owner ruling 2026-08-02): a shortcut follows the MENU BAR's availability, not the row's bare gate —
         so Ctrl+X refuses on a locked block, whose Cut the bar greys while the context flyout still offers it
         (D13). That is why these bind Registry.GestureCommands[<row id>] and not the CutCommand-style bridges:
         a KeyBinding never invokes a DISABLED command, and Avalonia services a TopLevel's KeyBindings before any
         instance KeyDown handler (tunnel included), so no handler could veto one after the fact. A row the bar
         never shows (Ctrl+I/Ctrl+U, and the context-menu-only rows) is judged by its own gate. The window's
         OnWindowKeyDownGateGestures then explains whatever did not fire. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+N', macOS='Cmd+N'}" Command="{Binding Registry.GestureCommands[file.new]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+O', macOS='Cmd+O'}" Command="{Binding Registry.GestureCommands[file.open]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+S', macOS='Cmd+S'}" Command="{Binding Registry.GestureCommands[file.save]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Shift+B', macOS='Cmd+Shift+B'}" Command="{Binding Registry.GestureCommands[insert.emptyFunctionBlock]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+G', macOS='Cmd+G'}" Command="{Binding Registry.GestureCommands[node.saveBlock]}"/>
        <KeyBinding Gesture="F3" Command="{Binding Registry.GestureCommands[view.showProgram]}"/>
        <KeyBinding Gesture="Escape" Command="{Binding Registry.GestureCommands[program.leaveMode]}"/>
        <KeyBinding Gesture="F5" Command="{Binding Registry.GestureCommands[controller.send]}"/>
        <KeyBinding Gesture="F1" Command="{Binding Registry.GestureCommands[help.onNode]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+I', macOS='Cmd+I'}" Command="{Binding Registry.GestureCommands[program.insertInput]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+U', macOS='Cmd+U'}" Command="{Binding Registry.GestureCommands[program.insertOutput]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Z', macOS='Cmd+Z'}" Command="{Binding Registry.GestureCommands[edit.undo]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Y', macOS='Cmd+Y'}" Command="{Binding Registry.GestureCommands[edit.redo]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+X', macOS='Cmd+X'}" Command="{Binding Registry.GestureCommands[edit.cut]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+C', macOS='Cmd+C'}" Command="{Binding Registry.GestureCommands[edit.copy]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+V', macOS='Cmd+V'}" Command="{Binding Registry.GestureCommands[edit.paste]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Shift+Up', macOS='Cmd+Shift+Up'}" Command="{Binding Registry.GestureCommands[edit.moveUp]}"/>
        <KeyBinding Gesture="{OnPlatform 'Ctrl+Shift+Down', macOS='Cmd+Shift+Down'}" Command="{Binding Registry.GestureCommands[edit.moveDown]}"/>
    </Window.KeyBindings>

    <Window.Resources>
        <!-- Recursive theme for the catalog product-insertion menu: each generated MenuItem takes its Header,
             child items and insert command from its ProductMenuItemViewModel, and reuses this same theme for its
             own children (self-reference via DynamicResource) so arbitrarily deep category trees render (US-010). -->
        <ControlTheme x:Key="ProductMenuItemTheme" TargetType="MenuItem" x:DataType="vm:ProductMenuItemViewModel"
                      BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Header}"/>
            <Setter Property="ItemsSource" Value="{Binding Children}"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="ItemContainerTheme" Value="{DynamicResource ProductMenuItemTheme}"/>
        </ControlTheme>

        <!-- The tree-node context menu, shared by both panes (a Flyout can be shared as a resource; a ContextMenu
             control cannot). Every item self-gates on the active SelectedNode, so the same menu suits either pane;
             "Insert product" is the one pane-specific item (products belong to the Installation pane, gated on
             CanInsertProduct). -->
        <MenuFlyout x:Key="NodeContextMenu" x:DataType="vm:MainWindowViewModel">
            <MenuItem Header="Indsæt _lokalitet" Command="{Binding InsertLocalityCommand}"
                      IsVisible="{Binding Registry.ContextMenu[insert.locality].Visible, FallbackValue=False}"/>
            <!-- Product category folders are data-driven (H2/D08) — see CatalogMenu.BuildProductForest. -->
            <MenuItem Header="Indsæt _produkt" ItemsSource="{Binding ProductsMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanInsertProduct, FallbackValue=False}"/>
            <MenuItem Header="Indsæt _Funktionsblok" ItemsSource="{Binding FunctionBlocksMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanInsertFunctionBlock, FallbackValue=False}"/>
            <MenuItem Header="_Tom Funktionsblok" Command="{Binding InsertEmptyFunctionBlockCommand}"
                      InputGesture="{OnPlatform 'Ctrl+Shift+B', macOS='Cmd+Shift+B'}"
                      IsVisible="{Binding Registry.ContextMenu[insert.emptyFunctionBlock].Visible, FallbackValue=False}"/>
            <MenuItem Header="Indsæt _variabel" ItemsSource="{Binding VariablePaletteMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanInsertVariable, FallbackValue=False}"/>
            <MenuItem Header="Link _fra her" Command="{Binding StartLinkCommand}"
                      IsVisible="{Binding Registry.ContextMenu[link.startFromHere].Visible, FallbackValue=False}"/>
            <MenuItem Header="Link _til her" Command="{Binding LinkToHereCommand}"
                      IsVisible="{Binding Registry.ContextMenu[link.toHere].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Brug i program" Command="{Binding UseInProgramCommand}"
                      IsVisible="{Binding Registry.ContextMenu[node.useInProgram].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Logmærke" Command="{Binding ToggleLogMarkCommand}"
                      IsVisible="{Binding Registry.ContextMenu[node.toggleLogMark].Visible, FallbackValue=False}"/>
            <MenuItem Header="Gem aktuel _værdi" Command="{Binding ToggleSaveValueCommand}"
                      ToggleType="CheckBox" IsChecked="{Binding SelectedNode.IsValueSaved, Mode=OneWay, FallbackValue=False}"
                      IsVisible="{Binding Registry.ContextMenu[program.toggleSaveValue].Visible, FallbackValue=False}"/>
            <MenuItem Header="Tilføj _hændelse" ItemsSource="{Binding ProgramEventMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddEvent, FallbackValue=False}"/>
            <MenuItem Header="_Powerup hændelse" Command="{Binding AddPowerEventCommand}"
                      IsVisible="{Binding Registry.ContextMenu[program.addPowerEvent].Visible, FallbackValue=False}"/>
            <MenuItem Header="Tilføj _kommando" ItemsSource="{Binding ProgramCommandMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddCommand, FallbackValue=False}"/>
            <MenuItem Header="_Program" Command="{Binding AddProgramCommand}"
                      IsVisible="{Binding Registry.ContextMenu[program.addProgram].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Under program" Command="{Binding AddSubProgramCommand}"
                      IsVisible="{Binding Registry.ContextMenu[program.addSubProgram].Visible, FallbackValue=False}"/>
            <!-- Case and Arithmetic bind their OWN gates: all three of these submenus hang off a Commands node, but
                 each fills under different conditions (an eligible switch type / a numeric target register), so a
                 shared CanAddCommand offered two of them empty. -->
            <MenuItem Header="C_ase" ItemsSource="{Binding ProgramCaseMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddCase, FallbackValue=False}"/>
            <MenuItem Header="Arit_metik" ItemsSource="{Binding ProgramArithmeticMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddArithmetic, FallbackValue=False}"/>
            <MenuItem Header="_Ny case værdi som angiver tilstand…" Command="{Binding NewCaseValueCommand}"
                      IsVisible="{Binding Registry.ContextMenu[program.newCaseValue].Visible, FallbackValue=False}"/>
            <MenuItem Header="Tilføj _betingelse" ItemsSource="{Binding ProgramConditionMenu}"
                      ItemContainerTheme="{StaticResource ProductMenuItemTheme}"
                      IsVisible="{Binding CanAddCondition, FallbackValue=False}"/>
            <MenuItem Header="_Logik gruppe" Command="{Binding AddLogicGroupCommand}"
                      IsVisible="{Binding Registry.ContextMenu[program.addLogicGroup].Visible, FallbackValue=False}"/>
            <!-- The AND/OR pair is a fixed two-item menu, so each item is a registry ROW and takes its visibility
                 from that row — not from CanAddCondition, which speaks for the data-driven "Add condition" submenu
                 and is now empty until an operand is armed. The parent follows the same rows (they share one gate),
                 so the group never appears with nothing under it. -->
            <MenuItem Header="Logisk betingelse"
                      IsVisible="{Binding Registry.ContextMenu[program.setConditionsAnd].Visible, FallbackValue=False}">
                <MenuItem Header="AND (_&amp;)" Command="{Binding SetConditionsAndCommand}"
                          IsVisible="{Binding Registry.ContextMenu[program.setConditionsAnd].Visible, FallbackValue=False}"/>
                <MenuItem Header="OR (_&gt;=1)" Command="{Binding SetConditionsOrCommand}"
                          IsVisible="{Binding Registry.ContextMenu[program.setConditionsOr].Visible, FallbackValue=False}"/>
            </MenuItem>
            <MenuItem Header="_Gem Funktionsblok…" Command="{Binding SaveFunctionBlockCommand}"
                      InputGesture="{OnPlatform 'Ctrl+G', macOS='Cmd+G'}"
                      IsVisible="{Binding Registry.ContextMenu[node.saveBlock].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Klip" Command="{Binding CutCommand}"
                      InputGesture="{OnPlatform 'Ctrl+X', macOS='Cmd+X'}"
                      IsVisible="{Binding Registry.ContextMenu[edit.cut].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Kopier" Command="{Binding CopyCommand}"
                      InputGesture="{OnPlatform 'Ctrl+C', macOS='Cmd+C'}"
                      IsVisible="{Binding Registry.ContextMenu[edit.copy].Visible, FallbackValue=False}"/>
            <!-- "Op_lås", not "_Oplås": a locked block is also reorderable, so Flyt _op is on this same flyout
                 beside it. L is free here — Indsæt lokalitet, Logmærke and Logik gruppe never show on a block. -->
            <MenuItem Header="Op_lås" Command="{Binding UnlockCommand}"
                      IsVisible="{Binding Registry.ContextMenu[node.unlock].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Indsæt" Command="{Binding PasteCommand}"
                      InputGesture="{OnPlatform 'Ctrl+V', macOS='Cmd+V'}"
                      IsVisible="{Binding Registry.ContextMenu[edit.paste].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Hop til modsat link" Command="{Binding NavigateLinkOppositeCommand}"
                      InputGesture="F4"
                      IsVisible="{Binding Registry.ContextMenu[link.jumpOpposite].Visible, FallbackValue=False}"/>
            <MenuItem Header="Flyt _op" Command="{Binding MoveUpCommand}"
                      IsVisible="{Binding Registry.ContextMenu[edit.moveUp].Visible, FallbackValue=False}"/>
            <MenuItem Header="Flyt _ned" Command="{Binding MoveDownCommand}"
                      IsVisible="{Binding Registry.ContextMenu[edit.moveDown].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Slet" Command="{Binding DeleteCommand}"
                      IsVisible="{Binding Registry.ContextMenu[edit.delete].Visible, FallbackValue=False}"/>
            <!-- Offered on a block AND on its pins: the vendor lets you jump from a pin to the program that uses
                 it (uxparity S-28). The registry row's gate resolves the owning block for either. -->
            <MenuItem Header="_Vis program" Command="{Binding EnterProgrammingModeCommand}"
                      InputGesture="F3"
                      IsVisible="{Binding Registry.ContextMenu[view.showProgram].Visible, FallbackValue=False}"/>
            <MenuItem Header="_Egenskaber…" Command="{Binding PropertiesCommand}"
                      IsVisible="{Binding Registry.ContextMenu[node.properties].Visible, FallbackValue=False}"/>
        </MenuFlyout>

        <!-- The tree-row container theme + row template, shared by both panes (they were byte-identical). The
             theme carries the container behaviour (TwoWay IsExpanded so an expander click reaches the VM for the
             US-070 snapshot/restore) and the UIA name/kind; the template renders icon + label + the US-014
             unlinked "!" marker. Both panes reference these instead of repeating the blocks inline. -->
        <ControlTheme x:Key="TreeNodeItemTheme" TargetType="TreeViewItem" x:DataType="vm:TreeNodeViewModel"
                      BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <!-- TwoWay so a user's expander click reaches the view-model, which snapshots and restores expansion
                 across every edit's tree rebuild (US-070). -->
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- Publish the row's accessible name on the container itself so a UIA client reading TreeItem.Name gets
                 the label directly (not blank, with the name on an inner peer). -->
            <Setter Property="a:AutomationProperties.Name" Value="{Binding AccessibleName}"/>
            <!-- Publish the row's KIND for automation. AutomationId is never rendered and is not announced as
                 content, so this is invisible to a user — unlike HelpText, which is already the tooltip the user
                 sees. It exists because a row's LABEL is user data and cannot identify it (see
                 TreeNodeViewModel.NodeKind). -->
            <Setter Property="a:AutomationProperties.AutomationId" Value="{Binding NodeKind}"/>
        </ControlTheme>

        <TreeDataTemplate x:Key="TreeNodeTemplate" x:DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
            <!-- DoubleTapped is handled HERE, on the row's own content, and not on the TreeView: the event only
                 bubbles, and TreeViewItem toggles expansion from a handler on its header presenter — this
                 StackPanel's ancestor. Handling it here is therefore the last point that still runs BEFORE the
                 toggle (US-044, F-006/F-007). -->
            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Tooltip}"
                        DoubleTapped="OnNodeDoubleTapped"
                        Background="{Binding IsDropTarget, Converter={x:Static conv:BoolToBrushConverter.DropTarget}}"
                        a:AutomationProperties.Name="{Binding AccessibleName}"
                        a:AutomationProperties.HelpText="{Binding Tooltip}">
                <svg:Svg Width="16" Height="16" Path="{Binding IconAsset}" CurrentColor="{DynamicResource IconColor}"
                         a:AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                           FontWeight="{Binding IsBold, Converter={x:Static conv:BoolToFontWeightConverter.Instance}}"/>
                <!-- Unlinked wireless product marker (US-014) -->
                <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding IsUnlinked}"
                           ToolTip.Tip="Endnu ikke linket til controlleren"/>
            </StackPanel>
        </TreeDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ============ Menu bar: the stable title hosts ============ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Filer" a:AutomationProperties.AutomationId="MenuFile">
                <MenuItem Header="_Nyt projekt" Command="{Binding NewCommand}" InputGesture="{OnPlatform 'Ctrl+N', macOS='Cmd+N'}"/>
                <MenuItem Header="Å_bn projekt…" Command="{Binding OpenCommand}" InputGesture="{OnPlatform 'Ctrl+O', macOS='Cmd+O'}"/>
                <Separator/>
                <MenuItem Header="_Gem projekt" Command="{Binding SaveCommand}" InputGesture="{OnPlatform 'Ctrl+S', macOS='Cmd+S'}"/>
                <MenuItem Header="Gem projekt _som…" Command="{Binding SaveAsCommand}"
                          IsEnabled="{Binding Registry.Bar[file.saveAs].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[file.saveAs].Reason}"/>
                <Separator/>
                <MenuItem Header="_Luk projekt" Command="{Binding CloseCommand}"
                          IsEnabled="{Binding Registry.Bar[file.close].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[file.close].Reason}"/>
                <Separator/>
                <!-- "_projekter", not "Se_neste": N is _Nyt projekt's access key, and two items in one menu sharing a
                     key cycle focus instead of invoking. (The vendor has no such submenu — its MRU is inline &1…&4.) -->
                <MenuItem Name="RecentProjectsMenu" Header="Seneste _projekter" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentProjectViewModel">
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                    <MenuItem.Styles>
                        <!-- Scoped to #RecentProjectsMenu's own children: an unscoped "MenuItem > MenuItem" also
                             matches this MenuItem itself (its real parent, the File menu, is a MenuItem too),
                             applying these setters against MainWindowViewModel instead of the per-item
                             RecentProjectViewModel — Path doesn't exist there, hence a binding warning.
                             x:DataType names that per-item type, which is what keeps these setters COMPILED
                             (architecture review A-06): a renamed RecentProjectViewModel member now breaks the
                             build, where the ReflectionBinding these replaced would have silently bound nothing
                             and left the menu items inert. Same annotation as the ItemTemplate above. -->
                        <Style Selector="MenuItem#RecentProjectsMenu > MenuItem" x:DataType="vm:RecentProjectViewModel">
                            <Setter Property="Command" Value="{Binding OpenCommand}"/>
                            <Setter Property="CommandParameter" Value="{Binding Path}"/>
                        </Style>
                    </MenuItem.Styles>
                </MenuItem>
                <Separator/>
                <!-- No InputGesture: the vendor's Luk advertises none, and Alt+F4 is the window manager's gesture
                     rather than the command's (uxparity S-27). It still closes the window. -->
                <MenuItem Header="_Afslut" Command="{Binding ExitCommand}"/>
            </MenuItem>

            <!-- Edit is owned by later epics (E14–E15); present as a stable host. -->
            <MenuItem Header="_Rediger" a:AutomationProperties.AutomationId="MenuEdit">
                <MenuItem Header="{Binding UndoMenuHeader}" Command="{Binding UndoCommand}" InputGesture="{OnPlatform 'Ctrl+Z', macOS='Cmd+Z'}"
                          IsEnabled="{Binding Registry.Bar[edit.undo].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.undo].Reason}"/>
                <MenuItem Header="{Binding RedoMenuHeader}" Command="{Binding RedoCommand}" InputGesture="{OnPlatform 'Ctrl+Y', macOS='Cmd+Y'}"
                          IsEnabled="{Binding Registry.Bar[edit.redo].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.redo].Reason}"/>
                <!-- No separator here: the vendor's Rediger runs Fortryd…Egenskaber ungrouped (uxparity S-27). -->
                <MenuItem Header="_Klip" Command="{Binding CutCommand}" InputGesture="{OnPlatform 'Ctrl+X', macOS='Cmd+X'}"
                          IsEnabled="{Binding Registry.Bar[edit.cut].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.cut].Reason}"/>
                <MenuItem Header="_Kopier" Command="{Binding CopyCommand}" InputGesture="{OnPlatform 'Ctrl+C', macOS='Cmd+C'}"
                          IsEnabled="{Binding Registry.Bar[edit.copy].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.copy].Reason}"/>
                <MenuItem Header="_Indsæt" Command="{Binding PasteCommand}" InputGesture="{OnPlatform 'Ctrl+V', macOS='Cmd+V'}"
                          IsEnabled="{Binding Registry.Bar[edit.paste].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.paste].Reason}"/>
                <MenuItem Header="_Slet" Command="{Binding DeleteCommand}" InputGesture="Delete"
                          IsEnabled="{Binding Registry.Bar[edit.delete].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[edit.delete].Reason}"/>
                <!-- The vendor's Rediger ends with Egenskaber… F2 (uxparity S-27); OpenVisual bound F2 but only
                     surfaced Properties on the context menu. -->
                <MenuItem Header="_Egenskaber…" Command="{Binding PropertiesCommand}" InputGesture="F2"
                          IsEnabled="{Binding Registry.Bar[node.properties].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[node.properties].Reason}"/>
            </MenuItem>

            <MenuItem Header="_Vis" a:AutomationProperties.AutomationId="MenuView">
                <!-- The vendor's Vis leads with the three view/navigation commands (uxparity S-27):
                     Konfigurationsvisning (ESC), Vis program (F3), Hop til modsat link (F4). OpenVisual bound all
                     three as keys but surfaced none of them in the menu. -->
                <MenuItem Header="_Konfigurationsvisning" Command="{Binding LeaveProgrammingModeCommand}" InputGesture="Escape"
                          IsEnabled="{Binding Registry.Bar[program.leaveMode].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[program.leaveMode].Reason}"/>
                <MenuItem Header="_Værktøjslinie" ToggleType="CheckBox"
                          IsChecked="{Binding IsToolbarVisible}" Command="{Binding ToggleToolbarCommand}"/>
                <MenuItem Header="_Statuslinie" ToggleType="CheckBox"
                          IsChecked="{Binding IsStatusBarVisible}" Command="{Binding ToggleStatusBarCommand}"/>
                <MenuItem Header="_Vis program" Command="{Binding EnterProgrammingModeCommand}" InputGesture="F3"
                          IsEnabled="{Binding Registry.Bar[view.showProgram].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[view.showProgram].Reason}"/>
                <MenuItem Header="_Hop til modsat link" Command="{Binding NavigateLinkOppositeCommand}" InputGesture="F4"
                          IsEnabled="{Binding Registry.Bar[link.jumpOpposite].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[link.jumpOpposite].Reason}"/>
                <MenuItem Header="Tema">
                    <MenuItem Header="System" ToggleType="Radio"
                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.System}"
                              IsChecked="{Binding CurrentTheme, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=System}"/>
                    <MenuItem Header="Lys" ToggleType="Radio"
                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Light}"
                              IsChecked="{Binding CurrentTheme, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Light}"/>
                    <MenuItem Header="Mørk" ToggleType="Radio"
                              Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Dark}"
                              IsChecked="{Binding CurrentTheme, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Dark}"/>
                </MenuItem>
                <!-- Tekststørrelse (US-001 SHOULD): the only route to OS-level text scaling, which Avalonia does
                     not honour (accessibility BP-12). Same shape as the Tema submenu above — a parameterized
                     item command, one of the narrow registry exemptions. -->
                <MenuItem Header="Tekststørrelse">
                    <MenuItem Header="Lille" ToggleType="Radio"
                              Command="{Binding SetTextScaleCommand}" CommandParameter="{x:Static svc:TextScale.Small}"
                              IsChecked="{Binding CurrentTextScale, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Small}"/>
                    <MenuItem Header="Normal" ToggleType="Radio"
                              Command="{Binding SetTextScaleCommand}" CommandParameter="{x:Static svc:TextScale.Normal}"
                              IsChecked="{Binding CurrentTextScale, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Normal}"/>
                    <MenuItem Header="Stor" ToggleType="Radio"
                              Command="{Binding SetTextScaleCommand}" CommandParameter="{x:Static svc:TextScale.Large}"
                              IsChecked="{Binding CurrentTextScale, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Large}"/>
                    <MenuItem Header="Størst" ToggleType="Radio"
                              Command="{Binding SetTextScaleCommand}" CommandParameter="{x:Static svc:TextScale.Largest}"
                              IsChecked="{Binding CurrentTextScale, Converter={x:Static conv:EnumMatchConverter.Instance}, ConverterParameter=Largest}"/>
                </MenuItem>
            </MenuItem>

            <!-- Insert mirrors IHC Visual's Indsæt inventory AND order (uxparity S-27). These commands are also on
                 the node context menu, which is correct — the vendor offers them in both places, and only having
                 them on the context menu left the bar's Insert with a single item. -->
            <MenuItem Header="_Indsæt" a:AutomationProperties.AutomationId="MenuInsert">
                <MenuItem Header="_Program elementer">
                    <MenuItem Header="_Program" Command="{Binding AddProgramCommand}"
                              IsEnabled="{Binding Registry.Bar[program.addProgram].Enabled}"
                              ToolTip.Tip="{Binding Registry.Bar[program.addProgram].Reason}"/>
                    <MenuItem Header="_Ny case værdi som angiver tilstand…" Command="{Binding NewCaseValueCommand}"
                              IsEnabled="{Binding Registry.Bar[program.newCaseValue].Enabled}"
                              ToolTip.Tip="{Binding Registry.Bar[program.newCaseValue].Reason}"/>
                    <MenuItem Header="_Under program" Command="{Binding AddSubProgramCommand}"
                              IsEnabled="{Binding Registry.Bar[program.addSubProgram].Enabled}"
                              ToolTip.Tip="{Binding Registry.Bar[program.addSubProgram].Reason}"/>
                    <MenuItem Header="_Logik gruppe" Command="{Binding AddLogicGroupCommand}"
                              IsEnabled="{Binding Registry.Bar[program.addLogicGroup].Enabled}"
                              ToolTip.Tip="{Binding Registry.Bar[program.addLogicGroup].Reason}"/>
                </MenuItem>
                <MenuItem Header="_FunktionsBlokke" ItemsSource="{Binding FunctionBlocksMenu}"
                          ItemContainerTheme="{StaticResource ProductMenuItemTheme}"/>
                <MenuItem Header="_Tom Funktionsblok" Command="{Binding InsertEmptyFunctionBlockCommand}"
                          IsEnabled="{Binding Registry.Bar[insert.emptyFunctionBlock].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[insert.emptyFunctionBlock].Reason}"
                          InputGesture="{OnPlatform 'Ctrl+Shift+B', macOS='Cmd+Shift+B'}"/>
                <MenuItem Header="_Lokalitet" Command="{Binding InsertLocalityCommand}"
                          IsEnabled="{Binding Registry.Bar[insert.locality].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[insert.locality].Reason}"/>
                <!-- No access key, as IHC Visual's own Specielle carries none: P is already _Program elementer's
                     and _Produkter's (the vendor collides on those two; adding a third is ours to avoid). -->
                <MenuItem Header="Specielle">
                    <MenuItem Header="_Powerup hændelse" Command="{Binding AddPowerEventCommand}"
                              IsEnabled="{Binding Registry.Bar[program.addPowerEvent].Enabled}"
                              ToolTip.Tip="{Binding Registry.Bar[program.addPowerEvent].Reason}"/>
                </MenuItem>
                <!-- The product category folders are data-driven (H2/D08): Wired / IHC Wireless / Bus / Special plus an
                     Imported/Uncategorized bucket, derived from the catalog's CategoryPath by CatalogMenu. -->
                <MenuItem Header="_Produkter" ItemsSource="{Binding ProductsMenu}"
                          ItemContainerTheme="{StaticResource ProductMenuItemTheme}"/>
                <MenuItem Header="_Variable" ItemsSource="{Binding VariablePaletteMenu}"
                          ItemContainerTheme="{StaticResource ProductMenuItemTheme}"/>
            </MenuItem>
            <!-- Bibliotek carries the vendor's THREE items, in the vendor's order (ids 24588 / 24765 / 24766,
                 measured 2026-08-04), then OpenVisual's own catalog-import pair below a separator — the reference
                 application has no counterpart for those two, so they are marked off rather than interleaved.
                 There is deliberately NO "Indsæt Funktionsblok" here: it was a second copy of Indsæt ▸
                 FunktionsBlokke, it is not on the vendor's Bibliotek, and it displaced the vendor's first item. -->
            <MenuItem Header="_Bibliotek" a:AutomationProperties.AutomationId="MenuLibrary">
                <!-- "Rediger Enumerator typer": capital E and NO ellipsis, the vendor's own label (measured
                     2026-08-04). It opens a dialog, but the reference application spells it without one. -->
                <MenuItem Header="_Rediger Enumerator typer" Command="{Binding ManageEnumTypesCommand}"
                          IsEnabled="{Binding Registry.Bar[library.manageEnumTypes].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[library.manageEnumTypes].Reason}"/>
                <!-- Vendor position 2 (id 24765, Ctrl+G): greyed until a function block is selected. Also on the
                     node flyout — the reference application offers it in both places. -->
                <MenuItem Header="_Gem Funktionsblok…" Command="{Binding SaveFunctionBlockCommand}"
                          InputGesture="{OnPlatform 'Ctrl+G', macOS='Cmd+G'}"
                          IsEnabled="{Binding Registry.Bar[node.saveBlock].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[node.saveBlock].Reason}"/>
                <!-- Vendor position 3 (id 24766, no shortcut): greyed unless the selection is a LOCKED library
                     block. "_Oplås" here — O is free on this menu; the node flyout keeps "Op_lås" because L is
                     taken there by Flyt _op's neighbours. -->
                <MenuItem Header="_Oplås" Command="{Binding UnlockCommand}"
                          IsEnabled="{Binding Registry.Bar[node.unlock].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[node.unlock].Reason}"/>
                <Separator/>
                <MenuItem Header="_Importer katalogfil…" Command="{Binding ImportCatalogFileCommand}"/>
                <MenuItem Header="Importer katalog_mappe…" Command="{Binding ImportCatalogFolderCommand}"/>
            </MenuItem>
            <MenuItem Header="_Controller" a:AutomationProperties.AutomationId="MenuController">
                <MenuItem Header="_Send projekt…" Command="{Binding SendProjectCommand}" InputGesture="F5"
                          IsEnabled="{Binding Registry.Bar[controller.send].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[controller.send].Reason}"/>
                <MenuItem Header="_Hent projekt…" Command="{Binding RetrieveProjectCommand}"/>
            </MenuItem>
            <!-- The vendor's three surviving items first, in the vendor's own order (&Datalinie moduler,
                 &Projektinfo, &Rediger data tabeller); its Rapporter… is replaced by our three named report
                 entries, kept below a separator as Bibliotek keeps its extensions. -->
            <MenuItem Header="_Dokumentation" a:AutomationProperties.AutomationId="MenuDocumentation">
                <MenuItem Header="_Datalinie moduler…" Command="{Binding ModuleMapCommand}"
                          IsEnabled="{Binding Registry.Bar[project.moduleMap].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[project.moduleMap].Reason}"/>
                <MenuItem Header="_Projektinfo…" Command="{Binding ProjectInfoCommand}"
                          IsEnabled="{Binding Registry.Bar[project.info].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[project.info].Reason}"/>
                <MenuItem Header="_Rediger data tabeller…" Command="{Binding DataTablesCommand}"
                          IsEnabled="{Binding Registry.Bar[project.dataTables].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[project.dataTables].Reason}"/>
                <Separator/>
                <MenuItem Header="_Funktionsdokumentation…" Command="{Binding FunctionsReportCommand}"
                          IsEnabled="{Binding Registry.Bar[reports.functions].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[reports.functions].Reason}"/>
                <MenuItem Header="_Installationsdokumentation…" Command="{Binding InstallationReportCommand}"
                          IsEnabled="{Binding Registry.Bar[reports.installation].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[reports.installation].Reason}"/>
                <!-- "_blok", not "_dokumentation": D is _Datalinie moduler…'s key in this same menu. -->
                <MenuItem Header="Functions_blok dokumentation…" Command="{Binding FunctionBlocksReportCommand}"
                          IsEnabled="{Binding Registry.Bar[reports.functionBlocks].Enabled}"
                          ToolTip.Tip="{Binding Registry.Bar[reports.functionBlocks].Reason}"/>
            </MenuItem>

            <MenuItem Header="_Hjælp" a:AutomationProperties.AutomationId="MenuHelp">
                <MenuItem Header="_Hjælpe emner" Command="{Binding HelpCommand}" InputGesture="F1"/>
                <Separator/>
                <MenuItem Header="Vis indstillinger" Command="{Binding ShowSettingsCommand}"/>
                <MenuItem Header="Telemetridiagnostik" Command="{Binding TelemetryDiagnosticsCommand}"/>
                <Separator/>
                <MenuItem Header="_Om IHC OpenVisual…" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ============ Toolbar ============ -->
        <!-- Landmark: lets a screen-reader user jump straight to the command chrome instead of walking the tree.
             AccessibilityView MUST accompany it — Narrator ignores a landmark below Control, so the annotation
             would look present and do nothing. Same for the status bar and the two panes below. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding IsToolbarVisible}"
                a:AutomationProperties.LandmarkType="Banner"
                a:AutomationProperties.AccessibilityView="Control"
                a:AutomationProperties.Name="Toolbar"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <StackPanel.Styles>
                    <Style Selector="Button.tool">
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style Selector="svg|Svg.toolicon">
                        <Setter Property="Width" Value="18"/>
                        <Setter Property="Height" Value="18"/>
                        <!-- Icons are decorative; the accessible name lives on the parent Button. Keep the glyph
                             out of the automation tree so it is not announced separately. -->
                        <Setter Property="a:AutomationProperties.AccessibilityView" Value="Raw"/>
                    </Style>
                    <Style Selector="Rectangle.toolsep">
                        <Setter Property="Width" Value="1"/>
                        <Setter Property="Margin" Value="5,3"/>
                        <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
                    </Style>
                </StackPanel.Styles>

                <!-- Every toolbar button takes its enabled state from its row's Toolbar availability, including the
                     four that are always allowed today: leaving them unbound would put part of the toolbar's rule in
                     the markup by omission, so a row that later gains a gate would silently keep its button live. -->
                <Button Classes="tool" Command="{Binding NewCommand}" ToolTip.Tip="Nyt projekt (Ctrl+N)"
                        IsEnabled="{Binding Registry.Toolbar[file.new].Enabled}"
                        a:AutomationProperties.Name="Nyt projekt" a:AutomationProperties.AutomationId="ToolbarNew">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_new.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding OpenCommand}" ToolTip.Tip="Åbn projekt (Ctrl+O)"
                        IsEnabled="{Binding Registry.Toolbar[file.open].Enabled}"
                        a:AutomationProperties.Name="Åbn projekt" a:AutomationProperties.AutomationId="ToolbarOpen">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_open.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="Gem projekt (Ctrl+S)"
                        IsEnabled="{Binding Registry.Toolbar[file.save].Enabled}"
                        a:AutomationProperties.Name="Gem projekt" a:AutomationProperties.AutomationId="ToolbarSave">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_save.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>

                <Rectangle Classes="toolsep"/>
                <Button Classes="tool" Command="{Binding AboutCommand}" ToolTip.Tip="Hjælp / Om"
                        IsEnabled="{Binding Registry.Toolbar[help.about].Enabled}"
                        a:AutomationProperties.Name="Hjælp og Om" a:AutomationProperties.AutomationId="ToolbarHelp">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_help.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>

                <Rectangle Classes="toolsep"/>
                <!-- T020: real registry-bound buttons (the toolbar is a persistent surface — it greys, never
                     hides). Tooltips stay the static captions: the T016 spike proved a DISABLED control shows
                     no tooltip, so disabled reasons surface via the T021 status-bar handler instead. -->
                <Button Classes="tool" Command="{Binding RetrieveProjectCommand}"
                        IsEnabled="{Binding Registry.Toolbar[controller.retrieve].Enabled}"
                        ToolTip.Tip="Hent fra controller"
                        a:AutomationProperties.Name="Hent fra controller" a:AutomationProperties.AutomationId="ToolbarRetrieve">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_retrieve.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding SendProjectCommand}"
                        IsEnabled="{Binding Registry.Toolbar[controller.send].Enabled}"
                        ToolTip.Tip="Send til controller (F5)"
                        a:AutomationProperties.Name="Send til controller" a:AutomationProperties.AutomationId="ToolbarSend">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_send.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>

                <Rectangle Classes="toolsep"/>
                <Button Classes="tool" Command="{Binding CutCommand}"
                        IsEnabled="{Binding Registry.Toolbar[edit.cut].Enabled}"
                        ToolTip.Tip="Klip (Ctrl+X)"
                        a:AutomationProperties.Name="Klip" a:AutomationProperties.AutomationId="ToolbarCut">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_cut.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding CopyCommand}"
                        IsEnabled="{Binding Registry.Toolbar[edit.copy].Enabled}"
                        ToolTip.Tip="Kopier (Ctrl+C)"
                        a:AutomationProperties.Name="Kopier" a:AutomationProperties.AutomationId="ToolbarCopy">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_copy.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
                <Button Classes="tool" Command="{Binding PasteCommand}"
                        IsEnabled="{Binding Registry.Toolbar[edit.paste].Enabled}"
                        ToolTip.Tip="Indsæt (Ctrl+V)"
                        a:AutomationProperties.Name="Indsæt" a:AutomationProperties.AutomationId="ToolbarPaste">
                    <svg:Svg Classes="toolicon" Path="/Assets/toolbar_paste.svg" CurrentColor="{DynamicResource IconColor}"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Status bar ============ -->
        <Border Name="StatusBar" DockPanel.Dock="Bottom" IsVisible="{Binding IsStatusBarVisible}"
                a:AutomationProperties.LandmarkType="ContentInfo"
                a:AutomationProperties.AccessibilityView="Control"
                a:AutomationProperties.Name="Statuslinje"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0"
                Padding="8,3">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- A POLITE live region, and not a nicety: this is where a REFUSED shortcut's reason is written
                     (T021 branch B — a disabled control shows no tooltip, so the status bar is the only channel).
                     Without a live setting that explanation is announced to nobody, leaving a screen-reader user
                     the one user who never learns why a key did nothing. Polite, not Assertive: it must not
                     interrupt what the reader is already saying. -->
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center"
                           a:AutomationProperties.LiveSetting="Polite"
                           FontSize="{DynamicResource CaptionFontSize}"/>
                <!-- Controller-connection indicator (W9/F10): the reference application carries one at this end of
                     the status bar. The two states are two GLYPHS, never one glyph recoloured. -->
                <svg:Svg Name="ControllerConnectionIndicator" Grid.Column="1"
                         Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                         Path="{Binding ControllerConnectionIcon}"
                         ToolTip.Tip="{Binding ControllerConnectionText}"
                         a:AutomationProperties.Name="{Binding ControllerConnectionText}"/>
                <!-- Locale indicator: Danish flag -->
                <Border Grid.Column="2" Width="20" Height="14" Background="#C8102E" ToolTip.Tip="Dansk projektsprog"
                        a:AutomationProperties.Name="Dansk projektsprog">
                    <Canvas>
                        <Rectangle Canvas.Left="6" Canvas.Top="0" Width="2.5" Height="14" Fill="White"/>
                        <Rectangle Canvas.Left="0" Canvas.Top="5.75" Width="20" Height="2.5" Fill="White"/>
                    </Canvas>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Two tree panes with a splitter ============ -->
        <Grid ColumnDefinitions="*,Auto,*">
            <!-- Both panes are Region landmarks rather than Main/Complementary: they carry equal weight in this
                 shell, and Main is singular. A Region is only navigable if it is NAMED, so each takes its pane
                 header as its accessible name — which also keeps the two apart in a landmark list. -->
            <DockPanel Grid.Column="0"
                       a:AutomationProperties.LandmarkType="Region"
                       a:AutomationProperties.AccessibilityView="Control"
                       a:AutomationProperties.Name="{Binding InstallationPaneHeader}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBackgroundBrush}" Padding="10,5">
                    <TextBlock Text="{Binding InstallationPaneHeader}" Foreground="{DynamicResource PaneHeaderForegroundBrush}"
                               FontWeight="SemiBold" FontSize="{DynamicResource BodyFontSize}"/>
                </Border>
                <controls:AccessibleTreeView x:Name="InstallationTree" ItemsSource="{Binding InstallationNodes}" KeyDown="OnTreeKeyDown"
                          SelectedItem="{Binding SelectedInstallationNode, Mode=TwoWay}"
                          ContextFlyout="{StaticResource NodeContextMenu}"
                          ItemContainerTheme="{StaticResource TreeNodeItemTheme}"
                          ItemTemplate="{StaticResource TreeNodeTemplate}"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

            <DockPanel Grid.Column="2"
                       a:AutomationProperties.LandmarkType="Region"
                       a:AutomationProperties.AccessibilityView="Control"
                       a:AutomationProperties.Name="{Binding FunctionsPaneHeader}">
                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBackgroundBrush}" Padding="10,5">
                    <TextBlock Text="{Binding FunctionsPaneHeader}" Foreground="{DynamicResource PaneHeaderForegroundBrush}"
                               FontWeight="SemiBold" FontSize="{DynamicResource BodyFontSize}"/>
                </Border>
                <controls:AccessibleTreeView x:Name="FunctionsTree" ItemsSource="{Binding FunctionNodes}" KeyDown="OnTreeKeyDown"
                          SelectedItem="{Binding SelectedFunctionsNode, Mode=TwoWay}"
                          ContextFlyout="{StaticResource NodeContextMenu}"
                          ItemContainerTheme="{StaticResource TreeNodeItemTheme}"
                          ItemTemplate="{StaticResource TreeNodeTemplate}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
