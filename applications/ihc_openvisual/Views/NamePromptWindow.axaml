<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a="using:Avalonia.Automation"
        xmlns:controls="using:ihc_openvisual.Controls"
        x:Class="ihc_openvisual.Views.NamePromptWindow"
        a:AutomationProperties.AutomationId="NamePromptWindow"
        Title="Navn"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <StackPanel Margin="16" Spacing="12">
        <!-- The vendor frames the single field in a "Navn" group box; the header doubles as the field's label. -->
        <controls:AccessibleGroupBox Name="NameGroup" Header="Navn">
            <TextBox Name="NameBox" Margin="8"
                     a:AutomationProperties.Name="Navn"/>
        </controls:AccessibleGroupBox>
        <!-- Why OK refused. Hidden until it happens, and announced when it appears: a polite live region is the
             only way a screen-reader user learns of a refusal that changes nothing on screen but this line. -->
        <!-- The text is set from the SDK's coded required-field problem when OK refuses (T045); the markup
             states no sentence of its own. -->
        <TextBlock Name="NameError" IsVisible="False"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ErrorBrush}"
                   a:AutomationProperties.AutomationId="NamePromptError"
                   a:AutomationProperties.LiveSetting="Polite"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
            <Button Name="CancelButton" Content="Annuller" MinWidth="84" IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </StackPanel>
</Window>
