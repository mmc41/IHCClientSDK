<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ihc_openvisual.ViewModels"
        xmlns:svc="clr-namespace:ihc_openvisual.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="330"
        x:Class="ihc_openvisual.Views.DataTablesWindow"
        x:DataType="vm:DataTablesViewModel"
        Title="Rediger data tabeller"
        Width="600" Height="330"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Styles>
        <!-- The same captioned group box the other Dokumentation dialogs use; a Grid, not a StackPanel, so the
             '*' row hands the group's own height down to the list inside it. -->
        <Style Selector="HeaderedContentControl.group">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="{TemplateBinding Header}" FontWeight="SemiBold"
                                   Margin="2,0,0,4"/>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <!-- OK commits the working copy, Annuller discards it — the vendor's two buttons. -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                    Margin="0,12,0,0">
            <Button Name="OkButton" Content="OK" MinWidth="84" IsDefault="True" Click="OnOk"/>
            <Button Name="CancelButton" Content="Annuller" MinWidth="84" IsCancel="True" Click="OnCancel"/>
        </StackPanel>

        <!-- Tabeller on the left, the selected table's texts on the right, as the vendor stacks them. -->
        <Grid ColumnDefinitions="*,12,*">
            <HeaderedContentControl Grid.Column="0" Classes="group" Header="Tabeller">
                <ListBox Name="TablesList" ItemsSource="{Binding Tables}"
                         SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                         a:AutomationProperties.Name="Tabeller">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:DataTableDefinition">
                            <!-- The caption, not the record: without this the row's accessible name was the
                                 record's ToString(), which a screen reader read out in full. -->
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Column="2" Classes="group" Header="Bruger definerede tekster">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0"
                                HorizontalAlignment="Center">
                        <Button Name="AddButton" Content="Tilføj" MinWidth="75" Command="{Binding AddTextCommand}"/>
                        <Button Name="EditButton" Content="Rediger" MinWidth="75" Command="{Binding EditTextCommand}"
                                IsEnabled="{Binding HasSelectedText}"/>
                        <Button Name="DeleteButton" Content="Slet" MinWidth="75" Command="{Binding DeleteTextCommand}"
                                IsEnabled="{Binding HasSelectedText}"/>
                    </StackPanel>
                    <ListBox Name="TextsList" ItemsSource="{Binding Texts}"
                             SelectedItem="{Binding SelectedText, Mode=TwoWay}"
                             a:AutomationProperties.Name="Bruger definerede tekster"/>
                </DockPanel>
            </HeaderedContentControl>
        </Grid>
    </DockPanel>
</Window>
