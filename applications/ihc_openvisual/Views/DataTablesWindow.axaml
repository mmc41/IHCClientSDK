<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ihc_openvisual.ViewModels"
        xmlns:svc="clr-namespace:ihc_openvisual.Services"
        xmlns:vis="clr-namespace:Ihc.Vis;assembly=ihcclient"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="420"
        x:Class="ihc_openvisual.Views.DataTablesWindow"
        x:DataType="vm:DataTablesViewModel"
        Title="Data tabeller"
        Width="560" Height="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16" ColumnDefinitions="*,12,*" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Name="SystemTablesLabel" Text="System tabeller (skrivebeskyttet)" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Name="UserTextsLabel" Text="Brugerdefinerede tekster" FontWeight="Bold" Margin="0,0,0,6"/>

        <!-- System tables: each table name then its reference rows, read-only -->
        <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding SystemTables}" IsEnabled="False"
                 a:AutomationProperties.LabeledBy="{Binding #SystemTablesLabel}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vis:DataTableView">
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="12,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- User-defined texts: editable list -->
        <ListBox Grid.Row="1" Grid.Column="2" x:Name="UserTextsList"
                 ItemsSource="{Binding UserTexts}" SelectedItem="{Binding SelectedUserText, Mode=TwoWay}"
                 a:AutomationProperties.LabeledBy="{Binding #UserTextsLabel}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:UserTextItem">
                    <TextBlock Text="{Binding Text}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <Button Content="Tilføj" Command="{Binding AddTextCommand}"/>
            <Button Content="Rediger" Command="{Binding EditTextCommand}"/>
            <Button Content="Slet" Command="{Binding DeleteTextCommand}"/>
        </StackPanel>

        <Button Grid.Row="2" Grid.Column="0" Content="Luk" MinWidth="84" IsCancel="True"
                HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnClose"/>
    </Grid>
</Window>
