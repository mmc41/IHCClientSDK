<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:a="using:Avalonia.Automation"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="280"
        x:Class="ihc_openvisual.Views.AboutWindow"
        Title="Om IHC OpenVisual"
        Width="420" Height="290"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Window.Styles>
        <!-- A hyperlink rendered as a Button so it is keyboard-focusable and activatable with Enter/Space
             (accessibility), while still looking like an inline link. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}"/>
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>
    <StackPanel Margin="24" Spacing="10">
        <TextBlock Text="IHC OpenVisual"
                   FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Name="AppDescription"
                   FontSize="{DynamicResource BodyFontSize}"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
            <TextBlock Text="Kilde:" VerticalAlignment="Center"/>
            <Button Name="RepoLink" Classes="link"
                    Click="OnRepoLinkClick"
                    a:AutomationProperties.Name="Åbn kildekode-arkivet i browseren"
                    VerticalAlignment="Center">
                <TextBlock Name="RepoLinkText" TextDecorations="Underline"/>
            </Button>
        </StackPanel>

        <TextBlock Name="RepoAuthors"
                   FontSize="{DynamicResource BodyFontSize}"
                   HorizontalAlignment="Center"/>

        <StackPanel HorizontalAlignment="Center" Spacing="2" Margin="0,6,0,0">
            <TextBlock Name="AppVersionText"
                       FontSize="{DynamicResource CaptionFontSize}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Name="SdkVersionText"
                       FontSize="{DynamicResource CaptionFontSize}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Button Content="Luk" MinWidth="84"
                HorizontalAlignment="Center" Margin="0,8,0,0"
                IsCancel="True" IsDefault="True" Click="OnCloseClick"/>
    </StackPanel>
</Window>
