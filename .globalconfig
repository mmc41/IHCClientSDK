# Repository-wide analyzer rule selection.
#
# The built-in .NET analyzers ship ~450 rules and enable about thirty of them as warnings by default.
# Raising the whole set (AnalysisMode=All) was measured before writing this file: 7,092 findings, of which
# 5,442 come from four rules that do not apply repo-wide — CA1707 (underscores in test method names), CA1515
# (public types in an application assembly), CA1861 (constant arrays in test data), and CA2007, which
# demands the ConfigureAwait call that the OpenVisual architecture rules ban outright. Enabling the mode
# would therefore have bought noise plus one rule contradicting an architectural decision.
#
# CA2007 is not absent, it is scoped: it is enabled for the SDK in ihcclient/analyser.config, where a library
# must not resume on its caller's context. Why it can go there and nowhere else is recorded in ADR-001.
#
# So the rules are opted into individually, and the ones listed here share a property: a violation is a
# defect or a latent one, not a matter of taste. Anything that is a style or naming preference belongs in
# .editorconfig, not here. The security category is enabled wholesale instead — as a mode property in
# Directory.Build.props, since it costs one finding.
#
# This is a global AnalyzerConfig: entries apply to a whole compilation, not to a path. Path-scoped
# severity goes in an .editorconfig (see tests/.editorconfig, and ihcclient/generatedsrc/.editorconfig).
#
# Adding a rule here means fixing its findings in the same change: warnings are errors repo-wide.

is_global = true

# ── Resource lifetime ────────────────────────────────────────────────────────────────────────────────
dotnet_diagnostic.CA1001.severity = warning  # type owns a disposable field but is not disposable
dotnet_diagnostic.CA1063.severity = warning  # IDisposable implemented incorrectly
dotnet_diagnostic.CA1816.severity = warning  # Dispose() does not call GC.SuppressFinalize
dotnet_diagnostic.CA2000.severity = warning  # disposable lost before it is disposed
dotnet_diagnostic.CA2213.severity = warning  # disposable field never disposed
dotnet_diagnostic.CA2215.severity = warning  # Dispose does not call base.Dispose
dotnet_diagnostic.CA2025.severity = warning  # disposable handed to a task nobody awaits

# ── Async and cancellation ───────────────────────────────────────────────────────────────────────────
dotnet_diagnostic.CA1849.severity = warning  # synchronous call blocking inside an async method
dotnet_diagnostic.CA2012.severity = warning  # ValueTask consumed more than once
dotnet_diagnostic.CA2016.severity = warning  # CancellationToken not forwarded to a call that takes one

# ── Exceptions ───────────────────────────────────────────────────────────────────────────────────────
dotnet_diagnostic.CA2201.severity = warning  # throwing a reserved type nobody can catch selectively
dotnet_diagnostic.CA2208.severity = warning  # argument exception naming a parameter that does not exist
dotnet_diagnostic.CA2219.severity = warning  # throw inside finally, discarding the original exception

# ── Silently wrong code ──────────────────────────────────────────────────────────────────────────────
dotnet_diagnostic.CA1806.severity = warning  # result of a call ignored (TryParse, LINQ, string methods)
dotnet_diagnostic.CA1508.severity = warning  # condition that can never change the outcome
dotnet_diagnostic.CA2011.severity = warning  # property assigning to itself — unbounded recursion
dotnet_diagnostic.CA2019.severity = warning  # ThreadStatic field with an initializer only one thread sees
dotnet_diagnostic.CA2020.severity = warning  # built-in operator whose overflow behaviour changed in .NET 7
dotnet_diagnostic.CA2245.severity = warning  # property assigned to itself
dotnet_diagnostic.CA2246.severity = warning  # symbol and its member assigned in one statement
dotnet_diagnostic.CA2248.severity = warning  # HasFlag called with the wrong enum type
dotnet_diagnostic.CA2211.severity = warning  # mutable static field visible outside its type

# ── Diagnostics that must stay machine-readable ──────────────────────────────────────────────────────
# A log call whose template is built per call defeats structured logging: every call becomes its own
# message shape, so the field cannot be queried in OpenObserve — which is where this repo diagnoses runs.
dotnet_diagnostic.CA2254.severity = warning

# ── Argument contracts ───────────────────────────────────────────────────────────────────────────────
# CA1062 asks every externally visible entry point to refuse a null it is about to dereference. Like a few of
# the rules above it, the test suites turn it back off; tests/.editorconfig says why, and the reason is its
# own rather than the one those share.
#
# It was the SDK's rule first, in ihcclient/analyser.config, on a ground only ihcclient has. That is the
# project which PACKS — the csproj carries the version, the copyright and the schema's PackagePath — so its
# consumers compile under settings this repository does not choose. Nullable reference types are on
# everywhere here, so a caller built in this solution already cannot pass null to a non-nullable parameter
# without a warning of its own; a null arriving from a nullable-OBLIVIOUS assembly is invisible to the
# compiler on both sides, and without a guard it surfaces as a NullReferenceException raised somewhere inside
# the SDK, naming no parameter and pointing at no call site.
#
# No other project in this repository has such a consumer, so extending the rule to all of them is a decision
# about the CONVENTION rather than about the consumer: one shape for refusing a bad argument, at the door,
# everywhere that ships. What the applications and utilities get out of it is not protection from a caller
# that cannot exist — it is that a wrong argument is named where it was passed instead of dereferenced three
# frames later. The convention was already theirs; the rule is what makes it mechanical.
#
# What extending it cost was measured, not assumed: 103 findings, all in five projects — the two Avalonia
# applications, the project IO extractor and the two bootstrap libraries. Every one was fixed with
# ArgumentNullException.ThrowIfNull as the member's first statement, and the remaining non-test projects were
# already clean. Two findings were not a missing guard at all, and they are the argument for the rule over the
# convention: DialogFieldTemplate.Build reached its `object?` parameter through the null-forgiving operator,
# which the guard let it drop, and the Avalonia-to-ILogger sink read a `params` array the framework is free to
# pass as null. The rest of the churn is syntax: an expression-bodied member has nowhere to put a first
# statement, so the ones that were flagged were widened to block bodies.
dotnet_diagnostic.CA1062.severity = warning

# ── Correct API selection ────────────────────────────────────────────────────────────────────────────
dotnet_diagnostic.CA1854.severity = warning  # double dictionary lookup instead of TryGetValue
dotnet_diagnostic.CA2249.severity = warning  # IndexOf compared against -1 instead of Contains
dotnet_diagnostic.CA2263.severity = warning  # Type-taking overload where a generic one exists

# ═══════════════════════════════════════════════════════════════════════════════════════════════════
# Rules DECLINED out of AnalysisMode=Recommended, repo-wide.
#
# Everything above this line is a rule opted INTO on top of the SDK default. Everything below is the
# opposite: a rule the mode turns on that this repository turns back off. The two halves are kept apart
# because they answer different questions — above is "what does a violation mean here", below is "why is
# this rule not measuring anything here".
#
# A rule belongs below only if its findings are, across the whole repository, either not defects or not
# fixable without a change bigger than the rule is worth. A rule whose findings are merely INCONVENIENT
# gets fixed instead. Rules the SDK alone declines live in ihcclient/analyser.config, not here.
# ═══════════════════════════════════════════════════════════════════════════════════════════════════

# The declines here are the ones that hold for EVERY project. A rule declined for one part of the tree is
# scoped by path instead, in an .editorconfig beside the code it covers — applications/, utilities/ and
# shared/ each carry one. Rules the SDK alone declines live in ihcclient/analyser.config.

# CA1848 (use the LoggerMessage delegates) is off. It is a rule about the COST of a log call, and none of
# the call sites it reaches here is on a path where that cost is measurable.
#
# All of them sit in the Avalonia applications and the bootstrap libraries beneath them, and what they log is
# lifecycle: a window opening, a project loading, a dialog answered, a telemetry exporter starting, an
# unhandled exception on the way to a crash dialog. These fire once per user gesture or once per process.
# The allocation CA1848 removes — the boxed argument array on a call the framework may discard — is worth
# removing in a request loop; against a keystroke it is not.
#
# The SDK is not exempted from this, it is unreachable by it: Ihc has no logging dependency at all (the
# architecture invariant in CLAUDE.md), so a LoggerMessage delegate has nowhere to live there. That is why
# the entry is repo-wide rather than scoped: there is no path it could be narrowed to.
#
# What CA1848 would cost is the part that argues it down. Satisfying it means a partial method and a
# distinct EventId per site, which is a mechanical rewrite of every log statement in both GUIs — and the
# property this repository actually depends on is not allocation but that the TEMPLATE stays constant, so a
# message shape can be queried in OpenObserve. That property is enforced separately and unconditionally by
# CA2254 above, which is on repo-wide and stays on.
dotnet_diagnostic.CA1848.severity = none

# CA1873 (evaluation of this argument may be expensive if logging is disabled) is off. The rule is a
# syntactic heuristic: it flags any log argument that is not a constant, a local or a plain field, because it
# cannot tell a cheap expression from an expensive one.
#
# Every finding here is cheap in fact. Most are a property read on an object already in hand — ex.Message on
# an exception already caught, parameters[i].Name on an array already indexed, source?.GetType().Name. Two
# are a call rather than a read (MapFromAvaloniaLogToILogLevel), and that is still a switch over an enum
# argument the caller already has. None of them allocates, queries, formats or serializes.
#
# Some are worse than merely pointless: they are in the unhandled-exception and dispatcher-exception
# handlers, on the way to a crash. A log call there must not be conditional on the logger's level, and the
# repository asserts that real output reaches a real ILogger from exactly those handlers — see
# safe_visual_tests/UnhandledExceptionTests.cs and GlobalExceptionHandlerTests.cs.
#
# The rule would earn its place against a ToString() over a collection, or a serialization, in an argument.
# Nothing enforces that promise mechanically, so it is a reason to re-measure if the logging in these hosts
# grows — not a guarantee that it stays true on its own.
dotnet_diagnostic.CA1873.severity = none

# CA1822 (mark members as static) is SCOPED rather than switched off: it stays in force on private and
# internal members, where adding `static` costs nothing and states something true, and is lifted from the
# public surface, where it is not a performance question at all.
#
# In the applications the reason is data binding. A view-model property is reached by name from XAML, and a
# binding resolves against the DataContext INSTANCE — promoting one to static does not fail to compile, it
# silently binds to nothing at runtime. ProductDialogSettingsGridViewModel.Name and .AutomationId are exactly
# that: the accessible name and the automation id the headless UI suite locates the grid by.
#
# In the SDK the reason is different — C# forbids calling a static member through an instance reference, so
# promoting a public one is source- and binary-breaking for consumers — and ihcclient/analyser.config states
# it there against the facades it fires on. The setting is the same either way, so it is written once here.
dotnet_code_quality.CA1822.api_surface = private, internal
