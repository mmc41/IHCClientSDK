<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Stages the .pdb files that ship in the referenced packages, so a break in Lab can be stepped into
         Avalonia rather than stopping at the assembly boundary. This is the GUI the SDK is explored from,
         so that matters more here than in an application. Local diagnosis only: symbols are not shipped. -->
    <CopyDebugSymbolFilesFromPackages>true</CopyDebugSymbolFilesFromPackages>
    <!-- Writes System.Runtime.InteropServices.BuiltInComInterop.IsSupported=true into runtimeconfig.json.
         Redundant for an ordinary build, where that is already the default, and not for a trimmed or AOT
         publish, which turns the switch off unless a project asks for it — and Avalonia's Win32 backend
         reaches the shell through built-in COM. Stated rather than inherited for that reason. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.9.0</Version>
    <InformationalVersion>This is a beta version</InformationalVersion>
    <AssemblyTitle>IHC Lab</AssemblyTitle>
    <Product>IHC Lab</Product>
    <CopyIhcSettingsToOutput>true</CopyIhcSettingsToOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FakeItEasy" />
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj" />
    <ProjectReference Include="..\..\shared\ihc_appbootstrap\ihc_appbootstrap.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
