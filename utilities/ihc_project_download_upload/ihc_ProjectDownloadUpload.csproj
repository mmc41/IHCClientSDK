<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CopyIhcSettingsToOutput>true</CopyIhcSettingsToOutput>
  </PropertyGroup>
  <ItemGroup>
    <!-- T044/R17 check three: the architecture suite calls this utility's own console renderer with an arbitrary
         SDK problem, and reads this assembly's references to prove it needs no GUI. -->
    <InternalsVisibleTo Include="safe_architecture_tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ihcclient\ihcclient.csproj"/>
    <!-- The shared telemetry bootstrap: this utility no longer builds its own providers. The
         toolkit-NEUTRAL half, so referencing it pulls in no UI toolkit. -->
    <ProjectReference Include="..\..\shared\ihc_telemetrybootstrap\ihc_telemetrybootstrap.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json"/>
  </ItemGroup>
</Project>
