# Repository-wide editor and analyzer configuration.
#
# Scope note: this file currently exists for ONE purpose — pinning the severity of Avalonia's XAML diagnostics
# (AVLN*) deliberately rather than leaving them at framework defaults (Avalonia logging/debugging review BP-16,
# QC-07). Formatting and .NET style rules are intentionally NOT configured here; adding them would reformat a
# large existing codebase and is a separate decision.
#
# Why this is not redundant with Directory.Build.props: TreatWarningsAsErrors=true already promotes every AVLN
# WARNING to an error, which is the blunt half. What it cannot do is raise a diagnostic Avalonia emits below
# warning level. The entries below name the cases the team wants to fail the build regardless of the level
# Avalonia ships them at, so a future Avalonia release that downgrades one cannot silently un-gate it.

root = true

# LF, because that is what the working tree actually holds for source (verified, not assumed) — declaring crlf
# here would make every editor rewrite every file on save. Line endings that MATTER are pinned per-pattern in
# .gitattributes instead (the .vis/.def/.ifb oracles check out CRLF, the report oracles LF, because the
# serializers hardcode one and the report generator the other); this file must not contradict that, so the
# fixture tree is left unset below.
[*]
end_of_line = lf
insert_final_newline = true

[tests/testdata/**]
end_of_line = unset
insert_final_newline = unset

[*.{cs,axaml,xaml}]
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json}]
indent_style = space
indent_size = 2

# ── Avalonia XAML diagnostics ────────────────────────────────────────────────────────────────────────────────
# A binding, resource or template defect that reaches runtime shows up as a silently empty control, so these are
# build errors here rather than advisory output.
[*.{axaml,xaml}]
# Use of a member marked [Obsolete] from XAML. (Note: the docs cite AVLN2001 for this; the shipped code defines
# AVLN5001 and no AVLN2001 at all — the framework's own .editorconfig agrees on AVLN5001.)
avalonia_xaml_diagnostic.AVLN5001.severity = error

# ── Generated SOAP layer: oblivious nullability (RS0041) ─────────────────────────────────────────────────────
# The generated layer is public only because XmlSerializer requires it (ADR-003) and is not part of the SDK's
# contract, so the nullability of its members states nothing a caller should rely on. It is generated without
# a nullable context and generate.ps1/generate.sh rewrite the directory wholesale, so annotating it is neither
# possible to keep nor meaningful to read -- the same grounds on which generatedsrc/.editorconfig already
# excludes it from the public-API baseline (RS0016).
#
# Scoped from HERE rather than from generatedsrc/.editorconfig, but NOT because a file there would not last:
# generate.ps1/generate.sh remove only generatedsrc/*.cs and *.json, so that file survives regeneration -- which
# is exactly what its own note says, and it is the reason RS0016 can live inside the folder and cover generated
# files that do not exist yet. The two placements are technically interchangeable; this one keeps the rule
# visible from the root, beside the other repo-wide severities, rather than inside a directory that is off
# limits to hand edits. Move it only deliberately -- ihcclient/analyser.config names both placements, and a
# reader who finds one and assumes it is the whole answer is the failure this note exists to prevent.
[ihcclient/generatedsrc/**.cs]
dotnet_diagnostic.RS0041.severity = none
