is_global = true

# CA2007 is enabled for the SDK and NOWHERE ELSE in the repository, which is why it lives in this
# project-scoped file rather than in the repo-wide /.globalconfig.
#
# The SDK is a library: it must not resume a caller's continuation on whatever context the caller happened
# to be on, and it already says so 234 times through ConfigureAwait(settings.AsyncContinueOnCapturedContext)
# - a per-caller choice that defaults to false. The rule makes the convention mechanical rather than
# remembered; before it was turned on, the api tier held it at 191 of 192 awaits and the app tier at 43 of 62.
#
# It must NOT be turned on repo-wide. Both Avalonia apps and both headless Avalonia test suites need the
# opposite rule - a pool-thread continuation there corrupts bound collections, which is why
# OpenVisualThreadingArchitectureTests bans the call outright - and in the remaining test suites the rule is
# noise. Measured: 2,297 findings repo-wide, of which 2,256 sit in code that must not satisfy it.
dotnet_diagnostic.CA2007.severity = warning

# Public-API baseline: the two optional-parameter backcompat rules are off.
#
# RS0026 (no multiple overloads with optional parameters) and RS0027 (an API with optional parameters
# should have the most parameters among its overloads) are API *design* rules, not part of pinning a
# surface. They fire on 66 existing signatures — concentrated in the builder APIs and ProjectAppService —
# where the overload sets are the intended shape. Satisfying them would mean redesigning public API to
# suit a lint rule. The baseline files themselves remain the change gate (RS0016/RS0017).
dotnet_diagnostic.RS0026.severity = none
dotnet_diagnostic.RS0027.severity = none

# RS0041 (public member declared with oblivious nullability) is ON, and keeps the SDK's public surface
# annotated now that it is. It was off while the surface was still being migrated, because it would have
# failed the build once per member for a condition that was known and deliberately incremental; that
# migration is done, the authored surface raises RS0041 nowhere, and the rule is what stops it regressing.
# The generated SOAP layer is scoped out of this rule from the ROOT .editorconfig -- see the note there for
# why the exclusion cannot live inside generatedsrc/.
dotnet_diagnostic.RS0041.severity = warning
