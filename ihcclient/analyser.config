is_global = true

# global_level is STATED, and it has to be. Roslyn's implicit level is 100 for a file literally named
# .globalconfig and 0 for every other global config, so without this line the repo-wide /.globalconfig
# outranks this file on any key they share — and it wins SILENTLY, with no diagnostic and a green build.
#
# That matters most for the very next entry. CA2007 is enabled here and is the mechanical basis of ADR-001's
# position; at the implicit level, the day anyone writes CA2007 into /.globalconfig the SDK's opt-in dies
# without a trace. 200 says this file is the more specific of the two and is meant to win.
global_level = 200

# CA2007 is enabled for the SDK and NOWHERE ELSE in the repository, which is why it lives in this
# project-scoped file rather than in the repo-wide /.globalconfig.
#
# The SDK is a library: it must not resume a caller's continuation on whatever context the caller happened
# to be on, and it already says so 234 times through ConfigureAwait(settings.AsyncContinueOnCapturedContext)
# - a per-caller choice that defaults to false. The rule makes the convention mechanical rather than
# remembered; before it was turned on, the api tier held it at 191 of 192 awaits and the app tier at 43 of 62.
#
# It must NOT be turned on repo-wide. Both Avalonia apps and both headless Avalonia test suites need the
# opposite rule - a pool-thread continuation there corrupts bound collections, which is why
# OpenVisualThreadingArchitectureTests bans the call outright - and in the remaining test suites the rule is
# noise. Measured: 2,297 findings repo-wide, of which 2,256 sit in code that must not satisfy it.
dotnet_diagnostic.CA2007.severity = warning

# Not every decision about this project lives in this file, so grep here is not the whole answer:
#
#   - Three rules are scoped by PATH, which a global config cannot express because it applies to a whole
#     compilation — so each lives in an .editorconfig instead, and they do NOT all live in the same one:
#       * CA1861 (constant array arguments), off for ihcclient/src/vis/catalog/definitions/ alone, in an
#         .editorconfig in that folder.
#       * RS0016 (public API baseline), off for the generated SOAP layer, in generatedsrc/.editorconfig —
#         inside the folder, so it covers generated files that do not exist yet, and generate.ps1/generate.sh
#         delete only *.cs and *.json, so it survives regeneration.
#       * RS0041 (nullable public API), off for the same folder but scoped from the ROOT .editorconfig via
#         [ihcclient/generatedsrc/**.cs] — NOT from inside it, and NOT for a reason that makes the two
#         placements different in kind. Looking for it beside RS0016 and concluding it is unscoped is the
#         mistake this bullet exists to prevent; the note at the bottom of this file says the same thing.
#   - CA1822 is scoped in /.globalconfig, where the applications reached the same setting independently.
#
# Everything else this project declines is below, as a setting rather than only as prose.

# What a `severity = none` below does and does not give up, since every one of them is justified by naming
# EXISTING symbols and the question of new code is fair to ask.
#
# These are naming and shape rules, and their default scope is the externally visible surface — which in this
# project includes internal members, because InternalsVisibleTo makes them visible (that is why CA1068 reaches
# the internal ServiceHelpers). So switching one off gives up nothing over private code, gives up the public
# surface to PublicAPI.Shipped.txt, and gives up a narrow internal slice outright.
#
# The public half is the larger one and it is not ungated: a new public member does not compile until it is
# added to PublicAPI.Unshipped.txt, so a new violation still arrives as a reviewed line in the baseline diff
# rather than silently. The internal slice has no such gate; it is accepted as the price of a rule that cannot
# be satisfied on the shipped symbols it fires on.
#
# Narrowing to `api_surface = private, internal` is NOT the better answer, and this was measured rather than
# assumed: it does not restrict these rules, it MOVES them onto surface they never covered, and the
# transcribed catalogue tables alone — whose factory names are vendor identifiers like Product_0x3103 --
# then dominate the report. Per-symbol suppressions in source would scatter across the tree what this file
# keeps in one reviewable place; if that trade is ever worth making, make it deliberately, not rule by rule.

# CA1822 (mark members as static) is scoped to the members where satisfying it is free.
#
# On a private or internal member, adding `static` costs nothing and states something true, so the rule is
# left in force there — it moved the SOAP mapping helpers and the catalog registration hooks.
#
# On a PUBLIC member it is not a performance question at all. C# forbids calling a static member through an
# instance reference, so promoting one is source-breaking for every caller and binary-breaking for every
# compiled one. The findings are all in the two facades whose whole design is to be reached through an
# instance: ProjectCommands, documented as the single authoring door behind ProjectAppService.Commands, whose
# factories deliberately share one shape (`Foo(Project project, …)`) whether or not that particular command
# needs the catalog or the clock; and ProjectAppService itself. Splitting either set into static and instance
# halves by whether today's implementation happens to touch a field would fracture the vocabulary and break
# `service.Commands.AddLocality(…)` — to save pushing `this`.
#
# What the public surface is actually governed by is PublicAPI.Shipped.txt, which gates every addition and
# signature change deliberately, and would record such a promotion as the breaking change it is.
#
# The SETTING that says this lives in /.globalconfig, because the applications reached the same scoping from
# their own direction (a static view-model property binds to nothing at runtime). Written once there rather
# than twice, so a reader can see which entry is in force; the reason above is why the SDK would still need
# it if the applications ever stopped.

# CA1707 (identifiers should not contain underscores) is off, on the same ground as RS0026/RS0027 below:
# it is a naming rule whose every finding sits on a surface this project has deliberately frozen.
#
# Every one is shipped public API recorded in PublicAPI.Shipped.txt — the Ihc.Errors.* error-code
# constants, Ihc.UserConstants.REDACTED_PASSWORD, and parameter names on public interface members
# (timeout_between_waits_in_seconds, timeout_seconds, _cookie). None can be renamed without breaking
# consumers: a renamed parameter breaks every named-argument call site, and a renamed const is worse than
# that — const values are inlined at the consumer's compile, so the break is silent until they rebuild.
#
# The rule is not measuring a defect here, and it is not the gate on this surface either. PublicAPI.*.txt is,
# and it would record a rename as the breaking change it is. Renaming these remains available as a deliberate
# version decision; it is not something an analyzer mode should do as a side effect.
#
# The rule is NOT off repo-wide. Most projects here do have an underscore in their assembly name, but that is
# a different reason from this one, so it is scoped where it applies — applications/, utilities/ and
# shared/ each carry an .editorconfig that says so. The examples keep the rule on, and so would any new
# project with a clean name.
dotnet_diagnostic.CA1707.severity = none

# CA1708 (identifiers should not differ only by case) is off. Its findings fall into three groups, and
# none of them is a name anyone chose badly.
#
# One group is not a case difference at all. CA1708 has not caught up with C# 14 extension members: every
# extension block lowers to a member the rule reads as `extension(...)`, and `extension` is a keyword
# position, not an identifier. In CategoryExtensions it reports one block against the OTHER block with the
# same receiver type — the same spelling, so "differ by more than case" is unsatisfiable; in ValidationGate
# it reports two blocks whose receivers are different types entirely. Neither is renameable without giving
# up the language feature.
#
# Another group is Ihc.FieldMetaData, where both spellings are shipped public API: PublicAPI.Shipped.txt records
# AttributeProvider.get and attributeProvider.get side by side. The record takes lower-cased positional
# parameters so construction stays positional, and re-declares the surface in PascalCase so callers read
# idiomatic names; the type says so in a comment above the re-declarations. Dropping either spelling breaks
# consumers, and which one to drop is a version decision, not an analyzer's.
#
# The last is the fluent-builder shape in DefinitionBuilderBase: a `private protected` field beside the verb that
# sets it (categoryPath/CategoryPath, grammar/Grammar). The rule exists for consumers in languages that
# cannot tell Foo from foo apart — and a `private protected` field is not visible to any of them.
dotnet_diagnostic.CA1708.severity = none

# CA1720 (identifier contains type name) is off. The rule is aimed at Hungarian residue — a `GetIntValue` or
# an `intCount`, where the type name is noise the identifier would read better without. Every finding here is
# the opposite case: a member of a kind-enum whose whole job is to enumerate value types, where the type name
# IS the meaning.
#
# ResourceValue.ValueKind.INT and .DOUBLE sit among BOOL, DATE, ENUM, TIME; ProblemArgumentKind.Integer sits
# beside Number and Path; ResourceValueKind.Decimal is documented as distinct from Number precisely because
# the .vis format writes 43.00 where Number writes 43 — rename it and the distinction it exists to carry has
# no name left. ResourceInitialValue's Decimal parameter and property are that kind's payload.
#
# They are also shipped: PublicAPI.Shipped.txt records ValueKind.INT, ValueKind.DOUBLE, ResourceValueKind.Decimal
# and ResourceInitialValue.Decimal, so no rename is available that is not a breaking change.
dotnet_diagnostic.CA1720.severity = none

# CA1051 (do not declare visible instance fields) is off. Every finding is on surface that is already
# pinned somewhere else, and two of them are not the SDK's to restyle at all.
#
# RequestEnvelope<T>.Body and ResponseEnvelope<T>.Body are SOAP wire members: they carry
# [XmlElement(Order = ...)] and XmlSerializer binds them by that declaration. Their shape is the message
# format, not a style choice.
#
# The others — ErrorWithCodeException.ErrorCode, serviceBase.settings and
# AuthenticatedAppServiceBase.authService — are shipped, and PublicAPI.Shipped.txt records ErrorCode
# explicitly as a readonly FIELD. Promoting a field to a property keeps source compatibility but not binary
# compatibility: a field read compiles to ldfld at the consumer, and every already-compiled caller breaks on
# the next load. That is a version decision with a baseline entry to move, not something to do in passing.
dotnet_diagnostic.CA1051.severity = none

# CA1068 (CancellationToken parameters must come last) is off. Its findings are all one signature.
#
# IOpenAPIService.GetResourceValueChanges and IResourceInteractionService.GetResourceValueChanges are
# shipped with the token in position two, ahead of timeout_between_waits_in_seconds, and both are recorded
# that way in PublicAPI.Shipped.txt. Both trailing parameters are optional, so the convention the rule
# protects — a caller can just append a token — already holds; what reordering would buy is the declaration
# order, at the cost of breaking every positional three-argument call site (the examples, the Lab fakes and
# the unit tests all pass all three).
#
# The last is ServiceHelpers.GetResourceValueChanges, which is `internal` and reaches the rule only through
# InternalsVisibleTo. It exists to carry the body of the other two and mirrors their parameter order
# deliberately; reordering it alone would satisfy the rule by making the helper disagree with the two methods
# it serves.
dotnet_diagnostic.CA1068.severity = none

# CA1715 (prefix interface names with 'I') is off. Ihc.BinaryFile and Ihc.TextFile are shipped interfaces,
# recorded in PublicAPI.Shipped.txt, and they are the SDK's file-carrying contract, so the rename does not
# stop at this project: files across the SDK, the Lab utility (down to a BinaryFilePicker control) and the
# test suites implement or consume them.
#
# The convention is worth having and the names do read as classes; but adopting it is a breaking API change
# with a blast radius outside this assembly, which is a version decision rather than a build-mode one.
dotnet_diagnostic.CA1715.severity = none

# CA1711 (identifiers should not have an incorrect suffix) is off. It fires on DialogBinding.RootAttribute and
# DialogBinding.DescendantAttribute, wanting the 'Attribute' suffix reserved for System.Attribute subclasses.
#
# Here 'attribute' is the domain noun, not a framework suffix: a DialogBinding says WHICH XML attribute of a
# product a dialog field is bound to, and the two cases say whether it sits on the root element or on the
# first matching descendant. Both are nested in DialogBinding and read at their use sites as
# DialogBinding.RootAttribute, so nothing invites the System.Attribute reading the rule guards against —
# and dropping the word would remove the one the type is about. Both are also shipped public API.
dotnet_diagnostic.CA1711.severity = none

# CA1716 (do not name a virtual/interface member after a reserved language keyword) is off. It fires on
# IProgramUsageAnalysis.Of, and 'Of' is reserved in Visual Basic, not in C#.
#
# 'Of' is the validation layer's own word for "the facts about this element": IdAnalysis.Of,
# TopologyAnalysis.Of, ProgramUsageAnalysis.Of and EnumValueIndex.Of all spell it that way. The rule reaches
# only the interface member, because only that one is implementable from another language — so satisfying it
# would rename exactly one member of a family whose whole value is reading the same everywhere, on behalf of
# a language this SDK does not target and in which the caller can write [Of] anyway.
#
# The rule is NOT off repo-wide, and its keyword set is not VB-only — it reports C#'s own keywords too. The
# only other finding is in OpenVisual, declined in applications/.editorconfig on its own grounds.
dotnet_diagnostic.CA1716.severity = none

# CA1000 (do not declare static members on generic types) is off. It fires on EquatableArray<T>.Empty
# and EquatableSet<T>.Empty, and that spelling is the point rather than an oversight.
#
# Both are readonly structs wrapping ImmutableArray<T>, and they mirror its surface deliberately — the
# accessor right above Empty names ImmutableArray<T>.Empty as what it is modelled on. The BCL states the empty
# value of a generic collection this way throughout (ImmutableArray<T>.Empty, ReadOnlySpan<T>.Empty,
# Memory<T>.Empty), so a reader already knows the shape, and the call sites here spell it that way.
#
# The rule's alternative is a non-generic companion — EquatableArray.Empty<T>() — which asks the caller for
# MORE type arguments, not fewer, and stops the type reading like the one it wraps. Both are shipped API.
dotnet_diagnostic.CA1000.severity = none

# CA1036 (override the comparison operators on a comparable type) is off. It fires on IhcUser, and the
# operators it asks for could not be made truthful here.
#
# IhcUser is a record, so == and != are memberwise over all ten members, while CompareTo orders on Username
# alone — it exists to sort a user list, which is what the summary above it says. Add < <= > >= over that
# CompareTo and the type publishes a contradiction: two users with the same Username and different Passwords
# satisfy a <= b and a >= b while a == b is false. CA1036's own guidance is that the operators agree with
# equality, and reaching that means changing either the record's equality or the ordering — both breaking, on
# a shipped type whose CompareTo is already recorded in PublicAPI.Shipped.txt.
#
# The rule is right that IComparable normally implies the operators. The honest answer here is that the
# ordering is a sort key rather than a total order over the value, and adding operators would hide that.
dotnet_diagnostic.CA1036.severity = none

# Public-API baseline: the two optional-parameter backcompat rules are off.
#
# RS0026 (no multiple overloads with optional parameters) and RS0027 (an API with optional parameters
# should have the most parameters among its overloads) are API *design* rules, not part of pinning a
# surface. They fire on 66 existing signatures — concentrated in the builder APIs and ProjectAppService —
# where the overload sets are the intended shape. Satisfying them would mean redesigning public API to
# suit a lint rule. The baseline files themselves remain the change gate (RS0016/RS0017).
dotnet_diagnostic.RS0026.severity = none
dotnet_diagnostic.RS0027.severity = none

# RS0041 (public member declared with oblivious nullability) is ON, and keeps the SDK's public surface
# annotated now that it is. It was off while the surface was still being migrated, because it would have
# failed the build once per member for a condition that was known and deliberately incremental; that
# migration is done, the authored surface raises RS0041 nowhere, and the rule is what stops it regressing.
# The generated SOAP layer is scoped out of this rule from the ROOT .editorconfig — see the note there for
# why the exclusion cannot live inside generatedsrc/.
dotnet_diagnostic.RS0041.severity = warning
