<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TargetFramework / TreatWarningsAsErrors come from Directory.Build.props. -->
    <!-- The SDK is the one library still compiled without nullable reference types, so its public
         API expresses no nullability contract to the apps built on it. Tracked as designfix P3/C4. -->
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591,CS1587</NoWarn>
    <Version>0.8.1</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <InformationalVersion>This is a beta package</InformationalVersion>
    <Copyright>Apache License 2.0</Copyright>
    <Authors>mmc41</Authors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="safe_integration_tests" />
    <InternalsVisibleTo Include="safe_unit_tests" />
    <InternalsVisibleTo Include="safe_project_tests" />
    <InternalsVisibleTo Include="ihc_lab" />
  </ItemGroup>
  <ItemGroup>
    <!-- Verbatim canonical .vis DTD blocks (the schema registry's single source of truth). Embedded so the
         byte-exact serializer reproduces IHC Visual's inline DTD without recomputing any DTD text. -->
    <None Remove="src\vis\schema\CanonicalDtdBlocks.dtd" />
    <EmbeddedResource Include="src\vis\schema\CanonicalDtdBlocks.dtd">
      <LogicalName>Ihc.Vis.CanonicalDtdBlocks.dtd</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="analyser.config" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="System.ServiceModel.Duplex" />
    <PackageReference Include="System.ServiceModel.Http" />
    <PackageReference Include="System.ServiceModel.NetTcp" />
    <PackageReference Include="System.ServiceModel.Primitives" />
    <PackageReference Include="System.ServiceModel.Security" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>
</Project>