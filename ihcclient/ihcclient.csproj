<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591,CS1587</NoWarn>
    <Version>0.8.1</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <InformationalVersion>This is a beta package</InformationalVersion>
    <Copyright>Apache License 2.0</Copyright>
    <Authors>mmc41</Authors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="safe_integration_tests" />
    <InternalsVisibleTo Include="safe_unit_tests" />
    <InternalsVisibleTo Include="safe_project_tests" />
    <InternalsVisibleTo Include="ihc_lab" />
  </ItemGroup>
  <ItemGroup>
    <!-- Verbatim canonical .vis DTD blocks (the schema registry's single source of truth). Embedded so the
         byte-exact serializer reproduces IHC Visual's inline DTD without recomputing any DTD text. -->
    <None Remove="src\vis\schema\CanonicalDtdBlocks.dtd" />
    <EmbeddedResource Include="src\vis\schema\CanonicalDtdBlocks.dtd">
      <LogicalName>Ihc.Projects.CanonicalDtdBlocks.dtd</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="analyser.config" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="System.ServiceModel.Duplex" Version="6.0.0" />
    <PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.NetTcp" Version="8.1.2" />
    <PackageReference Include="System.ServiceModel.Security" Version="6.0.0" />
    <!-- Override the vulnerable 8.0.2 pulled in transitively by System.ServiceModel.Primitives
         (advisories GHSA-37gx-xxp4-5rgx and GHSA-w3x6-4m5h-cxqf). 8.0.3 is the patched 8.x release. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Primitives" Version="8.*" />
  </ItemGroup>
</Project>