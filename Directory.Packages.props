<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Central Package Management: one version per package for the whole repository.

    Package versions used to live in the 17 individual project files, where nothing compared them.
    Six packages had forked across the test suites by the time this file was written — NUnit ran at
    three versions and coverlet at three, and FakeItEasy differed by a MAJOR version between the two
    suites that use it. A version stated once cannot drift.

    Adding a version here is the only supported way to introduce one, and
    CentralPackageVersionOverrideEnabled=false is what makes that a rule rather than a convention: a
    VersionOverride on any PackageReference is now a restore-time ERROR. The escape hatch is relocated
    rather than removed — a project that genuinely must diverge is unblocked by turning that flag off
    here, which is an edit to this file and so gets reviewed, instead of one line in one project file
    that only a grep would ever surface. No project overrode a version when this was turned on.

    Every entry is referenced by at least one project. An entry nothing references restores nothing and
    is checked by nothing, so it reads as a supported dependency while being neither — which is what
    Microsoft.CodeAnalysis.CSharp had become before it was removed.

    Packages that ship together are grouped and bumped together, and where a group is NOT uniform the
    reason is stated on the entry that breaks the pattern. Two pairs are matched for a harder reason
    than tidiness:

      - NUnit and NUnit.Analyzers. Framework 4.6.1 against analyzer 4.10.0 raises a spurious NUnit2021
        ("EqualTo always fails") on a correct assertion.
      - The two Microsoft.CodeAnalysis analyzers, which are one Roslyn release train.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="WCF / SOAP (consumed by ihcclient's generated proxies)">
    <!-- Duplex and Security look like drift beside the 8.1.2 trio and are not: 6.0.0 is the LAST version
         either package was ever published at, so there is nothing to raise them to. Do not "fix" the gap. -->
    <PackageVersion Include="System.ServiceModel.Duplex" Version="6.0.0" />
    <PackageVersion Include="System.ServiceModel.Security" Version="6.0.0" />
    <PackageVersion Include="System.ServiceModel.Http" Version="8.1.2" />
    <PackageVersion Include="System.ServiceModel.NetTcp" Version="8.1.2" />
    <!-- Was a floating '8.*' in ihcclient.csproj, resolving to 8.1.2. Pinned: a floating version is
         a restore-time drift source of exactly the kind this file exists to remove. -->
    <PackageVersion Include="System.ServiceModel.Primitives" Version="8.1.2" />
  </ItemGroup>

  <!-- Out-of-band BCL packages. Same release train as Microsoft.Extensions above, hence the same version. -->
  <ItemGroup Label="BCL">
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.11" />
    <!-- Referenced top-level by ihcclient to override the vulnerable 8.0.2 that
         System.ServiceModel.Primitives pulls in transitively (advisories GHSA-37gx-xxp4-5rgx and
         GHSA-w3x6-4m5h-cxqf). Any 8.0.3+ clears those; it rides the runtime's own release train, so it
         tracks ConfigurationManager above rather than the WCF versions it is overriding. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
    <!-- GDI+ imaging, for the screen capture in shared/ihc_uiautomation_windows. Windows-only at RUN time (its
         types carry SupportedOSPlatform("windows")), which is exactly what that toolkit already declares; the
         package ships a net10.0 asset, so a platform-neutral project still compiles against it everywhere. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Avalonia / GUI">
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Runtime XAML parsing, referenced only so HotAvalonia gets it at the SAME version as Avalonia: the
         plugin ships an old copy to stay compatible back to Avalonia 11, which does not parse 12's markup. -->
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Headless.NUnit" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- IDE-agnostic .axaml hot reload (MIT). Development-only: nothing of it ships in a Release build. -->
    <PackageVersion Include="HotAvalonia" Version="3.1.4" />
    <!-- 12.0.0.15 or newer is REQUIRED, not merely current: through 12.0.0.13 the control resolved the SVG
         `currentColor` keyword on Windows only. On Linux/macOS every glyph fell back to the SVG default (pure
         black), so the icon ink token was ignored and a disabled toolbar command rendered exactly as dark as an
         available one — no disabled affordance at all on two of the three desktops this app targets. The
         `CurrentColor` PROPERTY read back correctly the whole time, so only rendered pixels ever showed it
         (measured Windows vs Ubuntu 24.04, 2026-08-17: glyph core #303030/#A6A6A6 vs #000000/#000000).
         Literal colours were always honoured — it is the keyword resolution that was platform-dependent. -->
    <PackageVersion Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.15" />
  </ItemGroup>

  <ItemGroup Label="Telemetry">
    <PackageVersion Include="OpenTelemetry" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="CompareNETObjects" Version="4.84.0" />
    <PackageVersion Include="CsCheck" Version="4.7.0" />
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
    <!-- Ships from dotnet/extensions, whose versions run ahead of the runtime's — so this is the one
         Microsoft.Extensions.* entry that does NOT track the 10.0.x above, and matching it to those would
         be a downgrade to a version that does not exist. It was left behind on 9.0.0 while the rest of the
         family moved to 10.x. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <!-- Architecture fitness tests: ArchUnitNET reads IL to enforce the SDK's directional layering
         rules (safe_architecture_tests). The .NUnit package supplies the Check() assertion adapter. -->
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.3" />
    <PackageVersion Include="TngTech.ArchUnitNET.NUnit" Version="0.13.3" />
  </ItemGroup>

  <ItemGroup Label="Tooling">
    <PackageVersion Include="AspNetCore.Proxy" Version="4.5.0" />
    <!-- Pins the SDK's public API surface as a reviewable text file (ihcclient only). Analyzer-only:
         PrivateAssets="all" keeps it out of any consumer's dependency graph. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- Compile-time ban on the generated SOAP layer outside the SDK (see BannedSymbols.txt and
         Directory.Build.targets). Same Roslyn analyzer release train as the public-API analyzer above:
         bump them together. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <!-- Source generator for the Win32 and UIA3 COM surface ihc_uiautomation_windows drives (that project
         only). Generator-only: PrivateAssets="all" at the reference keeps it out of any dependency graph, and
         nothing of it ships. Pinned at the version measured to compile clean at plain net10.0 under this
         repository's analyzer settings — FlaUI, the obvious alternative, publishes no net10.0 asset at all. -->
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.321" />
  </ItemGroup>

</Project>
